#Область ОбработчикиСобытий

Функция WebhookPOST(HTTPЗапрос)

    ИмяБота = HTTPЗапрос.ПараметрыURL.Получить("bot");
    СекретВебхука = HTTPЗапрос.Заголовки.Получить("X-Telegram-Bot-Api-Secret-Token");
    ТелоЗапроса = HTTPЗапрос.ПолучитьТелоКакСтроку();

    РезультатПриема = ЕРП_ИнтеграцияUBT.ПринятьWebhook(
        ИмяБота,
        СекретВебхука,
        ТелоЗапроса);

    Если Не РезультатПриема.Успешно Тогда
        Возврат Новый HTTPСервисОтвет(404);
    КонецЕсли;

    Попытка

        Обновление = УБТ_РаботаСJSON.JSONВЗначение(ТелоЗапроса, , Ложь);
        МассивОбновлений = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Обновление);
        ТаблицаСообщений =
            УБТ_РаботаСБотамиTelegram.ПолученныеСообщенияВТаблицуЗначений(
                МассивОбновлений);

        Бот = Справочники.УБТ_БотыTelegram.НайтиБотаTelegramПоИмениИСекретномуЗаголовку(
            ИмяБота,
            СекретВебхука);
        УБТ_РаботаСБотамиTelegram.ОтветитьНаПолученныеСообщения(
            Бот,
            ТаблицаСообщений);

    Исключение

        ЗаписьЖурналаРегистрации(
            "ЕРП_TelegramWebhook",
            УровеньЖурналаРегистрации.Ошибка,
            ,
            ,
            "Ошибка передачи Telegram update в штатный обработчик УБТ.");
        Возврат Новый HTTPСервисОтвет(500);

    КонецПопытки;

    Возврат Новый HTTPСервисОтвет(200);

КонецФункции

#КонецОбласти

       
////////////////////////////////////////////////////////////////////////////////
// Форма обработки: ЕРП_НастройкаSMTP
////////////////////////////////////////////////////////////////////////////////

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Настройки = ЕРП_ОтправкаПочты.ЕРП_ПолучитьНастройкиSMTP();

	SMTPСервер = Настройки.SMTPСервер;
	SMTPПорт = Настройки.SMTPПорт;
	SMTPЛогин = Настройки.SMTPЛогин;
	SMTPПароль = Настройки.SMTPПароль;
	АдресОтправителя = Настройки.АдресОтправителя;
	ИспользоватьSSL = Настройки.ИспользоватьSSL;

	АдресПолучателя = "naumovd@radixrnd.ru";
	ТемаПисьма = "Проверка отправки почты из 1С ERP";

	ТекстПисьма =
		"Это контрольное сообщение из 1С ERP." + Символы.ПС
		+ "Проверка SMTP-соединения NIC.RU." + Символы.ПС
		+ "Если вы получили это письмо, отправка почты работает.";
    Сообщить("Сервер: текст письма = " + ТекстПисьма); 
	
	Если ПустаяСтрока(ТекстПисьма) Тогда
	ТекстПисьма = "Контрольное письмо из 1С ERP. Проверка SMTP.";
КонецЕсли;

КонецПроцедуры


&НаКлиенте
Процедура СохранитьНастройки(Команда)

	Результат = СохранитьНастройкиНаСервере();

	Сообщить(Результат);

КонецПроцедуры


&НаСервере
Функция СохранитьНастройкиНаСервере()

	Возврат ЕРП_ОтправкаПочты.ЕРП_СохранитьНастройкиSMTP(
		SMTPСервер,
		SMTPПорт,
		SMTPЛогин,
		SMTPПароль,
		АдресОтправителя,
		ИспользоватьSSL
	);

КонецФункции


&НаКлиенте
Процедура ОтправитьКонтрольноеПисьмо(Команда)

	РезультатСохранения = СохранитьНастройкиНаСервере();

	Если Лев(РезультатСохранения, 6) = "ОШИБКА" Тогда
		Сообщить(РезультатСохранения);
		Возврат;
	КонецЕсли;

	РезультатОтправки = ОтправитьПисьмоНаСервере();

	Сообщить(РезультатОтправки);

КонецПроцедуры


&НаСервере
Функция ОтправитьПисьмоНаСервере()

	Возврат ЕРП_ОтправкаПочты.ЕРП_ОтправитьПисьмо(
		АдресПолучателя,
		ТемаПисьма,
		ТекстПисьма
	);

КонецФункции


&НаКлиенте
Процедура ЗакрытьФорму(Команда)

	Закрыть();

КонецПроцедуры

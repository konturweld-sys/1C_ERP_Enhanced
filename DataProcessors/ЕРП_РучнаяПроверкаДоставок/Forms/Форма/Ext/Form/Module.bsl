////////////////////////////////////////////////////////////////////////////////
// Форма рабочего места ручной проверки доставок уведомлений.
////////////////////////////////////////////////////////////////////////////////

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Не РольДоступна("ЕРП_УправлениеДоставками") Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	ЗагрузитьСледующуюДоставкуНаСервере("");

КонецПроцедуры


&НаКлиенте
Процедура СледующаяДоставка(Команда)
	ЗагрузитьСледующуюДоставкуНаСервере(КлючДоставки);
КонецПроцедуры


&НаСервере
Процедура ЗагрузитьСледующуюДоставкуНаСервере(ПослеКлюча)

	Попытка
		Данные = ЕРП_ОбработкаОчередиУведомлений.ПолучитьДоставкуТребующуюПроверки(ПослеКлюча);

		Если Не Данные.Найдено Тогда
			КлючДоставки = "";
			Состояние = "";
			Сотрудник = "";
			Канал = "";
			АдресПолучателя = "";
			Тема = "";
			ТекстСообщения = "";
			КоличествоПопыток = 0;
			ПоследняяОшибка = "Нет доставок, требующих ручной проверки.";
			КомментарийРешения = "";
			Возврат;
		КонецЕсли;

		КлючДоставки = Данные.КлючДоставки;
		Состояние = "ТребуетПроверки";
		Сотрудник = Данные.Сотрудник;
		Канал = Данные.Канал;
		АдресПолучателя = Данные.АдресПолучателя;
		Тема = Данные.Тема;
		ТекстСообщения = Данные.ТекстСообщения;
		КоличествоПопыток = Данные.КоличествоПопыток;
		ПоследняяОшибка = Данные.ПоследняяОшибка;
		КомментарийРешения = "";

	Исключение
		КлючДоставки = "";
		Состояние = "Ошибка";
		Сотрудник = "";
		Канал = "";
		АдресПолучателя = "";
		Тема = "";
		ТекстСообщения = "";
		КоличествоПопыток = 0;
		ПоследняяОшибка =
			"Не удалось загрузить доставку для ручной проверки: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КомментарийРешения = "";
	КонецПопытки;

КонецПроцедуры


&НаКлиенте
Процедура ПодтвердитьОтправку(Команда)
	ВыполнитьРучноеРешение("ПодтвердитьОтправку");
КонецПроцедуры


&НаКлиенте
Процедура РазрешитьОднократныйПовтор(Команда)
	ВыполнитьРучноеРешение("РазрешитьОднократныйПовтор");
КонецПроцедуры


&НаКлиенте
Процедура ВыполнитьРучноеРешение(Решение)

	Если Не ЗначениеЗаполнено(КлючДоставки) Тогда
		ПоказатьПредупреждение(, "Нет выбранной доставки.");
		Возврат;
	КонецЕсли;

	Если ПустаяСтрока(СокрЛП(КомментарийРешения)) Тогда
		Если Решение = "ПодтвердитьОтправку" Тогда
			ПоказатьПредупреждение(, "Укажите комментарий, подтверждающий отправку.");
		Иначе
			ПоказатьПредупреждение(, "Укажите причину, по которой подтверждено отсутствие отправки.");
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Результат = ПрименитьРучноеРешениеНаСервере(
		КлючДоставки,
		Решение,
		КомментарийРешения
	);

	Если Не Результат.Успех Тогда
		ПоказатьПредупреждение(, Результат.ОписаниеОшибки);
		Возврат;
	КонецЕсли;

	ПоказатьОповещениеПользователя(
		"Ручное решение применено",
		,
		Результат.Сообщение,
		БиблиотекаКартинок.Успешно
	);

	ЗагрузитьСледующуюДоставкуНаСервере("");

КонецПроцедуры


&НаСервере
Функция ПрименитьРучноеРешениеНаСервере(КлючДоставкиДляРешения, Решение, Комментарий)

	Результат = Новый Структура("Успех,ОписаниеОшибки,Сообщение", Ложь, "", "");

	Попытка
		Если Не ЗначениеЗаполнено(КлючДоставкиДляРешения) Тогда
			ВызватьИсключение "Не выбрана доставка для ручного решения.";
		КонецЕсли;

		ЕРП_ОбработкаОчередиУведомлений.ПрименитьРучноеРешениеПоДоставке(
			КлючДоставкиДляРешения,
			Решение,
			Комментарий
		);

		Результат.Успех = Истина;
		Если Решение = "ПодтвердитьОтправку" Тогда
			Результат.Сообщение = "Отправка подтверждена. Доставка переведена в состояние «Отправлено».";
		Иначе
			Результат.Сообщение = "Для доставки разрешена одна повторная попытка.";
		КонецЕсли;

	Исключение
		Результат.ОписаниеОшибки =
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат Результат;

КонецФункции


&НаКлиенте
Процедура ЗакрытьФорму(Команда)
	Закрыть();
КонецПроцедуры

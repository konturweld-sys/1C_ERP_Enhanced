////////////////////////////////////////////////////////////////////////////////
// Форма рабочего места ручной проверки доставок уведомлений.
////////////////////////////////////////////////////////////////////////////////

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Не РольДоступна("ЕРП_УправлениеДоставками") Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	ЗагрузитьСледующуюДоставкуНаСервере("");

КонецПроцедуры


&НаКлиенте
Процедура СледующаяДоставка(Команда)
	ЗагрузитьСледующуюДоставкуНаСервере(КлючДоставки);
КонецПроцедуры


&НаСервере
Процедура ЗагрузитьСледующуюДоставкуНаСервере(ПослеКлюча)

	Данные = ЕРП_ОбработкаОчередиУведомлений.ПолучитьДоставкуТребующуюПроверки(ПослеКлюча);

	Если Не Данные.Найдено Тогда
		КлючДоставки = "";
		Состояние = "";
		Сотрудник = "";
		Канал = "";
		АдресПолучателя = "";
		Тема = "";
		ТекстСообщения = "";
		КоличествоПопыток = 0;
		ПоследняяОшибка = "Нет доставок, требующих ручной проверки.";
		КомментарийРешения = "";
		Возврат;
	КонецЕсли;

	КлючДоставки = Данные.КлючДоставки;
	Состояние = "ТребуетПроверки";
	Сотрудник = Данные.Сотрудник;
	Канал = Данные.Канал;
	АдресПолучателя = Данные.АдресПолучателя;
	Тема = Данные.Тема;
	ТекстСообщения = Данные.ТекстСообщения;
	КоличествоПопыток = Данные.КоличествоПопыток;
	ПоследняяОшибка = Данные.ПоследняяОшибка;
	КомментарийРешения = "";

КонецПроцедуры


&НаКлиенте
Процедура ПодтвердитьОтправку(Команда)

	Если Не ЗначениеЗаполнено(КлючДоставки) Тогда
		Сообщить("Нет выбранной доставки.");
		Возврат;
	КонецЕсли;
	Если ПустаяСтрока(СокрЛП(КомментарийРешения)) Тогда
		Сообщить("Укажите комментарий, подтверждающий отправку.");
		Возврат;
	КонецЕсли;

	ПрименитьРучноеРешениеНаСервере("ПодтвердитьОтправку");
	ЗагрузитьСледующуюДоставкуНаСервере("");

КонецПроцедуры


&НаКлиенте
Процедура РазрешитьОднократныйПовтор(Команда)

	Если Не ЗначениеЗаполнено(КлючДоставки) Тогда
		Сообщить("Нет выбранной доставки.");
		Возврат;
	КонецЕсли;
	Если ПустаяСтрока(СокрЛП(КомментарийРешения)) Тогда
		Сообщить("Укажите причину, по которой подтверждено отсутствие отправки.");
		Возврат;
	КонецЕсли;

	ПрименитьРучноеРешениеНаСервере("РазрешитьОднократныйПовтор");
	ЗагрузитьСледующуюДоставкуНаСервере("");

КонецПроцедуры


&НаСервере
Процедура ПрименитьРучноеРешениеНаСервере(Решение)

	ЕРП_ОбработкаОчередиУведомлений.ПрименитьРучноеРешениеПоДоставке(
		КлючДоставки,
		Решение,
		КомментарийРешения
	);

КонецПроцедуры


&НаКлиенте
Процедура ЗакрытьФорму(Команда)
	Закрыть();
КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// Форма обработки: ЕРП_НастройкаИнтеграцииRabbitMQ
//
// Назначение:
// 1. Загрузка настроек RabbitMQ из регистра при открытии формы.
// 2. Отображение настроек в реквизитах формы.
// 3. Сохранение настроек в регистр сведений.
// 4. Закрытие формы.
////////////////////////////////////////////////////////////////////////////////


////////////////////////////////////////////////////////////////////////////////
// ЗАГРУЗКА НАСТРОЕК ПРИ СОЗДАНИИ ФОРМЫ
////////////////////////////////////////////////////////////////////////////////

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

    Настройки = ЕРП_ИнтеграцияRabbitMQ.ЕРП_ПолучитьНастройки();

    Если Настройки = Неопределено Тогда
        Отказ = Истина;
        Сообщить("Не удалось получить настройки RabbitMQ.");
        Возврат;
    КонецЕсли;

    // Заполняем непосредственно реквизиты управляемой формы.

    Сервер = Настройки.Сервер;
    Порт = Настройки.Порт;
    Пользователь = Настройки.Пользователь;
    Пароль = Настройки.Пароль;
    ВиртуальныйХост = Настройки.ВиртуальныйХост;

КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// СОХРАНЕНИЕ НАСТРОЕК
////////////////////////////////////////////////////////////////////////////////

&НаКлиенте
Процедура ЗаписатьНажатие1(Команда)

    Если ПустаяСтрока(Сервер) Тогда
        Сообщить("Не указан сервер RabbitMQ.");
        Возврат;
    КонецЕсли;

    Если Порт <= 0 Тогда
        Сообщить("Указан некорректный порт RabbitMQ.");
        Возврат;
    КонецЕсли;

    Если ПустаяСтрока(Пользователь) Тогда
        Сообщить("Не указан пользователь RabbitMQ.");
        Возврат;
    КонецЕсли;

    Если ПустаяСтрока(ВиртуальныйХост) Тогда
        Сообщить("Не указан виртуальный хост RabbitMQ.");
        Возврат;
    КонецЕсли;

    ЕРП_ИнтеграцияRabbitMQ.ЕРП_СохранитьНастройки(
        Сервер,
        Порт,
        Пользователь,
        Пароль,
        ВиртуальныйХост
    );

    Сообщить("Настройки RabbitMQ сохранены.");

КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// ЗАКРЫТИЕ ФОРМЫ
////////////////////////////////////////////////////////////////////////////////

&НаКлиенте
Процедура ЗакрытьНажатие1(Команда)

    Закрыть();

КонецПроцедуры

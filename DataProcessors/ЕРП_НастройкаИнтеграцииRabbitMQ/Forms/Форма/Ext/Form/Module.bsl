////////////////////////////////////////////////////////////////////////////////
// Форма обработки: ЕРП_НастройкаИнтеграцииRabbitMQ
//
// Назначение:
// 1. Загрузка настроек RabbitMQ при открытии формы.
// 2. Проверка и сохранение настроек через серверный общий модуль.
// 3. Понятное отображение ошибок пользователю.
////////////////////////////////////////////////////////////////////////////////

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

    Попытка

        Настройки = ЕРП_ИнтеграцияRabbitMQ.ЕРП_ПолучитьНастройки();

        Если Настройки = Неопределено Тогда
            ВызватьИсключение "Не удалось получить настройки RabbitMQ.";
        КонецЕсли;

        Сервер = Настройки.Сервер;
        Порт = Настройки.Порт;
        Пользователь = Настройки.Пользователь;
        Пароль = Настройки.Пароль;
        ВиртуальныйХост = Настройки.ВиртуальныйХост;

    Исключение

        Отказ = Истина;
        Сообщить(
            "Не удалось загрузить настройки RabbitMQ: "
            + ОписаниеОшибки()
        );

    КонецПопытки;

КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// СОХРАНЕНИЕ НАСТРОЕК
////////////////////////////////////////////////////////////////////////////////

&НаКлиенте
Процедура ЗаписатьНажатие1(Команда)

    Если ПустаяСтрока(СокрЛП(Сервер)) Тогда
        Сообщить("Не указан сервер RabbitMQ.");
        Возврат;
    КонецЕсли;

    Если Порт < 1 Или Порт > 65535 Тогда
        Сообщить("Порт RabbitMQ должен быть в диапазоне от 1 до 65535.");
        Возврат;
    КонецЕсли;

    Если ПустаяСтрока(СокрЛП(Пользователь)) Тогда
        Сообщить("Не указан пользователь RabbitMQ.");
        Возврат;
    КонецЕсли;

    Если ПустаяСтрока(СокрЛП(ВиртуальныйХост)) Тогда
        Сообщить("Не указан виртуальный хост RabbitMQ.");
        Возврат;
    КонецЕсли;

    Попытка

        Результат = СохранитьНастройкиНаСервере(
            Сервер,
            Порт,
            Пользователь,
            Пароль,
            ВиртуальныйХост
        );

    Исключение

        Сообщить(
            "Не удалось получить результат сохранения настроек RabbitMQ. "
            + "Обновите форму и проверьте сохранённые значения перед повторной записью. "
            + ОписаниеОшибки()
        );
        Возврат;

    КонецПопытки;

    Если Не Результат.Успех Тогда

        Если Результат.НастройкиСохранены Тогда
            Сообщить(
                "Настройки RabbitMQ сохранены, но регламентное задание "
                + "приема номенклатуры из PDM не зарегистрировано: "
                + Результат.ОписаниеОшибки
            );
        Иначе
            Сообщить(
                "Настройки RabbitMQ не сохранены: "
                + Результат.ОписаниеОшибки
            );
        КонецЕсли;

        Возврат;

    КонецЕсли;

    Сообщить(
        "Настройки RabbitMQ сохранены. "
        + "Регламентное задание приема номенклатуры из PDM зарегистрировано."
    );

КонецПроцедуры


&НаСервере
Функция СохранитьНастройкиНаСервере(
    Сервер,
    Порт,
    Пользователь,
    Пароль,
    ВиртуальныйХост
)

    Результат = Новый Структура;
    Результат.Вставить("Успех", Ложь);
    Результат.Вставить("НастройкиСохранены", Ложь);
    Результат.Вставить("ЗаданиеЗарегистрировано", Ложь);
    Результат.Вставить("ОписаниеОшибки", "");

    Попытка

        ЕРП_ИнтеграцияRabbitMQ.ЕРП_СохранитьНастройки(
            Сервер,
            Порт,
            Пользователь,
            Пароль,
            ВиртуальныйХост
        );

        Результат.НастройкиСохранены = Истина;

    Исключение

        Результат.ОписаниеОшибки =
            "Не удалось сохранить настройки RabbitMQ: "
            + ОписаниеОшибки();

        Возврат Результат;

    КонецПопытки;

    Попытка

        ЕРП_ПриемИнтеграции.ЕРП_ЗарегистрироватьЗаданиеПриемаНоменклатурыИзPDM();
        Результат.ЗаданиеЗарегистрировано = Истина;
        Результат.Успех = Истина;

    Исключение

        Результат.ОписаниеОшибки =
            "Настройки RabbitMQ сохранены, но регистрация регламентного "
            + "задания завершилась ошибкой: "
            + ОписаниеОшибки();

    КонецПопытки;

    Возврат Результат;

КонецФункции


////////////////////////////////////////////////////////////////////////////////
// ЗАКРЫТИЕ ФОРМЫ
////////////////////////////////////////////////////////////////////////////////

&НаКлиенте
Процедура ЗакрытьНажатие1(Команда)

    Закрыть();

КонецПроцедуры

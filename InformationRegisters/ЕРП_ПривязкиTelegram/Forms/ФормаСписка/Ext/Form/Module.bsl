#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ИнициироватьПеренос(Команда)

    ТекущиеДанные = Элементы.Список.ТекущиеДанные;
    Если ТекущиеДанные = Неопределено Тогда
        ПоказатьПредупреждение(, "Выберите активную Telegram-привязку.");
        Возврат;
    КонецЕсли;

    Если ТекущиеДанные.Состояние <> "Активна"
        Или Не ЗначениеЗаполнено(ТекущиеДанные.ИдентификаторПривязки) Тогда
        ПоказатьПредупреждение(, "Перенос доступен только для активной записи с UUID привязки.");
        Возврат;
    КонецЕсли;

    НовыйСотрудник = Неопределено;
    Если Не ВвестиЗначение(
        НовыйСотрудник,
        "Выберите сотрудника — нового владельца Telegram-привязки",
        Тип("СправочникСсылка.Сотрудники")) Тогда
        Возврат;
    КонецЕсли;

    Если Не ЗначениеЗаполнено(НовыйСотрудник) Тогда
        Возврат;
    КонецЕсли;

    Попытка
        Результат = ИнициироватьПереносНаСервере(
            ТекущиеДанные.ИдентификаторПривязки,
            НовыйСотрудник);
    Исключение
        ПоказатьПредупреждение(
            ,
            "Не удалось инициировать перенос: " + ОписаниеОшибки());
        Возврат;
    КонецПопытки;

    ПоказатьПредупреждение(
        ,
        "Передайте новому владельцу команду Telegram:\n"
            + Результат.Команда
            + "\n\nПосле выполнения команды вернитесь в список запросов привязки "
            + "и отдельно подтвердите перенос. Код действует до "
            + Формат(Результат.ДатаИстечения, "ДФ=dd.MM.yyyy HH:mm:ss") + ".");

КонецПроцедуры


&НаСервере
Функция ИнициироватьПереносНаСервере(
    СтарыйИдентификаторПривязки,
    НовыйСотрудник)

    Возврат ЕРП_ПривязкаTelegram.ЕРП_СоздатьЗапросПереносаTelegram(
        СтарыйИдентификаторПривязки,
        НовыйСотрудник);

КонецФункции

#КонецОбласти

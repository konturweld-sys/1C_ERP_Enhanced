&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

    ДоступноАдминистратору = РольДоступна("ЕРП_УправлениеПривязкамиTelegram")
        Или РольДоступна("АдминистраторСистемы");
    Элементы.ФормаИнициироватьПеренос.Доступность = ДоступноАдминистратору;
    Элементы.ФормаДеактивироватьПривязку.Доступность = ДоступноАдминистратору;

КонецПроцедуры


#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ИнициироватьПеренос(Команда)

    ТекущиеДанные = Элементы.Список.ТекущиеДанные;
    Если ТекущиеДанные = Неопределено Тогда
        ПоказатьПредупреждение(, "Выберите активную Telegram-привязку.");
        Возврат;
    КонецЕсли;

    Если ТекущиеДанные.Состояние <> "Активна"
        Или Не ЗначениеЗаполнено(ТекущиеДанные.ИдентификаторПривязки) Тогда
        ПоказатьПредупреждение(, "Перенос доступен только для активной записи с UUID привязки.");
        Возврат;
    КонецЕсли;

    НовыйСотрудник = Неопределено;
    Если Не ВвестиЗначение(
        НовыйСотрудник,
        "Выберите сотрудника — нового владельца Telegram-привязки",
        Тип("СправочникСсылка.Сотрудники")) Тогда
        Возврат;
    КонецЕсли;

    Если Не ЗначениеЗаполнено(НовыйСотрудник) Тогда
        Возврат;
    КонецЕсли;

    Попытка
        Результат = ИнициироватьПереносНаСервере(
            ТекущиеДанные.ИдентификаторПривязки,
            НовыйСотрудник);
    Исключение
        ПоказатьПредупреждение(
            ,
            "Не удалось инициировать перенос: " + ОписаниеОшибки());
        Возврат;
    КонецПопытки;

    ПоказатьПредупреждение(
        ,
        "Передайте новому владельцу команду Telegram:"
            + Символы.ПС
            + Результат.Команда
            + Символы.ПС + Символы.ПС
            + "После выполнения команды вернитесь в список запросов привязки "
            + "и отдельно подтвердите перенос. Код действует до "
            + Формат(Результат.ДатаИстечения, "ДФ=dd.MM.yyyy HH:mm:ss") + ".");

КонецПроцедуры


&НаСервере
Функция ИнициироватьПереносНаСервере(
    СтарыйИдентификаторПривязки,
    НовыйСотрудник)

    Возврат ЕРП_ПривязкаTelegram.ЕРП_СоздатьЗапросПереносаTelegram(
        СтарыйИдентификаторПривязки,
        НовыйСотрудник);

КонецФункции

#КонецОбласти


&НаКлиенте
Процедура ДеактивироватьПривязку(Команда)

    ТекущиеДанные = Элементы.Список.ТекущиеДанные;
    Если ТекущиеДанные = Неопределено
        Или ТекущиеДанные.Состояние <> "Активна" Тогда
        ПоказатьПредупреждение(, "Выберите активную Telegram-привязку.");
        Возврат;
    КонецЕсли;

    Причина = "Ручная деактивация администратором";
    Если Не ВвестиСтроку(
        Причина,
        "Укажите причину деактивации Telegram-привязки",
        200) Тогда
        Возврат;
    КонецЕсли;

    Если Не ЗначениеЗаполнено(СокрЛП(Причина)) Тогда
        ПоказатьПредупреждение(, "Причина деактивации обязательна.");
        Возврат;
    КонецЕсли;

    Попытка
        ДеактивироватьПривязкуНаСервере(ТекущиеДанные.Сотрудник, Причина);
    Исключение
        ПоказатьПредупреждение(
            ,
            "Не удалось деактивировать Telegram-привязку: " + ОписаниеОшибки());
        Возврат;
    КонецПопытки;

    Элементы.Список.Обновить();

КонецПроцедуры


&НаСервере
Процедура ДеактивироватьПривязкуНаСервере(Сотрудник, Причина)

    ЕРП_ПривязкаTelegram.ЕРП_ОтвязатьTelegram(Сотрудник, Причина);

КонецПроцедуры

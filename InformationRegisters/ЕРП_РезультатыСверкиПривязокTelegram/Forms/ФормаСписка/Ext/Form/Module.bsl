&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

    Элементы.ФормаЗафиксироватьРешение.Доступность =
        РольДоступна("ЕРП_УправлениеПривязкамиTelegram")
        Или РольДоступна("АдминистраторСистемы");

КонецПроцедуры


&НаКлиенте
Процедура ЗафиксироватьРешение(Команда)

    ТекущиеДанные = Элементы.Список.ТекущиеДанные;
    Если ТекущиеДанные = Неопределено
        Или ТекущиеДанные.ТипЗаписи <> "Проблема" Тогда
        ПоказатьПредупреждение(
            ,
            "Выберите строку типа «Проблема». Сводка и история решений не являются проблемными записями.");
        Возврат;
    КонецЕсли;

    Решение = "";
    Если Не ВвестиСтроку(
        Решение,
        "Введите: ИсправленоВручную, ЛожноеСрабатывание или ОставленоБезИзменений",
        40) Тогда
        Возврат;
    КонецЕсли;

    Решение = СокрЛП(Решение);
    Если Решение <> "ИсправленоВручную"
        И Решение <> "ЛожноеСрабатывание"
        И Решение <> "ОставленоБезИзменений" Тогда
        ПоказатьПредупреждение(, "Недопустимый тип решения.");
        Возврат;
    КонецЕсли;

    ПричинаРешения = "";
    Если Не ВвестиСтроку(
        ПричинаРешения,
        "Укажите обязательную причину административного решения",
        1000) Тогда
        Возврат;
    КонецЕсли;

    СостояниеПослеРешения = "";
    Если Не ВвестиСтроку(
        СостояниеПослеРешения,
        "Опишите состояние после рассмотрения или исправления",
        1000) Тогда
        Возврат;
    КонецЕсли;

    Попытка
        ИдентификаторРешения = ЗафиксироватьРешениеНаСервере(
            ТекущиеДанные.ИдентификаторЗаписи,
            Решение,
            ПричинаРешения,
            СостояниеПослеРешения);
    Исключение
        ПоказатьПредупреждение(
            ,
            "Не удалось зарегистрировать решение: " + ОписаниеОшибки());
        Возврат;
    КонецПопытки;

    Элементы.Список.Обновить();
    ПоказатьПредупреждение(
        ,
        "Решение зарегистрировано. UUID записи решения: " + Строка(ИдентификаторРешения));

КонецПроцедуры


&НаСервере
Функция ЗафиксироватьРешениеНаСервере(
    ИдентификаторЗаписиПроблемы,
    Решение,
    ПричинаРешения,
    СостояниеПослеРешения)

    Возврат ЕРП_ПривязкаTelegram.ЕРП_ЗафиксироватьРешениеПоСверкеTelegram(
        ИдентификаторЗаписиПроблемы,
        Решение,
        ПричинаРешения,
        СостояниеПослеРешения);

КонецФункции

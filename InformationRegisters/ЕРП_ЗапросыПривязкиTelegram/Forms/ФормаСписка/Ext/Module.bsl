////////////////////////////////////////////////////////////////////////////////
// Форма администрирования обычных Telegram-привязок и контролируемых переносов.
// Клиентский модуль получает текущую строку; серверный модуль выполняет операции.
////////////////////////////////////////////////////////////////////////////////

&НаКлиенте
Процедура ПодтвердитьПривязку(Команда)

    ТекущаяСтрока = Элементы.Список.ТекущиеДанные;
    Если ТекущаяСтрока = Неопределено Тогда
        ВызватьИсключение "Выберите запрос Telegram-привязки.";
    КонецЕсли;

    ПодтвердитьПривязкуНаСервере(
        ТекущаяСтрока.Сотрудник,
        ТекущаяСтрока.ХешКода,
        ТекущаяСтрока.ИдентификаторОперацииПереноса);

    Элементы.Список.Обновить();

КонецПроцедуры


&НаСервере
Процедура ПодтвердитьПривязкуНаСервере(
    Сотрудник,
    ХешКода,
    ИдентификаторОперацииПереноса)

    Если Не ЗначениеЗаполнено(ИдентификаторОперацииПереноса)
        Или ИдентификаторОперацииПереноса
            = Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000") Тогда

        ЕРП_ПривязкаTelegram.ЕРП_ПодтвердитьПривязкуTelegramПоХешу(
            Сотрудник,
            ХешКода);

    Иначе

        ЕРП_ПривязкаTelegram.ЕРП_ПодтвердитьПереносTelegramПоИдентификатору(
            ИдентификаторОперацииПереноса);

    КонецЕсли;

КонецПроцедуры


&НаКлиенте
Процедура ОтменитьЗапрос(Команда)

    ТекущаяСтрока = Элементы.Список.ТекущиеДанные;
    Если ТекущаяСтрока = Неопределено Тогда
        ВызватьИсключение "Выберите запрос Telegram-привязки для отмены.";
    КонецЕсли;

    ОтменитьЗапросНаСервере(ТекущаяСтрока.ХешКода);
    Элементы.Список.Обновить();

КонецПроцедуры


&НаСервере
Процедура ОтменитьЗапросНаСервере(ХешКода)

    ЕРП_ПривязкаTelegram.ЕРП_ОтменитьЗапросПривязкиTelegramПоХешу(
        ХешКода);

КонецПроцедуры

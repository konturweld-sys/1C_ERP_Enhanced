////////////////////////////////////////////////////////////////////////////////
// Форма администрирования обычных Telegram-привязок и контролируемых переносов.
// Клиентский модуль получает текущую строку; серверный модуль выполняет операции.
////////////////////////////////////////////////////////////////////////////////

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

    ДоступноАдминистратору = РольДоступна("ЕРП_УправлениеПривязкамиTelegram")
        Или РольДоступна("АдминистраторСистемы");
    Элементы.ФормаПодтвердитьПривязку.Доступность = ДоступноАдминистратору;
    Элементы.ФормаОтменитьЗапрос.Доступность = ДоступноАдминистратору;

КонецПроцедуры


&НаКлиенте
Процедура ПодтвердитьПривязку(Команда)

    ТекущаяСтрока = Элементы.Список.ТекущиеДанные;
    Если ТекущаяСтрока = Неопределено Тогда
        ВызватьИсключение "Выберите запрос Telegram-привязки.";
    КонецЕсли;

    ПодтвердитьПривязкуНаСервере(
        ТекущаяСтрока.Сотрудник,
        ТекущаяСтрока.ИдентификаторБота,
        ТекущаяСтрока.ДатаСоздания,
        ТекущаяСтрока.UpdateID,
        ТекущаяСтрока.ИдентификаторОперацииПереноса);

    Элементы.Список.Обновить();

КонецПроцедуры


&НаСервере
Процедура ПодтвердитьПривязкуНаСервере(
    Сотрудник,
    ИдентификаторБота,
    ДатаСоздания,
    UpdateID,
    ИдентификаторОперацииПереноса)

    ЕРП_ПривязкаTelegram.ЕРП_ПодтвердитьЗапросTelegramПоПараметрам(
        Сотрудник,
        ИдентификаторБота,
        ДатаСоздания,
        UpdateID,
        ИдентификаторОперацииПереноса);

КонецПроцедуры


&НаКлиенте
Процедура ОтменитьЗапрос(Команда)

    ТекущаяСтрока = Элементы.Список.ТекущиеДанные;
    Если ТекущаяСтрока = Неопределено Тогда
        ВызватьИсключение "Выберите запрос Telegram-привязки для отмены.";
    КонецЕсли;

    ОтменитьЗапросНаСервере(
        ТекущаяСтрока.Сотрудник,
        ТекущаяСтрока.ИдентификаторБота,
        ТекущаяСтрока.ДатаСоздания,
        ТекущаяСтрока.UpdateID,
        ТекущаяСтрока.ИдентификаторОперацииПереноса);
    Элементы.Список.Обновить();

КонецПроцедуры


&НаСервере
Процедура ОтменитьЗапросНаСервере(
    Сотрудник,
    ИдентификаторБота,
    ДатаСоздания,
    UpdateID,
    ИдентификаторОперацииПереноса)

    ЕРП_ПривязкаTelegram.ЕРП_ОтменитьЗапросПривязкиTelegramПоПараметрам(
        Сотрудник,
        ИдентификаторБота,
        ДатаСоздания,
        UpdateID,
        ИдентификаторОперацииПереноса);

КонецПроцедуры

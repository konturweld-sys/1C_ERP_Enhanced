#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Элементы.ФормаПодтвердитьПривязку.Доступность = Ложь;

КонецПроцедуры

#КонецОбласти


#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)

	ОбновитьДоступностьКоманд();

КонецПроцедуры

#КонецОбласти


#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПодтвердитьПривязку(Команда)

	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ПоказатьПредупреждение(, "Выберите запрос привязки в списке.");
		Возврат;
	КонецЕсли;

	Если ТекущиеДанные.Состояние <> "ПолученОтБота" Тогда
		ПоказатьПредупреждение(
			,
			"Подтверждение доступно только для запросов в состоянии «ПолученОтБота»."
		);
		Возврат;
	КонецЕсли;

	КлючЗаписи = Элементы.Список.ТекущаяСтрока;
	Если КлючЗаписи = Неопределено Тогда
		ПоказатьПредупреждение(, "Не удалось определить выбранную запись. Обновите список.");
		Возврат;
	КонецЕсли;

	Результат = ПодтвердитьПривязкуНаСервере(КлючЗаписи);

	Элементы.Список.Обновить();
	ОбновитьДоступностьКоманд();

	Если Результат.Успех Тогда
		ПоказатьОповещениеПользователя(
			"Привязка Telegram подтверждена",
			,
			СтрШаблон(
				"Привязка для сотрудника %1 успешно активирована.",
				Строка(ТекущиеДанные.Сотрудник)
			),
			БиблиотекаКартинок.Успешно
		);
	Иначе
		ПоказатьПредупреждение(, Результат.ОписаниеОшибки);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти


#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОбновитьДоступностьКоманд()

	ТекущиеДанные = Элементы.Список.ТекущиеДанные;

	Если ТекущиеДанные = Неопределено Тогда
		Элементы.ФормаПодтвердитьПривязку.Доступность = Ложь;
		Возврат;
	КонецЕсли;

	Элементы.ФормаПодтвердитьПривязку.Доступность =
		(ТекущиеДанные.Состояние = "ПолученОтБота");

КонецПроцедуры


&НаСервере
Функция ПодтвердитьПривязкуНаСервере(КлючЗаписи)

	Результат = Новый Структура("Успех,ОписаниеОшибки", Ложь, "");

	Попытка
		Если ТипЗнч(КлючЗаписи)
			<> Тип("РегистрСведенийКлючЗаписи.ЕРП_ЗапросыПривязкиTelegram") Тогда
			ВызватьИсключение "Не передан ключ записи регистра запросов Telegram.";
		КонецЕсли;

		МенеджерЗаписи =
			РегистрыСведений.ЕРП_ЗапросыПривязкиTelegram.СоздатьМенеджерЗаписи();

		МенеджерЗаписи.ХешКода = КлючЗаписи.ХешКода;
		МенеджерЗаписи.Прочитать();

		Если Не МенеджерЗаписи.Выбран() Тогда
			ВызватьИсключение "Выбранный запрос привязки больше не существует.";
		КонецЕсли;

		Если МенеджерЗаписи.Состояние <> "ПолученОтБота" Тогда
			ВызватьИсключение "Запрос уже обработан или не ожидает подтверждения.";
		КонецЕсли;

		Если Не ЗначениеЗаполнено(МенеджерЗаписи.Сотрудник) Тогда
			ВызватьИсключение "В запросе не указан сотрудник.";
		КонецЕсли;

		// ХешКода считывается только на сервере из записи по её полному ключу.
		// Метод подтверждения повторно проверяет состояние, срок и принадлежность
		// запроса под управляемой блокировкой внутри своей транзакции.
		ЕРП_ПривязкаTelegram.ЕРП_ПодтвердитьПривязкуTelegramПоХешу(
			МенеджерЗаписи.Сотрудник,
			МенеджерЗаписи.ХешКода
		);

		Результат.Успех = Истина;

	Исключение
		Результат.ОписаниеОшибки =
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Элементы.ФормаПодтвердитьПривязку.Доступность = Ложь;

КонецПроцедуры

#КонецОбласти


#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)

	ОбновитьДоступностьКоманд();

КонецПроцедуры

#КонецОбласти


#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПодтвердитьПривязку(Команда)

	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ПоказатьПредупреждение(, "Выберите запрос привязки в списке.");
		Возврат;
	КонецЕсли;

	Если ТекущиеДанные.Состояние <> "ПолученОтБота" Тогда
		ПоказатьПредупреждение(
			,
			"Подтверждение доступно только для запросов в состоянии «ПолученОтБота»."
		);
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ТекущиеДанные.ИдентификаторБота)
		Или ТекущиеДанные.UpdateID <= 0 Тогда
		ПоказатьПредупреждение(
			,
			"В выбранной строке отсутствует идентификатор Telegram-обновления."
		);
		Возврат;
	КонецЕсли;

	Результат = ПодтвердитьПривязкуНаСервере(
		ТекущиеДанные.ИдентификаторБота,
		ТекущиеДанные.UpdateID
	);

	Элементы.Список.Обновить();
	ОбновитьДоступностьКоманд();

	Если Результат.Успех Тогда
		ПоказатьОповещениеПользователя(
			"Привязка Telegram подтверждена",
			,
			СтрШаблон(
				"Привязка для сотрудника %1 успешно активирована.",
				Строка(ТекущиеДанные.Сотрудник)
			),
			БиблиотекаКартинок.Успешно
		);
	Иначе
		ПоказатьПредупреждение(, Результат.ОписаниеОшибки);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти


#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОбновитьДоступностьКоманд()

	ТекущиеДанные = Элементы.Список.ТекущиеДанные;

	Если ТекущиеДанные = Неопределено Тогда
		Элементы.ФормаПодтвердитьПривязку.Доступность = Ложь;
		Возврат;
	КонецЕсли;

	Элементы.ФормаПодтвердитьПривязку.Доступность =
		(ТекущиеДанные.Состояние = "ПолученОтБота");

КонецПроцедуры


&НаСервере
Функция ПодтвердитьПривязкуНаСервере(ИдентификаторБота, UpdateID)

	Результат = Новый Структура("Успех,ОписаниеОшибки", Ложь, "");

	Попытка
		Если Не ЗначениеЗаполнено(ИдентификаторБота) Или UpdateID <= 0 Тогда
			ВызватьИсключение "Не переданы идентификатор бота или Telegram Update ID.";
		КонецЕсли;

		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ИдентификаторБота", ИдентификаторБота);
		Запрос.УстановитьПараметр("UpdateID", UpdateID);
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Запросы.ХешКода КАК ХешКода
		|ИЗ
		|	РегистрСведений.ЕРП_ЗапросыПривязкиTelegram КАК Запросы
		|ГДЕ
		|	Запросы.ИдентификаторБота = &ИдентификаторБота
		|	И Запросы.UpdateID = &UpdateID
		|	И Запросы.Состояние = ""ПолученОтБота""";

		Выборка = Запрос.Выполнить().Выбрать();
		Если Не Выборка.Следующий() Тогда
			ВызватьИсключение "Не найден запрос привязки в состоянии «ПолученОтБота». Обновите список.";
		КонецЕсли;

		ХешКода = Выборка.ХешКода;
		Если Выборка.Следующий() Тогда
			ВызватьИсключение "Обнаружено несколько запросов с одинаковыми идентификатором бота и Update ID. Подтверждение остановлено.";
		КонецЕсли;

		МенеджерЗаписи =
			РегистрыСведений.ЕРП_ЗапросыПривязкиTelegram.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ХешКода = ХешКода;
		МенеджерЗаписи.Прочитать();

		Если Не МенеджерЗаписи.Выбран()
			Или МенеджерЗаписи.Состояние <> "ПолученОтБота"
			Или Не ЗначениеЗаполнено(МенеджерЗаписи.Сотрудник) Тогда
			ВызватьИсключение "Запрос привязки изменился или больше не готов к подтверждению.";
		КонецЕсли;

		// ХешКода остаётся только в серверной памяти. Метод общего модуля
		// повторно проверяет сотрудника, срок, состояние и занятость Chat ID
		// под управляемыми блокировками внутри транзакции.
		ЕРП_ПривязкаTelegram.ЕРП_ПодтвердитьПривязкуTelegramПоХешу(
			МенеджерЗаписи.Сотрудник,
			МенеджерЗаписи.ХешКода
		);

		Результат.Успех = Истина;

	Исключение
		Результат.ОписаниеОшибки =
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат Результат;

КонецФункции

#КонецОбласти

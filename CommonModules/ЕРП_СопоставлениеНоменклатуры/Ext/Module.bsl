
////////////////////////////////////////////////////////////////////////////////
// ОБЩИЙ МОДУЛЬ: ЕРП_СопоставлениеНоменклатуры
//
// Серверный общий модуль.
// Поиск справочника Номенклатура, групп и элементов по UUID.
// Поиск единиц измерения по коду или наименованию.
// Не подменяет локальные UUID ERP.
////////////////////////////////////////////////////////////////////////////////

Функция ЕРП_ПолучитьИмяСправочникаНоменклатуры() Экспорт

    Если Метаданные.Справочники.Найти("Номенклатура") = Неопределено Тогда
        ВызватьИсключение
            "В конфигурации ERP не найден справочник Номенклатура.";
    КонецЕсли;

    Возврат "Номенклатура";

КонецФункции


Функция ЕРП_ПолучитьСсылкуПоUUID(UUID) Экспорт

    Если Не ЗначениеЗаполнено(UUID) Тогда
        Возврат Неопределено;
    КонецЕсли;

    ИмяСправочника = ЕРП_ПолучитьИмяСправочникаНоменклатуры();

    УникальныйUUID = Новый УникальныйИдентификатор(UUID);

    Ссылка = Справочники[ИмяСправочника].ПолучитьСсылку(
        УникальныйUUID
    );

    Попытка
        Объект = Ссылка.ПолучитьОбъект();
    Исключение
        Возврат Неопределено;
    КонецПопытки;

    Если Объект = Неопределено Тогда
        Возврат Неопределено;
    КонецЕсли;

    Возврат Ссылка;

КонецФункции


Функция ЕРП_СоздатьГруппуПоUUID(ДанныеГруппы, Родитель) Экспорт

    Ссылка = ЕРП_ПолучитьСсылкуПоUUID(ДанныеГруппы.UUID);

    Если Ссылка <> Неопределено Тогда

        Объект = Ссылка.ПолучитьОбъект();

        Если Не Объект.ЭтоГруппа Тогда
            ВызватьИсключение
                "UUID группы уже занят элементом номенклатуры: "
                + ДанныеГруппы.UUID;
        КонецЕсли;

        Если Объект.Наименование <> ДанныеГруппы.Наименование Тогда
            Объект.Наименование = ДанныеГруппы.Наименование;
            Объект.Записать();
        КонецЕсли;

        Возврат Ссылка;

    КонецЕсли;

    Объект = Справочники.Номенклатура.СоздатьГруппу();

    Объект.УстановитьСсылкуНового(
        Справочники.Номенклатура.ПолучитьСсылку(
            Новый УникальныйИдентификатор(ДанныеГруппы.UUID)
        )
    );

    Объект.Наименование = ДанныеГруппы.Наименование;

    Если Родитель <> Неопределено Тогда
        Объект.Родитель = Родитель;
    КонецЕсли;

    Объект.Записать();

    Возврат Объект.Ссылка;

КонецФункции


Функция ЕРП_НайтиЕдиницуИзмерения(ДанныеЕдиницы) Экспорт

    Если Метаданные.Справочники.Найти("КлассификаторЕдиницИзмерения")
        = Неопределено Тогда

        ВызватьИсключение
            "Не найден справочник КлассификаторЕдиницИзмерения. "
            + "Сопоставление единицы измерения не выполнено.";

    КонецЕсли;

    Если ДанныеЕдиницы.Свойство("Код")
        И ЗначениеЗаполнено(ДанныеЕдиницы.Код) Тогда

        Выборка = Справочники.КлассификаторЕдиницИзмерения.Выбрать();

        Пока Выборка.Следующий() Цикл

            Если Выборка.Код = ДанныеЕдиницы.Код Тогда
                Возврат Выборка.Ссылка;
            КонецЕсли;

        КонецЦикла;

    КонецЕсли;

    Если ДанныеЕдиницы.Свойство("Наименование")
        И ЗначениеЗаполнено(ДанныеЕдиницы.Наименование) Тогда

        Выборка = Справочники.КлассификаторЕдиницИзмерения.Выбрать();

        Пока Выборка.Следующий() Цикл

            Если Выборка.Наименование = ДанныеЕдиницы.Наименование Тогда
                Возврат Выборка.Ссылка;
            КонецЕсли;

        КонецЦикла;

    КонецЕсли;

    ВызватьИсключение
        "Не найдена единица измерения: "
        + ДанныеЕдиницы.Наименование
        + ", код: "
        + ДанныеЕдиницы.Код;

КонецФункции


Функция ЕРП_ПолучитьUUIDИзСтроки(UUID) Экспорт

    Если Не ЕРП_ВалидацияКонтракта.ЕРП_ЭтоВалидныйUUID(UUID) Тогда
        ВызватьИсключение "Некорректный UUID: " + UUID;
    КонецЕсли;

    Возврат Новый УникальныйИдентификатор(UUID);

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// EMAIL / TELEGRAM
////////////////////////////////////////////////////////////////////////////////

Процедура ЕРП_ОтправитьEmail(Настройки, АдресПолучателя, Тема, Текст)

    Если Не ЗначениеЗаполнено(Настройки.SMTPСервер)
        Или Не ЗначениеЗаполнено(Настройки.SMTPОтправитель) Тогда
        ВызватьИсключение "Не заполнены SMTP-сервер или адрес отправителя ERP.";
    КонецЕсли;

    Профиль = Новый ИнтернетПочтовыйПрофиль;
    Профиль.АдресСервераSMTP = Настройки.SMTPСервер;
    Профиль.ПортSMTP = Настройки.SMTPПорт;
    Профиль.ПользовательSMTP = Настройки.SMTPПользователь;
    Профиль.ПарольSMTP = Настройки.SMTPПароль;
    Профиль.ИспользоватьSSLSMTP = Настройки.SMTPИспользоватьSSL;
    Профиль.ВремяОжидания = Настройки.SMTPТаймаут;

    Письмо = Новый ИнтернетПочтовоеСообщение;
    Письмо.Отправитель = Настройки.SMTPОтправитель;
    Письмо.Получатели.Добавить(АдресПолучателя);
    Письмо.Тема = Тема;

    ТекстПисьма = Письмо.Тексты.Добавить(Текст);
    ТекстПисьма.ТипТекста = ТипТекстаПочтовогоСообщения.ПростойТекст;

    Почта = Новый ИнтернетПочта;

    Попытка
        Почта.Подключиться(Профиль);
        Почта.Послать(Письмо);
    Исключение
        Попытка
            Почта.Отключиться();
        Исключение
        КонецПопытки;
        ВызватьИсключение;
    КонецПопытки;

    // Ошибка закрытия уже отправленного SMTP-сеанса не должна
    // превращать успешную отправку в повторную попытку.
    Попытка
        Почта.Отключиться();
    Исключение
    КонецПопытки;

КонецПроцедуры


Процедура ЕРП_ОтправитьTelegram(Настройки, ChatID, Текст)

    // Совместимый внутренний адаптер для прежнего обработчика.
    // Сетевая реализация и разбор ответа находятся в общей внутренней функции.
    Результат = ЕРП_ОтправитьTelegramДляФасада(
        Настройки,
        ChatID,
        Текст
    );

    Если Не Результат.Успех Тогда
        ВызватьИсключение Результат.ОписаниеОшибки;
    КонецЕсли;

КонецПроцедуры



//------------------------------------------------------------------------------
// Публичный фасад отправки одной доставки.
// Внутренние отправители Email/Telegram остаются неэкспортными.
//------------------------------------------------------------------------------
Функция ОтправитьДоставкуУведомления(ПараметрыДоставки) Экспорт

    Результат = Новый Структура("Успех, ОписаниеОшибки, RetryAfter", Ложь, "", 0);

    Если ТипЗнч(ПараметрыДоставки) <> Тип("Структура") Тогда
        Результат.ОписаниеОшибки = "Параметры доставки должны иметь тип Структура.";
        Возврат Результат;
    КонецЕсли;

    Канал = "";
    АдресПолучателя = "";
    Тема = "";
    ТекстСообщения = "";

    Если Не ПараметрыДоставки.Свойство("Канал", Канал)
        Или Не ПараметрыДоставки.Свойство("АдресПолучателя", АдресПолучателя)
        Или Не ПараметрыДоставки.Свойство("Тема", Тема)
        Или Не ПараметрыДоставки.Свойство("ТекстСообщения", ТекстСообщения) Тогда
        Результат.ОписаниеОшибки = "В параметрах доставки отсутствует обязательное поле.";
        Возврат Результат;
    КонецЕсли;

    Если ТипЗнч(Канал) <> Тип("Строка")
        Или ТипЗнч(АдресПолучателя) <> Тип("Строка")
        Или ТипЗнч(Тема) <> Тип("Строка")
        Или ТипЗнч(ТекстСообщения) <> Тип("Строка") Тогда
        Результат.ОписаниеОшибки =
            "Поля Канал, АдресПолучателя, Тема и ТекстСообщения должны иметь тип Строка.";
        Возврат Результат;
    КонецЕсли;

    Настройки = ЕРП_ПолучитьНастройкиУведомлений();

    Попытка
        Если Канал = "EMAIL" Тогда
            ЕРП_ОтправитьEmail(
                Настройки,
                АдресПолучателя,
                Тема,
                ТекстСообщения
            );
            Результат.Успех = Истина;

        ИначеЕсли Канал = "TELEGRAM" Тогда
            РезультатTelegram = ЕРП_ОтправитьTelegramДляФасада(
                Настройки,
                АдресПолучателя,
                ТекстСообщения
            );
            Результат.Успех = РезультатTelegram.Успех;
            Результат.ОписаниеОшибки = РезультатTelegram.ОписаниеОшибки;
            Результат.RetryAfter = РезультатTelegram.RetryAfter;

        Иначе
            Результат.ОписаниеОшибки = "Неизвестный канал доставки уведомления: " + Строка(Канал);
        КонецЕсли;

    Исключение
        Результат.Успех = Ложь;
        Результат.ОписаниеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
        Если Канал = "TELEGRAM" И ЗначениеЗаполнено(Настройки.TelegramТокенБота) Тогда
            Результат.ОписаниеОшибки = СтрЗаменить(
                Результат.ОписаниеОшибки,
                Настройки.TelegramТокенБота,
                "[токен скрыт]"
            );
        КонецЕсли;
    КонецПопытки;

    Если Результат.Успех Тогда
        ЕРП_ЖурналУведомлений.Информация(
            "ОТПРАВКА",
            "Уведомление передано каналу доставки.",
            "Канал: " + Канал + "; получатель: " + АдресПолучателя
        );
    Иначе
        ЕРП_ЖурналУведомлений.Ошибка(
            "ОТПРАВКА",
            "Ошибка отправки уведомления: " + Результат.ОписаниеОшибки,
            "Канал: " + Канал + "; получатель: " + АдресПолучателя
        );
    КонецЕсли;

    Возврат Результат;

КонецФункции


Функция ЕРП_ОтправитьTelegramДляФасада(Настройки, ChatID, Текст)

    Результат = Новый Структура("Успех, ОписаниеОшибки, RetryAfter", Ложь, "", 0);

    Если Не ЗначениеЗаполнено(Настройки.TelegramТокенБота) Тогда
        Результат.ОписаниеОшибки = "Не задан токен Telegram-бота ERP.";
        Возврат Результат;
    КонецЕсли;

    ДанныеСообщения = Новый Структура;
    ДанныеСообщения.Вставить("chat_id", ChatID);
    ДанныеСообщения.Вставить("text", Текст);

    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, ДанныеСообщения);
    СтрокаJSON = ЗаписьJSON.Закрыть();

    HTTPЗапрос = Новый HTTPЗапрос(
        "/bot" + Настройки.TelegramТокенБота + "/sendMessage"
    );
    HTTPЗапрос.Заголовки.Вставить(
        "Content-Type",
        "application/json; charset=utf-8"
    );
    HTTPЗапрос.УстановитьТелоИзСтроки(СтрокаJSON, КодировкаТекста.UTF8);

    Попытка
        Защита = Новый ЗащищенноеСоединениеOpenSSL(
            Новый СертификатКлиентаWindows(),
            Новый СертификатыУдостоверяющихЦентровWindows()
        );
        HTTPСоединение = Новый HTTPСоединение(
            "api.telegram.org", 443, , , , 30, Защита
        );
        Ответ = HTTPСоединение.ВызватьHTTPМетод("POST", HTTPЗапрос);
        ТелоОтвета = Ответ.ПолучитьТелоКакСтроку();

        ДанныеОтвета = Неопределено;
        Попытка
            ЧтениеJSON = Новый ЧтениеJSON;
            ЧтениеJSON.УстановитьСтроку(ТелоОтвета);
            ДанныеОтвета = ПрочитатьJSON(ЧтениеJSON);
        Исключение
            ДанныеОтвета = Неопределено;
        КонецПопытки;

        Если Ответ.КодСостояния = 200
            И ТипЗнч(ДанныеОтвета) = Тип("Структура") Тогда
            ПризнакУспеха = Ложь;
            Если ДанныеОтвета.Свойство("ok", ПризнакУспеха)
                И ПризнакУспеха Тогда
                Результат.Успех = Истина;
                Возврат Результат;
            КонецЕсли;
        КонецЕсли;

        КодОшибки = 0;
        Если ТипЗнч(ДанныеОтвета) = Тип("Структура") Тогда
            ДанныеОтвета.Свойство("error_code", КодОшибки);
        КонецЕсли;

        Если Ответ.КодСостояния = 429 Или КодОшибки = 429 Тогда
            ПараметрыОтвета = Неопределено;
            RetryAfter = 0;

            Если ТипЗнч(ДанныеОтвета) = Тип("Структура")
                И ДанныеОтвета.Свойство("parameters", ПараметрыОтвета)
                И ТипЗнч(ПараметрыОтвета) = Тип("Структура") Тогда
                ПараметрыОтвета.Свойство("retry_after", RetryAfter);
            КонецЕсли;

            Если ТипЗнч(RetryAfter) = Тип("Число") И RetryAfter > 0 Тогда
                Результат.RetryAfter = RetryAfter;
            КонецЕсли;
        КонецЕсли;

        Описание = "";
        Если ТипЗнч(ДанныеОтвета) = Тип("Структура") Тогда
            ДанныеОтвета.Свойство("description", Описание);
        КонецЕсли;
        Если Не ЗначениеЗаполнено(Описание) Тогда
            Описание = "Telegram API вернул HTTP "
                + Строка(Ответ.КодСостояния) + ": " + ТелоОтвета;
        Иначе
            Описание = "Telegram API: " + Описание;
        КонецЕсли;

        Описание = СтрЗаменить(
            Описание,
            Настройки.TelegramТокенБота,
            "[токен скрыт]"
        );
        Результат.ОписаниеОшибки = Описание;

    Исключение
        Результат.ОписаниеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
        Результат.ОписаниеОшибки = СтрЗаменить(
            Результат.ОписаниеОшибки,
            Настройки.TelegramТокенБота,
            "[токен скрыт]"
        );
    КонецПопытки;

    Возврат Результат;

КонецФункции

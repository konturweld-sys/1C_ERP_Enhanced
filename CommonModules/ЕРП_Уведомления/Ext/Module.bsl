////////////////////////////////////////////////////////////////////////////////
// ОБЩИЙ МОДУЛЬ: ЕРП_Уведомления
//
// Единственный центр уведомлений ERP.
// Все сетевые вызовы выполняются регламентным заданием,
// вне транзакции создания номенклатуры.
//
// Типы событий:
// УспешноСоздано
// ОшибкаДвухПопыток
// RabbitMQНедоступен
// RabbitMQВосстановлен
//
// Каналы доставки независимы: EMAIL / TELEGRAM.
// Максимум 5 попыток; интервалы 1, 5, 15, 60 и 180 минут.
////////////////////////////////////////////////////////////////////////////////

Функция ЕРП_ПолучитьНастройкиУведомлений() Экспорт

    Настройки = Новый Структура;
    Настройки.Вставить("ИспользоватьУведомления", Ложь);
    Настройки.Вставить("ИспользоватьEmail", Ложь);
    Настройки.Вставить("ИспользоватьTelegram", Ложь);
    Настройки.Вставить("TelegramТокенБота", "");
    Настройки.Вставить("SMTPСервер", "");
    Настройки.Вставить("SMTPПорт", 25);
    Настройки.Вставить("SMTPПользователь", "");
    Настройки.Вставить("SMTPПароль", "");
    Настройки.Вставить("SMTPОтправитель", "");
    Настройки.Вставить("SMTPИспользоватьSSL", Ложь);
    Настройки.Вставить("SMTPТаймаут", 30);

    Выборка = РегистрыСведений.ЕРП_НастройкиУведомлений.Выбрать();

    Если Выборка.Следующий() Тогда
        Настройки.ИспользоватьУведомления = Выборка.ИспользоватьУведомления;
        Настройки.ИспользоватьEmail = Выборка.ИспользоватьEmail;
        Настройки.ИспользоватьTelegram = Выборка.ИспользоватьTelegram;
        Настройки.TelegramТокенБота = Выборка.TelegramТокенБота;
        Настройки.SMTPСервер = Выборка.SMTPСервер;
        Настройки.SMTPПорт = Выборка.SMTPПорт;
        Настройки.SMTPПользователь = Выборка.SMTPПользователь;
        Настройки.SMTPПароль = Выборка.SMTPПароль;
        Настройки.SMTPОтправитель = Выборка.SMTPОтправитель;
        Настройки.SMTPИспользоватьSSL = Выборка.SMTPИспользоватьSSL;
        Настройки.SMTPТаймаут = Выборка.SMTPТаймаут;
    КонецЕсли;

    Возврат Настройки;

КонецФункции


////////////////////////////////////////////////////////////////////////////////
// СОЗДАНИЕ СОБЫТИЙ
////////////////////////////////////////////////////////////////////////////////

Функция ЕРП_СоздатьСобытиеУведомления(
    КлючСобытия,
    ТипСобытия,
    UUIDНоменклатуры,
    Наименование,
    ТекстСообщения) Экспорт

    Менеджер = РегистрыСведений.ЕРП_СобытияУведомлений.СоздатьМенеджерЗаписи();
    Менеджер.КлючСобытия = КлючСобытия;
    Менеджер.Прочитать();

    Если ЗначениеЗаполнено(Менеджер.Состояние) Тогда
        Возврат Ложь;
    КонецЕсли;

    Менеджер.КлючСобытия = КлючСобытия;
    Менеджер.ТипСобытия = ТипСобытия;
    Менеджер.UUIDНоменклатуры = UUIDНоменклатуры;
    Менеджер.Наименование = Наименование;
    Менеджер.ТекстСообщения = ТекстСообщения;
    Менеджер.ДатаСоздания = ТекущаяДата();
    Менеджер.Состояние = "Новая";
    Менеджер.Записать();

    Возврат Истина;

КонецФункции


Процедура ЕРП_ЗарегистрироватьУспешноеСоздание(UUID, Наименование) Экспорт

    Счетчик = РегистрыСведений.ЕРП_ПовторыСозданияНоменклатуры.СоздатьМенеджерЗаписи();
    Счетчик.UUIDНоменклатуры = UUID;
    Счетчик.Прочитать();

    Если Счетчик.УведомлениеОбУспехеСоздано Тогда
        Возврат;
    КонецЕсли;

    Текст =
        "🟢 Интеграция 1С: Успешно создано по заявке."
        + Символы.ПС
        + "Номенклатура: " + Наименование
        + Символы.ПС
        + "UUID: " + UUID;

    ЕРП_СоздатьСобытиеУведомления(
        "CREATE_SUCCESS:" + UUID,
        "УспешноСоздано",
        UUID,
        Наименование,
        Текст
    );

    Счетчик.UUIDНоменклатуры = UUID;
    Счетчик.УведомлениеОбУспехеСоздано = Истина;
    Счетчик.ДатаПоследнейПопытки = ТекущаяДата();
    Счетчик.Записать();

КонецПроцедуры


Процедура ЕРП_ЗарегистрироватьНеудачнуюПопыткуСоздания(
    UUID,
    Наименование,
    ТекстОшибки) Экспорт

    Если Не ЗначениеЗаполнено(UUID) Тогда
        Возврат;
    КонецЕсли;

    Счетчик = РегистрыСведений.ЕРП_ПовторыСозданияНоменклатуры.СоздатьМенеджерЗаписи();
    Счетчик.UUIDНоменклатуры = UUID;
    Счетчик.Прочитать();

    Счетчик.UUIDНоменклатуры = UUID;
    Счетчик.КоличествоОшибок = Счетчик.КоличествоОшибок + 1;
    Счетчик.ПоследняяОшибка = ТекстОшибки;
    Счетчик.ДатаПоследнейПопытки = ТекущаяДата();

    Если Счетчик.КоличествоОшибок >= 2
        И Не Счетчик.УведомлениеОбОшибкеСоздано Тогда

        Текст =
            "🔴 Интеграция 1С: Ошибка создания номенклатуры после двух неудачных попыток."
            + Символы.ПС
            + "Номенклатура: " + Наименование
            + Символы.ПС
            + "UUID: " + UUID
            + Символы.ПС
            + "Последняя ошибка: " + ТекстОшибки;

        ЕРП_СоздатьСобытиеУведомления(
            "CREATE_FAILED:" + UUID,
            "ОшибкаДвухПопыток",
            UUID,
            Наименование,
            Текст
        );

        Счетчик.УведомлениеОбОшибкеСоздано = Истина;

    КонецЕсли;

    Счетчик.Записать();

КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// МОНИТОРИНГ ДОСТУПНОСТИ RABBITMQ
////////////////////////////////////////////////////////////////////////////////

Процедура ЕРП_ЗафиксироватьСбойRabbitMQ(ТекстОшибки) Экспорт

    Менеджер = РегистрыСведений.ЕРП_СостояниеСвязиRabbitMQ.СоздатьМенеджерЗаписи();
    Менеджер.Канал = "PDM_ERP";
    Менеджер.Прочитать();

    Менеджер.Канал = "PDM_ERP";
    Менеджер.КоличествоОшибокПодряд = Менеджер.КоличествоОшибокПодряд + 1;
    Менеджер.ДатаПоследнейОшибки = ТекущаяДата();
    Менеджер.ТекстПоследнейОшибки = ТекстОшибки;

    Если Менеджер.КоличествоОшибокПодряд >= 3
        И Не Менеджер.Недоступен Тогда

        Менеджер.Недоступен = Истина;
        Менеджер.НомерИнцидента = Менеджер.НомерИнцидента + 1;

        Текст =
            "🔴 Интеграция 1С: RabbitMQ недоступен после трех последовательных ошибок."
            + Символы.ПС
            + "Последняя ошибка: " + ТекстОшибки;

        ЕРП_СоздатьСобытиеУведомления(
            "RABBITMQ_DOWN:" + Строка(Менеджер.НомерИнцидента),
            "RabbitMQНедоступен",
            "",
            "RabbitMQ",
            Текст
        );

    КонецЕсли;

    Менеджер.Записать();

КонецПроцедуры


Процедура ЕРП_ЗафиксироватьДоступностьRabbitMQ() Экспорт

    Менеджер = РегистрыСведений.ЕРП_СостояниеСвязиRabbitMQ.СоздатьМенеджерЗаписи();
    Менеджер.Канал = "PDM_ERP";
    Менеджер.Прочитать();

    Если Менеджер.Недоступен Тогда

        Текст =
            "🟢 Интеграция 1С: Связь с RabbitMQ восстановлена.";

        ЕРП_СоздатьСобытиеУведомления(
            "RABBITMQ_RECOVERED:" + Строка(Менеджер.НомерИнцидента),
            "RabbitMQВосстановлен",
            "",
            "RabbitMQ",
            Текст
        );

    КонецЕсли;

    Менеджер.Канал = "PDM_ERP";
    Менеджер.КоличествоОшибокПодряд = 0;
    Менеджер.Недоступен = Ложь;
    Менеджер.Записать();

КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// ФОРМИРОВАНИЕ ОЧЕРЕДИ ДОСТАВКИ
////////////////////////////////////////////////////////////////////////////////

Процедура ЕРП_СоздатьДоставкиПоНовымСобытиям()

    Настройки = ЕРП_ПолучитьНастройкиУведомлений();

    Если Не Настройки.ИспользоватьУведомления Тогда
        Возврат;
    КонецЕсли;

    События = РегистрыСведений.ЕРП_СобытияУведомлений.Выбрать();

    Пока События.Следующий() Цикл

        Если События.Состояние <> "Новая" Тогда
            Продолжить;
        КонецЕсли;

        КоличествоДоставок = 0;
        Получатели = РегистрыСведений.ЕРП_ПолучателиУведомлений.Выбрать();

        Пока Получатели.Следующий() Цикл

            Если Не Получатели.Включен Тогда
                Продолжить;
            КонецЕсли;

            Уведомлять = Ложь;

            Если События.ТипСобытия = "УспешноСоздано" Тогда
                Уведомлять = Получатели.УведомлятьОбУспехе;
            ИначеЕсли События.ТипСобытия = "ОшибкаДвухПопыток" Тогда
                Уведомлять = Получатели.УведомлятьОбОшибке;
            ИначеЕсли События.ТипСобытия = "RabbitMQНедоступен"
                Или События.ТипСобытия = "RabbitMQВосстановлен" Тогда
                Уведомлять = Получатели.УведомлятьОСвязи;
            КонецЕсли;

            Если Не Уведомлять Тогда
                Продолжить;
            КонецЕсли;

            Если Настройки.ИспользоватьEmail
                И Получатели.EmailВключен
                И ЗначениеЗаполнено(Получатели.Email) Тогда

                Ключ = События.КлючСобытия + "|" + Строка(Получатели.Сотрудник) + "|EMAIL";
                ЕРП_СоздатьЗаписьДоставки(
                    Ключ,
                    События.КлючСобытия,
                    Получатели.Сотрудник,
                    "EMAIL",
                    Получатели.Email,
                    События.ТипСобытия,
                    События.ТекстСообщения
                );
                КоличествоДоставок = КоличествоДоставок + 1;

            КонецЕсли;

            Если Настройки.ИспользоватьTelegram
                И Получатели.TelegramВключен
                И ЗначениеЗаполнено(Получатели.TelegramChatID) Тогда

                Ключ = События.КлючСобытия + "|" + Строка(Получатели.Сотрудник) + "|TELEGRAM";
                ЕРП_СоздатьЗаписьДоставки(
                    Ключ,
                    События.КлючСобытия,
                    Получатели.Сотрудник,
                    "TELEGRAM",
                    Получатели.TelegramChatID,
                    События.ТипСобытия,
                    События.ТекстСообщения
                );
                КоличествоДоставок = КоличествоДоставок + 1;

            КонецЕсли;

        КонецЦикла;

        МенеджерСобытия = РегистрыСведений.ЕРП_СобытияУведомлений.СоздатьМенеджерЗаписи();
        МенеджерСобытия.КлючСобытия = События.КлючСобытия;
        МенеджерСобытия.Прочитать();
        МенеджерСобытия.Состояние = ?(КоличествоДоставок = 0, "БезПолучателей", "ДоставкиСозданы");
        МенеджерСобытия.Записать();

    КонецЦикла;

КонецПроцедуры


Процедура ЕРП_СоздатьЗаписьДоставки(
    КлючДоставки,
    КлючСобытия,
    Сотрудник,
    Канал,
    АдресПолучателя,
    ТипСобытия,
    ТекстСообщения)

    Менеджер = РегистрыСведений.ЕРП_ДоставкиУведомлений.СоздатьМенеджерЗаписи();
    Менеджер.КлючДоставки = КлючДоставки;
    Менеджер.Прочитать();

    Если ЗначениеЗаполнено(Менеджер.Состояние) Тогда
        Возврат;
    КонецЕсли;

    Менеджер.КлючДоставки = КлючДоставки;
    Менеджер.КлючСобытия = КлючСобытия;
    Менеджер.Сотрудник = Сотрудник;
    Менеджер.Канал = Канал;
    Менеджер.АдресПолучателя = АдресПолучателя;
    Менеджер.Тема = "Интеграция 1С: " + ТипСобытия;
    Менеджер.ТекстСообщения = ТекстСообщения;
    Менеджер.Состояние = "Ожидает";
    Менеджер.КоличествоПопыток = 0;
    Менеджер.СледующаяПопытка = Дата(1, 1, 1);
    Менеджер.Записать();

КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// РЕГЛАМЕНТНАЯ ОТПРАВКА
////////////////////////////////////////////////////////////////////////////////

Процедура ЕРП_ОбработатьОчередьУведомлений() Экспорт

    Настройки = ЕРП_ПолучитьНастройкиУведомлений();

    Если Не Настройки.ИспользоватьУведомления Тогда
        Возврат;
    КонецЕсли;

    ЕРП_СоздатьДоставкиПоНовымСобытиям();

    Выборка = РегистрыСведений.ЕРП_ДоставкиУведомлений.Выбрать();

    Пока Выборка.Следующий() Цикл

        Если Выборка.Состояние <> "Ожидает"
            И Выборка.Состояние <> "Повтор" Тогда
            Продолжить;
        КонецЕсли;

        Если ЗначениеЗаполнено(Выборка.СледующаяПопытка)
            И Выборка.СледующаяПопытка > ТекущаяДата() Тогда
            Продолжить;
        КонецЕсли;

        ЕРП_ВыполнитьПопыткуДоставки(Выборка.КлючДоставки, Настройки);

    КонецЦикла;

КонецПроцедуры


Процедура ЕРП_ВыполнитьПопыткуДоставки(КлючДоставки, Настройки)

    Менеджер = РегистрыСведений.ЕРП_ДоставкиУведомлений.СоздатьМенеджерЗаписи();
    Менеджер.КлючДоставки = КлючДоставки;
    Менеджер.Прочитать();

    Если Менеджер.Состояние <> "Ожидает"
        И Менеджер.Состояние <> "Повтор" Тогда
        Возврат;
    КонецЕсли;

    НомерПопытки = Менеджер.КоличествоПопыток + 1;
    Ошибка = "";

    Попытка

        Если Менеджер.Канал = "EMAIL" Тогда
            ЕРП_ОтправитьEmail(
                Настройки,
                Менеджер.АдресПолучателя,
                Менеджер.Тема,
                Менеджер.ТекстСообщения
            );
        ИначеЕсли Менеджер.Канал = "TELEGRAM" Тогда
            ЕРП_ОтправитьTelegram(
                Настройки,
                Менеджер.АдресПолучателя,
                Менеджер.ТекстСообщения
            );
        Иначе
            ВызватьИсключение "Неизвестный канал доставки: " + Менеджер.Канал;
        КонецЕсли;

        Менеджер.КоличествоПопыток = НомерПопытки;
        Менеджер.Состояние = "Отправлено";
        Менеджер.ДатаОтправки = ТекущаяДата();
        Менеджер.ПоследняяОшибка = "";
        Менеджер.Записать();

        ЕРП_ЗаписатьИсториюДоставки(КлючДоставки, НомерПопытки, "Отправлено", "");

    Исключение

        Ошибка = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());

        Менеджер.КоличествоПопыток = НомерПопытки;
        Менеджер.ПоследняяОшибка = Ошибка;

        Если НомерПопытки >= 5 Тогда
            Менеджер.Состояние = "ОкончательнаяОшибка";
            Менеджер.СледующаяПопытка = Дата(1, 1, 1);
        Иначе
            Менеджер.Состояние = "Повтор";
            Менеджер.СледующаяПопытка =
                ТекущаяДата() + ЕРП_ИнтервалПовтораСекунд(НомерПопытки);
        КонецЕсли;

        Менеджер.Записать();

        ЕРП_ЗаписатьИсториюДоставки(
            КлючДоставки,
            НомерПопытки,
            "Ошибка",
            Ошибка
        );

        ЗаписьЖурналаРегистрации(
            "ERP.Уведомления." + Менеджер.Канал,
            УровеньЖурналаРегистрации.Ошибка,
            ,
            ,
            Ошибка
        );

    КонецПопытки;

КонецПроцедуры


Функция ЕРП_ИнтервалПовтораСекунд(НомерПопытки)

    Если НомерПопытки = 1 Тогда
        Возврат 60;
    ИначеЕсли НомерПопытки = 2 Тогда
        Возврат 300;
    ИначеЕсли НомерПопытки = 3 Тогда
        Возврат 900;
    ИначеЕсли НомерПопытки = 4 Тогда
        Возврат 3600;
    КонецЕсли;

    Возврат 10800;

КонецФункции


Процедура ЕРП_ЗаписатьИсториюДоставки(
    КлючДоставки,
    НомерПопытки,
    Результат,
    Ошибка)

    Менеджер = РегистрыСведений.ЕРП_ИсторияДоставкиУведомлений.СоздатьМенеджерЗаписи();
    Менеджер.КлючДоставки = КлючДоставки;
    Менеджер.НомерПопытки = НомерПопытки;
    Менеджер.Прочитать();

    Менеджер.КлючДоставки = КлючДоставки;
    Менеджер.НомерПопытки = НомерПопытки;
    Менеджер.ДатаПопытки = ТекущаяДата();
    Менеджер.Результат = Результат;
    Менеджер.Ошибка = Ошибка;
    Менеджер.Записать();

КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// EMAIL / TELEGRAM
////////////////////////////////////////////////////////////////////////////////

Процедура ЕРП_ОтправитьEmail(Настройки, АдресПолучателя, Тема, Текст)

    Если Не ЗначениеЗаполнено(Настройки.SMTPСервер)
        Или Не ЗначениеЗаполнено(Настройки.SMTPОтправитель) Тогда
        ВызватьИсключение "Не заполнены SMTP-сервер или адрес отправителя ERP.";
    КонецЕсли;

    Профиль = Новый ИнтернетПочтовыйПрофиль;
    Профиль.АдресСервераSMTP = Настройки.SMTPСервер;
    Профиль.ПортSMTP = Настройки.SMTPПорт;
    Профиль.ПользовательSMTP = Настройки.SMTPПользователь;
    Профиль.ПарольSMTP = Настройки.SMTPПароль;
    Профиль.ИспользоватьSSLSMTP = Настройки.SMTPИспользоватьSSL;
    Профиль.ВремяОжидания = Настройки.SMTPТаймаут;

    Письмо = Новый ИнтернетПочтовоеСообщение;
    Письмо.Отправитель = Настройки.SMTPОтправитель;
    Письмо.Получатели.Добавить(АдресПолучателя);
    Письмо.Тема = Тема;

    ТекстПисьма = Письмо.Тексты.Добавить(Текст);
    ТекстПисьма.ТипТекста = ТипТекстаПочтовогоСообщения.ПростойТекст;

    Почта = Новый ИнтернетПочта;

    Попытка
        Почта.Подключиться(Профиль);
        Почта.Послать(Письмо);
    Исключение
        Попытка
            Почта.Отключиться();
        Исключение
        КонецПопытки;
        ВызватьИсключение;
    КонецПопытки;

    Почта.Отключиться();

КонецПроцедуры


Процедура ЕРП_ОтправитьTelegram(Настройки, ChatID, Текст)

    Если Не ЗначениеЗаполнено(Настройки.TelegramТокенБота) Тогда
        ВызватьИсключение "Не задан токен Telegram-бота ERP.";
    КонецЕсли;

    ДанныеСообщения = Новый Структура;
    ДанныеСообщения.Вставить("chat_id", ChatID);
    ДанныеСообщения.Вставить("text", Текст);

    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, ДанныеСообщения);
    СтрокаJSON = ЗаписьJSON.Закрыть();

    HTTPЗапрос = Новый HTTPЗапрос(
        "/bot" + Настройки.TelegramТокенБота + "/sendMessage"
    );
    HTTPЗапрос.Заголовки.Вставить(
        "Content-Type",
        "application/json; charset=utf-8"
    );
    HTTPЗапрос.УстановитьТелоИзСтроки(
        СтрокаJSON,
        КодировкаТекста.UTF8
    );

    Защита = Новый ЗащищенноеСоединениеOpenSSL(
        Новый СертификатКлиентаWindows(),
        Новый СертификатыУдостоверяющихЦентровWindows()
    );

    HTTPСоединение = Новый HTTPСоединение(
        "api.telegram.org",
        443,
        ,
        ,
        ,
        30,
        Защита
    );

    Ответ = HTTPСоединение.ВызватьHTTPМетод("POST", HTTPЗапрос);

    Если Ответ.КодСостояния <> 200 Тогда
        ВызватьИсключение
            "Telegram API вернул HTTP "
            + Строка(Ответ.КодСостояния)
            + ": "
            + Ответ.ПолучитьТелоКакСтроку();
    КонецЕсли;

КонецПроцедуры

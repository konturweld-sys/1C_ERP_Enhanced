////////////////////////////////////////////////////////////////////////////////
// Привилегированная запись ручных решений оператора доставки.
// Проверка роли выполняется до входа в привилегированный участок.
////////////////////////////////////////////////////////////////////////////////

Процедура ПрименитьРучноеРешениеПоДоставке(
    КлючДоставки, Решение, Комментарий) Экспорт

    Если Не РольДоступна("ЕРП_УправлениеДоставками") Тогда
        ВызватьИсключение "Недостаточно прав для изменения состояния доставки.";
    КонецЕсли;

    Комментарий = СокрЛП(Комментарий);
    Если ПустаяСтрока(Комментарий) Тогда
        ВызватьИсключение "Для ручного решения необходимо указать комментарий.";
    КонецЕсли;

    Если Решение <> "ПодтвердитьОтправку"
        И Решение <> "РазрешитьОднократныйПовтор" Тогда
        ВызватьИсключение "Неизвестный вариант ручного решения.";
    КонецЕсли;

    ПредварительнаяЗапись = РегистрыСведений.ЕРП_ДоставкиУведомлений.СоздатьМенеджерЗаписи();
    ПредварительнаяЗапись.КлючДоставки = КлючДоставки;
    ПредварительнаяЗапись.Прочитать();
    Если Не ПредварительнаяЗапись.Выбран() Тогда
        ВызватьИсключение "Доставка не найдена.";
    КонецЕсли;
    КлючСобытия = ПредварительнаяЗапись.КлючСобытия;

    НачатьТранзакцию();
    Попытка
        Если ЗначениеЗаполнено(КлючСобытия) Тогда
            ЗаблокироватьСобытие(КлючСобытия);
        КонецЕсли;
        ЗаблокироватьДоставку(КлючДоставки);

        Доставка = РегистрыСведений.ЕРП_ДоставкиУведомлений.СоздатьМенеджерЗаписи();
        Доставка.КлючДоставки = КлючДоставки;
        Доставка.Прочитать();

        Если Не Доставка.Выбран()
            Или Доставка.Состояние <> "ТребуетПроверки" Тогда
            ВызватьИсключение "Доставка уже обработана или её состояние изменилось. Обновите список.";
        КонецЕсли;

        Если Решение = "РазрешитьОднократныйПовтор"
            И ЗначениеЗаполнено(Доставка.ДатаРезервации) Тогда
            ВызватьИсключение
                "Повтор запрещён: срок резервации истёк во время незавершённой отправки. "
                + "Внешний вызов мог ещё выполняться. Подтвердите отправку после проверки результата у получателя.";
        КонецЕсли;

        Если Решение = "ПодтвердитьОтправку" Тогда
            Доставка.Состояние = "Отправлено";
            Доставка.ДатаОтправки = ТекущаяДата();
            Доставка.ПоследняяОшибка = "";
            Доставка.СледующаяПопытка = Дата(1, 1, 1);
        Иначе
            Доставка.Состояние = "ПовторВручную";
            Доставка.СледующаяПопытка = ТекущаяДата();
        КонецЕсли;

        Доставка.ИдентификаторРезервации =
            Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");
        Доставка.ДатаРезервации = Дата(1, 1, 1);
        Доставка.СрокРезервации = Дата(1, 1, 1);
        Доставка.Записать();

        ТекущийПользовательИБ = ПользователиИнформационнойБазы.ТекущийПользователь();
        ИмяПользователя = "";
        Если ТекущийПользовательИБ <> Неопределено Тогда
            ИмяПользователя = ТекущийПользовательИБ.Имя;
        КонецЕсли;
        ТекстРешения =
            "Дата: " + Строка(ТекущаяДата())
            + "; пользователь: " + ИмяПользователя
            + "; решение: " + Решение
            + "; комментарий: " + Комментарий;

        История = РегистрыСведений.ЕРП_ИсторияДоставкиУведомлений.СоздатьМенеджерЗаписи();
        История.ИдентификаторЗаписи = Новый УникальныйИдентификатор;
        История.КлючДоставки = КлючДоставки;
        История.НомерПопытки = 0;
        История.ДатаПопытки = ТекущаяДата();
        История.Результат = "РучноеРешение";
        История.Ошибка = ТекстРешения;
        История.Записать();

        Если ЗначениеЗаполнено(Доставка.КлючСобытия) Тогда
            ОбновитьСостояниеСобытияПодБлокировкой(Доставка.КлючСобытия);
        КонецЕсли;

        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;

КонецПроцедуры


Процедура ЗаблокироватьДоставку(КлючДоставки)
    БлокировкаДанных = Новый БлокировкаДанных;
    ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений.ЕРП_ДоставкиУведомлений");
    ЭлементБлокировки.УстановитьЗначение("КлючДоставки", КлючДоставки);
    ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
    БлокировкаДанных.Заблокировать();
КонецПроцедуры


Процедура ЗаблокироватьСобытие(КлючСобытия)
    БлокировкаДанных = Новый БлокировкаДанных;
    ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений.ЕРП_СобытияУведомлений");
    ЭлементБлокировки.УстановитьЗначение("КлючСобытия", КлючСобытия);
    ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
    БлокировкаДанных.Заблокировать();
КонецПроцедуры


Процедура ОбновитьСостояниеСобытияПодБлокировкой(КлючСобытия)

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |   Доставки.Состояние КАК Состояние
    |ИЗ
    |   РегистрСведений.ЕРП_ДоставкиУведомлений КАК Доставки
    |ГДЕ
    |   Доставки.КлючСобытия = &КлючСобытия";
    Запрос.УстановитьПараметр("КлючСобытия", КлючСобытия);

    КоличествоДоставок = 0;
    ВсеОтправлены = Истина;
    ВсеТерминальны = Истина;
    ЕстьОкончательныеОшибки = Ложь;
    ЕстьНеопределенныеРезультаты = Ложь;

    ВыборкаДоставок = Запрос.Выполнить().Выбрать();
    Пока ВыборкаДоставок.Следующий() Цикл
        КоличествоДоставок = КоличествоДоставок + 1;
        Если ВыборкаДоставок.Состояние <> "Отправлено" Тогда
            ВсеОтправлены = Ложь;
        КонецЕсли;
        Если ВыборкаДоставок.Состояние = "ОкончательнаяОшибка" Тогда
            ЕстьОкончательныеОшибки = Истина;
        ИначеЕсли ВыборкаДоставок.Состояние = "ТребуетПроверки" Тогда
            ЕстьНеопределенныеРезультаты = Истина;
        ИначеЕсли ВыборкаДоставок.Состояние <> "Отправлено" Тогда
            ВсеТерминальны = Ложь;
        КонецЕсли;
    КонецЦикла;

    Событие = РегистрыСведений.ЕРП_СобытияУведомлений.СоздатьМенеджерЗаписи();
    Событие.КлючСобытия = КлючСобытия;
    Событие.Прочитать();

    Если КоличествоДоставок = 0 Тогда
        Событие.Состояние = "БезПолучателей";
    ИначеЕсли ВсеОтправлены Тогда
        Событие.Состояние = "Завершено";
    ИначеЕсли ВсеТерминальны И ЕстьНеопределенныеРезультаты Тогда
        Событие.Состояние = "ТребуетПроверки";
    ИначеЕсли ВсеТерминальны И ЕстьОкончательныеОшибки Тогда
        Событие.Состояние = "ЗавершеноСОшибками";
    Иначе
        Событие.Состояние = "Выполняется";
    КонецЕсли;

    Событие.Записать();

КонецПроцедуры

// ЕРП_ВАЛИДАЦИЯКОНТРАКТА
////////////////////////////////////////////////////////////////////////////////

Функция ЕРП_ЭтоВалидныйUUID(Значение) Экспорт

    Если ТипЗнч(Значение) <> Тип("Строка") Тогда
        Возврат Ложь;
    КонецЕсли;

    Если ПустаяСтрока(Значение) Тогда
        Возврат Ложь;
    КонецЕсли;

    Попытка
        ПроверяемыйUUID = Новый УникальныйИдентификатор(Значение);
        Возврат Истина;
    Исключение
        Возврат Ложь;
    КонецПопытки;

КонецФункции

Функция ЕРП_ПроверитьСтроковоеПоле(СтруктураДанных, ИмяПоля)

    ЗначениеПоля = Неопределено;

    Если Не СтруктураДанных.Свойство(ИмяПоля, ЗначениеПоля) Тогда
        Возврат Ложь;
    КонецЕсли;

    Возврат ТипЗнч(ЗначениеПоля) = Тип("Строка");

КонецФункции


Функция ЕРП_ПроверитьПутьРодителей(Путь, ТекстОшибки)

    Если ТипЗнч(Путь) <> Тип("Массив") Тогда
        ТекстОшибки = "ПутьРодителей должен быть массивом.";
        Возврат Ложь;
    КонецЕсли;

    Для Каждого Папка Из Путь Цикл

        Если ТипЗнч(Папка) <> Тип("Структура") Тогда
            ТекстОшибки = "Элемент ПутьРодителей должен быть структурой.";
            Возврат Ложь;
        КонецЕсли;

        UUID = "";
        Наименование = "";
        ЭтоГруппа = Ложь;

        Если Не Папка.Свойство("UUID", UUID)
            Или Не ЕРП_ЭтоUUID(UUID) Тогда

            ТекстОшибки = "Некорректный UUID папки.";
            Возврат Ложь;

        КонецЕсли;

        Если Не Папка.Свойство("Наименование", Наименование)
            Или ТипЗнч(Наименование) <> Тип("Строка") Тогда

            ТекстОшибки = "Некорректное наименование папки.";
            Возврат Ложь;

        КонецЕсли;

        Если Не Папка.Свойство("ЭтоГруппа", ЭтоГруппа)
            Или Не ЭтоГруппа Тогда

            ТекстОшибки = "Элемент пути должен быть группой.";
            Возврат Ложь;

        КонецЕсли;

    КонецЦикла;

    Возврат Истина;

КонецФункции


Функция ЕРП_ПроверитьХарактеристики(Характеристики, ТекстОшибки)

    Если ТипЗнч(Характеристики) <> Тип("Массив") Тогда
        ТекстОшибки = "Характеристики должны быть массивом.";
        Возврат Ложь;
    КонецЕсли;

    Для Каждого Характеристика Из Характеристики Цикл

        Если ТипЗнч(Характеристика) <> Тип("Структура") Тогда
            ТекстОшибки = "Характеристика должна быть структурой.";
            Возврат Ложь;
        КонецЕсли;

        UUID = "";
        Наименование = "";
        ЭтоОбщая = Ложь;

        Если Не Характеристика.Свойство("UUID", UUID)
            Или Не ЕРП_ЭтоUUID(UUID) Тогда

            ТекстОшибки = "Некорректный UUID характеристики.";
            Возврат Ложь;

        КонецЕсли;

        Если Не Характеристика.Свойство("Наименование", Наименование)
            Или ТипЗнч(Наименование) <> Тип("Строка") Тогда

            ТекстОшибки = "Некорректное наименование характеристики.";
            Возврат Ложь;

        КонецЕсли;

        Если Не Характеристика.Свойство("ЭтоОбщаяХарактеристика", ЭтоОбщая)
            Или ТипЗнч(ЭтоОбщая) <> Тип("Булево") Тогда

            ТекстОшибки = "Некорректный признак общей характеристики.";
            Возврат Ложь;

        КонецЕсли;

    КонецЦикла;

    Возврат Истина;

КонецФункции


Функция ЕРП_ПроверитьСпецификацию(Спецификация, ТекстОшибки)

    Если ТипЗнч(Спецификация) <> Тип("Структура") Тогда
        ТекстОшибки = "Спецификация должна быть структурой.";
        Возврат Ложь;
    КонецЕсли;

    Наименование = "";
    Состав = Неопределено;

    Если Не Спецификация.Свойство("Наименование", Наименование)
        Или ТипЗнч(Наименование) <> Тип("Строка") Тогда

        ТекстОшибки = "Некорректное наименование спецификации.";
        Возврат Ложь;

    КонецЕсли;

    Если Не Спецификация.Свойство("Состав", Состав)
        Или ТипЗнч(Состав) <> Тип("Массив") Тогда

        ТекстОшибки = "Состав спецификации должен быть массивом.";
        Возврат Ложь;

    КонецЕсли;

    Для Каждого СтрокаСостава Из Состав Цикл

        Если ТипЗнч(СтрокаСостава) <> Тип("Структура") Тогда
            ТекстОшибки = "Строка состава должна быть структурой.";
            Возврат Ложь;
        КонецЕсли;

        UUIDНоменклатуры = "";
        Количество = 0;

        Если Не СтрокаСостава.Свойство(
            "Номенклатура_UUID",
            UUIDНоменклатуры
        ) Или Не ЕРП_ЭтоUUID(UUIDНоменклатуры) Тогда

            ТекстОшибки = "Некорректный UUID материала в составе.";
            Возврат Ложь;

        КонецЕсли;

        Если Не СтрокаСостава.Свойство(
            "Количество",
            Количество
        ) Или ТипЗнч(Количество) <> Тип("Число")
            Или Количество <= 0 Тогда

            ТекстОшибки = "Количество материала должно быть положительным числом.";
            Возврат Ложь;

        КонецЕсли;

    КонецЦикла;

    Возврат Истина;

КонецФункции


Функция ЕРП_ВалидироватьИРазобратьJSON(
    Знач ТекстJSON,
    ТекстОшибкиВалидации
) Экспорт

    ТекстОшибкиВалидации = "";

    ПакетДанных = Неопределено;

    Попытка

        ЧтениеJSON = Новый ЧтениеJSON;
        ЧтениеJSON.УстановитьСтроку(ТекстJSON);

        ПакетДанных = ПрочитатьJSON(ЧтениеJSON);

        ЧтениеJSON.Закрыть();

    Исключение

        ТекстОшибкиВалидации =
            "Ошибка разбора JSON: " + ОписаниеОшибки();

        Возврат Неопределено;

    КонецПопытки;

    Если ТипЗнч(ПакетДанных) <> Тип("Структура") Тогда
        ТекстОшибкиВалидации = "Корень JSON должен быть объектом.";
        Возврат Неопределено;
    КонецЕсли;

    UUID = "";
    Наименование = "";
    Артикул = "";
    ЭтоГруппа = Ложь;
    РодительUUID = "";
    ПутьРодителей = Неопределено;

    Если Не ПакетДанных.Свойство("UUID", UUID)
        Или Не ЕРП_ЭтоUUID(UUID) Тогда

        ТекстОшибкиВалидации = "Некорректный UUID объекта.";
        Возврат Неопределено;

    КонецЕсли;

    Если Не ПакетДанных.Свойство("Наименование", Наименование)
        Или ТипЗнч(Наименование) <> Тип("Строка")
        Или ПустаяСтрока(Наименование) Тогда

        ТекстОшибкиВалидации = "Некорректное наименование.";
        Возврат Неопределено;

    КонецЕсли;

    Если Не ПакетДанных.Свойство("Артикул", Артикул)
        Или ТипЗнч(Артикул) <> Тип("Строка") Тогда

        ТекстОшибкиВалидации = "Некорректный артикул.";
        Возврат Неопределено;

    КонецЕсли;

    Если Не ПакетДанных.Свойство("ЭтоГруппа", ЭтоГруппа)
        Или ТипЗнч(ЭтоГруппа) <> Тип("Булево") Тогда

        ТекстОшибкиВалидации = "Некорректный признак ЭтоГруппа.";
        Возврат Неопределено;

    КонецЕсли;

    Если Не ПакетДанных.Свойство("Родитель_UUID", РодительUUID) Тогда
        ТекстОшибкиВалидации = "Не передан Родитель_UUID.";
        Возврат Неопределено;
    КонецЕсли;

    Если ЗначениеЗаполнено(РодительUUID)
        И Не ЕРП_ЭтоUUID(РодительUUID) Тогда

        ТекстОшибкиВалидации = "Некорректный Родитель_UUID.";
        Возврат Неопределено;

    КонецЕсли;

    Если Не ПакетДанных.Свойство("ПутьРодителей", ПутьРодителей) Тогда
        ТекстОшибкиВалидации = "Не передан ПутьРодителей.";
        Возврат Неопределено;
    КонецЕсли;

    Если Не ЕРП_ПроверитьПутьРодителей(
        ПутьРодителей,
        ТекстОшибкиВалидации
    ) Тогда
        Возврат Неопределено;
    КонецЕсли;

    Если ЭтоГруппа Тогда
        Возврат ПакетДанных;
    КонецЕсли;

    Поля = Новый Массив;
    Поля.Добавить("ТипНоменклатуры");
    Поля.Добавить("ВидНоменклатуры");
    Поля.Добавить("ИспользованиеХарактеристик");
    Поля.Добавить("ВладелецХарактеристик");

    Для Каждого ИмяПоля Из Поля Цикл

        Если Не ЕРП_ПроверитьСтроковоеПоле(
            ПакетДанных,
            ИмяПоля
        ) Тогда

            ТекстОшибкиВалидации =
                "Поле " + ИмяПоля + " должно быть строкой.";

            Возврат Неопределено;

        КонецЕсли;

    КонецЦикла;

    ЕдиницаИзмерения = Неопределено;

    Если Не ПакетДанных.Свойство(
        "ЕдиницаИзмерения",
        ЕдиницаИзмерения
    ) Или ТипЗнч(ЕдиницаИзмерения) <> Тип("Структура") Тогда

        ТекстОшибкиВалидации = "Не передана ЕдиницаИзмерения.";
        Возврат Неопределено;

    КонецЕсли;

    Если Не ЕРП_ПроверитьСтроковоеПоле(
        ЕдиницаИзмерения,
        "Код"
    ) Или Не ЕРП_ПроверитьСтроковоеПоле(
        ЕдиницаИзмерения,
        "Наименование"
    ) Тогда

        ТекстОшибкиВалидации =
            "Неверная структура ЕдиницаИзмерения.";

        Возврат Неопределено;

    КонецЕсли;

    Характеристики = Неопределено;

    Если Не ПакетДанных.Свойство(
        "Характеристики",
        Характеристики
    ) Тогда

        ТекстОшибкиВалидации = "Не переданы характеристики.";
        Возврат Неопределено;

    КонецЕсли;

    Если Не ЕРП_ПроверитьХарактеристики(
        Характеристики,
        ТекстОшибкиВалидации
    ) Тогда
        Возврат Неопределено;
    КонецЕсли;

    Спецификация = Неопределено;

    Если Не ПакетДанных.Свойство(
        "Спецификация",
        Спецификация
    ) Тогда

        ТекстОшибкиВалидации = "Не передана спецификация.";
        Возврат Неопределено;

    КонецЕсли;

    Если Не ЕРП_ПроверитьСпецификацию(
        Спецификация,
        ТекстОшибкиВалидации
    ) Тогда
        Возврат Неопределено;
    КонецЕсли;

    Возврат ПакетДанных;

КонецФункции


Функция ЕРП_ЭтоUUID(Значение) Экспорт

    Возврат ЕРП_ЭтоВалидныйUUID(Значение);

КонецФункции
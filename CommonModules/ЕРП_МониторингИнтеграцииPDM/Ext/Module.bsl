////////////////////////////////////////////////////////////////////////////////
// Минимальный мониторинг приёма номенклатуры из PDM.
// Только фиксация состояния в двух независимых регистрах.
// Внешние каналы уведомлений (Email/Telegram) не используются.
////////////////////////////////////////////////////////////////////////////////

Процедура ЗафиксироватьСбойRabbitMQ(ТекстОшибки) Экспорт

    ТранзакцияБылаАктивна = ТранзакцияАктивна();
    Если Не ТранзакцияБылаАктивна Тогда
        НачатьТранзакцию();
    КонецЕсли;

    Попытка
        Блокировка = Новый БлокировкаДанных;
        ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ЕРП_СостояниеСвязиRabbitMQ");
        ЭлементБлокировки.УстановитьЗначение("Канал", "PDM_ERP");
        ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
        Блокировка.Заблокировать();

        Менеджер = РегистрыСведений.ЕРП_СостояниеСвязиRabbitMQ.СоздатьМенеджерЗаписи();
        Менеджер.Канал = "PDM_ERP";
        Менеджер.Прочитать();

        Менеджер.Канал = "PDM_ERP";
        Менеджер.КоличествоОшибокПодряд = Менеджер.КоличествоОшибокПодряд + 1;
        Менеджер.ДатаПоследнейОшибки = ТекущаяДата();
        Менеджер.ТекстПоследнейОшибки = ТекстОшибки;

        Если Менеджер.КоличествоОшибокПодряд >= 3 И Не Менеджер.Недоступен Тогда
            Менеджер.НомерИнцидента = Менеджер.НомерИнцидента + 1;
            Менеджер.Недоступен = Истина;
        КонецЕсли;

        Менеджер.Записать();

        Если Не ТранзакцияБылаАктивна Тогда
            ЗафиксироватьТранзакцию();
        КонецЕсли;
    Исключение
        Если Не ТранзакцияБылаАктивна Тогда
            ОтменитьТранзакцию();
        КонецЕсли;
        ВызватьИсключение;
    КонецПопытки;

КонецПроцедуры



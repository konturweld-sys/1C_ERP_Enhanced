Процедура ЗарегистрироватьУспешноеСоздание(UUID, Наименование) Экспорт

    Если Не ЗначениеЗаполнено(UUID) Тогда
        Возврат;
    КонецЕсли;

    ТранзакцияБылаАктивна = ТранзакцияАктивна();
    Если Не ТранзакцияБылаАктивна Тогда
        НачатьТранзакцию();
    КонецЕсли;

    Попытка
        Блокировка = Новый БлокировкаДанных;
        ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ЕРП_ПовторыСозданияНоменклатуры");
        ЭлементБлокировки.УстановитьЗначение("UUIDНоменклатуры", UUID);
        ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
        Блокировка.Заблокировать();

        Менеджер = РегистрыСведений.ЕРП_ПовторыСозданияНоменклатуры.СоздатьМенеджерЗаписи();
        Менеджер.UUIDНоменклатуры = UUID;
        Менеджер.Прочитать();

        Менеджер.UUIDНоменклатуры = UUID;
        Менеджер.КоличествоОшибок = 0;
        Менеджер.ПоследняяОшибка = "";
        Менеджер.ДатаПоследнейПопытки = ТекущаяДата();
        Менеджер.Записать();

        Если Не ТранзакцияБылаАктивна Тогда

////////////////////////////////////////////////////////////////////////////////
// ОБЩИЙ МОДУЛЬ: ЕРП_Уведомления
//
// Единственный центр уведомлений ERP.
// Все сетевые вызовы выполняются регламентным заданием,
// вне транзакции создания номенклатуры.
//
// Типы событий:
// УспешноСоздано
// ОшибкаДвухПопыток
// RabbitMQНедоступен
// RabbitMQВосстановлен
//
// Каналы доставки независимы: EMAIL / TELEGRAM.
// Максимум 5 попыток; интервалы 1, 5, 15, 60 и 180 минут.
////////////////////////////////////////////////////////////////////////////////

Функция ЕРП_ПолучитьНастройкиУведомлений() Экспорт

    Настройки = Новый Структура;
    Настройки.Вставить("ИспользоватьУведомления", Ложь);
    Настройки.Вставить("ИспользоватьEmail", Ложь);
    Настройки.Вставить("ИспользоватьTelegram", Ложь);
    Настройки.Вставить("TelegramИмяБота", "");

    Выборка = РегистрыСведений.ЕРП_НастройкиУведомлений.Выбрать();

    Если Выборка.Следующий() Тогда
        Настройки.ИспользоватьУведомления = Выборка.ИспользоватьУведомления;
        Настройки.ИспользоватьEmail = Выборка.ИспользоватьEmail;
        Настройки.ИспользоватьTelegram = Выборка.ИспользоватьTelegram;
        Настройки.TelegramИмяБота = Выборка.TelegramИмяБота;
    КонецЕсли;

    Возврат Настройки;

КонецФункции


////////////////////////////////////////////////////////////////////////////////
// СОЗДАНИЕ СОБЫТИЙ
////////////////////////////////////////////////////////////////////////////////

Функция ЕРП_СоздатьСобытиеУведомления(
    КлючСобытия,
    ТипСобытия,
    UUIDНоменклатуры,
    Наименование,
    ТекстСообщения) Экспорт

    Менеджер = РегистрыСведений.ЕРП_СобытияУведомлений.СоздатьМенеджерЗаписи();
    Менеджер.КлючСобытия = КлючСобытия;
    Менеджер.Прочитать();

    Если ЗначениеЗаполнено(Менеджер.Состояние) Тогда
        Возврат Ложь;
    КонецЕсли;

    Менеджер.КлючСобытия = КлючСобытия;
    Менеджер.ТипСобытия = ТипСобытия;
    Менеджер.UUIDНоменклатуры = UUIDНоменклатуры;
    Менеджер.Наименование = Наименование;
    Менеджер.ТекстСообщения = ТекстСообщения;
    Менеджер.ДатаСоздания = ТекущаяДата();
    Менеджер.Состояние = "Новая";
    Менеджер.Записать();

    Возврат Истина;

КонецФункции


Процедура ЕРП_ЗарегистрироватьУспешноеСоздание(UUID, Наименование) Экспорт

    Счетчик = РегистрыСведений.ЕРП_ПовторыСозданияНоменклатуры.СоздатьМенеджерЗаписи();
    Счетчик.UUIDНоменклатуры = UUID;
    Счетчик.Прочитать();

    Если Счетчик.УведомлениеОбУспехеСоздано Тогда
        Возврат;
    КонецЕсли;

    Текст =
        "🟢 Интеграция 1С: Успешно создано по заявке."
        + Символы.ПС
        + "Номенклатура: " + Наименование
        + Символы.ПС
        + "UUID: " + UUID;

    ЕРП_СоздатьСобытиеУведомления(
        "CREATE_SUCCESS:" + UUID,
        "УспешноСоздано",
        UUID,
        Наименование,
        Текст
    );

    Счетчик.UUIDНоменклатуры = UUID;
    Счетчик.УведомлениеОбУспехеСоздано = Истина;
    Счетчик.ДатаПоследнейПопытки = ТекущаяДата();
    Счетчик.Записать();

КонецПроцедуры


Процедура ЕРП_ЗарегистрироватьНеудачнуюПопыткуСоздания(
    UUID,
    Наименование,
    ТекстОшибки) Экспорт

    Если Не ЗначениеЗаполнено(UUID) Тогда
        Возврат;
    КонецЕсли;

    Счетчик = РегистрыСведений.ЕРП_ПовторыСозданияНоменклатуры.СоздатьМенеджерЗаписи();
    Счетчик.UUIDНоменклатуры = UUID;
    Счетчик.Прочитать();

    Счетчик.UUIDНоменклатуры = UUID;
    Счетчик.КоличествоОшибок = Счетчик.КоличествоОшибок + 1;
    Счетчик.ПоследняяОшибка = ТекстОшибки;
    Счетчик.ДатаПоследнейПопытки = ТекущаяДата();

    // Сначала сохраняем счётчик вне транзакции создания.
    // Даже если регистрация события уведомления завершится ошибкой,
    // факт неудачной попытки останется в ERP.
    Счетчик.Записать();

    Если Счетчик.КоличествоОшибок >= 2
        И Не Счетчик.УведомлениеОбОшибкеСоздано Тогда

        Текст =
            "🔴 Интеграция 1С: Ошибка создания номенклатуры после двух неудачных попыток."
            + Символы.ПС
            + "Номенклатура: " + Наименование
            + Символы.ПС
            + "UUID: " + UUID
            + Символы.ПС
            + "Последняя ошибка: " + ТекстОшибки;

        ЕРП_СоздатьСобытиеУведомления(
            "CREATE_FAILED:" + UUID,
            "ОшибкаДвухПопыток",
            UUID,
            Наименование,
            Текст
        );

        Счетчик.УведомлениеОбОшибкеСоздано = Истина;
        Счетчик.Записать();

    КонецЕсли;

КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// МОНИТОРИНГ ДОСТУПНОСТИ RABBITMQ
////////////////////////////////////////////////////////////////////////////////

Процедура ЕРП_ЗафиксироватьСбойRabbitMQ(ТекстОшибки) Экспорт

    Менеджер = РегистрыСведений.ЕРП_СостояниеСвязиRabbitMQ.СоздатьМенеджерЗаписи();
    Менеджер.Канал = "PDM_ERP";
    Менеджер.Прочитать();

    Менеджер.Канал = "PDM_ERP";
    Менеджер.КоличествоОшибокПодряд = Менеджер.КоличествоОшибокПодряд + 1;
    Менеджер.ДатаПоследнейОшибки = ТекущаяДата();
    Менеджер.ТекстПоследнейОшибки = ТекстОшибки;

    // Сохраняем каждую ошибку до попытки создать событие.
    Менеджер.Записать();

    Если Менеджер.КоличествоОшибокПодряд >= 3
        И Не Менеджер.Недоступен Тогда

        НовыйНомерИнцидента = Менеджер.НомерИнцидента + 1;

        Текст =
            "🔴 Интеграция 1С: RabbitMQ недоступен после трех последовательных ошибок."
            + Символы.ПС
            + "Последняя ошибка: " + ТекстОшибки;

        // Сначала создаём уникальное событие. Если запись не удастся,
        // состояние останется неотмеченным и следующая ошибка повторит попытку.
        ЕРП_СоздатьСобытиеУведомления(
            "RABBITMQ_DOWN:" + Строка(НовыйНомерИнцидента),
            "RabbitMQНедоступен",
            "",
            "RabbitMQ",
            Текст
        );

        Менеджер.НомерИнцидента = НовыйНомерИнцидента;
        Менеджер.Недоступен = Истина;
        Менеджер.Записать();

    КонецЕсли;

КонецПроцедуры


Процедура ЕРП_ЗафиксироватьДоступностьRabbitMQ() Экспорт

    Менеджер = РегистрыСведений.ЕРП_СостояниеСвязиRabbitMQ.СоздатьМенеджерЗаписи();
    Менеджер.Канал = "PDM_ERP";
    Менеджер.Прочитать();

    Если Менеджер.Недоступен Тогда

        Текст =
            "🟢 Интеграция 1С: Связь с RabbitMQ восстановлена.";

        ЕРП_СоздатьСобытиеУведомления(
            "RABBITMQ_RECOVERED:" + Строка(Менеджер.НомерИнцидента),
            "RabbitMQВосстановлен",
            "",
            "RabbitMQ",
            Текст
        );

    КонецЕсли;

    Менеджер.Канал = "PDM_ERP";
    Менеджер.КоличествоОшибокПодряд = 0;
    Менеджер.Недоступен = Ложь;
    Менеджер.Записать();

КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// EMAIL ИЗ ШТАТНОЙ КОНТАКТНОЙ ИНФОРМАЦИИ СОТРУДНИКА
////////////////////////////////////////////////////////////////////////////////

Функция ЕРП_ПолучитьEmailСотрудника(Сотрудник)

    Если Не ЗначениеЗаполнено(Сотрудник) Тогда
        Возврат "";
    КонецЕсли;

    ФизическоеЛицо = Сотрудник.ФизическоеЛицо;

    Если Не ЗначениеЗаполнено(ФизическоеЛицо) Тогда
        Возврат "";
    КонецЕсли;

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |   КонтактнаяИнформация.АдресЭП КАК Email
    |ИЗ
    |   Справочник.ФизическиеЛица.КонтактнаяИнформация КАК КонтактнаяИнформация
    |ГДЕ
    |   КонтактнаяИнформация.Ссылка = &ФизическоеЛицо
    |   И КонтактнаяИнформация.Вид = &ВидКонтактнойИнформации
    |УПОРЯДОЧИТЬ ПО
    |   КонтактнаяИнформация.НомерСтроки";

    Запрос.УстановитьПараметр("ФизическоеЛицо", ФизическоеЛицо);
    Запрос.УстановитьПараметр(
        "ВидКонтактнойИнформации",
        Справочники.ВидыКонтактнойИнформации.EmailПользователя
    );

    ВыборкаEmail = Запрос.Выполнить().Выбрать();

    Если ВыборкаEmail.Следующий() Тогда
        Возврат СокрЛП(ВыборкаEmail.Email);
    КонецЕсли;

    Возврат "";

КонецФункции


////////////////////////////////////////////////////////////////////////////////
// ФОРМИРОВАНИЕ ОЧЕРЕДИ ДОСТАВКИ
////////////////////////////////////////////////////////////////////////////////

Процедура ЕРП_СоздатьДоставкиПоНовымСобытиям()

    Настройки = ЕРП_ПолучитьНастройкиУведомлений();

    Если Не Настройки.ИспользоватьУведомления Тогда
        Возврат;
    КонецЕсли;

    МассивКлючейСобытий = Новый Массив;
    События = РегистрыСведений.ЕРП_СобытияУведомлений.Выбрать();

    Пока События.Следующий() Цикл
        Если События.Состояние = "Новая" Тогда
            МассивКлючейСобытий.Добавить(События.КлючСобытия);
        КонецЕсли;
    КонецЦикла;

    Для Каждого КлючТекущегоСобытия Из МассивКлючейСобытий Цикл

        Событие = РегистрыСведений.ЕРП_СобытияУведомлений.СоздатьМенеджерЗаписи();
        Событие.КлючСобытия = КлючТекущегоСобытия;
        Событие.Прочитать();

        КоличествоДоставок = 0;
        Получатели = РегистрыСведений.ЕРП_ПолучателиУведомлений.Выбрать();

        Пока Получатели.Следующий() Цикл

            Если Не Получатели.Включен Тогда
                Продолжить;
            КонецЕсли;

            Уведомлять = Ложь;

            Если Событие.ТипСобытия = "УспешноСоздано" Тогда
                Уведомлять = Получатели.УведомлятьОбУспехе;
            ИначеЕсли Событие.ТипСобытия = "ОшибкаДвухПопыток" Тогда
                Уведомлять = Получатели.УведомлятьОбОшибке;
            ИначеЕсли Событие.ТипСобытия = "RabbitMQНедоступен"
                Или Событие.ТипСобытия = "RabbitMQВосстановлен" Тогда
                Уведомлять = Получатели.УведомлятьОСвязи;
            КонецЕсли;

            Если Не Уведомлять Тогда
                Продолжить;
            КонецЕсли;

            EmailСотрудника = ЕРП_ПолучитьEmailСотрудника(
                Получатели.Сотрудник
            );

            Если Настройки.ИспользоватьEmail
                И Получатели.EmailВключен
                И ЗначениеЗаполнено(EmailСотрудника) Тогда

                Ключ = Событие.КлючСобытия + "|" + Строка(Получатели.Сотрудник.УникальныйИдентификатор()) + "|EMAIL";
                ЕРП_СоздатьЗаписьДоставки(
                    Ключ,
                    Событие.КлючСобытия,
                    Получатели.Сотрудник,
                    "EMAIL",
                    EmailСотрудника,
                    Событие.ТипСобытия,
                    Событие.ТекстСообщения
                );
                КоличествоДоставок = КоличествоДоставок + 1;

            КонецЕсли;

            Если Настройки.ИспользоватьTelegram
                И Получатели.TelegramВключен
                И ЗначениеЗаполнено(Получатели.TelegramChatID) Тогда

                Ключ = Событие.КлючСобытия + "|" + Строка(Получатели.Сотрудник.УникальныйИдентификатор()) + "|TELEGRAM";
                ЕРП_СоздатьЗаписьДоставки(
                    Ключ,
                    Событие.КлючСобытия,
                    Получатели.Сотрудник,
                    "TELEGRAM",
                    Получатели.TelegramChatID,
                    Событие.ТипСобытия,
                    Событие.ТекстСообщения
                );
                КоличествоДоставок = КоличествоДоставок + 1;

            КонецЕсли;

        КонецЦикла;

        МенеджерСобытия = РегистрыСведений.ЕРП_СобытияУведомлений.СоздатьМенеджерЗаписи();
        МенеджерСобытия.КлючСобытия = КлючТекущегоСобытия;
        МенеджерСобытия.Прочитать();
        МенеджерСобытия.Состояние = ?(КоличествоДоставок = 0, "БезПолучателей", "ДоставкиСозданы");
        МенеджерСобытия.Записать();

    КонецЦикла;

КонецПроцедуры


Процедура ЕРП_СоздатьЗаписьДоставки(
    КлючДоставки,
    КлючСобытия,
    Сотрудник,
    Канал,
    АдресПолучателя,
    ТипСобытия,
    ТекстСообщения)

    Менеджер = РегистрыСведений.ЕРП_ДоставкиУведомлений.СоздатьМенеджерЗаписи();
    Менеджер.КлючДоставки = КлючДоставки;
    Менеджер.Прочитать();

    Если ЗначениеЗаполнено(Менеджер.Состояние) Тогда
        Возврат;
    КонецЕсли;

    Менеджер.КлючДоставки = КлючДоставки;
    Менеджер.КлючСобытия = КлючСобытия;
    Менеджер.Сотрудник = Сотрудник;
    Менеджер.Канал = Канал;
    Менеджер.АдресПолучателя = АдресПолучателя;
    Менеджер.Тема = "Интеграция 1С: " + ТипСобытия;
    Менеджер.ТекстСообщения = ТекстСообщения;
    Менеджер.Состояние = "Ожидает";
    Менеджер.КоличествоПопыток = 0;
    Менеджер.СледующаяПопытка = Дата(1, 1, 1);
    Менеджер.Записать();

КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// РЕГЛАМЕНТНАЯ ОТПРАВКА
////////////////////////////////////////////////////////////////////////////////

Процедура ЕРП_ОбработатьОчередьУведомлений() Экспорт

    Настройки = ЕРП_ПолучитьНастройкиУведомлений();

    Если Не Настройки.ИспользоватьУведомления Тогда
        Возврат;
    КонецЕсли;

    ЕРП_СоздатьДоставкиПоНовымСобытиям();

    МассивКлючейДоставки = Новый Массив;
    Выборка = РегистрыСведений.ЕРП_ДоставкиУведомлений.Выбрать();

    Пока Выборка.Следующий() Цикл
        Если Выборка.Состояние <> "Ожидает"
            И Выборка.Состояние <> "Повтор" Тогда
            Продолжить;
        КонецЕсли;

        Если ЗначениеЗаполнено(Выборка.СледующаяПопытка)
            И Выборка.СледующаяПопытка > ТекущаяДата() Тогда
            Продолжить;
        КонецЕсли;

        МассивКлючейДоставки.Добавить(Выборка.КлючДоставки);
    КонецЦикла;

    Для Каждого КлючДоставки Из МассивКлючейДоставки Цикл
        ЕРП_ВыполнитьПопыткуДоставки(КлючДоставки, Настройки);
    КонецЦикла;

КонецПроцедуры


Процедура ЕРП_ВыполнитьПопыткуДоставки(КлючДоставки, Настройки)

    Менеджер = РегистрыСведений.ЕРП_ДоставкиУведомлений.СоздатьМенеджерЗаписи();
    Менеджер.КлючДоставки = КлючДоставки;
    Менеджер.Прочитать();

    Если Менеджер.Состояние <> "Ожидает"
        И Менеджер.Состояние <> "Повтор" Тогда
        Возврат;
    КонецЕсли;

    НомерПопытки = Менеджер.КоличествоПопыток + 1;
    Ошибка = "";

    Попытка

        Если Менеджер.Канал = "EMAIL" Тогда
            ЕРП_ОтправитьEmail(
                Менеджер.АдресПолучателя,
                Менеджер.Тема,
                Менеджер.ТекстСообщения
            );
        ИначеЕсли Менеджер.Канал = "TELEGRAM" Тогда
            ЕРП_ОтправитьTelegram(
                Настройки,
                Менеджер.АдресПолучателя,
                Менеджер.ТекстСообщения
            );
        Иначе
            ВызватьИсключение "Неизвестный канал доставки: " + Менеджер.Канал;
        КонецЕсли;

        Менеджер.КоличествоПопыток = НомерПопытки;
        Менеджер.Состояние = "Отправлено";
        Менеджер.ДатаОтправки = ТекущаяДата();
        Менеджер.ПоследняяОшибка = "";
        Менеджер.Записать();

        ЕРП_ЗаписатьИсториюДоставки(КлючДоставки, НомерПопытки, "Отправлено", "");

    Исключение

        Ошибка = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());

        Менеджер.КоличествоПопыток = НомерПопытки;
        Менеджер.ПоследняяОшибка = Ошибка;

        Если НомерПопытки >= 5 Тогда
            Менеджер.Состояние = "ОкончательнаяОшибка";
            Менеджер.СледующаяПопытка = Дата(1, 1, 1);
        Иначе
            Менеджер.Состояние = "Повтор";
            Менеджер.СледующаяПопытка =
                ТекущаяДата() + ЕРП_ИнтервалПовтораСекунд(НомерПопытки);
        КонецЕсли;

        Менеджер.Записать();

        ЕРП_ЗаписатьИсториюДоставки(
            КлючДоставки,
            НомерПопытки,
            "Ошибка",
            Ошибка
        );

        ЗаписьЖурналаРегистрации(
            "ERP.Уведомления." + Менеджер.Канал,
            УровеньЖурналаРегистрации.Ошибка,
            ,
            ,
            Ошибка
        );

    КонецПопытки;

КонецПроцедуры


Функция ЕРП_ИнтервалПовтораСекунд(НомерПопытки)

    Если НомерПопытки = 1 Тогда
        Возврат 60;
    ИначеЕсли НомерПопытки = 2 Тогда
        Возврат 300;
    ИначеЕсли НомерПопытки = 3 Тогда
        Возврат 900;
    ИначеЕсли НомерПопытки = 4 Тогда
        Возврат 3600;
    КонецЕсли;

    Возврат 10800;

КонецФункции


Процедура ЕРП_ЗаписатьИсториюДоставки(
    КлючДоставки,
    НомерПопытки,
    Результат,
    Ошибка)

    Менеджер = РегистрыСведений.ЕРП_ИсторияДоставкиУведомлений.СоздатьМенеджерЗаписи();
    Менеджер.КлючДоставки = КлючДоставки;
    Менеджер.НомерПопытки = НомерПопытки;
    Менеджер.Прочитать();

    Менеджер.КлючДоставки = КлючДоставки;
    Менеджер.НомерПопытки = НомерПопытки;
    Менеджер.ДатаПопытки = ТекущаяДата();
    Менеджер.Результат = Результат;
    Менеджер.Ошибка = Ошибка;
    Менеджер.Записать();

КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// EMAIL / TELEGRAM
////////////////////////////////////////////////////////////////////////////////

Процедура ЕРП_ОтправитьEmail(АдресПолучателя, Тема, Текст)

    УчетнаяЗапись = РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();

    Если Не ЗначениеЗаполнено(УчетнаяЗапись) Тогда
        ВызватьИсключение "Не настроена системная учетная запись электронной почты ERP.";
    КонецЕсли;

    Если Не РаботаСПочтовымиСообщениями.УчетнаяЗаписьНастроена(
        УчетнаяЗапись,
        Истина,
        Ложь) Тогда
        ВызватьИсключение "Системная учетная запись ERP не настроена для отправки почты.";
    КонецЕсли;

    ПараметрыПисьма = Новый Структура;
    ПараметрыПисьма.Вставить("Кому", АдресПолучателя);
    ПараметрыПисьма.Вставить("Тема", Тема);
    ПараметрыПисьма.Вставить("Тело", Текст);
    ПараметрыПисьма.Вставить("ТипТекста", "ПростойТекст");

    Письмо = РаботаСПочтовымиСообщениями.ПодготовитьПисьмо(
        УчетнаяЗапись,
        ПараметрыПисьма);

    РезультатОтправки = РаботаСПочтовымиСообщениями.ОтправитьПисьмо(
        УчетнаяЗапись,
        Письмо);

    Если РезультатОтправки.ОшибочныеПолучатели.Количество() > 0 Тогда

        ТекстОшибки = "Почтовый сервер отклонил адрес получателя "
            + АдресПолучателя + ".";

        Для Каждого ОшибочныйПолучатель Из РезультатОтправки.ОшибочныеПолучатели Цикл
            ТекстОшибки = ТекстОшибки + Символы.ПС
                + ОшибочныйПолучатель.Ключ + ": "
                + ОшибочныйПолучатель.Значение;
        КонецЦикла;

        ВызватьИсключение ТекстОшибки;

    КонецЕсли;

КонецПроцедуры


Процедура ЕРП_ОтправитьTelegram(Настройки, ChatID, Текст)

    Если Не ЗначениеЗаполнено(Настройки.TelegramИмяБота) Тогда
        ВызватьИсключение "Не указано имя Telegram-бота UBT в настройках уведомлений.";
    КонецЕсли;

    Если Метаданные.Справочники.Найти("УБТ_БотыTelegram") = Неопределено Тогда
        ВызватьИсключение "Не установлена подсистема UBT Telegram.";
    КонецЕсли;

    Если Не ЗначениеЗаполнено(ChatID) Тогда
        ВызватьИсключение "Не указан Telegram Chat ID получателя.";
    КонецЕсли;

    Бот = Справочники["УБТ_БотыTelegram"].НайтиБотаTelegramПоИмени(
        Настройки.TelegramИмяБота);

    Если Не ЗначениеЗаполнено(Бот) Тогда
        ВызватьИсключение "В UBT не найден Telegram-бот с именем "
            + Настройки.TelegramИмяБота + ".";
    КонецЕсли;

    МодульУБТ = ОбщегоНазначения.ОбщийМодуль("УБТ_РаботаСБотамиTelegram");

    Сообщение = Новый Структура(
        "chat_id,text,reply_markup,parse_mode",
        ChatID,
        Текст,
        Неопределено,
        "");

    Результат = МодульУБТ.ОтправитьСообщениеВЧат(Бот, Сообщение);

    УспешныйОтвет = Ложь;

    Если ТипЗнч(Результат) <> Тип("Структура")
        Или Не Результат.Свойство("ok", УспешныйОтвет)
        Или Не УспешныйОтвет Тогда
        ВызватьИсключение "UBT не подтвердил успешную отправку сообщения Telegram.";
    КонецЕсли;

КонецПроцедуры

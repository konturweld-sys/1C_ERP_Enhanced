////////////////////////////////////////////////////////////////////////////////
// Серверное чтение журналов уведомлений из D:\1C Log.
// Побайтовое чтение UTF-8, контроль ротации, SHA-256-дедупликация.
// События, снимки маршрутов, доставки и позиция фиксируются одной транзакцией.
////////////////////////////////////////////////////////////////////////////////

Процедура ОбработатьЖурналы() Экспорт

    КаталогЖурналов = "D:\1C Log";
    ОбъектКаталога = Новый Файл(КаталогЖурналов);
    Если Не ОбъектКаталога.Существует() Или Не ОбъектКаталога.ЭтоКаталог() Тогда
        Возврат;
    КонецЕсли;

    Маски = Новый Массив;
    ВыборкаМасок = Справочники.ЕРП_МаскиЖурналов.Выбрать();
    Пока ВыборкаМасок.Следующий() Цикл
        Если ВыборкаМасок.Активна
            И ЗначениеЗаполнено(ВыборкаМасок.МаскаФайлов) Тогда
            Маски.Добавить(ВыборкаМасок.Ссылка);
        КонецЕсли;
    КонецЦикла;

    // Один файл может соответствовать нескольким маскам. Файл читается один раз,
    // а каждая полная логическая строка проверяется по всем соответствующим маскам.
    Файлы = Новый Массив;

    Для Каждого СсылкаМаски Из Маски Цикл
        Маска = СсылкаМаски.ПолучитьОбъект();
        // Рекурсивный обход включает вложенные каталоги источника.
        // Найденные файлы регистрируются по полному пути в регистре
        // ЕРП_ПозицииЧтенияЛогов при первой обработке, включая пустые файлы.
        НайденныеФайлы = НайтиФайлы(КаталогЖурналов, Маска.МаскаФайлов, Истина);

        Для Каждого НайденныйФайл Из НайденныеФайлы Цикл
            Если Не НайденныйФайл.ЭтоФайл() Тогда
                Продолжить;
            КонецЕсли;

            // Не читаем собственный служебный журнал подсистемы:
            // иначе запись ошибки чтения могла бы породить новое событие чтения.
            Если НРег(НайденныйФайл.Имя) = НРег("ERP_Email_Telegram_Notification.log") Тогда
                Продолжить;
            КонецЕсли;

            ИндексФайла = -1;
            Для Индекс = 0 По Файлы.Количество() - 1 Цикл
                Если НРег(Файлы[Индекс].Путь) = НРег(НайденныйФайл.ПолноеИмя) Тогда
                    ИндексФайла = Индекс;
                    Прервать;
                КонецЕсли;
            КонецЦикла;

            Если ИндексФайла = -1 Тогда
                МаскиФайла = Новый Массив;
                МаскиФайла.Добавить(СсылкаМаски);
                Файлы.Добавить(Новый Структура(
                    "Путь, Маски", НайденныйФайл.ПолноеИмя, МаскиФайла));
            Иначе
                Файлы[ИндексФайла].Маски.Добавить(СсылкаМаски);
            КонецЕсли;
        КонецЦикла;
    КонецЦикла;

    Для Каждого ДанныеФайла Из Файлы Цикл
        Попытка
            ОбработатьФайл(ДанныеФайла.Путь, ДанныеФайла.Маски);
        Исключение
            ЕРП_ЖурналУведомлений.Ошибка(
                "ЧТЕНИЕ ЖУРНАЛОВ",
                "Не удалось обработать файл журнала.",
                "Файл: " + ДанныеФайла.Путь
                    + "; ошибка: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
        КонецПопытки;
    КонецЦикла;

КонецПроцедуры


Процедура ОбработатьФайл(ПутьКФайлу, МаскиФайла)

    Файл = Новый Файл(ПутьКФайлу);
    Если Не Файл.Существует() Тогда
        Возврат;
    КонецЕсли;

    РазмерФайла = Файл.Размер();
    ДатаМодификации = Файл.ПолучитьВремяИзменения();

    Позиция = РегистрыСведений.ЕРП_ПозицииЧтенияЛогов.СоздатьМенеджерЗаписи();
    Позиция.ПутьКФайлу = ПутьКФайлу;
    Позиция.Прочитать();

    СтараяПозиция = Позиция.ПоследняяПозицияБайт;
    ПозицияДоЧтения = СтараяПозиция;
    СтарыйРазмерФайла = Позиция.РазмерФайла;
    СтараяСигнатура = Позиция.СигнатураНачалаФайла;
    СтараяДатаМодификации = Позиция.ДатаМодификацииФайла;
    СтарыйХвостBase64 = Позиция.ХвостНезавершеннойСтрокиBase64;

    Если РазмерФайла = СтараяПозиция
        И ДатаМодификации = СтараяДатаМодификации Тогда
        Возврат;
    КонецЕсли;

    НоваяСигнатура = ПолучитьСигнатуруНачалаФайла(ПутьКФайлу, РазмерФайла);

    СброситьПозицию = Ложь;
    Если РазмерФайла < СтараяПозиция Тогда
        СброситьПозицию = Истина;
    ИначеЕсли СтарыйРазмерФайла >= 4096
        И РазмерФайла >= 4096
        И ЗначениеЗаполнено(СтараяСигнатура)
        И НоваяСигнатура <> СтараяСигнатура Тогда
        СброситьПозицию = Истина;
    КонецЕсли;

    Если РазмерФайла = СтараяПозиция
        И ДатаМодификации <> СтараяДатаМодификации Тогда

        // Для файлов короче 4096 байт неполную сигнатуру не считаем
        // доказательством ротации.
        Если СтарыйРазмерФайла >= 4096
            И РазмерФайла >= 4096
            И ЗначениеЗаполнено(СтараяСигнатура)
            И НоваяСигнатура <> СтараяСигнатура Тогда
            СброситьПозицию = Истина;
        Иначе
            ОбновитьДатуМодификацииБезЧтения(
                ПутьКФайлу, РазмерФайла, НоваяСигнатура, ДатаМодификации);
            Возврат;
        КонецЕсли;
    КонецЕсли;

    Если СброситьПозицию Тогда
        СтараяПозиция = 0;
        СтарыйХвостBase64 = "";
        СтараяСигнатура = НоваяСигнатура;
    КонецЕсли;

    ДоступноБайт = РазмерФайла - СтараяПозиция;
    Если ДоступноБайт <= 0 Тогда
        Если СброситьПозицию Тогда
            СохранитьСбросПозицииФайла(
                ПутьКФайлу, ПозицияДоЧтения, РазмерФайла,
                НоваяСигнатура, ДатаМодификации);
        Иначе
            ОбновитьДатуМодификацииБезЧтения(
                ПутьКФайлу, РазмерФайла, НоваяСигнатура, ДатаМодификации);
        КонецЕсли;
        Возврат;
    КонецЕсли;

    РазмерПорции = Мин(ДоступноБайт, 1048576);
    НовыеДанные = ПрочитатьПорциюФайла(ПутьКФайлу, СтараяПозиция, РазмерПорции);
    Если НовыеДанные.Размер() = 0 Тогда
        Возврат;
    КонецЕсли;

    СтарыйХвост = Неопределено;
    РазмерСтарогоХвоста = 0;
    Если ЗначениеЗаполнено(СтарыйХвостBase64) Тогда
        СтарыйХвост = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(
            Base64Значение(СтарыйХвостBase64));
        РазмерСтарогоХвоста = СтарыйХвост.Размер;
    КонецЕсли;

    БуферНовыхДанных = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(НовыеДанные);
    ОбщийРазмер = РазмерСтарогоХвоста + БуферНовыхДанных.Размер;
    ОбщийБуфер = Новый БуферДвоичныхДанных(ОбщийРазмер);

    Если РазмерСтарогоХвоста > 0 Тогда
        Для Индекс = 0 По РазмерСтарогоХвоста - 1 Цикл
            ОбщийБуфер.Установить(Индекс, СтарыйХвост.Получить(Индекс));
        КонецЦикла;
    КонецЕсли;

    Для Индекс = 0 По БуферНовыхДанных.Размер - 1 Цикл
        ОбщийБуфер.Установить(
            РазмерСтарогоХвоста + Индекс,
            БуферНовыхДанных.Получить(Индекс));
    КонецЦикла;
    ПолныеСтроки = Новый Массив;
    НачалоСтроки = 0;

    Для Индекс = 0 По ОбщийБуфер.Размер - 1 Цикл
        Если ОбщийБуфер.Получить(Индекс) = 10 Тогда
            ДлинаСтроки = Индекс - НачалоСтроки;
            Если ДлинаСтроки > 0
                И ОбщийБуфер.Получить(Индекс - 1) = 13 Тогда
                ДлинаСтроки = ДлинаСтроки - 1;
            КонецЕсли;

            Если ДлинаСтроки > 0 Тогда
                ДанныеСтроки = ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(
                    ОбщийБуфер.Прочитать(НачалоСтроки, ДлинаСтроки));
                ТекстСтроки = ПолучитьСтрокуИзДвоичныхДанных(
                    ДанныеСтроки, КодировкаТекста.UTF8);
                Если СтрДлина(ТекстСтроки) > 0
                    И Лев(ТекстСтроки, 1) = Символ(65279) Тогда
                    ТекстСтроки = Сред(ТекстСтроки, 2);
                КонецЕсли;
                ПолныеСтроки.Добавить(ТекстСтроки);
            КонецЕсли;

            НачалоСтроки = Индекс + 1;
        КонецЕсли;
    КонецЦикла;

    ОстатокБайт = ОбщийБуфер.Размер - НачалоСтроки;
    НовыйХвостBase64 = "";
    Если ОстатокБайт > 0 Тогда
        ХвостДД = ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(
            ОбщийБуфер.Прочитать(НачалоСтроки, ОстатокБайт));
        НовыйХвостBase64 = ПолучитьBase64СтрокуИзДвоичныхДанных(ХвостДД);
    КонецЕсли;

    НоваяПозиция = СтараяПозиция + НовыеДанные.Размер();

    // Все записи базы для файла выполняются атомарно. Если обработка хотя бы
    // одной строки завершится ошибкой, позиция и все созданные записи откатятся.
    НачатьТранзакцию();
    Попытка

        Блокировка = Новый БлокировкаДанных;
        ЭлементБлокировки = Блокировка.Добавить(
            "РегистрСведений.ЕРП_ПозицииЧтенияЛогов");
        ЭлементБлокировки.УстановитьЗначение("ПутьКФайлу", ПутьКФайлу);
        ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
        Блокировка.Заблокировать();

        Позиция = РегистрыСведений.ЕРП_ПозицииЧтенияЛогов.СоздатьМенеджерЗаписи();
        Позиция.ПутьКФайлу = ПутьКФайлу;
        Позиция.Прочитать();

        Если Позиция.ПоследняяПозицияБайт <> ПозицияДоЧтения Тогда
            ЗафиксироватьТранзакцию();
            Возврат;
        КонецЕсли;

        Для Каждого ТекстСтроки Из ПолныеСтроки Цикл
            Для Каждого СсылкаМаски Из МаскиФайла Цикл
                Маска = СсылкаМаски.ПолучитьОбъект();
                Если Не СтрокаСоответствуетМаске(ТекстСтроки, Маска) Тогда
                    Продолжить;
                КонецЕсли;

                ДатаСобытия = ПолучитьДатуСобытия(ТекстСтроки, Маска.РегулярноеВыражениеВремени);
                ХешСобытия = ПолучитьХешСобытия(СсылкаМаски, ДатаСобытия, ТекстСтроки);

                БлокировкаХеша = Новый БлокировкаДанных;
                ЭлементБлокировкиХеша = БлокировкаХеша.Добавить(
                    "РегистрСведений.ЕРП_ОбработанныеЗаписиЛогов");
                ЭлементБлокировкиХеша.УстановитьЗначение("ХешСобытия", ХешСобытия);
                ЭлементБлокировкиХеша.Режим = РежимБлокировкиДанных.Исключительный;
                БлокировкаХеша.Заблокировать();

                ОбработаннаяЗапись = РегистрыСведений.ЕРП_ОбработанныеЗаписиЛогов.СоздатьМенеджерЗаписи();
                ОбработаннаяЗапись.ХешСобытия = ХешСобытия;
                ОбработаннаяЗапись.Прочитать();

                Если ЗначениеЗаполнено(ОбработаннаяЗапись.ДатаРегистрации) Тогда
                    Продолжить;
                КонецЕсли;

                КлючСобытия = "LOG:" + ХешСобытия;
                Тема = СформироватьТему(Маска, ДатаСобытия);
                ТекстУведомления = СформироватьТекст(Маска, ДатаСобытия, ТекстСтроки, ПутьКФайлу);

                БлокировкаСобытия = Новый БлокировкаДанных;
                ЭлементБлокировкиСобытия = БлокировкаСобытия.Добавить(
                    "РегистрСведений.ЕРП_СобытияУведомлений");
                ЭлементБлокировкиСобытия.УстановитьЗначение("КлючСобытия", КлючСобытия);
                ЭлементБлокировкиСобытия.Режим = РежимБлокировкиДанных.Исключительный;
                БлокировкаСобытия.Заблокировать();

                Событие = РегистрыСведений.ЕРП_СобытияУведомлений.СоздатьМенеджерЗаписи();
                Событие.КлючСобытия = КлючСобытия;
                Событие.Прочитать();

                Если Не ЗначениеЗаполнено(Событие.Состояние) Тогда
                    Событие.КлючСобытия = КлючСобытия;
                    Событие.ТипСобытия = "ЗаписьЖурнала";
                    Событие.UUIDНоменклатуры = "";
                    Событие.Наименование = Маска.Наименование;
                    Событие.ТекстСообщения = ТекстУведомления;
                    Событие.ДатаСоздания = ТекущаяДата();
                    Событие.Состояние = "Новая";
                    Событие.МаскаЖурнала = СсылкаМаски;
                    Событие.ПутьКФайлу = ПутьКФайлу;
                    Событие.ИмяФайла = Файл.Имя;
                    Событие.ДатаСобытия = ДатаСобытия;
                    Событие.ХешСобытия = ХешСобытия;
                    Событие.Записать();

                    КоличествоДоставок = ЕРП_ОбработкаОчередиУведомлений.СформироватьМаршрутыИДоставки(
                        КлючСобытия, СсылкаМаски, "ЗаписьЖурнала", Тема, ТекстУведомления);

                    Событие = РегистрыСведений.ЕРП_СобытияУведомлений.СоздатьМенеджерЗаписи();
                    Событие.КлючСобытия = КлючСобытия;
                    Событие.Прочитать();
                    Событие.Состояние = ?(КоличествоДоставок = 0, "БезПолучателей", "ДоставкиСозданы");
                    Событие.Записать();
                Иначе
                    // Если событие уже существует, но отметка хеша отсутствует,
                    // сначала восстанавливаем доставки из снимка маршрутов.
                    // При полном отсутствии снимка выполняется разовая миграция
                    // старого события по действующим настройкам получателей.
                    КоличествоДоставок = ЕРП_ОбработкаОчередиУведомлений.ВосстановитьДоставкиПоСобытию(
                        КлючСобытия,
                        Событие.МаскаЖурнала,
                        Событие.ТипСобытия,
                        Событие.Наименование,
                        Событие.ТекстСообщения);
                    Если Событие.Состояние = "Новая" Тогда
                        Событие.Состояние = ?(КоличествоДоставок = 0, "БезПолучателей", "ДоставкиСозданы");
                        Событие.Записать();
                    КонецЕсли;
                КонецЕсли;

                ОбработаннаяЗапись.ХешСобытия = ХешСобытия;
                ОбработаннаяЗапись.МаскаЖурнала = СсылкаМаски;
                ОбработаннаяЗапись.ДатаРегистрации = ТекущаяДата();
                ОбработаннаяЗапись.КлючСобытия = КлючСобытия;
                ОбработаннаяЗапись.Записать();
            КонецЦикла;
        КонецЦикла;

        Позиция.ПутьКФайлу = ПутьКФайлу;
        Позиция.ПоследняяПозицияБайт = НоваяПозиция;
        Позиция.РазмерФайла = РазмерФайла;
        Позиция.СигнатураНачалаФайла = НоваяСигнатура;
        Позиция.ДатаПоследнегоЧтения = ТекущаяДата();
        Позиция.ДатаМодификацииФайла = ДатаМодификации;
        Позиция.ХвостНезавершеннойСтрокиBase64 = НовыйХвостBase64;
        // Старый текстовый реквизит сохраняется для совместимости; хвост в нём
        // больше не используется, поскольку он может завершаться неполным UTF-8.
        Позиция.НезавершеннаяСтрока = "";
        Позиция.Записать();

        ЗафиксироватьТранзакцию();

    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;

КонецПроцедуры


Процедура СохранитьСбросПозицииФайла(
    ПутьКФайлу, ОжидаемаяПозиция, РазмерФайла, Сигнатура, ДатаМодификации)

    НачатьТранзакцию();
    Попытка
        Блокировка = Новый БлокировкаДанных;
        ЭлементБлокировки = Блокировка.Добавить(
            "РегистрСведений.ЕРП_ПозицииЧтенияЛогов");
        ЭлементБлокировки.УстановитьЗначение("ПутьКФайлу", ПутьКФайлу);
        ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
        Блокировка.Заблокировать();
        Позиция = РегистрыСведений.ЕРП_ПозицииЧтенияЛогов.СоздатьМенеджерЗаписи();
        Позиция.ПутьКФайлу = ПутьКФайлу;
        Позиция.Прочитать();

        Если Позиция.ПоследняяПозицияБайт <> ОжидаемаяПозиция Тогда
            ЗафиксироватьТранзакцию();
            Возврат;
        КонецЕсли;

        Позиция.ПутьКФайлу = ПутьКФайлу;
        Позиция.ПоследняяПозицияБайт = 0;
        Позиция.РазмерФайла = РазмерФайла;
        Позиция.СигнатураНачалаФайла = Сигнатура;
        Позиция.ДатаПоследнегоЧтения = ТекущаяДата();
        Позиция.ДатаМодификацииФайла = ДатаМодификации;
        Позиция.НезавершеннаяСтрока = "";
        Позиция.ХвостНезавершеннойСтрокиBase64 = "";
        Позиция.Записать();

        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;

КонецПроцедуры


Процедура ОбновитьДатуМодификацииБезЧтения(
    ПутьКФайлу, РазмерФайла, Сигнатура, ДатаМодификации)

    НачатьТранзакцию();
    Попытка
        Блокировка = Новый БлокировкаДанных;
        ЭлементБлокировки = Блокировка.Добавить(
            "РегистрСведений.ЕРП_ПозицииЧтенияЛогов");
        ЭлементБлокировки.УстановитьЗначение("ПутьКФайлу", ПутьКФайлу);
        ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
        Блокировка.Заблокировать();

        Позиция = РегистрыСведений.ЕРП_ПозицииЧтенияЛогов.СоздатьМенеджерЗаписи();
        Позиция.ПутьКФайлу = ПутьКФайлу;
        Позиция.Прочитать();

        Позиция.ПутьКФайлу = ПутьКФайлу;
        Позиция.РазмерФайла = РазмерФайла;
        Позиция.СигнатураНачалаФайла = Сигнатура;
        Позиция.ДатаМодификацииФайла = ДатаМодификации;
        Позиция.ДатаПоследнегоЧтения = ТекущаяДата();
        Позиция.Записать();

        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;

КонецПроцедуры


Функция ПрочитатьПорциюФайла(ПутьКФайлу, Смещение, Размер)

    Поток = ФайловыеПотоки.Открыть(
        ПутьКФайлу,
        РежимОткрытияФайла.Открыть,
        ДоступКФайлу.Чтение);

    Попытка
        Буфер = Новый БуферДвоичныхДанных(Размер);
        Поток.Перейти(Смещение, ПозицияВПотоке.Начало);
        Прочитано = Поток.Прочитать(Буфер, 0, Размер);
        Поток.Закрыть();

        Если Прочитано < Размер Тогда
            Буфер = Буфер.Прочитать(0, Прочитано);
        КонецЕсли;

        Возврат ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Буфер);
    Исключение
        Поток.Закрыть();
        ВызватьИсключение;
    КонецПопытки;

КонецФункции


Функция ПолучитьСигнатуруНачалаФайла(ПутьКФайлу, РазмерФайла)

    Если РазмерФайла = 0 Тогда
        Возврат "";
    КонецЕсли;

    РазмерСигнатуры = Мин(РазмерФайла, 4096);
    Данные = ПрочитатьПорциюФайла(ПутьКФайлу, 0, РазмерСигнатуры);
    Хешер = Новый ХешированиеДанных(АлгоритмХеширования.Sha256);
    Хешер.ДобавитьДанные(Данные);

    Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хешер.Результат));

КонецФункции


Функция СтрокаСоответствуетМаске(ТекстСтроки, Маска)

    Если Не ПустаяСтрока(Маска.ИсключающиеСлова) Тогда
        СловаИсключения = СтрРазделить(
            СтрЗаменить(Маска.ИсключающиеСлова, ",", ";"), ";");
        Для Каждого СловоИсключения Из СловаИсключения Цикл
            СловоИсключения = СокрЛП(СловоИсключения);
            Если Не ПустаяСтрока(СловоИсключения) Тогда
                Если Маска.УчитыватьРегистр Тогда
                    Если СтрНайти(ТекстСтроки, СловоИсключения) > 0 Тогда
                        Возврат Ложь;
                    КонецЕсли;
                ИначеЕсли СтрНайти(НРег(ТекстСтроки), НРег(СловоИсключения)) > 0 Тогда
                    Возврат Ложь;
                КонецЕсли;
            КонецЕсли;
        КонецЦикла;
    КонецЕсли;

    Шаблон = Маска.ШаблонПоиска;
    Если ПустаяСтрока(Шаблон) Тогда
        Возврат Ложь;
    КонецЕсли;

    Если Маска.ТипПоиска = "РегулярноеВыражение"
        Или Маска.ТипПоиска = "Регулярное выражение"
        Или Маска.ТипПоиска = "Regex" Тогда

        РезультатПоиска = СтрНайтиПоРегулярномуВыражению(
            ТекстСтроки, Шаблон, НаправлениеПоиска.СНачала, 1, 1,
            Не Маска.УчитыватьРегистр, Ложь);
        Возврат РезультатПоиска.НачальнаяПозиция > 0;

    ИначеЕсли Маска.ТипПоиска = "ТочноеСовпадение" Тогда
        Если Маска.УчитыватьРегистр Тогда
            Возврат ТекстСтроки = Шаблон;
        КонецЕсли;
        Возврат НРег(ТекстСтроки) = НРег(Шаблон);
    КонецЕсли;

    Если Маска.УчитыватьРегистр Тогда
        Возврат СтрНайти(ТекстСтроки, Шаблон) > 0;
    КонецЕсли;

    Возврат СтрНайти(НРег(ТекстСтроки), НРег(Шаблон)) > 0;

КонецФункции


Функция ПолучитьДатуСобытия(ТекстСтроки, РегулярноеВыражениеВремени)

    Если ПустаяСтрока(РегулярноеВыражениеВремени) Тогда
        Возврат ТекущаяДата();
    КонецЕсли;

    Попытка
        РезультатПоиска = СтрНайтиПоРегулярномуВыражению(
            ТекстСтроки, РегулярноеВыражениеВремени);
        Если РезультатПоиска.НачальнаяПозиция <= 0 Тогда
            Возврат ТекущаяДата();
        КонецЕсли;

        МеткаВремени = СокрЛП(РезультатПоиска.Значение);
        Если СтрДлина(МеткаВремени) >= 19
            И Сред(МеткаВремени, 5, 1) = "-" Тогда

            Год = Число(Лев(МеткаВремени, 4));
            Месяц = Число(Сред(МеткаВремени, 6, 2));
            День = Число(Сред(МеткаВремени, 9, 2));
            Час = Число(Сред(МеткаВремени, 12, 2));
            Минута = Число(Сред(МеткаВремени, 15, 2));
            Секунда = Число(Сред(МеткаВремени, 18, 2));
            Возврат Дата(Год, Месяц, День, Час, Минута, Секунда);

        ИначеЕсли СтрДлина(МеткаВремени) >= 19
            И Сред(МеткаВремени, 3, 1) = "." Тогда

            День = Число(Лев(МеткаВремени, 2));
            Месяц = Число(Сред(МеткаВремени, 4, 2));
            Год = Число(Сред(МеткаВремени, 7, 4));
            Час = Число(Сред(МеткаВремени, 12, 2));
            Минута = Число(Сред(МеткаВремени, 15, 2));
            Секунда = Число(Сред(МеткаВремени, 18, 2));
            Возврат Дата(Год, Месяц, День, Час, Минута, Секунда);
        КонецЕсли;

    Исключение
        // Ошибка разбора временной метки не должна терять критическое событие.
    КонецПопытки;

    Возврат ТекущаяДата();

КонецФункции


Функция ПолучитьХешСобытия(МаскаЖурнала, ДатаСобытия, ТекстСтроки)

    ДанныеДляХеширования = Строка(МаскаЖурнала.УникальныйИдентификатор())
        + Символы.ПС
        + Формат(ДатаСобытия, "ДФ=yyyy-MM-dd HH:mm:ss")
        + Символы.ПС
        + ТекстСтроки;

    Хешер = Новый ХешированиеДанных(АлгоритмХеширования.Sha256);
    Хешер.ДобавитьДанные(ПолучитьДвоичныеДанныеИзСтроки(
        ДанныеДляХеширования, КодировкаТекста.UTF8));

    Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хешер.Результат));

КонецФункции


Функция СформироватьТему(Маска, ДатаСобытия)

    Тема = Маска.ШаблонТемы;
    Если ПустаяСтрока(Тема) Тогда
        Тема = "Инцидент журнала: " + Маска.Наименование;
    КонецЕсли;

    Возврат СтрЗаменить(
        Тема,
        "{EventTime}",
        Формат(ДатаСобытия, "ДФ=dd.MM.yyyy HH:mm:ss"));

КонецФункции


Функция СформироватьТекст(Маска, ДатаСобытия, ТекстСтроки, ПутьКФайлу)

    Текст = Маска.ШаблонСообщения;
    Если ПустаяСтрока(Текст) Тогда
        Текст = "{EventTime}" + Символы.ПС
            + "Маска: " + Маска.Наименование + Символы.ПС
            + "Файл: {FilePath}" + Символы.ПС
            + "{Message}";
    КонецЕсли;

    Текст = СтрЗаменить(
        Текст, "{EventTime}",
        Формат(ДатаСобытия, "ДФ=dd.MM.yyyy HH:mm:ss"));
    Текст = СтрЗаменить(Текст, "{Message}", ТекстСтроки);
    Текст = СтрЗаменить(Текст, "{FilePath}", ПутьКФайлу);
    Текст = СтрЗаменить(Текст, "{FileName}", Новый Файл(ПутьКФайлу).Имя);

    Возврат Текст;

КонецФункции

#КонецОбласти

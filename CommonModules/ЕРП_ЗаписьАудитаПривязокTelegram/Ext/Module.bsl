////////////////////////////////////////////////////////////////////////////////
// Единственная привилегированная точка append-only записи истории Telegram.
// Открытые коды и SHA-256 хеши запросов в аудит не записываются.
////////////////////////////////////////////////////////////////////////////////

Процедура Записать(
    Сотрудник,
    ИдентификаторБота,
    ChatID,
    Операция,
    Причина,
    ИдентификаторОперацииПереноса = Неопределено,
    СтарыйИдентификаторПривязки = Неопределено,
    НовыйИдентификаторПривязки = Неопределено,
    СтарыйСотрудник = Неопределено,
    НовыйСотрудник = Неопределено,
    Результат = "Успех",
    СостояниеДо = "",
    СостояниеПосле = "",
    СтарыйChatID = "",
    НовыйChatID = "",
    ТекстОшибки = "") Экспорт

    Если Не ПривилегированныйРежим()
        И Не РольДоступна("ЕРП_УправлениеПривязкамиTelegram")
        И Не РольДоступна("ЕРП_ФоноваяОбработкаУведомлений")
        И Не РольДоступна("ЕРП_КадроваяОбработкаTelegram")
        И Не РольДоступна("АдминистраторСистемы") Тогда
        ВызватьИсключение "Недостаточно прав для регистрации события аудита Telegram-привязки.";
    КонецЕсли;

    Если Не ЗначениеЗаполнено(Сотрудник) Тогда
        ВызватьИсключение "Для записи аудита не указан сотрудник.";
    КонецЕсли;
    Если Не ЗначениеЗаполнено(ИдентификаторБота) Тогда
        ВызватьИсключение "Для записи аудита не указан идентификатор Telegram-бота.";
    КонецЕсли;

    Если Не ЗначениеЗаполнено(ChatID) Тогда ChatID = ""; КонецЕсли;
    Если Не ЗначениеЗаполнено(Причина) Тогда Причина = ""; КонецЕсли;
    Если Не ЗначениеЗаполнено(ИдентификаторОперацииПереноса) Тогда
        ИдентификаторОперацииПереноса = НулевойUUID();
    КонецЕсли;
    Если Не ЗначениеЗаполнено(СтарыйИдентификаторПривязки) Тогда
        СтарыйИдентификаторПривязки = НулевойUUID();
    КонецЕсли;
    Если Не ЗначениеЗаполнено(НовыйИдентификаторПривязки) Тогда
        НовыйИдентификаторПривязки = НулевойUUID();
    КонецЕсли;

    ФизическоеЛицо = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
        Сотрудник, "ФизическоеЛицо");
    Инициатор = Пользователи.ТекущийПользователь();

    ТранзакцияБылаАктивна = ТранзакцияАктивна();
    Если Не ТранзакцияБылаАктивна Тогда
        НачатьТранзакцию();
    КонецЕсли;

    Попытка

        Аудит = РегистрыСведений.ЕРП_ЖурналАудитаПривязокTelegram.СоздатьМенеджерЗаписи();
        Аудит.ИдентификаторСобытия = Новый УникальныйИдентификатор;
        Аудит.Сотрудник = Сотрудник;
        Аудит.ФизическоеЛицо = ФизическоеЛицо;
        Аудит.ИдентификаторБота = ИдентификаторБота;
        Аудит.ChatID = ChatID;
        Аудит.ДатаСобытия = ТекущаяДата();
        Аудит.Операция = Операция;
        Аудит.Причина = Причина;
        Аудит.Инициатор = Инициатор;
        Аудит.ИдентификаторОперацииПереноса = ИдентификаторОперацииПереноса;
        Аудит.СтарыйИдентификаторПривязки = СтарыйИдентификаторПривязки;
        Аудит.НовыйИдентификаторПривязки = НовыйИдентификаторПривязки;
        Аудит.СтарыйСотрудник = СтарыйСотрудник;
        Аудит.НовыйСотрудник = НовыйСотрудник;
        Аудит.Результат = Результат;
        Аудит.СостояниеДо = СостояниеДо;
        Аудит.СостояниеПосле = СостояниеПосле;
        Аудит.СтарыйChatID = СтарыйChatID;
        Аудит.НовыйChatID = НовыйChatID;
        Аудит.ТекстОшибки = ТекстОшибки;
        Аудит.Записать();

        Если Не ТранзакцияБылаАктивна Тогда
            ЗафиксироватьТранзакцию();
        КонецЕсли;

    Исключение

        Если Не ТранзакцияБылаАктивна Тогда
            ОтменитьТранзакцию();
        КонецЕсли;
        ВызватьИсключение;

    КонецПопытки;

КонецПроцедуры


Функция НулевойUUID()

    Возврат Новый УникальныйИдентификатор(
        "00000000-0000-0000-0000-000000000000");

КонецФункции

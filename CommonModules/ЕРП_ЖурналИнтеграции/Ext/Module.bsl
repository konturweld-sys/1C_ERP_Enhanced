
////////////////////////////////////////////////////////////////////////////////
// ОБЩИЙ МОДУЛЬ: ЕРП_ЖурналИнтеграции
//
// Назначение:
// Журналирование значимых событий переноса номенклатуры PDM → RabbitMQ → ERP.
//
// Файл:
// D:\1C Log\ERP_Nomenclature_Integration.log
//
// Файл дополняется. Предыдущие записи не удаляются.
//
// В журнал записываются:
// - INFO: реальные операции обмена;
// - ERROR: ошибки обмена и обработки;
// - STARTUP: запуск системы.
//
// Пустые циклы опроса RabbitMQ не журналируются.
////////////////////////////////////////////////////////////////////////////////



Процедура Записать(Уровень, Этап, Текст) Экспорт

	Запись = Неопределено;

	Попытка

		УровеньЖурнала = ВРег(СокрЛП(Строка(Уровень)));
		ЭтапЖурнала = ВРег(СокрЛП(Строка(Этап)));
		ТекстЖурнала = СокрЛП(Строка(Текст));

		// Не журналируем пустые циклы регламентного задания.
		Если УровеньЖурнала = "INFO" Тогда

			Если ЭтапЖурнала = "НАЧАЛО"
				Или ЭтапЖурнала = "ЗАВЕРШЕНИЕ"
				Или ЭтапЖурнала = "RABBITMQ"
				Или ЭтапЖурнала = "CONSUMER"
				Или ЭтапЖурнала = "RECEIVE" Тогда

				Возврат;

			КонецЕсли;

		КонецЕсли;

		Если ПустаяСтрока(ТекстЖурнала) Тогда
			Возврат;
		КонецЕсли;

		КаталогЖурнала = "D:\1C Log";

		ФайлКаталога = Новый Файл(КаталогЖурнала);

		Если Не ФайлКаталога.Существует() Тогда
			СоздатьКаталог(КаталогЖурнала);
		КонецЕсли;

		ПутьКФайлу =
			КаталогЖурнала
			+ "\ERP_Nomenclature_Integration.log";

		Запись = Новый ЗаписьТекста(
			ПутьКФайлу,
			КодировкаТекста.UTF8,
			Символы.ПС,
			Истина
		);

		СтрокаЖурнала =
			Формат(ТекущаяДата(), "ДФ=yyyy-MM-dd HH:mm:ss")
			+ " | "
			+ УровеньЖурнала
			+ " | "
			+ Строка(Этап)
			+ " | "
			+ ТекстЖурнала;

		Запись.ЗаписатьСтроку(СтрокаЖурнала);
		Запись.Закрыть();
		Запись = Неопределено;

	Исключение

		ТекстОшибки =
			ПодробноеПредставлениеОшибки(
				ИнформацияОбОшибке()
			);

		Если Запись <> Неопределено Тогда
			Попытка
				Запись.Закрыть();
			Исключение
			КонецПопытки;
		КонецЕсли;

		ВызватьИсключение
			"Ошибка записи журнала ERP: " + ТекстОшибки;

	КонецПопытки;

КонецПроцедуры


Функция ЕРП_ПроверитьЗаписьЖурнала() Экспорт

	Запись = Неопределено;

	КаталогЖурнала = "D:\1C Log";

	ПутьКФайлу =
		КаталогЖурнала
		+ "\ERP_Nomenclature_Integration.log";

	Попытка

		ФайлКаталога = Новый Файл(КаталогЖурнала);

		Если Не ФайлКаталога.Существует() Тогда
			СоздатьКаталог(КаталогЖурнала);
		КонецЕсли;

		ФайлКаталога = Новый Файл(КаталогЖурнала);

		Если Не ФайлКаталога.Существует() Тогда
			Возврат "ОШИБКА: каталог D:\1C Log не создан.";
		КонецЕсли;

		Запись = Новый ЗаписьТекста(
			ПутьКФайлу,
			КодировкаТекста.UTF8,
			Символы.ПС,
			Истина
		);

		Запись.ЗаписатьСтроку(
			"ПРОВЕРКА ЗАПИСИ ЖУРНАЛА: "
			+ Строка(ТекущаяДата())
		);

		Запись.Закрыть();
		Запись = Неопределено;

		ФайлЖурнала = Новый Файл(ПутьКФайлу);

		Если Не ФайлЖурнала.Существует() Тогда
			Возврат "ОШИБКА: файл после записи не найден.";
		КонецЕсли;

		Возврат
			"УСПЕХ: файл создан и доступен для записи: "
			+ ПутьКФайлу;

	Исключение

		Если Запись <> Неопределено Тогда
			Попытка
				Запись.Закрыть();
			Исключение
			КонецПопытки;
		КонецЕсли;

		Возврат
			"ОШИБКА ЗАПИСИ ЖУРНАЛА:"
			+ Символы.ПС
			+ ПодробноеПредставлениеОшибки(
				ИнформацияОбОшибке()
			);

	КонецПопытки;

КонецФункции

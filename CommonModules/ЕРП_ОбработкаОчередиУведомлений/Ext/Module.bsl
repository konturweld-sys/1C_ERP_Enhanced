////////////////////////////////////////////////////////////////////////////////
// Общий модуль ЕРП_ОбработкаОчередиУведомлений
// Атомарное формирование доставок; ограниченная выборка очереди.
// Резервирование с lease 300 секунд и UUID fencing.
// Неопределённый исход или истечение lease переводит доставку на ручную проверку.
// Для истёкшего lease сохраняется признак незавершённого вызова: ручной повтор запрещён.
// Сетевые вызовы всегда выполняются вне транзакций.
// Автоматически выполняется не более 5 попыток; вручную разрешённый повтор — одна отдельная попытка.
////////////////////////////////////////////////////////////////////////////////

Процедура ОбработатьОчередьУведомлений() Экспорт

    Настройки = ЕРП_Уведомления.ЕРП_ПолучитьНастройкиУведомлений();
    Если Не Настройки.ИспользоватьУведомления Тогда
        Возврат;
    КонецЕсли;

    // Сначала однократно восстанавливаем старые события, для которых
    // прежний генератор доставок уже удалён, затем читаем новые строки журналов.
    Попытка
        ВосстановитьСтарыеСобытияБезДоставок();
    Исключение
        ЕРП_ЖурналУведомлений.Ошибка(
            "ВОССТАНОВЛЕНИЕ ОЧЕРЕДИ",
            "Не удалось выполнить восстановление старых событий; обработка готовых доставок будет продолжена.",
            ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
    КонецПопытки;

    // Чтение журналов и создание событий, снимков маршрутов и доставок
    // выполняются до выборки очереди; запись доставки уже находится в статусе "Новая".
    Попытка
        ЕРП_ЧтениеЛоговУведомлений.ОбработатьЖурналы();
    Исключение
        ЕРП_ЖурналУведомлений.Ошибка(
            "ЧТЕНИЕ ЖУРНАЛОВ",
            "Сбой серверного цикла чтения журналов.",
            ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
    КонецПопытки;

    // За один запуск обрабатывается не более 100 готовых доставок.
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 100
    |   Доставки.КлючДоставки КАК КлючДоставки,
    |   Доставки.СледующаяПопытка КАК СледующаяПопытка,
    |   Доставки.ДатаРезервации КАК ДатаРезервации
    |ИЗ
    |   РегистрСведений.ЕРП_ДоставкиУведомлений КАК Доставки
    |ГДЕ
    |   Доставки.Состояние = &Новая
    |   ИЛИ (Доставки.Состояние = &Ожидает
    |       И Доставки.СледующаяПопытка <= &Сейчас)
    |   ИЛИ (Доставки.Состояние = &Повтор
    |       И Доставки.СледующаяПопытка <= &Сейчас)
    |   ИЛИ Доставки.Состояние = &ПовторВручную
    |   ИЛИ (Доставки.Состояние = &Обрабатывается
    |       И Доставки.СрокРезервации <= &Сейчас)
    |УПОРЯДОЧИТЬ ПО
    |   СледующаяПопытка,
    |   ДатаРезервации,
    |   КлючДоставки";
    Запрос.УстановитьПараметр("Новая", "Новая");
    Запрос.УстановитьПараметр("Ожидает", "Ожидает");
    Запрос.УстановитьПараметр("Повтор", "Повтор");
    Запрос.УстановитьПараметр("ПовторВручную", "ПовторВручную");
    Запрос.УстановитьПараметр("Обрабатывается", "Обрабатывается");
    Запрос.УстановитьПараметр("Сейчас", ТекущаяДата());

    Ключи = Новый Массив;
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        Ключи.Добавить(Выборка.КлючДоставки);
    КонецЦикла;

    Для Каждого КлючДоставки Из Ключи Цикл
        Попытка
            ОбработатьОднуДоставку(КлючДоставки);
        Исключение
            ЕРП_ЖурналУведомлений.Ошибка(
                "ОЧЕРЕДЬ ДОСТАВОК",
                "Не удалось обработать доставку; остальные элементы очереди продолжат обработку.",
                "Ключ доставки: " + КлючДоставки
                    + "; ошибка: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
        КонецПопытки;
    КонецЦикла;

КонецПроцедуры



////////////////////////////////////////////////////////////////////////////////
// Формирование неизменяемого снимка маршрутов и доставок.
// Вызывается читателем журналов внутри его транзакции регистрации события.
// Источник получателей читается только здесь; после записи снимка доставки
// обрабатываются исключительно по регистру ЕРП_МаршрутыСобытийУведомлений.
////////////////////////////////////////////////////////////////////////////////

Функция ВосстановитьДоставкиПоСобытию(
    КлючСобытия, МаскаЖурнала, ТипСобытия, Тема, ТекстСообщения) Экспорт

    КоличествоДоставок = 0;
    ЕстьМаршруты = Ложь;
    ЗапросМаршрутов = Новый Запрос;
    ЗапросМаршрутов.Текст =
    "ВЫБРАТЬ
    |   Маршруты.Сотрудник КАК Сотрудник,
    |   Маршруты.Канал КАК Канал,
    |   Маршруты.АдресПолучателя КАК АдресПолучателя,
    |   Маршруты.ИдентификаторБота КАК ИдентификаторБота
    |ИЗ
    |   РегистрСведений.ЕРП_МаршрутыСобытийУведомлений КАК Маршруты
    |ГДЕ
    |   Маршруты.КлючСобытия = &КлючСобытия";
    ЗапросМаршрутов.УстановитьПараметр("КлючСобытия", КлючСобытия);

    ВыборкаМаршрутов = ЗапросМаршрутов.Выполнить().Выбрать();
    Пока ВыборкаМаршрутов.Следующий() Цикл
        ЕстьМаршруты = Истина;
        ИдентификаторБотаМаршрута = ВыборкаМаршрутов.ИдентификаторБота;
        Если ВыборкаМаршрутов.Канал = "TELEGRAM"
            И Не ЗначениеЗаполнено(ИдентификаторБотаМаршрута) Тогда
            СтатусПривязки = ЕРП_ПривязкаTelegram.ЕРП_ПолучитьСтатусПривязкиTelegram(
                ВыборкаМаршрутов.Сотрудник
            );
            Если СтатусПривязки.ChatID = ВыборкаМаршрутов.АдресПолучателя Тогда
                ИдентификаторБотаМаршрута = СтатусПривязки.ИдентификаторБота;
            КонецЕсли;
        КонецЕсли;

        Если СоздатьМаршрутИДоставку(
            КлючСобытия,
            ВыборкаМаршрутов.Сотрудник,
            ВыборкаМаршрутов.Канал,
            ВыборкаМаршрутов.АдресПолучателя,
            Тема,
            ТекстСообщения,
            ИдентификаторБотаМаршрута) Тогда
            КоличествоДоставок = КоличествоДоставок + 1;
        КонецЕсли;
    КонецЦикла;

    Если Не ЕстьМаршруты Тогда
        // Совместимость со старыми событиями до появления регистра снимков.
        // Текущие получатели фиксируются только один раз в момент этой миграции.
        КоличествоДоставок = СформироватьМаршрутыИДоставки(
            КлючСобытия, МаскаЖурнала, ТипСобытия, Тема, ТекстСообщения);
    КонецЕсли;

    Возврат КоличествоДоставок;

КонецФункции


Процедура ВосстановитьСтарыеСобытияБезДоставок()

    ЗапросСобытий = Новый Запрос;
    ЗапросСобытий.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 100
    |   События.КлючСобытия КАК КлючСобытия
    |ИЗ
    |   РегистрСведений.ЕРП_СобытияУведомлений КАК События
    |ГДЕ
    |   События.Состояние = &Новая
    |УПОРЯДОЧИТЬ ПО
    |   События.ДатаСоздания";
    ЗапросСобытий.УстановитьПараметр("Новая", "Новая");

    ВыборкаСобытий = ЗапросСобытий.Выполнить().Выбрать();
    КлючиСобытий = Новый Массив;
    Пока ВыборкаСобытий.Следующий() Цикл
        КлючиСобытий.Добавить(ВыборкаСобытий.КлючСобытия);
    КонецЦикла;

    Для Каждого КлючСобытия Из КлючиСобытий Цикл
        НачатьТранзакцию();
        Попытка
            ЗаблокироватьСобытие(КлючСобытия);

            Событие = РегистрыСведений.ЕРП_СобытияУведомлений.СоздатьМенеджерЗаписи();
            Событие.КлючСобытия = КлючСобытия;
            Событие.Прочитать();

            Если Событие.Состояние = "Новая" Тогда
                КоличествоДоставок = ВосстановитьДоставкиПоСобытию(
                    Событие.КлючСобытия,
                    Событие.МаскаЖурнала,
                    Событие.ТипСобытия,
                    Событие.Наименование,
                    Событие.ТекстСообщения);

                Событие.Состояние = ?(КоличествоДоставок = 0, "БезПолучателей", "ДоставкиСозданы");
                Событие.Записать();
            КонецЕсли;

            ЗафиксироватьТранзакцию();
        Исключение
            ОтменитьТранзакцию();
            ЕРП_ЖурналУведомлений.Ошибка(
                "ВОССТАНОВЛЕНИЕ ДОСТАВОК",
                "Не удалось восстановить доставки старого события.",
                "Событие: " + КлючСобытия
                    + "; ошибка: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
        КонецПопытки;
    КонецЦикла;

КонецПроцедуры


Функция СформироватьМаршрутыИДоставки(
    КлючСобытия, МаскаЖурнала, ТипСобытия, Тема, ТекстСообщения) Экспорт

    Настройки = ЕРП_Уведомления.ЕРП_ПолучитьНастройкиУведомлений();
    Если Не Настройки.ИспользоватьУведомления Тогда
        Возврат 0;
    КонецЕсли;

    КоличествоДоставок = 0;

    // Для событий мониторинга маршруты строятся по назначению маски группам.
    Если ЗначениеЗаполнено(МаскаЖурнала) Тогда

        Запрос = Новый Запрос;
        Запрос.Текст =
        "ВЫБРАТЬ
        |   Назначения.ГруппаПолучателей КАК ГруппаПолучателей
        |ИЗ
        |   РегистрСведений.ЕРП_НазначениеМасокГруппам КАК Назначения
        |ГДЕ
        |   Назначения.МаскаЖурнала = &МаскаЖурнала
        |   И Назначения.Активно = ИСТИНА";
        Запрос.УстановитьПараметр("МаскаЖурнала", МаскаЖурнала);

        ВыборкаНазначений = Запрос.Выполнить().Выбрать();
        Пока ВыборкаНазначений.Следующий() Цикл

            Группа = ВыборкаНазначений.ГруппаПолучателей.ПолучитьОбъект();
            Если Не Группа.Активна Тогда
                Продолжить;
            КонецЕсли;

            Для Каждого СтрокаПолучателя Из Группа.Получатели Цикл
                Сотрудник = СтрокаПолучателя.Сотрудник;
                Если Не ЗначениеЗаполнено(Сотрудник) Тогда
                    Продолжить;
                КонецЕсли;

                НастройкиПолучателя = РегистрыСведений.ЕРП_ПолучателиУведомлений.СоздатьМенеджерЗаписи();
                НастройкиПолучателя.Сотрудник = Сотрудник;
                НастройкиПолучателя.Прочитать();

                // Для событий журналов тип уведомления задаётся самой маской
                // и назначением группы. Флаг системных ошибок здесь неприменим.
                Если Не НастройкиПолучателя.Включен Тогда
                    Продолжить;
                КонецЕсли;

                Если Настройки.ИспользоватьEmail
                    И Группа.ОтправлятьEmail
                    И НастройкиПолучателя.EmailВключен Тогда

                    EmailСотрудника = ПолучитьEmailСотрудника(Сотрудник);
                    Если ЗначениеЗаполнено(EmailСотрудника)
                        И СоздатьМаршрутИДоставку(
                            КлючСобытия, Сотрудник, "EMAIL", EmailСотрудника,
                            Тема, ТекстСообщения) Тогда
                        КоличествоДоставок = КоличествоДоставок + 1;
                    КонецЕсли;
                КонецЕсли;

                Если Настройки.ИспользоватьTelegram
                    И Группа.ОтправлятьTelegram
                    И НастройкиПолучателя.TelegramВключен Тогда

                    СтатусПривязкиTelegram =
                        ЕРП_ПривязкаTelegram.ЕРП_ПолучитьСтатусПривязкиTelegram(Сотрудник);
                    ChatIDTelegram = СтатусПривязкиTelegram.ChatID;

                    Если ЗначениеЗаполнено(ChatIDTelegram)
                        И СоздатьМаршрутИДоставку(
                            КлючСобытия, Сотрудник, "TELEGRAM", ChatIDTelegram,
                            Тема, ТекстСообщения,
                            СтатусПривязкиTelegram.ИдентификаторБота) Тогда
                        КоличествоДоставок = КоличествоДоставок + 1;
                    КонецЕсли;
                КонецЕсли;
            КонецЦикла;
        КонецЦикла;

        Возврат КоличествоДоставок;
    КонецЕсли;

    // Для прежних системных событий (создание номенклатуры и RabbitMQ)
    // фиксируем получателей непосредственно при регистрации события.
    Получатели = РегистрыСведений.ЕРП_ПолучателиУведомлений.Выбрать();
    Пока Получатели.Следующий() Цикл

        Если Не Получатели.Включен Тогда
            Продолжить;
        КонецЕсли;

        Уведомлять = Ложь;
        Если ТипСобытия = "УспешноСоздано" Тогда
            Уведомлять = Получатели.УведомлятьОбУспехе;
        ИначеЕсли ТипСобытия = "ОшибкаДвухПопыток" Тогда
            Уведомлять = Получатели.УведомлятьОбОшибке;
        ИначеЕсли ТипСобытия = "RabbitMQНедоступен"
            Или ТипСобытия = "RabbitMQВосстановлен" Тогда
            Уведомлять = Получатели.УведомлятьОСвязи;
        КонецЕсли;

        Если Не Уведомлять Тогда
            Продолжить;
        КонецЕсли;

        Если Настройки.ИспользоватьEmail И Получатели.EmailВключен Тогда
            EmailСотрудника = ПолучитьEmailСотрудника(Получатели.Сотрудник);
            Если ЗначениеЗаполнено(EmailСотрудника)
                И СоздатьМаршрутИДоставку(
                    КлючСобытия, Получатели.Сотрудник, "EMAIL", EmailСотрудника,
                    Тема, ТекстСообщения) Тогда
                КоличествоДоставок = КоличествоДоставок + 1;
            КонецЕсли;
        КонецЕсли;

        Если Настройки.ИспользоватьTelegram И Получатели.TelegramВключен Тогда
            СтатусПривязкиTelegram =
                ЕРП_ПривязкаTelegram.ЕРП_ПолучитьСтатусПривязкиTelegram(Получатели.Сотрудник);
            ChatIDTelegram = СтатусПривязкиTelegram.ChatID;

            Если ЗначениеЗаполнено(ChatIDTelegram)
                И СоздатьМаршрутИДоставку(
                    КлючСобытия, Получатели.Сотрудник, "TELEGRAM", ChatIDTelegram,
                    Тема, ТекстСообщения,
                    СтатусПривязкиTelegram.ИдентификаторБота) Тогда
                КоличествоДоставок = КоличествоДоставок + 1;
            КонецЕсли;
        КонецЕсли;

    КонецЦикла;

    Возврат КоличествоДоставок;

КонецФункции


Функция СоздатьМаршрутИДоставку(
    КлючСобытия, Сотрудник, Канал, АдресПолучателя, Тема, ТекстСообщения,
    ИдентификаторБота = Неопределено)

    Если Не ЗначениеЗаполнено(Сотрудник)
        Или Не ЗначениеЗаполнено(АдресПолучателя) Тогда
        Возврат Ложь;
    КонецЕсли;

    Маршрут = РегистрыСведений.ЕРП_МаршрутыСобытийУведомлений.СоздатьМенеджерЗаписи();
    Маршрут.КлючСобытия = КлючСобытия;
    Маршрут.Сотрудник = Сотрудник;
    Маршрут.Канал = Канал;
    Маршрут.Прочитать();

    Если Не ЗначениеЗаполнено(Маршрут.АдресПолучателя) Тогда
        Если СтрДлина(АдресПолучателя) > 250 Тогда
            ЕРП_ЖурналУведомлений.Ошибка(
                "МАРШРУТ УВЕДОМЛЕНИЯ",
                "Адрес получателя превышает допустимую длину 250 символов.",
                "Событие: " + КлючСобытия
                    + "; сотрудник: " + Строка(Сотрудник)
                    + "; канал: " + Канал
                    + "; длина адреса: " + Строка(СтрДлина(АдресПолучателя)));
            Возврат Ложь;
        КонецЕсли;

        Маршрут.КлючСобытия = КлючСобытия;
        Маршрут.Сотрудник = Сотрудник;
        Маршрут.Канал = Канал;
        Маршрут.АдресПолучателя = АдресПолучателя;
        Если Канал = "TELEGRAM"
            И ЗначениеЗаполнено(ИдентификаторБота) Тогда
            Маршрут.ИдентификаторБота = ИдентификаторБота;
        КонецЕсли;
        Маршрут.ДатаФиксации = ТекущаяДата();
        Маршрут.Записать();

        Маршрут = РегистрыСведений.ЕРП_МаршрутыСобытийУведомлений.СоздатьМенеджерЗаписи();
        Маршрут.КлючСобытия = КлючСобытия;
        Маршрут.Сотрудник = Сотрудник;
        Маршрут.Канал = Канал;
        Маршрут.Прочитать();
    КонецЕсли;

    // Сохраняем идентификатор бота в снимке маршрута.
    // Существующий непустой UUID не заменяем текущей привязкой.
    Если Канал = "TELEGRAM"
        И Не ЗначениеЗаполнено(Маршрут.ИдентификаторБота) Тогда
        Если Не ЗначениеЗаполнено(ИдентификаторБота) Тогда
            ЕРП_ЖурналУведомлений.Ошибка(
                "МАРШРУТ УВЕДОМЛЕНИЯ",
                "Нельзя восстановить Telegram-маршрут: отсутствует идентификатор бота привязки.",
                "Событие: " + КлючСобытия
                    + "; сотрудник: " + Строка(Сотрудник)
                    + "; Chat ID: " + АдресПолучателя
            );
            Возврат Ложь;
        КонецЕсли;
        Маршрут.ИдентификаторБота = ИдентификаторБота;
        Маршрут.Записать();
    КонецЕсли;

    Если СтрДлина(Маршрут.АдресПолучателя) > 250 Тогда
        ЕРП_ЖурналУведомлений.Ошибка(
            "МАРШРУТ УВЕДОМЛЕНИЯ",
            "Сохранённый адрес маршрута превышает допустимую длину 250 символов.",
            "Событие: " + КлючСобытия
                + "; сотрудник: " + Строка(Сотрудник)
                + "; канал: " + Канал
                + "; длина адреса: " + Строка(СтрДлина(Маршрут.АдресПолучателя)));
        Возврат Ложь;
    КонецЕсли;

    КлючДоставки = КлючСобытия + "|"
        + Строка(Маршрут.Сотрудник.УникальныйИдентификатор())
        + "|" + Маршрут.Канал;

    Доставка = РегистрыСведений.ЕРП_ДоставкиУведомлений.СоздатьМенеджерЗаписи();
    Доставка.КлючДоставки = КлючДоставки;
    Доставка.Прочитать();

    // Уже существующая доставка считается восстановленной: её статус и данные
    // не перезаписываются, включая отправленные и находящиеся в повторе.
    Если ЗначениеЗаполнено(Доставка.Состояние) Тогда
        Если Доставка.Канал = "TELEGRAM"
            И Не ЗначениеЗаполнено(Доставка.ИдентификаторБота)
            И ЗначениеЗаполнено(Маршрут.ИдентификаторБота)
            И (Доставка.Состояние = "Новая"
                Или Доставка.Состояние = "Повтор") Тогда
            Доставка.ИдентификаторБота = Маршрут.ИдентификаторБота;
            Доставка.Записать();
        КонецЕсли;
        Возврат Истина;
    КонецЕсли;

    Доставка.КлючДоставки = КлючДоставки;
    Доставка.КлючСобытия = Маршрут.КлючСобытия;
    Доставка.Сотрудник = Маршрут.Сотрудник;
    Доставка.Канал = Маршрут.Канал;
    Доставка.АдресПолучателя = Маршрут.АдресПолучателя;
    Если Доставка.Канал = "TELEGRAM" Тогда
        Доставка.ИдентификаторБота = Маршрут.ИдентификаторБота;
    КонецЕсли;
    Доставка.Тема = Лев(Тема, 250);
    Доставка.ТекстСообщения = ТекстСообщения;
    Доставка.Состояние = "Новая";
    Доставка.КоличествоПопыток = 0;
    Доставка.СледующаяПопытка = Дата(1, 1, 1);
    Доставка.ИдентификаторРезервации =
        Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");
    Доставка.ДатаРезервации = Дата(1, 1, 1);
    Доставка.СрокРезервации = Дата(1, 1, 1);
    Доставка.Записать();

    Возврат Истина;

КонецФункции


Процедура ЗаблокироватьСобытие(КлючСобытия)

    БлокировкаДанных = Новый БлокировкаДанных;
    ЭлементБлокировки = БлокировкаДанных.Добавить(
        "РегистрСведений.ЕРП_СобытияУведомлений"
    );
    ЭлементБлокировки.УстановитьЗначение("КлючСобытия", КлючСобытия);
    ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
    БлокировкаДанных.Заблокировать();

КонецПроцедуры


Функция ПолучитьEmailСотрудника(Сотрудник)

    Если Не ЗначениеЗаполнено(Сотрудник) Тогда
        Возврат "";
    КонецЕсли;

    ФизическоеЛицо = Сотрудник.ФизическоеЛицо;
    Если Не ЗначениеЗаполнено(ФизическоеЛицо) Тогда
        Возврат "";
    КонецЕсли;

    // Пользователь определяется по физическому лицу сотрудника.
    // При нескольких активных учетных записях учитываются все уникальные Email.
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |   Пользователи.Ссылка КАК Пользователь
    |ИЗ
    |   Справочник.Пользователи КАК Пользователи
    |ГДЕ
    |   Пользователи.ФизическоеЛицо = &ФизическоеЛицо
    |   И Пользователи.ПометкаУдаления = ЛОЖЬ
    |   И Пользователи.Недействителен = ЛОЖЬ";
    Запрос.УстановитьПараметр("ФизическоеЛицо", ФизическоеЛицо);

    УникальныеАдреса = Новый Массив;
    ВыборкаПользователей = Запрос.Выполнить().Выбрать();

    Пока ВыборкаПользователей.Следующий() Цикл

        КонтактнаяИнформация = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
            ВыборкаПользователей.Пользователь,
            Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты
        );

        Для Каждого СтрокаКонтактнойИнформации Из КонтактнаяИнформация Цикл

            АдресЭП = СокрЛП(СтрокаКонтактнойИнформации.АдресЭП);
            Если Не ЗначениеЗаполнено(АдресЭП) Тогда
                Продолжить;
            КонецЕсли;

            КлючАдреса = НРег(АдресЭП);
            АдресУжеДобавлен = Ложь;

            Для Каждого СуществующийАдрес Из УникальныеАдреса Цикл
                Если НРег(СуществующийАдрес) = КлючАдреса Тогда
                    АдресУжеДобавлен = Истина;
                    Прервать;
                КонецЕсли;
            КонецЦикла;

            Если Не АдресУжеДобавлен Тогда
                УникальныеАдреса.Добавить(АдресЭП);
            КонецЕсли;

        КонецЦикла;

    КонецЦикла;

    // Отсутствие Email или несколько различных адресов не создают Email-доставку.
    Если УникальныеАдреса.Количество() = 1 Тогда
        Возврат УникальныеАдреса[0];
    КонецЕсли;

    Возврат "";

КонецФункции


Процедура ОбработатьОднуДоставку(КлючДоставки)

    ПараметрыРезервации = ЗарезервироватьДоставку(КлючДоставки);
    Если ПараметрыРезервации = Неопределено Тогда
        Возврат;
    КонецЕсли;

    ЕРП_ЖурналУведомлений.Информация(
        "ДОСТАВКА",
        "Начата попытка отправки уведомления.",
        "Ключ доставки: " + КлючДоставки
            + "; попытка: " + Строка(ПараметрыРезервации.НомерПопытки)
            + "; канал: " + ПараметрыРезервации.ПараметрыДоставки.Канал
    );

    // Сетевой вызов выполняется после фиксации транзакции резервирования.
    // Любое исключение преобразуется в результат доставки, чтобы корректно
    // освободить lease и сохранить историю текущей попытки.
    Попытка
        РезультатОтправки = ЕРП_Уведомления.ОтправитьДоставкуУведомления(
            ПараметрыРезервации.ПараметрыДоставки
        );
    Исключение
        РезультатОтправки = Новый Структура(
            "Успех, ОписаниеОшибки, RetryAfter, РезультатНеопределен",
            Ложь,
            ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()),
            0,
            Истина
        );
    КонецПопытки;

    // Результат записывается отдельной транзакцией только при совпадении UUID.
    ЗафиксироватьРезультатДоставки(
        КлючДоставки,
        ПараметрыРезервации.ИдентификаторРезервации,
        ПараметрыРезервации.НомерПопытки,
        РезультатОтправки,
        ПараметрыРезервации.РучнаяПопытка
    );

КонецПроцедуры


Функция ЗарезервироватьДоставку(КлючДоставки)

    Результат = Неопределено;

    ПредварительнаяЗапись = РегистрыСведений.ЕРП_ДоставкиУведомлений.СоздатьМенеджерЗаписи();
    ПредварительнаяЗапись.КлючДоставки = КлючДоставки;
    ПредварительнаяЗапись.Прочитать();
    КлючСобытия = ПредварительнаяЗапись.КлючСобытия;

    НачатьТранзакцию();
    Попытка
        // Единый порядок блокировок: событие, затем конкретная доставка.
        Если ЗначениеЗаполнено(КлючСобытия) Тогда
            ЗаблокироватьСобытие(КлючСобытия);
        КонецЕсли;
        ЗаблокироватьДоставку(КлючДоставки);

        Менеджер = РегистрыСведений.ЕРП_ДоставкиУведомлений.СоздатьМенеджерЗаписи();
        Менеджер.КлючДоставки = КлючДоставки;
        Менеджер.Прочитать();

        Сейчас = ТекущаяДата();
        МожноРезервировать = Ложь;

        Если Менеджер.Состояние = "Новая"
            Или Менеджер.Состояние = "Ожидает"
            Или Менеджер.Состояние = "Повтор" Тогда
            МожноРезервировать =
                Не ЗначениеЗаполнено(Менеджер.СледующаяПопытка)
                Или Менеджер.СледующаяПопытка <= Сейчас;
        ИначеЕсли Менеджер.Состояние = "ПовторВручную" Тогда
            МожноРезервировать = Истина;
        ИначеЕсли Менеджер.Состояние = "Обрабатывается"
            И (Не ЗначениеЗаполнено(Менеджер.СрокРезервации)
                Или Менеджер.СрокРезервации <= Сейчас) Тогда
            МожноРезервировать = Истина;
        КонецЕсли;

        Если Не МожноРезервировать Тогда
            ЗафиксироватьТранзакцию();
            Возврат Неопределено;
        КонецЕсли;

        // Истечение lease не доказывает, что внешний сервис не принял сообщение.
        // Поэтому повторная отправка запрещена до ручной проверки результата.
        Если Менеджер.Состояние = "Обрабатывается" Тогда
            ОписаниеНеопределенногоРезультата =
                "Срок резервирования истёк; внешний сервис мог принять сообщение. "
                + "Автоматический повтор запрещён до проверки результата.";

            Менеджер.Состояние = "ТребуетПроверки";
            Менеджер.ПоследняяОшибка = ОписаниеНеопределенногоРезультата;
            Менеджер.СледующаяПопытка = Дата(1, 1, 1);
            Менеджер.ИдентификаторРезервации =
                Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");

            // ДатаРезервации намеренно сохраняется как признак того,
            // что внешний вызов мог остаться активным после истечения lease.
            // СрокРезервации сохраняем для аудита первоначального lease.
            Менеджер.Записать();

            ЗаписатьИсториюЕслиОтсутствует(
                КлючДоставки,
                Менеджер.КоличествоПопыток,
                "НеопределённыйРезультат",
                ОписаниеНеопределенногоРезультата
            );

            Если ЗначениеЗаполнено(Менеджер.КлючСобытия) Тогда
                ОбновитьСостояниеСобытияПодБлокировкой(Менеджер.КлючСобытия);
            КонецЕсли;

            ЗафиксироватьТранзакцию();

            ЕРП_ЖурналУведомлений.Предупреждение(
                "ДОСТАВКА",
                "Доставка переведена на ручную проверку; автоматический повтор не выполняется.",
                "Ключ доставки: " + КлючДоставки
            );
            Возврат Неопределено;
        КонецЕсли;

        РучнаяПопытка = Менеджер.Состояние = "ПовторВручную";

        Если Менеджер.КоличествоПопыток >= 5
            И Не РучнаяПопытка Тогда
            Менеджер.Состояние = "ОкончательнаяОшибка";
            Менеджер.СледующаяПопытка = Дата(1, 1, 1);
            Менеджер.ПоследняяОшибка =
                "Достигнут предел количества попыток отправки.";
            Менеджер.ИдентификаторРезервации =
                Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");
            Менеджер.ДатаРезервации = Дата(1, 1, 1);
            Менеджер.СрокРезервации = Дата(1, 1, 1);
            Менеджер.Записать();

            Если ЗначениеЗаполнено(Менеджер.КлючСобытия) Тогда
                ОбновитьСостояниеСобытияПодБлокировкой(Менеджер.КлючСобытия);
            КонецЕсли;

            ЗаписатьИсториюЕслиОтсутствует(
                КлючДоставки,
                Менеджер.КоличествоПопыток,
                "ОкончательнаяОшибка",
                Менеджер.ПоследняяОшибка
            );
            ЗафиксироватьТранзакцию();

            ЕРП_ЖурналУведомлений.Ошибка(
                "ДОСТАВКА",
                "Достигнут предел количества попыток отправки.",
                "Ключ доставки: " + КлючДоставки
            );
            Возврат Неопределено;
        КонецЕсли;

        НовыйUUID = Новый УникальныйИдентификатор;
        НомерПопытки = Менеджер.КоличествоПопыток + 1;
        Менеджер.КоличествоПопыток = НомерПопытки;
        Менеджер.ИдентификаторРезервации = НовыйUUID;
        Менеджер.ДатаРезервации = Сейчас;
        Менеджер.СрокРезервации = Сейчас + 300;
        Менеджер.Состояние = "Обрабатывается";
        Менеджер.СледующаяПопытка = Дата(1, 1, 1);
        Менеджер.Записать();

        ПараметрыДоставки = Новый Структура(
            "Канал, АдресПолучателя, Тема, ТекстСообщения, ИдентификаторБота",
            Менеджер.Канал,
            Менеджер.АдресПолучателя,
            Менеджер.Тема,
            Менеджер.ТекстСообщения,
            Менеджер.ИдентификаторБота
        );
        Результат = Новый Структура(
            "ИдентификаторРезервации, НомерПопытки, ПараметрыДоставки, РучнаяПопытка",
            НовыйUUID, НомерПопытки, ПараметрыДоставки, РучнаяПопытка
        );

        Если ЗначениеЗаполнено(Менеджер.КлючСобытия) Тогда
            ОбновитьСостояниеСобытияПодБлокировкой(Менеджер.КлючСобытия);
        КонецЕсли;

        ЗафиксироватьТранзакцию();

    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;

    Возврат Результат;

КонецФункции


Процедура ЗафиксироватьРезультатДоставки(
    КлючДоставки, UUIDРезервации, НомерПопытки, РезультатОтправки, РучнаяПопытка = Ложь)

    ПредварительнаяЗапись = РегистрыСведений.ЕРП_ДоставкиУведомлений.СоздатьМенеджерЗаписи();
    ПредварительнаяЗапись.КлючДоставки = КлючДоставки;
    ПредварительнаяЗапись.Прочитать();
    КлючСобытия = ПредварительнаяЗапись.КлючСобытия;

    НачатьТранзакцию();
    Попытка
        Если ЗначениеЗаполнено(КлючСобытия) Тогда
            ЗаблокироватьСобытие(КлючСобытия);
        КонецЕсли;
        ЗаблокироватьДоставку(КлючДоставки);

        Менеджер = РегистрыСведений.ЕРП_ДоставкиУведомлений.СоздатьМенеджерЗаписи();
        Менеджер.КлючДоставки = КлючДоставки;
        Менеджер.Прочитать();

        // Fencing: устаревший обработчик не меняет ни доставку, ни историю.
        Если Менеджер.ИдентификаторРезервации <> UUIDРезервации Тогда
            ЗафиксироватьТранзакцию();
            Возврат;
        КонецЕсли;

        ОписаниеОшибкиПопытки = РезультатОтправки.ОписаниеОшибки;
        Если РезультатОтправки.РезультатНеопределен
            И Не ЗначениеЗаполнено(ОписаниеОшибкиПопытки) Тогда
            ОписаниеОшибкиПопытки =
                "Внешний сервис не предоставил достоверный результат отправки.";
        КонецЕсли;

        Если РезультатОтправки.РезультатНеопределен Тогда
            Менеджер.Состояние = "ТребуетПроверки";
            Менеджер.ПоследняяОшибка = ОписаниеОшибкиПопытки;
            Менеджер.СледующаяПопытка = Дата(1, 1, 1);
        ИначеЕсли РезультатОтправки.Успех Тогда
            Менеджер.Состояние = "Отправлено";
            Менеджер.ДатаОтправки = ТекущаяДата();
            Менеджер.ПоследняяОшибка = "";
            Менеджер.СледующаяПопытка = Дата(1, 1, 1);
        Иначе
            Менеджер.ПоследняяОшибка = ОписаниеОшибкиПопытки;
            Если НомерПопытки >= 5 Или РучнаяПопытка Тогда
                Менеджер.Состояние = "ОкончательнаяОшибка";
                Менеджер.СледующаяПопытка = Дата(1, 1, 1);
            Иначе
                Менеджер.Состояние = "Повтор";
                Если РезультатОтправки.RetryAfter > 0 Тогда
                    Задержка = Мин(РезультатОтправки.RetryAfter, 86400);
                Иначе
                    Задержка = ИнтервалПовтораСекунд(НомерПопытки);
                КонецЕсли;
                Менеджер.СледующаяПопытка = ТекущаяДата() + Задержка;
            КонецЕсли;
        КонецЕсли;

        Менеджер.ИдентификаторРезервации =
            Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");
        Менеджер.ДатаРезервации = Дата(1, 1, 1);
        Менеджер.СрокРезервации = Дата(1, 1, 1);
        Менеджер.Записать();

        ЗаписатьИсторию(
            КлючДоставки,
            НомерПопытки,
            ?(РезультатОтправки.РезультатНеопределен,
                "НеопределённыйРезультат",
                ?(РезультатОтправки.Успех, "Отправлено", "Ошибка")),
            ОписаниеОшибкиПопытки
        );

        Если ЗначениеЗаполнено(Менеджер.КлючСобытия) Тогда
            ОбновитьСостояниеСобытияПодБлокировкой(Менеджер.КлючСобытия);
        КонецЕсли;

        ЗафиксироватьТранзакцию();

    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;

КонецПроцедуры




////////////////////////////////////////////////////////////////////////////////
// Ручная обработка неопределённых результатов.
// Номер попытки 0 зарезервирован в истории исключительно для ручного решения.
////////////////////////////////////////////////////////////////////////////////

Функция ПолучитьДоставкуТребующуюПроверки(ПослеКлюча = "") Экспорт

    Если Не РольДоступна("ЕРП_УправлениеДоставками") Тогда
        ВызватьИсключение "Недостаточно прав для просмотра доставок, требующих проверки.";
    КонецЕсли;

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |   Доставки.КлючДоставки КАК КлючДоставки,
    |   Доставки.КлючСобытия КАК КлючСобытия,
    |   Доставки.Сотрудник КАК Сотрудник,
    |   Доставки.Канал КАК Канал,
    |   Доставки.АдресПолучателя КАК АдресПолучателя,
    |   Доставки.Тема КАК Тема,
    |   Доставки.ТекстСообщения КАК ТекстСообщения,
    |   Доставки.КоличествоПопыток КАК КоличествоПопыток,
    |   Доставки.ПоследняяОшибка КАК ПоследняяОшибка
    |ИЗ
    |   РегистрСведений.ЕРП_ДоставкиУведомлений КАК Доставки
    |ГДЕ
    |   Доставки.Состояние = &ТребуетПроверки
    |   И Доставки.КлючДоставки > &ПослеКлюча
    |УПОРЯДОЧИТЬ ПО
    |   Доставки.КлючДоставки";
    Запрос.УстановитьПараметр("ТребуетПроверки", "ТребуетПроверки");
    Запрос.УстановитьПараметр("ПослеКлюча", ПослеКлюча);

    Выборка = Запрос.Выполнить().Выбрать();
    Если Не Выборка.Следующий() Тогда
        Запрос.УстановитьПараметр("ПослеКлюча", "");
        Выборка = Запрос.Выполнить().Выбрать();
        Если Не Выборка.Следующий() Тогда
            Возврат Новый Структура("Найдено", Ложь);
        КонецЕсли;
    КонецЕсли;

    Возврат Новый Структура(
        "Найдено,КлючДоставки,КлючСобытия,Сотрудник,Канал,АдресПолучателя,Тема,ТекстСообщения,КоличествоПопыток,ПоследняяОшибка",
        Истина,
        Выборка.КлючДоставки,
        Выборка.КлючСобытия,
        Строка(Выборка.Сотрудник),
        Выборка.Канал,
        Выборка.АдресПолучателя,
        Выборка.Тема,
        Выборка.ТекстСообщения,
        Выборка.КоличествоПопыток,
        Выборка.ПоследняяОшибка
    );

КонецФункции


Процедура ПрименитьРучноеРешениеПоДоставке(КлючДоставки, Решение, Комментарий) Экспорт

    Если Не РольДоступна("ЕРП_УправлениеДоставками") Тогда
        ВызватьИсключение "Недостаточно прав для изменения состояния доставки.";
    КонецЕсли;

    Комментарий = СокрЛП(Комментарий);
    Если ПустаяСтрока(Комментарий) Тогда
        ВызватьИсключение "Для ручного решения необходимо указать комментарий.";
    КонецЕсли;

    Если Решение <> "ПодтвердитьОтправку"
        И Решение <> "РазрешитьОднократныйПовтор" Тогда
        ВызватьИсключение "Неизвестный вариант ручного решения.";
    КонецЕсли;

    ПредварительнаяЗапись = РегистрыСведений.ЕРП_ДоставкиУведомлений.СоздатьМенеджерЗаписи();
    ПредварительнаяЗапись.КлючДоставки = КлючДоставки;
    ПредварительнаяЗапись.Прочитать();
    КлючСобытия = ПредварительнаяЗапись.КлючСобытия;

    НачатьТранзакцию();
    Попытка
        Если ЗначениеЗаполнено(КлючСобытия) Тогда
            ЗаблокироватьСобытие(КлючСобытия);
        КонецЕсли;
        ЗаблокироватьДоставку(КлючДоставки);

        Доставка = РегистрыСведений.ЕРП_ДоставкиУведомлений.СоздатьМенеджерЗаписи();
        Доставка.КлючДоставки = КлючДоставки;
        Доставка.Прочитать();

        Если Доставка.Состояние <> "ТребуетПроверки" Тогда
            ВызватьИсключение "Доставка уже обработана или её состояние изменилось. Обновите список.";
        КонецЕсли;

        // Если дата резервации сохранена, доставка попала на ручную проверку
        // именно из-за истечения lease. Исходный внешний вызов мог ещё выполняться
        // в момент проверки; разрешать параллельный повтор небезопасно.
        // Для таких записей допускается только подтверждение уже выполненной отправки.
        Если Решение = "РазрешитьОднократныйПовтор"
            И ЗначениеЗаполнено(Доставка.ДатаРезервации) Тогда
            ВызватьИсключение
                "Повтор запрещён: срок резервации истёк во время незавершённой отправки. "
                + "Внешний вызов мог ещё выполняться. Подтвердите отправку после проверки "
                + "результата у получателя либо оставьте доставку без повторной отправки.";
        КонецЕсли;

        История = РегистрыСведений.ЕРП_ИсторияДоставкиУведомлений.СоздатьМенеджерЗаписи();
        История.КлючДоставки = КлючДоставки;
        История.НомерПопытки = 0;
        История.Прочитать();

        Если ЗначениеЗаполнено(История.Результат)
            И История.Результат <> "РучныеРешения" Тогда
            ВызватьИсключение "В истории уже имеется несовместимая запись ручного решения.";
        КонецЕсли;

        Если Решение = "ПодтвердитьОтправку" Тогда
            Доставка.Состояние = "Отправлено";
            Доставка.ДатаОтправки = ТекущаяДата();
            Доставка.ПоследняяОшибка = "";
            Доставка.СледующаяПопытка = Дата(1, 1, 1);
        Иначе
            Доставка.Состояние = "ПовторВручную";
            Доставка.СледующаяПопытка = ТекущаяДата();
        КонецЕсли;

        Доставка.ИдентификаторРезервации =
            Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");
        Доставка.ДатаРезервации = Дата(1, 1, 1);
        Доставка.СрокРезервации = Дата(1, 1, 1);
        Доставка.Записать();

        ТекстРешения =
            "Дата: " + Строка(ТекущаяДата())
            + "; пользователь: " + ПользователиИнформационнойБазы.ТекущийПользователь().Имя
            + "; решение: " + Решение
            + "; комментарий: " + Комментарий;

        История.КлючДоставки = КлючДоставки;
        История.НомерПопытки = 0;
        История.ДатаПопытки = ТекущаяДата();
        Если ПустаяСтрока(История.Результат) Тогда
            История.Результат = "РучныеРешения";
            История.Ошибка = ТекстРешения;
        Иначе
            История.Ошибка = История.Ошибка + Символы.ПС
                + "---" + Символы.ПС + ТекстРешения;
        КонецЕсли;
        История.Записать();

        Если ЗначениеЗаполнено(Доставка.КлючСобытия) Тогда
            ОбновитьСостояниеСобытияПодБлокировкой(Доставка.КлючСобытия);
        КонецЕсли;

        ЗафиксироватьТранзакцию();

    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;

КонецПроцедуры


Процедура ЗаблокироватьДоставку(КлючДоставки)

    БлокировкаДанных = Новый БлокировкаДанных;
    ЭлементБлокировки = БлокировкаДанных.Добавить(
        "РегистрСведений.ЕРП_ДоставкиУведомлений"
    );
    ЭлементБлокировки.УстановитьЗначение("КлючДоставки", КлючДоставки);
    ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
    БлокировкаДанных.Заблокировать();

КонецПроцедуры

Процедура ОбновитьСостояниеСобытияПодБлокировкой(КлючСобытия)

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |   Доставки.Состояние КАК Состояние
    |ИЗ
    |   РегистрСведений.ЕРП_ДоставкиУведомлений КАК Доставки
    |ГДЕ
    |   Доставки.КлючСобытия = &КлючСобытия";
    Запрос.УстановитьПараметр("КлючСобытия", КлючСобытия);

    КоличествоДоставок = 0;
    ВсеОтправлены = Истина;
    ВсеТерминальны = Истина;
    ЕстьОкончательныеОшибки = Ложь;
    ЕстьНеопределенныеРезультаты = Ложь;

    ВыборкаДоставок = Запрос.Выполнить().Выбрать();
    Пока ВыборкаДоставок.Следующий() Цикл
        КоличествоДоставок = КоличествоДоставок + 1;

        Если ВыборкаДоставок.Состояние <> "Отправлено" Тогда
            ВсеОтправлены = Ложь;
        КонецЕсли;

        Если ВыборкаДоставок.Состояние = "ОкончательнаяОшибка" Тогда
            ЕстьОкончательныеОшибки = Истина;
        ИначеЕсли ВыборкаДоставок.Состояние = "ТребуетПроверки" Тогда
            ЕстьНеопределенныеРезультаты = Истина;
        ИначеЕсли ВыборкаДоставок.Состояние <> "Отправлено" Тогда
            ВсеТерминальны = Ложь;
        КонецЕсли;
    КонецЦикла;

    Событие = РегистрыСведений.ЕРП_СобытияУведомлений.СоздатьМенеджерЗаписи();
    Событие.КлючСобытия = КлючСобытия;
    Событие.Прочитать();

    Если КоличествоДоставок = 0 Тогда
        Событие.Состояние = "БезПолучателей";
    ИначеЕсли ВсеОтправлены Тогда
        Событие.Состояние = "Завершено";
    ИначеЕсли ВсеТерминальны И ЕстьНеопределенныеРезультаты Тогда
        Событие.Состояние = "ТребуетПроверки";
    ИначеЕсли ВсеТерминальны И ЕстьОкончательныеОшибки Тогда
        Событие.Состояние = "ЗавершеноСОшибками";
    Иначе
        Событие.Состояние = "Выполняется";
    КонецЕсли;

    Событие.Записать();

КонецПроцедуры



Функция ИнтервалПовтораСекунд(НомерПопытки)

    Если НомерПопытки = 1 Тогда
        Возврат 60;
    ИначеЕсли НомерПопытки = 2 Тогда
        Возврат 300;
    ИначеЕсли НомерПопытки = 3 Тогда
        Возврат 900;
    ИначеЕсли НомерПопытки = 4 Тогда
        Возврат 3600;
    КонецЕсли;

    Возврат 10800;

КонецФункции


Процедура ЗаписатьИсториюЕслиОтсутствует(
    КлючДоставки, НомерПопытки, Результат, Ошибка)

    История = РегистрыСведений.ЕРП_ИсторияДоставкиУведомлений.СоздатьМенеджерЗаписи();
    История.КлючДоставки = КлючДоставки;
    История.НомерПопытки = НомерПопытки;
    История.Прочитать();

    Если ЗначениеЗаполнено(История.Результат) Тогда
        Возврат;
    КонецЕсли;

    История.КлючДоставки = КлючДоставки;
    История.НомерПопытки = НомерПопытки;
    История.ДатаПопытки = ТекущаяДата();
    История.Результат = Результат;
    История.Ошибка = Ошибка;
    История.Записать();

КонецПроцедуры



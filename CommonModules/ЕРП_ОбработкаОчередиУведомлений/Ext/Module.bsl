////////////////////////////////////////////////////////////////////////////////
// Общий модуль ЕРП_ОбработкаОчередиУведомлений
// Атомарное формирование доставок; ограниченная выборка очереди.
// Резервирование с lease 300 секунд и UUID fencing.
// Сетевые вызовы всегда выполняются вне транзакций.
// Политика повторов: максимум 5 попыток; 60, 300, 900, 3600 и 10800 секунд.
////////////////////////////////////////////////////////////////////////////////

Процедура ОбработатьОчередьУведомлений() Экспорт

    Настройки = ЕРП_Уведомления.ЕРП_ПолучитьНастройкиУведомлений();
    Если Не Настройки.ИспользоватьУведомления Тогда
        Возврат;
    КонецЕсли;

    СоздатьДоставкиПоНовымСобытиям();

    // За один запуск обрабатывается не более 100 готовых доставок.
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 100
    |   Доставки.КлючДоставки КАК КлючДоставки,
    |   Доставки.СледующаяПопытка КАК СледующаяПопытка,
    |   Доставки.ДатаРезервации КАК ДатаРезервации
    |ИЗ
    |   РегистрСведений.ЕРП_ДоставкиУведомлений КАК Доставки
    |ГДЕ
    |   Доставки.Состояние = &Ожидает
    |   ИЛИ (Доставки.Состояние = &Повтор
    |       И Доставки.СледующаяПопытка <= &Сейчас)
    |   ИЛИ (Доставки.Состояние = &Обрабатывается
    |       И Доставки.СрокРезервации <= &Сейчас)
    |УПОРЯДОЧИТЬ ПО
    |   СледующаяПопытка,
    |   ДатаРезервации,
    |   КлючДоставки";
    Запрос.УстановитьПараметр("Ожидает", "Ожидает");
    Запрос.УстановитьПараметр("Повтор", "Повтор");
    Запрос.УстановитьПараметр("Обрабатывается", "Обрабатывается");
    Запрос.УстановитьПараметр("Сейчас", ТекущаяДата());

    Ключи = Новый Массив;
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        Ключи.Добавить(Выборка.КлючДоставки);
    КонецЦикла;

    Для Каждого КлючДоставки Из Ключи Цикл
        ОбработатьОднуДоставку(КлючДоставки);
    КонецЦикла;

КонецПроцедуры


Процедура СоздатьДоставкиПоНовымСобытиям()

    Настройки = ЕРП_Уведомления.ЕРП_ПолучитьНастройкиУведомлений();
    Если Не Настройки.ИспользоватьУведомления Тогда
        Возврат;
    КонецЕсли;

    КлючиСобытий = Новый Массив;
    ВыборкаСобытий = РегистрыСведений.ЕРП_СобытияУведомлений.Выбрать();
    Пока ВыборкаСобытий.Следующий() Цикл
        Если ВыборкаСобытий.Состояние = "Новая" Тогда
            КлючиСобытий.Добавить(ВыборкаСобытий.КлючСобытия);
        КонецЕсли;
    КонецЦикла;

    Для Каждого КлючСобытия Из КлючиСобытий Цикл

        НачатьТранзакцию();
        Попытка
            // Сериализация всех операций создания доставок одного события.
            ЗаблокироватьСобытие(КлючСобытия);

            Событие = РегистрыСведений.ЕРП_СобытияУведомлений.СоздатьМенеджерЗаписи();
            Событие.КлючСобытия = КлючСобытия;
            Событие.Прочитать();

            Если Событие.Состояние <> "Новая" Тогда
                ЗафиксироватьТранзакцию();
                Продолжить;
            КонецЕсли;

            КоличествоДоставок = 0;
            Получатели = РегистрыСведений.ЕРП_ПолучателиУведомлений.Выбрать();

            Пока Получатели.Следующий() Цикл
                Если Не Получатели.Включен Тогда
                    Продолжить;
                КонецЕсли;

                Уведомлять = Ложь;
                Если Событие.ТипСобытия = "УспешноСоздано" Тогда
                    Уведомлять = Получатели.УведомлятьОбУспехе;
                ИначеЕсли Событие.ТипСобытия = "ОшибкаДвухПопыток" Тогда
                    Уведомлять = Получатели.УведомлятьОбОшибке;
                ИначеЕсли Событие.ТипСобытия = "RabbitMQНедоступен"
                    Или Событие.ТипСобытия = "RabbitMQВосстановлен" Тогда
                    Уведомлять = Получатели.УведомлятьОСвязи;
                КонецЕсли;

                Если Не Уведомлять Тогда
                    Продолжить;
                КонецЕсли;

                EmailСотрудника = ПолучитьEmailСотрудника(Получатели.Сотрудник);

                Если Настройки.ИспользоватьEmail
                    И Получатели.EmailВключен
                    И ЗначениеЗаполнено(EmailСотрудника) Тогда

                    Ключ = Событие.КлючСобытия + "|"
                        + Строка(Получатели.Сотрудник.УникальныйИдентификатор())
                        + "|EMAIL";
                    Если СоздатьЗаписьДоставки(
                        Ключ, Событие.КлючСобытия, Получатели.Сотрудник,
                        "EMAIL", EmailСотрудника, Событие.ТипСобытия,
                        Событие.ТекстСообщения
                    ) Тогда
                        КоличествоДоставок = КоличествоДоставок + 1;
                    КонецЕсли;
                КонецЕсли;

                Если Настройки.ИспользоватьTelegram
                    И Получатели.TelegramВключен
                    И ЗначениеЗаполнено(Получатели.TelegramChatID) Тогда

                    Ключ = Событие.КлючСобытия + "|"
                        + Строка(Получатели.Сотрудник.УникальныйИдентификатор())
                        + "|TELEGRAM";
                    Если СоздатьЗаписьДоставки(
                        Ключ, Событие.КлючСобытия, Получатели.Сотрудник,
                        "TELEGRAM", Получатели.TelegramChatID, Событие.ТипСобытия,
                        Событие.ТекстСообщения
                    ) Тогда
                        КоличествоДоставок = КоличествоДоставок + 1;
                    КонецЕсли;
                КонецЕсли;
            КонецЦикла;

            Событие.Состояние =
                ?(КоличествоДоставок = 0, "БезПолучателей", "ДоставкиСозданы");
            Событие.Записать();
            ЗафиксироватьТранзакцию();

            ЕРП_ЖурналУведомлений.Информация(
                "ОБРАБОТКА СОБЫТИЯ",
                "Сформированы записи очереди доставки.",
                "Ключ события: " + КлючСобытия
                    + "; количество доставок: " + Строка(КоличествоДоставок)
            );

        Исключение
            ОтменитьТранзакцию();
            ЕРП_ЖурналУведомлений.Ошибка(
                "ОБРАБОТКА СОБЫТИЯ",
                "Не удалось атомарно сформировать доставки.",
                "Ключ события: " + КлючСобытия
                    + "; ошибка: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())
            );
        КонецПопытки;

    КонецЦикла;

КонецПроцедуры


Процедура ЗаблокироватьСобытие(КлючСобытия)

    БлокировкаДанных = Новый БлокировкаДанных;
    ЭлементБлокировки = БлокировкаДанных.Добавить(
        "РегистрСведений.ЕРП_СобытияУведомлений"
    );
    ЭлементБлокировки.УстановитьЗначение("КлючСобытия", КлючСобытия);
    ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
    БлокировкаДанных.Заблокировать();

КонецПроцедуры


Функция СоздатьЗаписьДоставки(
    КлючДоставки, КлючСобытия, Сотрудник, Канал,
    АдресПолучателя, ТипСобытия, ТекстСообщения)

    Менеджер = РегистрыСведений.ЕРП_ДоставкиУведомлений.СоздатьМенеджерЗаписи();
    Менеджер.КлючДоставки = КлючДоставки;
    Менеджер.Прочитать();

    Если ЗначениеЗаполнено(Менеджер.Состояние) Тогда
        Возврат Истина;
    КонецЕсли;

    Менеджер.КлючДоставки = КлючДоставки;
    Менеджер.КлючСобытия = КлючСобытия;
    Менеджер.Сотрудник = Сотрудник;
    Менеджер.Канал = Канал;
    Менеджер.АдресПолучателя = АдресПолучателя;
    Менеджер.Тема = "Интеграция 1С: " + ТипСобытия;
    Менеджер.ТекстСообщения = ТекстСообщения;
    Менеджер.Состояние = "Ожидает";
    Менеджер.КоличествоПопыток = 0;
    Менеджер.СледующаяПопытка = Дата(1, 1, 1);
    Менеджер.ИдентификаторРезервации =
        Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");
    Менеджер.ДатаРезервации = Дата(1, 1, 1);
    Менеджер.СрокРезервации = Дата(1, 1, 1);
    Менеджер.Записать();

    Возврат Истина;

КонецФункции


Функция ПолучитьEmailСотрудника(Сотрудник)

    Если Не ЗначениеЗаполнено(Сотрудник) Тогда
        Возврат "";
    КонецЕсли;

    ФизическоеЛицо = Сотрудник.ФизическоеЛицо;
    Если Не ЗначениеЗаполнено(ФизическоеЛицо) Тогда
        Возврат "";
    КонецЕсли;

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |   КонтактнаяИнформация.АдресЭП КАК Email
    |ИЗ
    |   Справочник.ФизическиеЛица.КонтактнаяИнформация КАК КонтактнаяИнформация
    |ГДЕ
    |   КонтактнаяИнформация.Ссылка = &ФизическоеЛицо
    |   И КонтактнаяИнформация.Вид = &ВидКонтактнойИнформации
    |УПОРЯДОЧИТЬ ПО
    |   КонтактнаяИнформация.НомерСтроки";
    Запрос.УстановитьПараметр("ФизическоеЛицо", ФизическоеЛицо);
    Запрос.УстановитьПараметр(
        "ВидКонтактнойИнформации",
        Справочники.ВидыКонтактнойИнформации.EmailПользователя
    );

    Выборка = Запрос.Выполнить().Выбрать();
    Если Выборка.Следующий() Тогда
        Возврат СокрЛП(Выборка.Email);
    КонецЕсли;

    Возврат "";

КонецФункции


Процедура ОбработатьОднуДоставку(КлючДоставки)

    ПараметрыРезервации = ЗарезервироватьДоставку(КлючДоставки);
    Если ПараметрыРезервации = Неопределено Тогда
        Возврат;
    КонецЕсли;

    ЕРП_ЖурналУведомлений.Информация(
        "ДОСТАВКА",
        "Начата попытка отправки уведомления.",
        "Ключ доставки: " + КлючДоставки
            + "; попытка: " + Строка(ПараметрыРезервации.НомерПопытки)
            + "; канал: " + ПараметрыРезервации.ПараметрыДоставки.Канал
    );

    // Сетевой вызов выполняется после фиксации транзакции резервирования.
    // Любое исключение преобразуется в результат доставки, чтобы корректно
    // освободить lease и сохранить историю текущей попытки.
    Попытка
        РезультатОтправки = ЕРП_Уведомления.ОтправитьДоставкуУведомления(
            ПараметрыРезервации.ПараметрыДоставки
        );
    Исключение
        РезультатОтправки = Новый Структура(
            "Успех, ОписаниеОшибки, RetryAfter",
            Ложь,
            ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()),
            0
        );
    КонецПопытки;

    // Результат записывается отдельной транзакцией только при совпадении UUID.
    ЗафиксироватьРезультатДоставки(
        КлючДоставки,
        ПараметрыРезервации.ИдентификаторРезервации,
        ПараметрыРезервации.НомерПопытки,
        РезультатОтправки
    );

КонецПроцедуры


Функция ЗарезервироватьДоставку(КлючДоставки)

    Результат = Неопределено;

    ПредварительнаяЗапись = РегистрыСведений.ЕРП_ДоставкиУведомлений.СоздатьМенеджерЗаписи();
    ПредварительнаяЗапись.КлючДоставки = КлючДоставки;
    ПредварительнаяЗапись.Прочитать();
    КлючСобытия = ПредварительнаяЗапись.КлючСобытия;

    НачатьТранзакцию();
    Попытка
        // Единый порядок блокировок: событие, затем конкретная доставка.
        Если ЗначениеЗаполнено(КлючСобытия) Тогда
            ЗаблокироватьСобытие(КлючСобытия);
        КонецЕсли;
        ЗаблокироватьДоставку(КлючДоставки);

        Менеджер = РегистрыСведений.ЕРП_ДоставкиУведомлений.СоздатьМенеджерЗаписи();
        Менеджер.КлючДоставки = КлючДоставки;
        Менеджер.Прочитать();

        Сейчас = ТекущаяДата();
        МожноРезервировать = Ложь;

        Если Менеджер.Состояние = "Ожидает"
            Или Менеджер.Состояние = "Повтор" Тогда
            МожноРезервировать =
                Не ЗначениеЗаполнено(Менеджер.СледующаяПопытка)
                Или Менеджер.СледующаяПопытка <= Сейчас;
        ИначеЕсли Менеджер.Состояние = "Обрабатывается"
            И ЗначениеЗаполнено(Менеджер.СрокРезервации)
            И Менеджер.СрокРезервации <= Сейчас Тогда
            МожноРезервировать = Истина;
        КонецЕсли;

        Если Не МожноРезервировать Тогда
            ЗафиксироватьТранзакцию();
            Возврат Неопределено;
        КонецЕсли;

        Если Менеджер.КоличествоПопыток >= 5 Тогда
            Менеджер.Состояние = "ОкончательнаяОшибка";
            Менеджер.СледующаяПопытка = Дата(1, 1, 1);
            Менеджер.ИдентификаторРезервации =
                Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");
            Менеджер.ДатаРезервации = Дата(1, 1, 1);
            Менеджер.СрокРезервации = Дата(1, 1, 1);
            Если Не ЗначениеЗаполнено(Менеджер.ПоследняяОшибка) Тогда
                Менеджер.ПоследняяОшибка =
                    "Срок аренды последней попытки истёк; лимит попыток исчерпан.";
            КонецЕсли;
            Менеджер.Записать();

            Если ЗначениеЗаполнено(Менеджер.КлючСобытия) Тогда
                ОбновитьСостояниеСобытияПодБлокировкой(Менеджер.КлючСобытия);
            КонецЕсли;

            ЗафиксироватьТранзакцию();
            ЗаписатьИсториюЕслиОтсутствует(
                КлючДоставки,
                Менеджер.КоличествоПопыток,
                "Прервано",
                "Срок аренды последней попытки истёк; лимит попыток исчерпан."
            );

            ЕРП_ЖурналУведомлений.Ошибка(
                "ДОСТАВКА",
                "Срок резервирования истёк; достигнут предел попыток.",
                "Ключ доставки: " + КлючДоставки
            );
            Возврат Неопределено;
        КонецЕсли;

        // Предыдущая попытка была зарезервирована, но обработчик не
        // зафиксировал результат до истечения lease. Сохраняем её отдельно.
        Если Менеджер.Состояние = "Обрабатывается"
            И Менеджер.КоличествоПопыток > 0 Тогда
            ЗаписатьИсториюЕслиОтсутствует(
                КлючДоставки,
                Менеджер.КоличествоПопыток,
                "Прервано",
                "Срок аренды истёк; результат отправки не был зафиксирован."
            );
        КонецЕсли;

        НовыйUUID = Новый УникальныйИдентификатор;
        НомерПопытки = Менеджер.КоличествоПопыток + 1;
        Менеджер.КоличествоПопыток = НомерПопытки;
        Менеджер.ИдентификаторРезервации = НовыйUUID;
        Менеджер.ДатаРезервации = Сейчас;
        Менеджер.СрокРезервации = Сейчас + 300;
        Менеджер.Состояние = "Обрабатывается";
        Менеджер.СледующаяПопытка = Дата(1, 1, 1);
        Менеджер.Записать();

        ПараметрыДоставки = Новый Структура(
            "Канал, АдресПолучателя, Тема, ТекстСообщения",
            Менеджер.Канал,
            Менеджер.АдресПолучателя,
            Менеджер.Тема,
            Менеджер.ТекстСообщения
        );
        Результат = Новый Структура(
            "ИдентификаторРезервации, НомерПопытки, ПараметрыДоставки",
            НовыйUUID, НомерПопытки, ПараметрыДоставки
        );

        Если ЗначениеЗаполнено(Менеджер.КлючСобытия) Тогда
            ОбновитьСостояниеСобытияПодБлокировкой(Менеджер.КлючСобытия);
        КонецЕсли;

        ЗафиксироватьТранзакцию();

    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;

    Возврат Результат;

КонецФункции


Процедура ЗафиксироватьРезультатДоставки(
    КлючДоставки, UUIDРезервации, НомерПопытки, РезультатОтправки)

    ПредварительнаяЗапись = РегистрыСведений.ЕРП_ДоставкиУведомлений.СоздатьМенеджерЗаписи();
    ПредварительнаяЗапись.КлючДоставки = КлючДоставки;
    ПредварительнаяЗапись.Прочитать();
    КлючСобытия = ПредварительнаяЗапись.КлючСобытия;

    НачатьТранзакцию();
    Попытка
        Если ЗначениеЗаполнено(КлючСобытия) Тогда
            ЗаблокироватьСобытие(КлючСобытия);
        КонецЕсли;
        ЗаблокироватьДоставку(КлючДоставки);

        Менеджер = РегистрыСведений.ЕРП_ДоставкиУведомлений.СоздатьМенеджерЗаписи();
        Менеджер.КлючДоставки = КлючДоставки;
        Менеджер.Прочитать();

        // Fencing: устаревший обработчик не меняет ни доставку, ни историю.
        Если Менеджер.ИдентификаторРезервации <> UUIDРезервации Тогда
            ЗафиксироватьТранзакцию();
            Возврат;
        КонецЕсли;

        Если РезультатОтправки.Успех Тогда
            Менеджер.Состояние = "Отправлено";
            Менеджер.ДатаОтправки = ТекущаяДата();
            Менеджер.ПоследняяОшибка = "";
            Менеджер.СледующаяПопытка = Дата(1, 1, 1);
        Иначе
            Менеджер.ПоследняяОшибка = РезультатОтправки.ОписаниеОшибки;
            Если НомерПопытки >= 5 Тогда
                Менеджер.Состояние = "ОкончательнаяОшибка";
                Менеджер.СледующаяПопытка = Дата(1, 1, 1);
            Иначе
                Менеджер.Состояние = "Повтор";
                Если РезультатОтправки.RetryAfter > 0 Тогда
                    Задержка = Мин(РезультатОтправки.RetryAfter, 86400);
                Иначе
                    Задержка = ИнтервалПовтораСекунд(НомерПопытки);
                КонецЕсли;
                Менеджер.СледующаяПопытка = ТекущаяДата() + Задержка;
            КонецЕсли;
        КонецЕсли;

        Менеджер.ИдентификаторРезервации =
            Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");
        Менеджер.ДатаРезервации = Дата(1, 1, 1);
        Менеджер.СрокРезервации = Дата(1, 1, 1);
        Менеджер.Записать();

        ЗаписатьИсторию(
            КлючДоставки,
            НомерПопытки,
            ?(РезультатОтправки.Успех, "Отправлено", "Ошибка"),
            РезультатОтправки.ОписаниеОшибки
        );

        Если ЗначениеЗаполнено(Менеджер.КлючСобытия) Тогда
            ОбновитьСостояниеСобытияПодБлокировкой(Менеджер.КлючСобытия);
        КонецЕсли;

        ЗафиксироватьТранзакцию();

    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;

КонецПроцедуры


Процедура ЗаблокироватьДоставку(КлючДоставки)

    БлокировкаДанных = Новый БлокировкаДанных;
    ЭлементБлокировки = БлокировкаДанных.Добавить(
        "РегистрСведений.ЕРП_ДоставкиУведомлений"
    );
    ЭлементБлокировки.УстановитьЗначение("КлючДоставки", КлючДоставки);
    ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
    БлокировкаДанных.Заблокировать();

КонецПроцедуры

Процедура ОбновитьСостояниеСобытияПодБлокировкой(КлючСобытия)

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |   Доставки.Состояние КАК Состояние
    |ИЗ
    |   РегистрСведений.ЕРП_ДоставкиУведомлений КАК Доставки
    |ГДЕ
    |   Доставки.КлючСобытия = &КлючСобытия";
    Запрос.УстановитьПараметр("КлючСобытия", КлючСобытия);

    КоличествоДоставок = 0;
    ВсеОтправлены = Истина;
    ВсеТерминальны = Истина;
    ЕстьОкончательныеОшибки = Ложь;

    ВыборкаДоставок = Запрос.Выполнить().Выбрать();
    Пока ВыборкаДоставок.Следующий() Цикл
        КоличествоДоставок = КоличествоДоставок + 1;

        Если ВыборкаДоставок.Состояние <> "Отправлено" Тогда
            ВсеОтправлены = Ложь;
        КонецЕсли;

        Если ВыборкаДоставок.Состояние = "ОкончательнаяОшибка" Тогда
            ЕстьОкончательныеОшибки = Истина;
        ИначеЕсли ВыборкаДоставок.Состояние <> "Отправлено" Тогда
            ВсеТерминальны = Ложь;
        КонецЕсли;
    КонецЦикла;

    Событие = РегистрыСведений.ЕРП_СобытияУведомлений.СоздатьМенеджерЗаписи();
    Событие.КлючСобытия = КлючСобытия;
    Событие.Прочитать();

    Если КоличествоДоставок = 0 Тогда
        Событие.Состояние = "БезПолучателей";
    ИначеЕсли ВсеОтправлены Тогда
        Событие.Состояние = "Завершено";
    ИначеЕсли ВсеТерминальны И ЕстьОкончательныеОшибки Тогда
        Событие.Состояние = "ЗавершеноСОшибками";
    Иначе
        Событие.Состояние = "Выполняется";
    КонецЕсли;

    Событие.Записать();

КонецПроцедуры



Функция ИнтервалПовтораСекунд(НомерПопытки)

    Если НомерПопытки = 1 Тогда
        Возврат 60;
    ИначеЕсли НомерПопытки = 2 Тогда
        Возврат 300;
    ИначеЕсли НомерПопытки = 3 Тогда
        Возврат 900;
    ИначеЕсли НомерПопытки = 4 Тогда
        Возврат 3600;
    КонецЕсли;

    Возврат 10800;

КонецФункции


Процедура ЗаписатьИсториюЕслиОтсутствует(
    КлючДоставки, НомерПопытки, Результат, Ошибка)

    История = РегистрыСведений.ЕРП_ИсторияДоставкиУведомлений.СоздатьМенеджерЗаписи();
    История.КлючДоставки = КлючДоставки;
    История.НомерПопытки = НомерПопытки;
    История.Прочитать();

    Если ЗначениеЗаполнено(История.Результат) Тогда
        Возврат;
    КонецЕсли;

    История.КлючДоставки = КлючДоставки;
    История.НомерПопытки = НомерПопытки;
    История.ДатаПопытки = ТекущаяДата();
    История.Результат = Результат;
    История.Ошибка = Ошибка;
    История.Записать();

КонецПроцедуры


Процедура ЗаписатьИсторию(КлючДоставки, НомерПопытки, Результат, Ошибка)

    История = РегистрыСведений.ЕРП_ИсторияДоставкиУведомлений.СоздатьМенеджерЗаписи();
    История.КлючДоставки = КлючДоставки;
    История.НомерПопытки = НомерПопытки;

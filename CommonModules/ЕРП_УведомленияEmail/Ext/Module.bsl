#Область ПрограммныйИнтерфейс

// Отправляет одно уведомление через штатную почтовую подсистему БСП.
// Учетная запись берется из параметра либо из системной учетной записи БСП.
// Успех означает, что штатная операция отправки завершилась без ошибки;
// фактическое попадание письма в почтовый ящик этим не подтверждается.

Функция ОтправитьПисьмо(
    АдресEmail,
    ТемаПисьма,
    ТекстПисьма,
    УчетнаяЗаписьПочты = Неопределено) Экспорт

    Результат = Новый Структура(
        "Успех,ОписаниеОшибки,RetryAfter,РезультатНеопределен",
        Ложь, "", 0, Ложь);

    АдресаПолучателей = Новый Массив;
    УникальныеАдреса = Новый Соответствие;
    ИсходныеАдреса = Новый Массив;

    Если ТипЗнч(АдресEmail) = Тип("Строка") Тогда
        ИсходныеАдреса.Добавить(АдресEmail);
    ИначеЕсли ТипЗнч(АдресEmail) = Тип("Массив") Тогда
        ИсходныеАдреса = АдресEmail;
    Иначе
        Результат.ОписаниеОшибки =
            "Адрес получателя должен быть строкой или массивом строк.";
        ЗаписатьСобытиеЖурналаEmail("ОШИБКА", Результат.ОписаниеОшибки);
        Возврат Результат;
    КонецЕсли;

    Для Каждого АдресИзМассива Из ИсходныеАдреса Цикл

        Если ТипЗнч(АдресИзМассива) <> Тип("Строка") Тогда
            Результат.ОписаниеОшибки =
                "Список адресов Email содержит элемент, который не является строкой.";
            ЗаписатьСобытиеЖурналаEmail("ОШИБКА", Результат.ОписаниеОшибки);
            Возврат Результат;
        КонецЕсли;

        Адрес = СокрЛП(АдресИзМассива);
        Если Не ЗначениеЗаполнено(Адрес) Тогда
            Результат.ОписаниеОшибки =
                "Список адресов Email содержит пустой адрес.";
            ЗаписатьСобытиеЖурналаEmail("ОШИБКА", Результат.ОписаниеОшибки);
            Возврат Результат;
        КонецЕсли;

        КлючАдреса = НРег(Адрес);
        Если УникальныеАдреса.Получить(КлючАдреса) = Неопределено Тогда
            УникальныеАдреса.Вставить(КлючАдреса, Истина);
            АдресаПолучателей.Добавить(Адрес);
        КонецЕсли;

    КонецЦикла;

    Если АдресаПолучателей.Количество() = 0 Тогда
        Результат.ОписаниеОшибки =
            "Не указан ни один адрес электронной почты получателя.";
        ЗаписатьСобытиеЖурналаEmail("ОШИБКА", Результат.ОписаниеОшибки);
        Возврат Результат;
    КонецЕсли;

    // Проверка синтаксиса каждого адреса до обращения к почтовому серверу.
    // При ошибке отклоняется весь список, частичная отправка не выполняется.
    Для Каждого АдресПолучателя Из АдресаПолучателей Цикл
        Если Не ОбщегоНазначенияКлиентСервер.АдресЭлектроннойПочтыСоответствуетТребованиям(
            АдресПолучателя,
            Ложь
        ) Тогда
            Результат.ОписаниеОшибки =
                "Адрес электронной почты получателя не соответствует требованиям БСП.";
            ЗаписатьСобытиеЖурналаEmail(
                "ОШИБКА",
                Результат.ОписаниеОшибки,
                "Письмо не отправлялось. Количество адресов: "
                    + Строка(АдресаПолучателей.Количество())
            );
            Возврат Результат;
        КонецЕсли;
    КонецЦикла;

    Если ТипЗнч(ТемаПисьма) <> Тип("Строка")
        Или Не ЗначениеЗаполнено(ТемаПисьма) Тогда
        Результат.ОписаниеОшибки = "Не указана тема электронного письма.";
        ЗаписатьСобытиеЖурналаEmail("ОШИБКА", Результат.ОписаниеОшибки);
        Возврат Результат;
    КонецЕсли;

    Если ТипЗнч(ТекстПисьма) <> Тип("Строка")
        Или Не ЗначениеЗаполнено(ТекстПисьма) Тогда
        Результат.ОписаниеОшибки = "Текст электронного письма не может быть пустым.";
        ЗаписатьСобытиеЖурналаEmail("ОШИБКА", Результат.ОписаниеОшибки);
        Возврат Результат;
    КонецЕсли;

    // Подготовка учетной записи и письма не обращается к SMTP.
    // Исключения на этом этапе означают известный отказ до начала отправки.
    Попытка

        Если ЗначениеЗаполнено(УчетнаяЗаписьПочты) Тогда
            Если ТипЗнч(УчетнаяЗаписьПочты)
                <> Тип("СправочникСсылка.УчетныеЗаписиЭлектроннойПочты") Тогда
                Результат.ОписаниеОшибки =
                    "Передана учетная запись почты неподдерживаемого типа.";
                ЗаписатьСобытиеЖурналаEmail("ОШИБКА", Результат.ОписаниеОшибки);
                Возврат Результат;
            КонецЕсли;

            УчетнаяЗапись = УчетнаяЗаписьПочты;
        Иначе
            УчетнаяЗапись = РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
        КонецЕсли;

        Если Не ЗначениеЗаполнено(УчетнаяЗапись) Тогда
            Результат.ОписаниеОшибки =
                "Не определена учетная запись электронной почты для отправки.";
            ЗаписатьСобытиеЖурналаEmail("ОШИБКА", Результат.ОписаниеОшибки);
            Возврат Результат;
        КонецЕсли;

        АдресУчетнойЗаписи = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
            УчетнаяЗапись,
            "АдресЭлектроннойПочты"
        );

        Если Не ЗначениеЗаполнено(АдресУчетнойЗаписи) Тогда
            Результат.ОписаниеОшибки =
                "В учетной записи БСП не заполнен адрес электронной почты отправителя.";
            ЗаписатьСобытиеЖурналаEmail("ОШИБКА", Результат.ОписаниеОшибки);
            Возврат Результат;
        КонецЕсли;

        Если ТипЗнч(АдресУчетнойЗаписи) <> Тип("Строка")
            Или Не ОбщегоНазначенияКлиентСервер.АдресЭлектроннойПочтыСоответствуетТребованиям(
                АдресУчетнойЗаписи,
                Ложь
            ) Тогда
            Результат.ОписаниеОшибки =
                "Адрес отправителя в учетной записи БСП не соответствует требованиям БСП.";
            ЗаписатьСобытиеЖурналаEmail("ОШИБКА", Результат.ОписаниеОшибки);
            Возврат Результат;
        КонецЕсли;

        ИспользоватьДляОтправки = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
            УчетнаяЗапись,
            "ИспользоватьДляОтправки"
        );

        Если Не ИспользоватьДляОтправки Тогда
            Результат.ОписаниеОшибки =
                "Учетная запись БСП отключена для отправки почты.";
            ЗаписатьСобытиеЖурналаEmail("ОШИБКА", Результат.ОписаниеОшибки);
            Возврат Результат;
        КонецЕсли;

        ПараметрыОтправки = Новый Структура;
        ПараметрыОтправки.Вставить(
            "Кому",
            СтрСоединить(АдресаПолучателей, ";")
        );
        ПараметрыОтправки.Вставить("Тема", ТемаПисьма);
        ПараметрыОтправки.Вставить("Тело", ТекстПисьма);
        ПараметрыОтправки.Вставить("ТипТекста", "ПростойТекст");

        Письмо = РаботаСПочтовымиСообщениями.ПодготовитьПисьмо(
            УчетнаяЗапись,
            ПараметрыОтправки
        );

    Исключение

        Результат.ОписаниеОшибки =
            КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
        ЗаписатьСобытиеЖурналаEmail(
            "ОШИБКА",
            "Не удалось подготовить письмо: " + Результат.ОписаниеОшибки,
            "Количество получателей: " + Строка(АдресаПолучателей.Количество())
        );
        Возврат Результат;

    КонецПопытки;

    // С этого места начинается внешний почтовый вызов.
    // При исключении нельзя достоверно утверждать, что SMTP-сервер
    // не принял письмо, поэтому результат остается неопределенным.
    Результат.РезультатНеопределен = Истина;

    ДатаНачалаSMTP = ТекущаяДата();
    Попытка

        РезультатОтправки = РаботаСПочтовымиСообщениями.ОтправитьПисьмо(
            УчетнаяЗапись,
            Письмо
        );

        ЗаписатьПредупреждениеЕслиSMTPДольшеПорога(ДатаНачалаSMTP);

        Если РезультатОтправки.ОшибочныеПолучатели.Количество() > 0 Тогда
            ТекстОшибкиПолучателей = "";
            Для Каждого ОшибочныйПолучатель Из РезультатОтправки.ОшибочныеПолучатели Цикл
                Если Не ПустаяСтрока(ТекстОшибкиПолучателей) Тогда
                    ТекстОшибкиПолучателей = ТекстОшибкиПолучателей + Символы.ПС;
                КонецЕсли;
                ТекстОшибкиПолучателей = ТекстОшибкиПолучателей
                    + Строка(ОшибочныйПолучатель.Ключ)
                    + ": "
                    + Строка(ОшибочныйПолучатель.Значение);
            КонецЦикла;

            Результат.ОписаниеОшибки =
                "Почтовый сервер отклонил одного или нескольких получателей."
                + Символы.ПС
                + ТекстОшибкиПолучателей;

            ЗаписатьСобытиеЖурналаEmail(
                "ОШИБКА",
                Результат.ОписаниеОшибки,
                "Результат оставлен неопределенным: возможна частичная отправка."
            );
            Возврат Результат;
        КонецЕсли;

        Результат.Успех = Истина;
        Результат.РезультатНеопределен = Ложь;

        ЗаписатьСобытиеЖурналаEmail(
            "ИНФОРМАЦИЯ",
            "Операция отправки письма через БСП завершилась без ошибки.",
            "Количество получателей: " + Строка(АдресаПолучателей.Количество())
                + ". Фактическая доставка в почтовые ящики не подтверждена."
        );

    Исключение

        ЗаписатьПредупреждениеЕслиSMTPДольшеПорога(ДатаНачалаSMTP);

        Результат.Успех = Ложь;
        Результат.ОписаниеОшибки =
            КраткоеПредставлениеОшибки(ИнформацияОбОшибке());

        // Не сбрасываем РезультатНеопределен: исключение возникло
        // внутри внешней операции, возможна неопределенность SMTP-результата.
        ЗаписатьСобытиеЖурналаEmail(
            "ОШИБКА",
            "Ошибка отправки через БСП: " + Результат.ОписаниеОшибки,
            "Количество получателей: " + Строка(АдресаПолучателей.Количество())
        );

    КонецПопытки;

    Возврат Результат;

КонецФункции

#КонецОбласти


#Область СлужебныеПроцедурыИФункции

// Ошибка журнала не должна менять результат отправки или провоцировать повтор.
Процедура ЗаписатьПредупреждениеЕслиSMTPДольшеПорога(ДатаНачалаSMTP)

    ДлительностьСекунд = ТекущаяДата() - ДатаНачалаSMTP;
    Если ДлительностьСекунд > 45 Тогда
        ЗаписатьСобытиеЖурналаEmail(
            "ПРЕДУПРЕЖДЕНИЕ",
            "Операция отправки SMTP превысила порог 45 секунд.",
            "Длительность операции, секунд: " + Строка(ДлительностьСекунд)
        );
    КонецЕсли;

КонецПроцедуры


Процедура ЗаписатьСобытиеЖурналаEmail(Уровень, Сообщение, Подробности = "")

    Попытка
        Если Уровень = "ИНФОРМАЦИЯ" Тогда
            ЕРП_ЖурналУведомлений.Информация(
                "EMAIL",
                Сообщение,
                Подробности
            );
        ИначеЕсли Уровень = "ПРЕДУПРЕЖДЕНИЕ" Тогда
            ЕРП_ЖурналУведомлений.Предупреждение(
                "EMAIL",
                Сообщение,
                Подробности
            );
        Иначе
            ЕРП_ЖурналУведомлений.Ошибка(
                "EMAIL",
                Сообщение,
                Подробности
            );
        КонецЕсли;
    Исключение
        // Журналирование вторично относительно результата почтовой операции.
    КонецПопытки;

КонецПроцедуры

#КонецОбласти

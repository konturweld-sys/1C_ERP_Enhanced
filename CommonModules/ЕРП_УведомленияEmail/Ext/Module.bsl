#Область ПрограммныйИнтерфейс

// Отправляет уведомление через штатный почтовый API БСП.
// Прямое подключение ИнтернетПочта и хранение SMTP-паролей в расширении
// для рабочего канала Email не используются.
//
// УчетнаяЗаписьПочты необязательна. Если она не передана,
// используется системная учетная запись БСП.

Функция ОтправитьПисьмо(
    АдресEmail,
    ТемаПисьма,
    ТекстПисьма,
    УчетнаяЗаписьПочты = Неопределено) Экспорт

    Результат = Новый Структура(
        "Успех,ОписаниеОшибки,РезультатНеопределен",
        Ложь, "", Ложь);

    АдресаПолучателей = Новый Массив;
    УникальныеАдреса = Новый Соответствие;

    Если ТипЗнч(АдресEmail) = Тип("Строка") Тогда
        Если ЗначениеЗаполнено(СокрЛП(АдресEmail)) Тогда
            АдресаПолучателей.Добавить(СокрЛП(АдресEmail));
        КонецЕсли;
    ИначеЕсли ТипЗнч(АдресEmail) = Тип("Массив") Тогда
        Для Каждого АдресИзМассива Из АдресEmail Цикл
            Если ТипЗнч(АдресИзМассива) <> Тип("Строка") Тогда
                Продолжить;
            КонецЕсли;

            Адрес = СокрЛП(АдресИзМассива);
            Если Не ЗначениеЗаполнено(Адрес) Тогда
                Продолжить;
            КонецЕсли;

            КлючАдреса = НРег(Адрес);
            Если УникальныеАдреса.Получить(КлючАдреса) = Неопределено Тогда
                УникальныеАдреса.Вставить(КлючАдреса, Истина);
                АдресаПолучателей.Добавить(Адрес);
            КонецЕсли;
        КонецЦикла;
    КонецЕсли;

    Если АдресаПолучателей.Количество() = 0 Тогда
        Результат.ОписаниеОшибки =
            "Не указан ни один корректно заполненный адрес электронной почты получателя.";
        ЕРП_ЖурналУведомлений.Ошибка("EMAIL", Результат.ОписаниеОшибки);
        Возврат Результат;
    КонецЕсли;

    Если ТипЗнч(ТемаПисьма) <> Тип("Строка")
        Или Не ЗначениеЗаполнено(ТемаПисьма) Тогда
        Результат.ОписаниеОшибки = "Не указана тема электронного письма.";
        ЕРП_ЖурналУведомлений.Ошибка("EMAIL", Результат.ОписаниеОшибки);
        Возврат Результат;
    КонецЕсли;

    Если ТипЗнч(ТекстПисьма) <> Тип("Строка")
        Или Не ЗначениеЗаполнено(ТекстПисьма) Тогда
        Результат.ОписаниеОшибки = "Текст электронного письма не может быть пустым.";
        ЕРП_ЖурналУведомлений.Ошибка("EMAIL", Результат.ОписаниеОшибки);
        Возврат Результат;
    КонецЕсли;

    Попытка

        ПараметрыПисьма = РаботаСПочтовымиСообщениями.ПараметрыОтправкиПисьма();

        Если ЗначениеЗаполнено(УчетнаяЗаписьПочты) Тогда
            Если ТипЗнч(УчетнаяЗаписьПочты)
                <> Тип("СправочникСсылка.УчетныеЗаписиЭлектроннойПочты") Тогда
                Результат.ОписаниеОшибки =
                    "Передана учетная запись почты неподдерживаемого типа.";
                ЕРП_ЖурналУведомлений.Ошибка("EMAIL", Результат.ОписаниеОшибки);
                Возврат Результат;
            КонецЕсли;

            ПараметрыПисьма.УчетнаяЗапись = УчетнаяЗаписьПочты;
        Иначе
            ПараметрыПисьма.УчетнаяЗапись =
                РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
        КонецЕсли;

        Если Не ЗначениеЗаполнено(ПараметрыПисьма.УчетнаяЗапись) Тогда
            Результат.ОписаниеОшибки =
                "Не определена учетная запись электронной почты для отправки.";
            ЕРП_ЖурналУведомлений.Ошибка("EMAIL", Результат.ОписаниеОшибки);
            Возврат Результат;
        КонецЕсли;

        ПроверитьТаймаутУчетнойЗаписи(ПараметрыПисьма.УчетнаяЗапись);

        АдресУчетнойЗаписи = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
            ПараметрыПисьма.УчетнаяЗапись,
            "АдресЭлектроннойПочты"
        );

        Если Не ЗначениеЗаполнено(АдресУчетнойЗаписи) Тогда
            Результат.ОписаниеОшибки =
                "В учетной записи БСП не заполнен адрес электронной почты отправителя.";
            ЕРП_ЖурналУведомлений.Ошибка("EMAIL", Результат.ОписаниеОшибки);
            Возврат Результат;
        КонецЕсли;

        ИспользоватьДляОтправки = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
            ПараметрыПисьма.УчетнаяЗапись,
            "ИспользоватьДляОтправки"
        );

        Если Не ИспользоватьДляОтправки Тогда
            Результат.ОписаниеОшибки =
                "Учетная запись БСП отключена для отправки почты.";
            ЕРП_ЖурналУведомлений.Ошибка("EMAIL", Результат.ОписаниеОшибки);
            Возврат Результат;
        КонецЕсли;

        Для Каждого АдресПолучателя Из АдресаПолучателей Цикл
            Получатель = ПараметрыПисьма.Получатели.Добавить();
            Получатель.Адрес = АдресПолучателя;
        КонецЦикла;

        ПараметрыПисьма.Тема = ТемаПисьма;
        ПараметрыПисьма.Тело = ТекстПисьма;
        ПараметрыПисьма.ТипТекста =
            ТипТекстаПочтовогоСообщения.ПростойТекст;

        // После начала вызова БСП исключение уже не доказывает,
        // что почтовый сервер не принял письмо.
        Результат.РезультатНеопределен = Истина;
        РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(
            ПараметрыПисьма
        );

        Результат.Успех = Истина;
        Результат.РезультатНеопределен = Ложь;

        ЕРП_ЖурналУведомлений.Информация(
            "EMAIL",
            "Письмо передано штатной подсистеме БСП.",
            "Количество получателей: " + Строка(АдресаПолучателей.Количество())
        );

    Исключение

        Результат.Успех = Ложь;
        Результат.РезультатНеопределен = Истина;
        Результат.ОписаниеОшибки =
            КраткоеПредставлениеОшибки(ИнформацияОбОшибке());

        ЕРП_ЖурналУведомлений.Ошибка(
            "EMAIL",
            "Ошибка отправки через БСП: " + Результат.ОписаниеОшибки,
            "Количество получателей: " + Строка(АдресаПолучателей.Количество())
        );

    КонецПопытки;

    Возврат Результат;

КонецФункции

#КонецОбласти


#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьТаймаутУчетнойЗаписи(УчетнаяЗапись)

    Попытка

        МетаданныеУчетнойЗаписи = УчетнаяЗапись.Метаданные();
        ИмяРеквизитаТаймаута = "";

        Если МетаданныеУчетнойЗаписи.Реквизиты.Найти("ВремяОжидания")
            <> Неопределено Тогда
            ИмяРеквизитаТаймаута = "ВремяОжидания";
        ИначеЕсли МетаданныеУчетнойЗаписи.Реквизиты.Найти("Таймаут")
            <> Неопределено Тогда
            ИмяРеквизитаТаймаута = "Таймаут";
        КонецЕсли;

        Если ПустаяСтрока(ИмяРеквизитаТаймаута) Тогда
            Возврат;
        КонецЕсли;

        ТаймаутСек = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
            УчетнаяЗапись,
            ИмяРеквизитаТаймаута
        );

        Если ТипЗнч(ТаймаутСек) <> Тип("Число") Тогда
            ЕРП_ЖурналУведомлений.Предупреждение(
                "EMAIL",
                "Реквизит таймаута учетной записи имеет неожиданный тип.",
                "Реквизит: " + ИмяРеквизитаТаймаута
            );
            Возврат;
        КонецЕсли;

        Если ТаймаутСек = 0 Или ТаймаутСек > 45 Тогда
            ЕРП_ЖурналУведомлений.Предупреждение(
                "EMAIL",
                "Таймаут учетной записи почты выходит за рекомендуемые пределы.",
                "Реквизит: " + ИмяРеквизитаТаймаута
                    + "; значение, сек.: " + Строка(ТаймаутСек)
            );
        КонецЕсли;

    Исключение

        ЕРП_ЖурналУведомлений.Предупреждение(
            "EMAIL",
            "Не удалось проверить таймаут учетной записи почты.",
            КраткоеПредставлениеОшибки(ИнформацияОбОшибке())
        );

    КонецПопытки;

КонецПроцедуры

#КонецОбласти

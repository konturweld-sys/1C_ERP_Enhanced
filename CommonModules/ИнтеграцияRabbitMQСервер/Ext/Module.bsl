
Функция СоздатьИзделие(Запрос) Экспорт

    Попытка
        Тело = Запрос.ПолучитьТелоКакСтроку();

        Если ПустаяСтрока(Тело) Тогда
            Возврат ОтветJSON(400, Ложь, "EMPTY_BODY",
                "Тело запроса не заполнено.");
        КонецЕсли;

        Попытка
            Чтение = Новый ЧтениеJSON;
            Чтение.УстановитьСтроку(Тело);
            Данные = ПрочитатьJSON(Чтение);
        Исключение
            Возврат ОтветJSON(
                400,
                Ложь,
                "INVALID_JSON",
                "Тело запроса содержит некорректный JSON.");
        КонецПопытки;

        Если ТипЗнч(Данные) <> Тип("Структура") Тогда
            Возврат ОтветJSON(400, Ложь, "INVALID_JSON_OBJECT",
                "Ожидается JSON-объект.");
        КонецЕсли;

        Версия = Поле(Данные, "schemaVersion", "SchemaVersion");
        MessageId = НРег(СокрЛП(Поле(Данные, "messageId", "MessageId")));
        EventType = Поле(Данные, "eventType", "EventType");
        SourceSystem = Поле(Данные, "sourceSystem", "SourceSystem");
        SourceRef = СокрЛП(Поле(Данные, "sourceRef", "SourceRef"));
        ItemName = СокрЛП(Поле(Данные, "itemName", "ItemName"));
        ВидНоменклатуры = СокрЛП(
            Поле(Данные, "nomenclatureView", "NomenclatureView"));
        ЕдиницаХранения = СокрЛП(
            Поле(Данные, "storageUnit", "StorageUnit"));
        ТипНоменклатурыНоменклатуры = СокрЛП(
            Поле(Данные, "nomenclatureType", "NomenclatureType"));
        Артикул = СокрЛП(Поле(Данные, "article", "Article"));
        КодИзИсточника = СокрЛП(Поле(Данные, "code", "Code"));
        ИспользованиеХарактеристик = Поле(
            Данные, "usesCharacteristics", "UsesCharacteristics");

        Если ТипЗнч(Версия) <> Тип("Число") Или Версия <> 1 Тогда
            Возврат ОтветJSON(400, Ложь, "UNSUPPORTED_SCHEMA_VERSION",
                "Поддерживается только schemaVersion = 1.");
        КонецЕсли;

        Если НЕ ЭтоUUID(MessageId) Тогда
            Возврат ОтветJSON(400, Ложь, "INVALID_MESSAGE_ID",
                "messageId должен быть UUID.");
        КонецЕсли;

        Если EventType <> "nomenclature.created"
            И EventType <> "nomenclatureView.created" Тогда
            Возврат ОтветJSON(400, Ложь, "INVALID_EVENT_TYPE",
                "Поддерживаются nomenclatureView.created и nomenclature.created.");
        КонецЕсли;

        Если ТипЗнч(SourceSystem) <> Тип("Строка")
            Или ПустаяСтрока(СокрЛП(SourceSystem)) Тогда
            Возврат ОтветJSON(400, Ложь, "SOURCE_SYSTEM_REQUIRED",
                "Не заполнено sourceSystem.");
        КонецЕсли;

        Если ПустаяСтрока(SourceRef) Тогда
            Возврат ОтветJSON(400, Ложь, "SOURCE_REF_REQUIRED",
                "Не заполнено sourceRef.");
        КонецЕсли;

        Если СтрДлина(SourceRef) > 255 Тогда
            Возврат ОтветJSON(400, Ложь, "SOURCE_REF_TOO_LONG",
                "sourceRef превышает допустимую длину 255 символов.");
        КонецЕсли;

        Если EventType = "nomenclatureView.created" Тогда

            РезультатВидаДляОбмена = СоздатьИлиНайтиВидНоменклатуры(
                MessageId,
                SourceSystem,
                SourceRef,
                ItemName,
                СокрЛП(Поле(Данные, "nomenclatureType", "NomenclatureType")),
                ЕдиницаХранения,
                ИспользованиеХарактеристик);

            Возврат ОтветJSON(
                РезультатВидаДляОбмена.КодHTTP,
                РезультатВидаДляОбмена.Успех,
                РезультатВидаДляОбмена.Код,
                РезультатВидаДляОбмена.Текст,
                ItemName,
                РезультатВидаДляОбмена.Ссылка,
                MessageId,
                РезультатВидаДляОбмена.Повтор);

        КонецЕсли;

        Если ВРег(ТипНоменклатурыНоменклатуры) <> ВРег("Товар") Тогда
            Возврат ОтветJSON(422, Ложь, "UNSUPPORTED_ITEM_TYPE",
                "Тестовый приёмник принимает только номенклатуру типа «Товар». Получено: "
                + ТипНоменклатурыНоменклатуры);
        КонецЕсли;

        Если ПустаяСтрока(ItemName) Тогда
            Возврат ОтветJSON(400, Ложь, "ITEM_NAME_REQUIRED",
                "Не заполнено itemName.");
        КонецЕсли;

        Если СтрДлина(ItemName) > 150 Тогда
            Возврат ОтветJSON(400, Ложь, "ITEM_NAME_TOO_LONG",
                "Наименование превышает допустимую длину 150 символов.");
        КонецЕсли;

        Если ПустаяСтрока(ВидНоменклатуры) Тогда
            Возврат ОтветJSON(400, Ложь, "NOMENCLATURE_VIEW_REQUIRED",
                "Не заполнено nomenclatureView.");
        КонецЕсли;

        Если ПустаяСтрока(ЕдиницаХранения) Тогда
            Возврат ОтветJSON(400, Ложь, "STORAGE_UNIT_REQUIRED",
                "Не заполнено storageUnit.");
        КонецЕсли;

        Если ТипЗнч(ИспользованиеХарактеристик) <> Тип("Булево") Тогда
            Возврат ОтветJSON(400, Ложь, "INVALID_CHARACTERISTICS_FLAG",
                "usesCharacteristics должен быть логическим.");
        КонецЕсли;

        Если ИспользованиеХарактеристик Тогда
            Возврат ОтветJSON(400, Ложь, "CHARACTERISTICS_NOT_SUPPORTED",
                "Позиции должны создаваться без характеристик.");
        КонецЕсли;

        Если СтрДлина(Артикул) > 50 Тогда
            Возврат ОтветJSON(400, Ложь, "ARTICLE_TOO_LONG",
                "Артикул превышает допустимую длину 50 символов.");
        КонецЕсли;

        Результат = СоздатьИлиНайтиНоменклатуру(
            MessageId,
            SourceSystem,
            SourceRef,
            ItemName,
            ВидНоменклатуры,
            ЕдиницаХранения,
            Артикул,
            КодИзИсточника);

        Возврат ОтветJSON(
            Результат.КодHTTP,
            Результат.Успех,
            Результат.Код,
            Результат.Текст,
            ItemName,
            Результат.Ссылка,
            MessageId,
            Результат.Повтор);

    Исключение
        ЗаписьЖурналаРегистрации(
            "ИнтеграцияRabbitMQ",
            УровеньЖурналаРегистрации.Ошибка,
            ,
            ,
            "HTTP_RECEIVER_ERROR; " + ОписаниеОшибки());

        Возврат ОтветJSON(
            500,
            Ложь,
            "INTERNAL_ERROR",
            "Внутренняя ошибка ERP. Результат операции не подтверждён; сообщение можно повторить.");
    КонецПопытки;

КонецФункции


Функция Поле(Данные, ИмяJSON, ИмяPascal)

    Значение = Неопределено;

    Если Данные.Свойство(ИмяJSON, Значение) Тогда
        Возврат Значение;
    КонецЕсли;

    Если Данные.Свойство(ИмяPascal, Значение) Тогда
        Возврат Значение;
    КонецЕсли;

    Возврат Неопределено;

КонецФункции


Функция ЭтоUUID(Значение)

    Если ТипЗнч(Значение) <> Тип("Строка")
        Или СтрДлина(Значение) <> 36 Тогда
        Возврат Ложь;
    КонецЕсли;

    Если Сред(Значение, 9, 1) <> "-"
        Или Сред(Значение, 14, 1) <> "-"
        Или Сред(Значение, 19, 1) <> "-"
        Или Сред(Значение, 24, 1) <> "-" Тогда
        Возврат Ложь;
    КонецЕсли;

    БезДефисов = СтрЗаменить(Значение, "-", "");

    Для ИндексСимвола = 1 По СтрДлина(БезДефисов) Цикл
        Если Найти(
            "0123456789abcdef",
            НРег(Сред(БезДефисов, ИндексСимвола, 1))) = 0 Тогда
            Возврат Ложь;
        КонецЕсли;
    КонецЦикла;

    Возврат Истина;

КонецФункции


Функция НайтиВидНоменклатуры(НаименованиеВида)

    Результат = Новый Структура(
        "Успех,Ссылка,Код,Текст",
        Ложь,
        Справочники.ВидыНоменклатуры.ПустаяСсылка(),
        "VIEW_NOT_FOUND",
        "Вид номенклатуры не найден.");

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |   Виды.Ссылка КАК Ссылка,
    |   Виды.ТипНоменклатуры КАК ТипНоменклатуры,
    |   Виды.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
    |   Виды.ИспользованиеХарактеристик КАК ИспользованиеХарактеристик
    |ИЗ
    |   Справочник.ВидыНоменклатуры КАК Виды
    |ГДЕ
    |   Виды.Наименование = &Наименование
    |   И НЕ Виды.ПометкаУдаления";

    Запрос.УстановитьПараметр("Наименование", НаименованиеВида);

    Выборка = Запрос.Выполнить().Выбрать();
    Количество = 0;
    НайденнаяСсылка = Справочники.ВидыНоменклатуры.ПустаяСсылка();

    Пока Выборка.Следующий() Цикл
        Количество = Количество + 1;
        НайденнаяСсылка = Выборка.Ссылка;
    КонецЦикла;

    Если Количество = 0 Тогда
        Возврат Результат;
    КонецЕсли;

    Если Количество > 1 Тогда
        Результат.Код = "VIEW_AMBIGUOUS";
        Результат.Текст =
            "Найдено несколько видов номенклатуры с таким наименованием.";
        Возврат Результат;
    КонецЕсли;

    Результат.Успех = Истина;
    Результат.Ссылка = НайденнаяСсылка;
    Результат.Код = "OK";
    Результат.Текст = "Вид номенклатуры найден.";

    Возврат Результат;

КонецФункции


Функция НайтиЕдиницуХранения(НаименованиеЕдиницы)

    Результат = Новый Структура(
        "Успех,Ссылка,Код,Текст",
        Ложь,
        Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка(),
        "STORAGE_UNIT_NOT_FOUND",
        "Единица хранения не найдена.");

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |   Единицы.Ссылка КАК Ссылка
    |ИЗ
    |   Справочник.УпаковкиЕдиницыИзмерения КАК Единицы
    |ГДЕ
    |   (Единицы.Наименование = &Наименование
    |       ИЛИ Единицы.НаименованиеПолное = &Наименование)
    |   И НЕ Единицы.ПометкаУдаления";

    Запрос.УстановитьПараметр("Наименование", НаименованиеЕдиницы);

    Выборка = Запрос.Выполнить().Выбрать();
    Количество = 0;
    НайденнаяСсылка =
        Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка();

    Пока Выборка.Следующий() Цикл
        Количество = Количество + 1;
        НайденнаяСсылка = Выборка.Ссылка;
    КонецЦикла;

    Если Количество = 0 Тогда
        Возврат Результат;
    КонецЕсли;

    Если Количество > 1 Тогда
        Результат.Код = "STORAGE_UNIT_AMBIGUOUS";
        Результат.Текст =
            "Единица хранения неоднозначна: найдено несколько совпадений.";
        Возврат Результат;
    КонецЕсли;

    Результат.Успех = Истина;
    Результат.Ссылка = НайденнаяСсылка;
    Результат.Код = "OK";
    Результат.Текст = "Единица хранения найдена.";

    Возврат Результат;

КонецФункции


Функция СоздатьИлиНайтиНоменклатуру(
    MessageId,
    SourceSystem,
    SourceRef,
    ItemName,
    НаименованиеВида,
    НаименованиеЕдиницы,
    Артикул,
    КодИзИсточника)

    Р = Новый Структура(
        "Успех,КодHTTP,Код,Текст,Ссылка,Повтор",
        Ложь,
        500,
        "PROCESSING_ERROR",
        "Операция не подтверждена.",
        "",
        Ложь);

    НачатьТранзакцию();

    Попытка

        Блокировка = Новый БлокировкаДанных;

        БлокНоменклатуры =
            Блокировка.Добавить("Справочник.Номенклатура");
        БлокНоменклатуры.Режим =
            РежимБлокировкиДанных.Исключительный;

        БлокСообщений =
            Блокировка.Добавить(
                "РегистрСведений.Расш1_ОбработанныеСообщения");
        БлокСообщений.Режим =
            РежимБлокировкиДанных.Исключительный;
        БлокСообщений.УстановитьЗначение("MessageId", MessageId);

        Блокировка.Заблокировать();

        Запись = РегистрыСведений.Расш1_ОбработанныеСообщения
            .СоздатьМенеджерЗаписи();
        Запись.MessageId = MessageId;
        Запись.Прочитать();

        Если Запись.Выбран() Тогда

            Если Запись.SourceRef <> SourceRef
                Или Запись.ItemName <> ItemName Тогда
                ОтменитьТранзакцию();

                Р.КодHTTP = 409;
                Р.Код = "MESSAGE_ID_CONFLICT";
                Р.Текст =
                    "Этот MessageId уже использован для другого сообщения.";

                Возврат Р;
            КонецЕсли;

            Если ПустаяСтрока(Запись.NomenclatureRef) Тогда
                ОтменитьТранзакцию();

                Р.КодHTTP = 500;
                Р.Код = "INCOMPLETE_PREVIOUS_RESULT";
                Р.Текст =
                    "В регистре найден неполный результат предыдущей обработки.";

                Возврат Р;
            КонецЕсли;

            ЗафиксироватьТранзакцию();

            Р.Успех = Истина;
            Р.КодHTTP = 200;
            Р.Код = "DUPLICATE_MESSAGE";
            Р.Текст = "Сообщение уже обработано.";
            Р.Ссылка = Запись.NomenclatureRef;
            Р.Повтор = Истина;

            Возврат Р;

        КонецЕсли;

        РезультатВида = НайтиВидНоменклатуры(НаименованиеВида);

        Если НЕ РезультатВида.Успех Тогда
            ОтменитьТранзакцию();

            Р.КодHTTP = 422;
            Р.Код = РезультатВида.Код;
            Р.Текст = РезультатВида.Текст;

            Возврат Р;
        КонецЕсли;

        ВидСсылка = РезультатВида.Ссылка;
        ОбъектВида = ВидСсылка.ПолучитьОбъект();

        Если ЗначениеЗаполнено(ОбъектВида.ТипНоменклатуры)
            И ОбъектВида.ТипНоменклатуры <>
                Перечисления.ТипыНоменклатуры.Товар Тогда

            ОтменитьТранзакцию();

            Р.КодHTTP = 422;
            Р.Код = "VIEW_TYPE_CONFLICT";
            Р.Текст =
                "Выбранный вид номенклатуры не относится к типу Товар.";

            Возврат Р;

        КонецЕсли;

        Если ЗначениеЗаполнено(
            ОбъектВида.ИспользованиеХарактеристик)
            И ОбъектВида.ИспользованиеХарактеристик <>
                Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать Тогда

            ОтменитьТранзакцию();

            Р.КодHTTP = 422;
            Р.Код = "VIEW_CHARACTERISTICS_CONFLICT";
            Р.Текст =
                "Для выбранного вида номенклатуры включены характеристики. "
                + "Измените настройку вида в ERP вручную.";

            Возврат Р;

        КонецЕсли;

        РезультатЕдиницы =
            НайтиЕдиницуХранения(НаименованиеЕдиницы);

        Если НЕ РезультатЕдиницы.Успех Тогда
            ОтменитьТранзакцию();

            Р.КодHTTP = 422;
            Р.Код = РезультатЕдиницы.Код;
            Р.Текст = РезультатЕдиницы.Текст;

            Возврат Р;
        КонецЕсли;

        ЕдиницаСсылка = РезультатЕдиницы.Ссылка;

        Если ЗначениеЗаполнено(ОбъектВида.ЕдиницаИзмерения)
            И ОбъектВида.ЕдиницаИзмерения <> ЕдиницаСсылка Тогда

            ОтменитьТранзакцию();

            Р.КодHTTP = 422;
            Р.Код = "VIEW_UNIT_CONFLICT";
            Р.Текст =
                "Единица хранения сообщения не совпадает с единицей "
                + "хранения выбранного вида номенклатуры.";

            Возврат Р;

        КонецЕсли;

        Запрос = Новый Запрос;
        Запрос.Текст =
        "ВЫБРАТЬ
        |   Номенклатура.Ссылка КАК Ссылка,
        |   Номенклатура.Наименование КАК Наименование,
        |   Номенклатура.НаименованиеПолное КАК НаименованиеПолное
        |ИЗ
        |   Справочник.Номенклатура КАК Номенклатура
        |ГДЕ
        |   Номенклатура.Наименование = &Наименование
        |   ИЛИ Номенклатура.НаименованиеПолное = &Наименование";

        Запрос.УстановитьПараметр("Наименование", ItemName);

        Выборка = Запрос.Выполнить().Выбрать();
        КоличествоСовпадений = 0;
        СуществующаяСсылка =
            Справочники.Номенклатура.ПустаяСсылка();

        Пока Выборка.Следующий() Цикл

            Если Выборка.Наименование = ItemName
                Или Выборка.НаименованиеПолное = ItemName Тогда

                КоличествоСовпадений = КоличествоСовпадений + 1;
                СуществующаяСсылка = Выборка.Ссылка;

            КонецЕсли;

        КонецЦикла;

        Если КоличествоСовпадений > 1 Тогда
            ОтменитьТранзакцию();

            Р.КодHTTP = 409;
            Р.Код = "ITEM_NAME_AMBIGUOUS";
            Р.Текст =
                "В ERP уже существует несколько позиций с таким точным именем.";

            Возврат Р;
        КонецЕсли;

        Если КоличествоСовпадений = 1 Тогда

            СуществующийОбъект = СуществующаяСсылка.ПолучитьОбъект();

            Если СуществующийОбъект.ВидНоменклатуры <> ВидСсылка
                Или СуществующийОбъект.ЕдиницаИзмерения <> ЕдиницаСсылка
                Или СуществующийОбъект.ТипНоменклатуры <>
                    Перечисления.ТипыНоменклатуры.Товар
                Или СуществующийОбъект.ИспользованиеХарактеристик <>
                    Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать Тогда

                ОтменитьТранзакцию();

                Р.КодHTTP = 409;
                Р.Код = "EXISTING_ITEM_CONFLICT";
                Р.Текст =
                    "Позиция с таким точным именем уже существует, "
                    + "но её вид, единица или настройка характеристик отличаются.";

                Возврат Р;

            КонецЕсли;

            Ссылка = СуществующаяСсылка;
            КодРезультата = "ALREADY_EXISTS";
            ТекстРезультата =
                "Позиция с таким точным наименованием уже существует и проверена.";
            КодHTTP = 200;

        Иначе

            Элемент = Справочники.Номенклатура.СоздатьЭлемент();

            Элемент.Наименование = ItemName;
            Элемент.НаименованиеПолное = ItemName;
            Элемент.ВидНоменклатуры = ВидСсылка;
            Элемент.ЕдиницаИзмерения = ЕдиницаСсылка;
            Элемент.ТипНоменклатуры =
                Перечисления.ТипыНоменклатуры.Товар;
            Элемент.ИспользованиеХарактеристик =
                Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать;

            Если НЕ ПустаяСтрока(Артикул) Тогда
                Элемент.Артикул = Артикул;
            КонецЕсли;

            Если НЕ ПустаяСтрока(КодИзИсточника) Тогда
                Элемент.Код = КодИзИсточника;
            КонецЕсли;

            Элемент.Записать();

            Ссылка = Элемент.Ссылка;
            КодРезультата = "CREATED";
            ТекстРезультата = "Позиция номенклатуры создана.";
            КодHTTP = 201;

        КонецЕсли;

        Запись = РегистрыСведений.Расш1_ОбработанныеСообщения
            .СоздатьМенеджерЗаписи();

        Запись.MessageId = MessageId;
        Запись.SourceRef = SourceRef;
        Запись.ItemName = ItemName;
        Запись.NomenclatureRef =
            Строка(Ссылка.УникальныйИдентификатор());
        Запись.ResultCode = КодРезультата;
        Запись.ProcessedAt = ТекущаяДатаСеанса();
        Запись.Записать();

        ЗафиксироватьТранзакцию();

        Р.Успех = Истина;
        Р.КодHTTP = КодHTTP;
        Р.Код = КодРезультата;
        Р.Текст = ТекстРезультата;
        Р.Ссылка = Строка(Ссылка.УникальныйИдентификатор());

        Возврат Р;

    Исключение

        ТекстОшибки = ОписаниеОшибки();
        ОтменитьТранзакцию();

        ЗаписьЖурналаРегистрации(
            "ИнтеграцияRabbitMQ",
            УровеньЖурналаРегистрации.Ошибка,
            ,
            ,
            "NOMENCLATURE_TRANSACTION_ERROR; MessageId="
                + MessageId + "; " + ТекстОшибки);

        Р.КодHTTP = 500;
        Р.Код = "TRANSACTION_FAILED";
        Р.Текст =
            "Операция не подтверждена. Сообщение можно повторить после проверки журнала.";

        Возврат Р;

    КонецПопытки;

КонецФункции


Функция ОтветJSON(
    КодHTTP,
    Успех,
    Код,
    Текст,
    ItemName = "",
    Ссылка = "",
    MessageId = "",
    Повтор = Ложь)

    Ответ = Новый HTTPСервисОтвет(КодHTTP);
    Ответ.Заголовки.Вставить(
        "Content-Type",
        "application/json; charset=utf-8");

    Данные = Новый Структура;
    Данные.Вставить("success", Успех);
    Данные.Вставить("code", Код);
    Данные.Вставить("message", Текст);

    Если НЕ ПустаяСтрока(ItemName) Тогда
        Данные.Вставить("itemName", ItemName);
    КонецЕсли;

    Если НЕ ПустаяСтрока(Ссылка) Тогда
        Данные.Вставить("nomenclatureRef", Ссылка);
    КонецЕсли;

    Если НЕ ПустаяСтрока(MessageId) Тогда
        Данные.Вставить("messageId", MessageId);
    КонецЕсли;

    Данные.Вставить("duplicateMessage", Повтор);

    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, Данные);

    Ответ.УстановитьТелоИзСтроки(
        ЗаписьJSON.Закрыть(),
        КодировкаТекста.UTF8);

    Возврат Ответ;

КонецФункции



Функция СоздатьИлиНайтиВидНоменклатуры(
    MessageId,
    SourceSystem,
    SourceRef,
    НаименованиеВида,
    НаименованиеТипа,
    НаименованиеЕдиницы,
    ИспользованиеХарактеристик)

    Р = Новый Структура(
        "Успех,КодHTTP,Код,Текст,Ссылка,Повтор",
        Ложь,
        500,
        "PROCESSING_ERROR",
        "Операция не подтверждена.",
        "",
        Ложь);

    Если ПустаяСтрока(НаименованиеВида) Тогда
        Р.КодHTTP = 400;
        Р.Код = "VIEW_NAME_REQUIRED";
        Р.Текст = "Не заполнено наименование вида номенклатуры.";
        Возврат Р;
    КонецЕсли;

    Если СтрДлина(НаименованиеВида) > 150 Тогда
        Р.КодHTTP = 400;
        Р.Код = "VIEW_NAME_TOO_LONG";
        Р.Текст = "Наименование вида превышает 150 символов.";
        Возврат Р;
    КонецЕсли;

    Если ВРег(НаименованиеТипа) <> ВРег("Товар") Тогда
        Р.КодHTTP = 422;
        Р.Код = "UNSUPPORTED_NOMENCLATURE_TYPE";
        Р.Текст =
            "Тестовый приёмник пока принимает только тип номенклатуры «Товар». "
            + "Получено: " + НаименованиеТипа;
        Возврат Р;
    КонецЕсли;

    Если ТипЗнч(ИспользованиеХарактеристик) <> Тип("Булево") Тогда
        Р.КодHTTP = 400;
        Р.Код = "INVALID_CHARACTERISTICS_FLAG";
        Р.Текст = "usesCharacteristics должен быть логическим.";
        Возврат Р;
    КонецЕсли;

    Если ИспользованиеХарактеристик Тогда
        Р.КодHTTP = 422;
        Р.Код = "CHARACTERISTICS_NOT_SUPPORTED";
        Р.Текст =
            "Для тестового переноса разрешены только виды без характеристик.";
        Возврат Р;
    КонецЕсли;

    РезультатЕдиницы = НайтиЕдиницуХранения(НаименованиеЕдиницы);

    Если НЕ РезультатЕдиницы.Успех Тогда
        Р.КодHTTP = 422;
        Р.Код = РезультатЕдиницы.Код;
        Р.Текст = РезультатЕдиницы.Текст;
        Возврат Р;
    КонецЕсли;

    ЕдиницаСсылка = РезультатЕдиницы.Ссылка;
    SourceRefВида = "VIEW:" + SourceRef;

    НачатьТранзакцию();

    Попытка

        Блокировка = Новый БлокировкаДанных;
        БлокВидов = Блокировка.Добавить("Справочник.ВидыНоменклатуры");
        БлокВидов.Режим = РежимБлокировкиДанных.Исключительный;

        БлокСообщений = Блокировка.Добавить(
            "РегистрСведений.Расш1_ОбработанныеСообщения");
        БлокСообщений.Режим = РежимБлокировкиДанных.Исключительный;
        БлокСообщений.УстановитьЗначение("MessageId", MessageId);

        Блокировка.Заблокировать();

        Запись = РегистрыСведений.Расш1_ОбработанныеСообщения
            .СоздатьМенеджерЗаписи();
        Запись.MessageId = MessageId;
        Запись.Прочитать();

        Если Запись.Выбран() Тогда

            Если Запись.SourceRef <> SourceRefВида
                Или Запись.ItemName <> НаименованиеВида Тогда

                ОтменитьТранзакцию();
                Р.КодHTTP = 409;
                Р.Код = "MESSAGE_ID_CONFLICT";
                Р.Текст =
                    "Этот MessageId уже использован для другого объекта.";
                Возврат Р;

            КонецЕсли;

            Если ПустаяСтрока(Запись.NomenclatureRef) Тогда
                ОтменитьТранзакцию();
                Р.КодHTTP = 500;
                Р.Код = "INCOMPLETE_PREVIOUS_RESULT";
                Р.Текст = "В регистре найден неполный результат обработки вида.";
                Возврат Р;
            КонецЕсли;

            ЗафиксироватьТранзакцию();
            Р.Успех = Истина;
            Р.КодHTTP = 200;
            Р.Код = "DUPLICATE_MESSAGE";
            Р.Текст = "Сообщение о виде уже обработано.";
            Р.Ссылка = Запись.NomenclatureRef;
            Р.Повтор = Истина;
            Возврат Р;

        КонецЕсли;

        Запрос = Новый Запрос;
        Запрос.Текст =
        "ВЫБРАТЬ
        |   Виды.Ссылка КАК Ссылка,
        |   Виды.ТипНоменклатуры КАК ТипНоменклатуры,
        |   Виды.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
        |   Виды.ИспользованиеХарактеристик КАК ИспользованиеХарактеристик
        |ИЗ
        |   Справочник.ВидыНоменклатуры КАК Виды
        |ГДЕ
        |   Виды.Наименование = &Наименование
        |   И НЕ Виды.ПометкаУдаления";

        Запрос.УстановитьПараметр("Наименование", НаименованиеВида);
        Выборка = Запрос.Выполнить().Выбрать();

        Количество = 0;
        СсылкаВида = Справочники.ВидыНоменклатуры.ПустаяСсылка();

        Пока Выборка.Следующий() Цикл
            Количество = Количество + 1;
            СсылкаВида = Выборка.Ссылка;
        КонецЦикла;

        Если Количество > 1 Тогда
            ОтменитьТранзакцию();
            Р.КодHTTP = 409;
            Р.Код = "VIEW_NAME_AMBIGUOUS";
            Р.Текст =
                "В ERP найдено несколько видов с таким точным наименованием.";
            Возврат Р;
        КонецЕсли;

        Если Количество = 1 Тогда

            СуществующийВид = СсылкаВида.ПолучитьОбъект();

            Если СуществующийВид.ТипНоменклатуры <>
                    Перечисления.ТипыНоменклатуры.Товар
                Или СуществующийВид.ЕдиницаИзмерения <> ЕдиницаСсылка
                Или СуществующийВид.ИспользованиеХарактеристик <>
                    Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать Тогда

                ОтменитьТранзакцию();
                Р.КодHTTP = 409;
                Р.Код = "EXISTING_VIEW_CONFLICT";
                Р.Текст =
                    "Вид с таким точным именем уже существует, "
                    + "но его тип, единица или настройка характеристик отличаются.";
                Возврат Р;

            КонецЕсли;

            КодРезультата = "ALREADY_EXISTS";
            ТекстРезультата =
                "Вид с таким точным наименованием уже существует и проверен.";
            КодHTTP = 200;

        Иначе

            ВидОбъект = Справочники.ВидыНоменклатуры.СоздатьЭлемент();
            ВидОбъект.Наименование = НаименованиеВида;
            ВидОбъект.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Товар;
            ВидОбъект.ЕдиницаИзмерения = ЕдиницаСсылка;
            ВидОбъект.ИспользованиеХарактеристик =
                Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать;
            ВидОбъект.Записать();

            СсылкаВида = ВидОбъект.Ссылка;
            КодРезультата = "CREATED";
            ТекстРезультата = "Вид номенклатуры создан.";
            КодHTTP = 201;

        КонецЕсли;

        Запись = РегистрыСведений.Расш1_ОбработанныеСообщения
            .СоздатьМенеджерЗаписи();
        Запись.MessageId = MessageId;
        Запись.SourceRef = SourceRefВида;
        Запись.ItemName = НаименованиеВида;
        Запись.NomenclatureRef =
            Строка(СсылкаВида.УникальныйИдентификатор());
        Запись.ResultCode = КодРезультата;
        Запись.ProcessedAt = ТекущаяДатаСеанса();
        Запись.Записать();

        ЗафиксироватьТранзакцию();

        Р.Успех = Истина;
        Р.КодHTTP = КодHTTP;
        Р.Код = КодРезультата;
        Р.Текст = ТекстРезультата;
        Р.Ссылка = Строка(СсылкаВида.УникальныйИдентификатор());

        Возврат Р;

    Исключение

        ТекстОшибки = ОписаниеОшибки();
        ОтменитьТранзакцию();

        ЗаписьЖурналаРегистрации(
            "ИнтеграцияRabbitMQ",
            УровеньЖурналаРегистрации.Ошибка,
            ,
            ,
            "NOMENCLATURE_VIEW_TRANSACTION_ERROR; MessageId="
                + MessageId + "; " + ТекстОшибки);

        Р.КодHTTP = 500;
        Р.Код = "TRANSACTION_FAILED";
        Р.Текст =
            "Создание вида не подтверждено. Сообщение можно повторить после проверки журнала.";
        Возврат Р;

    КонецПопытки;

КонецФункции

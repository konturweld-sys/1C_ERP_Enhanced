
////////////////////////////////////////////////////////////////////////////////
// ОБЩИЙ МОДУЛЬ: ЕРП_ПриемИнтеграции
//
// Серверный общий модуль.
// Вызов сервера: Да.
//
// Журнал:
// D:\1C Log\ERP_Nomenclature_Integration.log
//
// Ограничения одного запуска:
// - максимум 100 сообщений;
// - максимум 20 секунд;
// - ожидание сообщения максимум 250 мс.
//
// Входящая очередь: pdm_to_erp_nomenclature
// Exchange: 1c_integration
// Очередь статусов: erp_to_pdm_statuses
// Routing key статусов: status_key
////////////////////////////////////////////////////////////////////////////////


Процедура ЕРП_ПринятьПакетыИзPDM() Экспорт

    // Стандартная регистрация начала выполнения регламентного задания ERP.
    ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(
        Метаданные.РегламентныеЗадания.ЕРП_ПриемНоменклатурыИзPDM
    );

    МаксимумСообщений = 100;
    МаксимальноеВремяСекунд = 20;
    ОжиданиеСообщенияМС = 250;

    Брокер = Неопределено;
    Потребитель = Неопределено;

    ОшибкаОбработки = "";
    ПолученоСообщений = 0;
    УспешноОбработано = 0;
    ОшибокПереноса = 0;
    ПодтвержденоСообщений = 0;

    ВремяНачала = ТекущаяДата();

    ЕРП_ЗаписатьСобытие(
        "INFO",
        "НАЧАЛО",
        "Запуск приема номенклатуры PDM. Максимум сообщений: "
        + Строка(МаксимумСообщений)
        + "; ограничение времени: "
        + Строка(МаксимальноеВремяСекунд)
        + " сек."
    );

    Попытка

        ////////////////////////////////////////////////////////////////////////
        // 1. СОЗДАНИЕ ПОДКЛЮЧЕНИЯ
        ////////////////////////////////////////////////////////////////////////

        ЕРП_ЗаписатьСобытие(
            "INFO",
            "RABBITMQ",
            "Создание подключения к RabbitMQ."
        );

        Попытка
            Брокер = ЕРП_ИнтеграцияRabbitMQ.ЕРП_СоздатьБрокер();
        Исключение
            ТекстОшибкиПодключения =
                ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());

            // Ошибка мониторинга не должна маскировать первичный отказ RabbitMQ.
            Попытка
                ЕРП_МониторингИнтеграцииPDM.ЗафиксироватьСбойRabbitMQ(
                    ТекстОшибкиПодключения
                );
            Исключение
                ЕРП_ЗаписатьСобытие(
                    "ERROR",
                    "MONITORING",
                    ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())
                );
            КонецПопытки;

            ВызватьИсключение ТекстОшибкиПодключения;
        КонецПопытки;

        // Успешное подключение сбрасывает серию ошибок.
        // Ошибка записи мониторинга не прерывает рабочий обмен.
        Попытка
            ЕРП_МониторингИнтеграцииPDM.ЗафиксироватьДоступностьRabbitMQ();
        Исключение
            ЕРП_ЗаписатьСобытие(
                "ERROR",
                "MONITORING",
                ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())
            );
        КонецПопытки;

        ЕРП_ЗаписатьСобытие(
            "INFO",
            "RABBITMQ",
            "Подключение к RabbitMQ создано."
        );

        ////////////////////////////////////////////////////////////////////////
        // 2. ПОДГОТОВКА УСТОЙЧИВОЙ ОЧЕРЕДИ ОШИБОК
        ////////////////////////////////////////////////////////////////////////

        ОчередьОшибок = "pdm_to_erp_nomenclature_errors";

        Брокер.DeclareQueue(
            ОчередьОшибок,
            Ложь,
            Истина,
            Ложь,
            Ложь
        );

        ОшибкаRabbitMQ = Брокер.GetLastError();
        Если ЗначениеЗаполнено(ОшибкаRabbitMQ) Тогда
            ВызватьИсключение
                "Не удалось подготовить очередь ошибок ERP: "
                + ОшибкаRabbitMQ;
        КонецЕсли;

        ////////////////////////////////////////////////////////////////////////
        // 3. СОЗДАНИЕ ПОТРЕБИТЕЛЯ
        ////////////////////////////////////////////////////////////////////////

        ЕРП_ЗаписатьСобытие(
            "INFO",
            "CONSUMER",
            "Создание потребителя очереди pdm_to_erp_nomenclature."
        );

        Потребитель = Брокер.BasicConsume(
            "pdm_to_erp_nomenclature",
            "",
            Ложь,
            Ложь,
            0
        );

        ОшибкаRabbitMQ = Брокер.GetLastError();

        Если ЗначениеЗаполнено(ОшибкаRabbitMQ) Тогда

            ВызватьИсключение
                "Ошибка создания потребителя RabbitMQ: "
                + ОшибкаRabbitMQ;

        КонецЕсли;

        ЕРП_ЗаписатьСобытие(
            "INFO",
            "CONSUMER",
            "Потребитель создан."
        );

        ////////////////////////////////////////////////////////////////////////
        // 3. ЦИКЛ ПОЛУЧЕНИЯ СООБЩЕНИЙ
        ////////////////////////////////////////////////////////////////////////

        Пока ПолученоСообщений < МаксимумСообщений Цикл

            Если (ТекущаяДата() - ВремяНачала)
                >= МаксимальноеВремяСекунд Тогда

                ЕРП_ЗаписатьСобытие(
                    "INFO",
                    "LIMIT",
                    "Достигнуто ограничение времени выполнения."
                );

                Прервать;

            КонецЕсли;

            ТекстСообщения = "";
            ТегСообщения = 0;

            ПолученоСообщение = Брокер.BasicConsumeMessage(
                "",
                ТекстСообщения,
                ТегСообщения,
                ОжиданиеСообщенияМС
            );

            Если Не ЗначениеЗаполнено(ТекстСообщения) Тогда

                ЕРП_ЗаписатьСобытие(
                    "INFO",
                    "RECEIVE",
                    "Сообщений в очереди за время ожидания не получено."
                );

                Прервать;

            КонецЕсли;

            ПолученоСообщений = ПолученоСообщений + 1;

            ЕРП_ЗаписатьСобытие(
                "INFO",
                "RECEIVE",
                "Получено сообщение №"
                + Строка(ПолученоСообщений)
                + "; delivery tag: "
                + Строка(ТегСообщения)
                + "; длина JSON: "
                + Строка(СтрДлина(ТекстСообщения))
            );

            ////////////////////////////////////////////////////////////////////
            // 4. ПОДГОТОВКА РЕЗУЛЬТАТА ОБРАБОТКИ
            ////////////////////////////////////////////////////////////////////

            Результат = Новый Структура;

            Результат.Вставить(
                "ТегСообщения",
                ТегСообщения
            );

            Результат.Вставить(
                "UUID",
                ""
            );

            Результат.Вставить(
                "Статус",
                "ОшибкаПереноса"
            );

            Результат.Вставить(
                "ТекстОшибки",
                ""
            );

            ТипСообщения = "";

            ////////////////////////////////////////////////////////////////////
            // 5. ПРОВЕРКА И РАЗБОР JSON
            ////////////////////////////////////////////////////////////////////

            ЕРП_ЗаписатьСобытие(
                "INFO",
                "VALIDATION",
                "Начало проверки JSON."
            );

            ТекстОшибкиВалидации = "";

            Попытка

                Данные =
                    ЕРП_ВалидацияКонтракта.ЕРП_ВалидироватьИРазобратьJSON(
                        ТекстСообщения,
                        ТекстОшибкиВалидации
                    );

            Исключение

                ТекстОшибкиВалидации =
                    ПодробноеПредставлениеОшибки(
                        ИнформацияОбОшибке()
                    );

                Данные = Неопределено;

                ЕРП_ЗаписатьСобытие(
                    "ERROR",
                    "VALIDATION",
                    ТекстОшибкиВалидации
                );

            КонецПопытки;

            Если Данные = Неопределено Тогда

                Результат.ТекстОшибки =
                    ТекстОшибкиВалидации;

                ЕРП_ЗаписатьСобытие(
                    "ERROR",
                    "VALIDATION",
                    "Сообщение не прошло проверку JSON: "
                    + ТекстОшибкиВалидации
                );

            Иначе

                Результат.UUID = Данные.UUID;
                Данные.Свойство("ТипСообщения", ТипСообщения);

                ЕРП_ЗаписатьСобытие(
                    "INFO",
                    "VALIDATION",
                    "JSON проверен. UUID: "
                    + Данные.UUID
                );

                //////////////////////////////////////////////////////////////////
                // 6. ОБРАБОТКА ДАННЫХ В ТРАНЗАКЦИИ ERP
                //////////////////////////////////////////////////////////////////

                ТранзакцияНачата = Ложь;
                СозданНовыйЭлемент = Ложь;

                Попытка

                    НачатьТранзакцию();
                    ТранзакцияНачата = Истина;

                    ЕРП_ЗаписатьСобытие(
                        "INFO",
                        "TRANSACTION",
                        "Начата транзакция обработки UUID "
                        + Данные.UUID
                    );

                    Блокировка = Новый БлокировкаДанных;

                    ЭлементБлокировки = Блокировка.Добавить(
                        "РегистрСведений.ЕРП_БлокировкаПриемаRabbitMQ"
                    );

                    ЭлементБлокировки.УстановитьЗначение(
                        "Ключ",
                        "ПриемНоменклатуры"
                    );

                    Блокировка.Заблокировать();

                    ЕРП_ЗаписатьСобытие(
                        "INFO",
                        "LOCK",
                        "Получена блокировка обработки номенклатуры."
                    );

                    Если ТипСообщения = "nomenclature-kind.upsert" Тогда

                        ЕРП_ЗаписатьСобытие(
                            "INFO",
                            "KIND",
                            "Обработка вида номенклатуры: "
                            + Данные.Наименование + "; UUID: " + Данные.UUID
                        );
                        ЕРП_ОбработатьВидНоменклатуры(Данные);

                    ИначеЕсли Данные.ЭтоГруппа Тогда

                        ЕРП_ЗаписатьСобытие(
                            "INFO",
                            "GROUP",
                            "Обработка группы: "
                            + Данные.Наименование
                            + "; UUID: "
                            + Данные.UUID
                        );

                        ЕРП_ОбработатьГруппу(Данные);

                    Иначе

                        ЕРП_ЗаписатьСобытие(
                            "INFO",
                            "ITEM",
                            "Обработка элемента: "
                            + Данные.Наименование
                            + "; UUID: "
                            + Данные.UUID
                        );

                        СозданНовыйЭлемент =
                            ЕРП_ОбработатьЭлемент(Данные);

                        Если СозданНовыйЭлемент Тогда
                            // Событие регистрируется в транзакции создания.
                            // Внешняя отправка выполняется отдельным заданием.
                            ЕРП_МониторингИнтеграцииPDM.ЗарегистрироватьУспешноеСоздание(
                                Данные.UUID,
                                Данные.Наименование
                            );
                        КонецЕсли;

                    КонецЕсли;

                    ЗафиксироватьТранзакцию();
                    ТранзакцияНачата = Ложь;

                    Результат.Статус =
                        "УспешноПеренесено";

                    ЕРП_ЗаписатьСобытие(
                        "INFO",
                        "TRANSACTION",
                        "Транзакция успешно зафиксирована. UUID: "
                        + Данные.UUID
                    );

                Исключение

                    ТекстОшибкиОбработки =
                        ПодробноеПредставлениеОшибки(
                            ИнформацияОбОшибке()
                        );

                    Если ТранзакцияНачата Тогда

                        Попытка
                            ОтменитьТранзакцию();
                            ТранзакцияНачата = Ложь;
                        Исключение
                            ТекстОшибкиОбработки =
                                ТекстОшибкиОбработки
                                + Символы.ПС
                                + "Ошибка отмены транзакции: "
                                + ПодробноеПредставлениеОшибки(
                                    ИнформацияОбОшибке()
                                );
                        КонецПопытки;

                    КонецЕсли;

                    Результат.Статус =
                        "ОшибкаПереноса";

                    Результат.ТекстОшибки =
                        ТекстОшибкиОбработки;

                    ЕРП_ЗаписатьСобытие(
                        "ERROR",
                        "PROCESSING",
                        "Ошибка обработки UUID "
                        + Данные.UUID
                        + ": "
                        + ТекстОшибкиОбработки
                    );

                КонецПопытки;

                // Счётчик пишется после rollback основной транзакции.
                Если Результат.Статус = "ОшибкаПереноса"
                    И ТипСообщения <> "nomenclature-kind.upsert"
                    И Не Данные.ЭтоГруппа Тогда
                    Попытка
                        ЕРП_МониторингИнтеграцииPDM.ЗарегистрироватьНеудачнуюПопыткуСоздания(
                            Данные.UUID,
                            Данные.Наименование,
                            Результат.ТекстОшибки
                        );
                    Исключение
                        ЕРП_ЗаписатьСобытие(
                            "ERROR",
                            "NOTIFICATION",
                            "Не удалось зафиксировать ошибку создания UUID "
                            + Данные.UUID
                            + ": "
                            + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())
                        );
                    КонецПопытки;
                КонецЕсли;

            КонецЕсли;

            ////////////////////////////////////////////////////////////////////
            // 7. ПУБЛИКАЦИЯ СТАТУСА В PDM
            ////////////////////////////////////////////////////////////////////

            ЕРП_ЗаписатьСобытие(
                "INFO",
                "STATUS",
                "Публикация статуса "
                + Результат.Статус
                + "; UUID: "
                + Результат.UUID
            );

            Если ТипСообщения <> "nomenclature-kind.upsert" Тогда
                ЕРП_ОпубликоватьСтатус(
                    Брокер,
                    Результат.UUID,
                    Результат.Статус,
                    Результат.ТекстОшибки
                );
            КонецЕсли;

            ЕРП_ЗаписатьСобытие(
                "INFO",
                "STATUS",
                "Статус опубликован. UUID: "
                + Результат.UUID
            );

            ////////////////////////////////////////////////////////////////////
            // 8. ПОДТВЕРЖДЕНИЕ УСПЕШНОГО СООБЩЕНИЯ ИЛИ СОХРАНЕНИЕ ОШИБКИ
            ////////////////////////////////////////////////////////////////////

            Если Результат.Статус = "УспешноПеренесено" Тогда

                ЕРП_ПодтвердитьСообщение(
                    Брокер,
                    Результат.ТегСообщения
                );

                ПодтвержденоСообщений = ПодтвержденоСообщений + 1;
                УспешноОбработано = УспешноОбработано + 1;

                ЕРП_ЗаписатьСобытие(
                    "INFO",
                    "ACK",
                    "Успешное сообщение подтверждено. UUID: "
                    + Результат.UUID
                );

            Иначе

                Попытка

                    ЕРП_СохранитьОшибочноеСообщение(
                        Брокер,
                        Результат.UUID,
                        ТипСообщения,
                        Результат.ТекстОшибки,
                        ТекстСообщения
                    );

                    // ACK исходного сообщения разрешён только после
                    // успешной публикации его полного содержимого в durable-очередь.
                    ЕРП_ПодтвердитьСообщение(
                        Брокер,
                        Результат.ТегСообщения
                    );

                    ПодтвержденоСообщений = ПодтвержденоСообщений + 1;
                    ОшибокПереноса = ОшибокПереноса + 1;

                    ЕРП_ЗаписатьСобытие(
                        "ERROR",
                        "ERROR_QUEUE",
                        "Сообщение сохранено в очереди "
                        + ОчередьОшибок
                        + ". UUID: "
                        + Результат.UUID
                    );

                Исключение

                    ОшибкаСохранения = ПодробноеПредставлениеОшибки(
                        ИнформацияОбОшибке()
                    );

                    ОшибкаОбработки =
                        "Не удалось сохранить ошибочное сообщение в "
                        + ОчередьОшибок
                        + ". Исходное сообщение оставлено неподтверждённым. "
                        + ОшибкаСохранения;

                    ЕРП_ЗаписатьСобытие(
                        "ERROR",
                        "ERROR_QUEUE",
                        ОшибкаОбработки
                    );

                    // Не подтверждаем исходное сообщение. После освобождения
                    // соединения RabbitMQ вернёт его в основную очередь.
                    ТекстСообщения = "";
                    ТегСообщения = 0;
                    Прервать;

                КонецПопытки;

            КонецЕсли;

            // PinkRabbitMQ требует освобождать выходные параметры
            // BasicConsumeMessage после каждой итерации.
            ТекстСообщения = "";
            ТегСообщения = 0;
        КонецЦикла;

    Исключение

        ОшибкаОбработки =
            ПодробноеПредставлениеОшибки(
                ИнформацияОбОшибке()
            );

        ЕРП_ЗаписатьСобытие(
            "ERROR",
            "FATAL",
            ОшибкаОбработки
        );

    КонецПопытки;

    ////////////////////////////////////////////////////////////////////////
    // 9. ОТМЕНА ПОТРЕБИТЕЛЯ
    ////////////////////////////////////////////////////////////////////////

    Если Брокер <> Неопределено
        И Потребитель <> Неопределено Тогда

        Попытка

            ЕРП_ЗаписатьСобытие(
                "INFO",
                "CONSUMER",
                "Отмена потребителя RabbitMQ."
            );

            Брокер.BasicCancel(Потребитель);

            ОшибкаRabbitMQ = Брокер.GetLastError();

            Если ЗначениеЗаполнено(ОшибкаRabbitMQ) Тогда

                ВызватьИсключение
                    "Ошибка отмены потребителя: "
                    + ОшибкаRabbitMQ;

            КонецЕсли;

            ЕРП_ЗаписатьСобытие(
                "INFO",
                "CONSUMER",
                "Потребитель отменён."
            );

        Исключение

            ТекстОшибкиОтмены =
                ПодробноеПредставлениеОшибки(
                    ИнформацияОбОшибке()
                );

            ЕРП_ЗаписатьСобытие(
                "ERROR",
                "CONSUMER",
                ТекстОшибкиОтмены
            );

            Если Не ЗначениеЗаполнено(ОшибкаОбработки) Тогда
                ОшибкаОбработки = ТекстОшибкиОтмены;
            КонецЕсли;

        КонецПопытки;

    КонецЕсли;

    // Освобождение объекта закрывает соединение. Это важно, если сообщение
    // осталось неподтверждённым из-за недоступности очереди ошибок:
    // RabbitMQ повторно доставит его после закрытия соединения.
    Брокер = Неопределено;

    ////////////////////////////////////////////////////////////////////////
    // 10. ИТОГОВАЯ ЗАПИСЬ
    ////////////////////////////////////////////////////////////////////////

    ВремяВыполнения = ТекущаяДата() - ВремяНачала;

    Итог =
        "Получено: " + Строка(ПолученоСообщений)
        + "; успешно обработано: " + Строка(УспешноОбработано)
        + "; ошибок переноса: " + Строка(ОшибокПереноса)
        + "; подтверждено: " + Строка(ПодтвержденоСообщений)
        + "; время выполнения, сек.: " + Строка(ВремяВыполнения);

    Если ЗначениеЗаполнено(ОшибкаОбработки) Тогда

        ЕРП_ЗаписатьСобытие(
            "ERROR",
            "ЗАВЕРШЕНИЕ",
            "Запуск завершён с технической ошибкой. " + Итог
        );

        ВызватьИсключение ОшибкаОбработки;

    Иначе

        ЕРП_ЗаписатьСобытие(
            "INFO",
            "ЗАВЕРШЕНИЕ",
            "Запуск завершён. " + Итог
        );

    КонецЕсли;

КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// СОПОСТАВЛЕНИЕ И ОБРАБОТКА ВИДОВ НОМЕНКЛАТУРЫ
////////////////////////////////////////////////////////////////////////////////

Функция ЕРП_НайтиСсылкуПоКодуИлиНаименованию(ИмяСправочника, ДанныеСправочника)

    Код = "";
    Наименование = "";
    ДанныеСправочника.Свойство("Код", Код);
    ДанныеСправочника.Свойство("Наименование", Наименование);

    Менеджер = Справочники[ИмяСправочника];

    Если Не ЗначениеЗаполнено(Код)
        И Не ЗначениеЗаполнено(Наименование) Тогда
        Возврат Менеджер.ПустаяСсылка();
    КонецЕсли;

    // Приоритет — точное совпадение кода.
    // Дубли кода запрещают автоматический выбор даже при наличии имени:
    // код перестаёт однозначно идентифицировать значение справочника.
    Если ЗначениеЗаполнено(Код) Тогда
        НайденнаяСсылкаПоКоду = Менеджер.ПустаяСсылка();
        КоличествоСовпаденийКода = 0;

        ВыборкаПоКоду = Менеджер.Выбрать();
        Пока ВыборкаПоКоду.Следующий() Цикл
            Если ВыборкаПоКоду.Код = Код Тогда
                НайденнаяСсылкаПоКоду = ВыборкаПоКоду.Ссылка;
                КоличествоСовпаденийКода = КоличествоСовпаденийКода + 1;
            КонецЕсли;
        КонецЦикла;

        Если КоличествоСовпаденийКода = 1 Тогда
            Возврат НайденнаяСсылкаПоКоду;
        ИначеЕсли КоличествоСовпаденийКода > 1 Тогда
            ВызватьИсключение
                "Неоднозначное сопоставление справочника "
                + ИмяСправочника
                + " по коду """ + Код + """: найдено записей "
                + Строка(КоличествоСовпаденийКода) + ".";
        КонецЕсли;
    КонецЕсли;

    // Если кода нет в ERP, используем точное наименование.
    // Неоднозначное совпадение не выбираем произвольно.
    Если ЗначениеЗаполнено(Наименование) Тогда

        НайденнаяСсылка = Менеджер.ПустаяСсылка();
        КоличествоСовпадений = 0;

        ВыборкаПоНаименованию = Менеджер.Выбрать();
        Пока ВыборкаПоНаименованию.Следующий() Цикл
            Если ВыборкаПоНаименованию.Наименование = Наименование Тогда
                НайденнаяСсылка = ВыборкаПоНаименованию.Ссылка;
                КоличествоСовпадений = КоличествоСовпадений + 1;
            КонецЕсли;
        КонецЦикла;

        Если КоличествоСовпадений = 1 Тогда
            Возврат НайденнаяСсылка;
        ИначеЕсли КоличествоСовпадений > 1 Тогда
            ВызватьИсключение
                "Неоднозначное сопоставление справочника "
                + ИмяСправочника
                + " по наименованию """ + Наименование + """.";
        КонецЕсли;

    КонецЕсли;

    ВызватьИсключение
        "Не найдено значение справочника " + ИмяСправочника
        + " по коду """ + Код + """ и наименованию """ + Наименование + """. "
        + "Автоматическое создание значения не выполняется.";

КонецФункции


Функция ЕРП_НормализоватьПредставлениеПеречисления(ИмяЗначения)

    // PDM может передать имя значения перечисления или его представление.
    // Удаление пробелов и приведение к нижнему регистру устраняет
    // различия "МногооборотнаяТара"/"Многооборотная тара" и т.п.
    Возврат СтрЗаменить(
        НРег(СокрЛП(ИмяЗначения)),
        " ",
        ""
    );

КонецФункции


Функция ЕРП_ПолучитьТипНоменклатурыИзPDM(ИмяЗначения)

    НормализованноеЗначение =
        ЕРП_НормализоватьПредставлениеПеречисления(ИмяЗначения);

    Если НормализованноеЗначение = "товар" Тогда
        Возврат Перечисления.ТипыНоменклатуры.Товар;
    ИначеЕсли НормализованноеЗначение = "многооборотнаятара"
        Или НормализованноеЗначение = "тара" Тогда
        Возврат Перечисления.ТипыНоменклатуры.МногооборотнаяТара;
    ИначеЕсли НормализованноеЗначение = "услуга" Тогда
        Возврат Перечисления.ТипыНоменклатуры.Услуга;
    ИначеЕсли НормализованноеЗначение = "работа" Тогда
        Возврат Перечисления.ТипыНоменклатуры.Работа;
    ИначеЕсли НормализованноеЗначение = "набор" Тогда
        Возврат Перечисления.ТипыНоменклатуры.Набор;
    КонецЕсли;

    ВызватьИсключение
        "Неизвестное значение ТипНоменклатуры из PDM: " + ИмяЗначения;

КонецФункции


Функция ЕРП_ПолучитьИспользованиеХарактеристикИзPDM(ИмяЗначения)

    НормализованноеЗначение =
        ЕРП_НормализоватьПредставлениеПеречисления(ИмяЗначения);

    Если НормализованноеЗначение = "неиспользовать"
        Или НормализованноеЗначение = "неиспользуются" Тогда
        Возврат Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать;
    ИначеЕсли НормализованноеЗначение = "общиедлявида"
        Или НормализованноеЗначение = "общиедлявиданоменклатуры" Тогда
        Возврат Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.ОбщиеДляВидаНоменклатуры;
    ИначеЕсли НормализованноеЗначение = "индивидуальныедляноменклатуры" Тогда
        Возврат Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.ИндивидуальныеДляНоменклатуры;
    ИначеЕсли НормализованноеЗначение = "общиесдругимвидомноменклатуры" Тогда
        Возврат Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.ОбщиеСДругимВидомНоменклатуры;
    КонецЕсли;

    ВызватьИсключение
        "Неизвестное значение ИспользованиеХарактеристик из PDM: " + ИмяЗначения;

КонецФункции


Процедура ЕРП_ОбработатьВидНоменклатуры(Данные)

	СсылкаВида = Справочники.ВидыНоменклатуры.ПолучитьСсылку(
		Новый УникальныйИдентификатор(Данные.UUID)
	);

	Попытка
		ОбъектВида = СсылкаВида.ПолучитьОбъект();
	Исключение
		ОбъектВида = Неопределено;
	КонецПопытки;

	Если ОбъектВида = Неопределено Тогда
		ОбъектВида = Справочники.ВидыНоменклатуры.СоздатьЭлемент();
		ОбъектВида.УстановитьСсылкуНового(СсылкаВида);
	КонецЕсли;

	ОбъектВида.Наименование = Данные.Наименование;
	ОбъектВида.ТипНоменклатуры =
		ЕРП_ПолучитьТипНоменклатурыИзPDM(Данные.ТипНоменклатуры);
	ОбъектВида.ИспользованиеХарактеристик =
		ЕРП_ПолучитьИспользованиеХарактеристикИзPDM(
			Данные.ИспользованиеХарактеристик
		);
	ОбъектВида.ИспользоватьУпаковки = Данные.ИспользоватьУпаковки;
	ОбъектВида.ИспользоватьХарактеристики = Данные.ИспользоватьХарактеристики;

	ОбъектВида.ЕдиницаИзмерения =
		ЕРП_НайтиСсылкуПоКодуИлиНаименованию(
			"УпаковкиЕдиницыИзмерения",
			Данные.ЕдиницаИзмерения
		);
	ОбъектВида.НаборУпаковок =
		ЕРП_НайтиСсылкуПоКодуИлиНаименованию(
			"НаборыУпаковок",
			Данные.НаборУпаковок
		);

	ВладелецUUID = "";
	Данные.Свойство("ВладелецХарактеристик_UUID", ВладелецUUID);
	Если ЗначениеЗаполнено(ВладелецUUID) Тогда
		СсылкаВладельца = Справочники.ВидыНоменклатуры.ПолучитьСсылку(
			Новый УникальныйИдентификатор(ВладелецUUID)
		);
		Попытка
			ОбъектВладельца = СсылкаВладельца.ПолучитьОбъект();
		Исключение
			ОбъектВладельца = Неопределено;
		КонецПопытки;
		Если ОбъектВладельца = Неопределено Тогда
			ВызватьИсключение
				"KIND_OWNER_NOT_FOUND: не найден владелец характеристик " + ВладелецUUID;
		КонецЕсли;
		ОбъектВида.ВладелецХарактеристик = СсылкаВладельца;
	Иначе
		ОбъектВида.ВладелецХарактеристик =
			Справочники.ВидыНоменклатуры.ПустаяСсылка();
	КонецЕсли;

	ОбъектВида.Записать();

	ЕРП_ЗаписатьСобытие(
		"INFO",
		"KIND",
		"Вид номенклатуры создан или обновлён. UUID: " + Данные.UUID
	);

КонецПроцедуры


Функция ЕРП_ПолучитьСсылкуВидаНоменклатурыПоUUID(UUID)

	Если Не ЗначениеЗаполнено(UUID) Тогда
		Возврат Неопределено;
	КонецЕсли;

	СсылкаВида = Справочники.ВидыНоменклатуры.ПолучитьСсылку(
		Новый УникальныйИдентификатор(UUID)
	);
	Попытка
		ОбъектВида = СсылкаВида.ПолучитьОбъект();
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Если ОбъектВида = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат СсылкаВида;

КонецФункции


////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТКА ГРУППЫ
////////////////////////////////////////////////////////////////////////////////

Процедура ЕРП_ОбработатьГруппу(Данные)

    Родитель = Неопределено;

    Если ЗначениеЗаполнено(Данные.Родитель_UUID) Тогда

        ЕРП_ЗаписатьСобытие(
            "INFO",
            "GROUP",
            "Поиск родительской группы UUID: "
            + Данные.Родитель_UUID
        );

        Родитель =
            ЕРП_СопоставлениеНоменклатуры.ЕРП_ПолучитьСсылкуПоUUID(
                Данные.Родитель_UUID
            );

        Если Родитель = Неопределено Тогда

            ВызватьИсключение
                "Не найдена родительская группа: "
                + Данные.Родитель_UUID;

        КонецЕсли;

    КонецЕсли;

    ЕРП_СопоставлениеНоменклатуры.ЕРП_СоздатьГруппуПоUUID(
        Данные,
        Родитель
    );

    ЕРП_ЗаписатьСобытие(
        "INFO",
        "GROUP",
        "Группа обработана. UUID: " + Данные.UUID
    );

КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТКА ЭЛЕМЕНТА
////////////////////////////////////////////////////////////////////////////////

Функция ЕРП_ОбработатьЭлемент(Данные)

    ЕРП_ЗаписатьСобытие(
        "INFO",
        "ITEM",
        "Обеспечение пути родительских групп."
    );

    Родитель = ЕРП_ОбеспечитьПутьРодителей(Данные);

    ЕРП_ЗаписатьСобытие(
        "INFO",
        "ITEM",
        "Поиск существующего элемента по UUID: "
        + Данные.UUID
    );

    Ссылка =
        ЕРП_СопоставлениеНоменклатуры.ЕРП_ПолучитьСсылкуПоUUID(
            Данные.UUID
        );

    НовыйЭлемент = Ссылка = Неопределено;

    Если Ссылка = Неопределено Тогда

        ЕРП_ЗаписатьСобытие(
            "INFO",
            "ITEM",
            "Элемент не найден. Создание нового элемента."
        );

        Объект = Справочники.Номенклатура.СоздатьЭлемент();

        Объект.УстановитьСсылкуНового(
            Справочники.Номенклатура.ПолучитьСсылку(
                Новый УникальныйИдентификатор(Данные.UUID)
            )
        );

    Иначе

        Если Ссылка.ЭтоГруппа Тогда

            ВызватьИсключение
                "UUID элемента уже занят группой: "
                + Данные.UUID;

        КонецЕсли;

        ЕРП_ЗаписатьСобытие(
            "INFO",
            "ITEM",
            "Найден существующий элемент. Обновление."
        );

        Объект = Ссылка.ПолучитьОбъект();

    КонецЕсли;

    Объект.Наименование = Данные.Наименование;
    Объект.Артикул = Данные.Артикул;
    Объект.Родитель = Родитель;

    СсылкаВидаНоменклатуры = ЕРП_ПолучитьСсылкуВидаНоменклатурыПоUUID(
        Данные.ВидНоменклатуры_UUID
    );
    Если СсылкаВидаНоменклатуры = Неопределено Тогда
        ВызватьИсключение
            "KIND_NOT_FOUND: вид номенклатуры с UUID "
            + Данные.ВидНоменклатуры_UUID
            + " не зарегистрирован в ERP. Сначала синхронизируйте виды номенклатуры.";
    КонецЕсли;
    Объект.ВидНоменклатуры = СсылкаВидаНоменклатуры;

    // Код ERP не переносим.
    // Характеристики и спецификации не создаём.

    ЕРП_ЗаписатьСобытие(
        "INFO",
        "ITEM",
        "Запись элемента номенклатуры."
    );

    Объект.Записать();

    ЕРП_ЗаписатьСобытие(
        "INFO",
        "ITEM",
        "Элемент записан. UUID: " + Данные.UUID
    );

    Возврат НовыйЭлемент;

КонецФункции


////////////////////////////////////////////////////////////////////////////////
// ОБЕСПЕЧЕНИЕ ПУТИ РОДИТЕЛЕЙ
////////////////////////////////////////////////////////////////////////////////

Функция ЕРП_ОбеспечитьПутьРодителей(Данные)

    Родитель = Неопределено;

    Если Не Данные.Свойство("ПутьРодителей") Тогда
        Возврат Родитель;
    КонецЕсли;

    ЕРП_ЗаписатьСобытие(
        "INFO",
        "PARENTS",
        "Количество родительских групп: "
        + Строка(Данные.ПутьРодителей.Количество())
    );

    Для Каждого ДанныеГруппы Из Данные.ПутьРодителей Цикл

        ЕРП_ЗаписатьСобытие(
            "INFO",
            "PARENTS",
            "Обработка родительской группы: "
            + ДанныеГруппы.Наименование
            + "; UUID: "
            + ДанныеГруппы.UUID
        );

        Родитель =
            ЕРП_СопоставлениеНоменклатуры.ЕРП_СоздатьГруппуПоUUID(
                ДанныеГруппы,
                Родитель
            );

    КонецЦикла;

    Возврат Родитель;

КонецФункции


////////////////////////////////////////////////////////////////////////////////
// ПУБЛИКАЦИЯ СТАТУСА
////////////////////////////////////////////////////////////////////////////////

Процедура ЕРП_ОпубликоватьСтатус(
    Брокер,
    UUID,
    Статус,
    ТекстОшибки
)

    ДанныеСтатуса = Новый Структура;

    ДанныеСтатуса.Вставить("PDM_UUID", UUID);
    ДанныеСтатуса.Вставить("Статус", Статус);
    ДанныеСтатуса.Вставить("ТекстОшибки", ТекстОшибки);
    ДанныеСтатуса.Вставить("ВремяERP", ТекущаяДата());

    ЕРП_ЗаписатьСобытие(
        "INFO",
        "STATUS",
        "Формирование JSON статуса."
    );

    ТекстJSON =
        ЕРП_ИнтеграцияRabbitMQ.ЕРП_СформироватьJSON(
            ДанныеСтатуса
        );

    ЕРП_ЗаписатьСобытие(
        "INFO",
        "STATUS",
        "Публикация в exchange 1c_integration, routing key status_key."
    );

    Брокер.BasicPublish(
        "1c_integration",
        "status_key",
        ТекстJSON,
        0,
        Истина
    );

    ОшибкаRabbitMQ = Брокер.GetLastError();

    Если ЗначениеЗаполнено(ОшибкаRabbitMQ) Тогда

        ВызватьИсключение
            "Ошибка публикации статуса RabbitMQ: "
            + ОшибкаRabbitMQ;

    КонецЕсли;

КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// СОХРАНЕНИЕ ОШИБОЧНОГО ВХОДЯЩЕГО СООБЩЕНИЯ
////////////////////////////////////////////////////////////////////////////////

Процедура ЕРП_СохранитьОшибочноеСообщение(
    Брокер,
    UUID,
    ТипСообщения,
    ТекстОшибки,
    ИсходныйJSON
)

    ОчередьОшибок = "pdm_to_erp_nomenclature_errors";

    ПакетОшибки = Новый Структура;
    ПакетОшибки.Вставить("ТипСообщения", "pdm.integration.error");
    ПакетОшибки.Вставить("UUID", UUID);
    ПакетОшибки.Вставить("ИсходныйТипСообщения", ТипСообщения);
    ПакетОшибки.Вставить("ВремяERP", ТекущаяДата());
    ПакетОшибки.Вставить("ТекстОшибки", ТекстОшибки);
    ПакетОшибки.Вставить("ИсходноеСообщениеJSON", ИсходныйJSON);

    ТекстJSONОшибки =
        ЕРП_ИнтеграцияRabbitMQ.ЕРП_СформироватьJSON(ПакетОшибки);

    // Публикация через default exchange напрямую в durable-очередь.
    Брокер.BasicPublish(
        "",
        ОчередьОшибок,
        ТекстJSONОшибки,
        0,
        Истина
    );

    ОшибкаRabbitMQ = Брокер.GetLastError();
    Если ЗначениеЗаполнено(ОшибкаRabbitMQ) Тогда
        ВызватьИсключение
            "Ошибка публикации в очередь ошибок ERP: "
            + ОшибкаRabbitMQ;
    КонецЕсли;

КонецПроцедуры



////////////////////////////////////////////////////////////////////////////////
// ПОДТВЕРЖДЕНИЕ СООБЩЕНИЯ
////////////////////////////////////////////////////////////////////////////////


Процедура ЕРП_ПодтвердитьСообщение(
    Брокер,
    ТегСообщения
)

    ЕРП_ЗаписатьСобытие(
        "INFO",
        "ACK",
        "Вызов BasicAck. Тег: " + Строка(ТегСообщения)
    );

    Брокер.BasicAck(ТегСообщения);

    ОшибкаRabbitMQ = Брокер.GetLastError();

    Если ЗначениеЗаполнено(ОшибкаRabbitMQ) Тогда

        ВызватьИсключение
            "Ошибка подтверждения сообщения RabbitMQ: "
            + ОшибкаRabbitMQ;

    КонецЕсли;

    ЕРП_ЗаписатьСобытие(
        "INFO",
        "ACK",
        "BasicAck выполнен. Тег: " + Строка(ТегСообщения)
    );

КонецПроцедуры



////////////////////////////////////////////////////////////////////////////////
// ЗАПИСЬ СОБЫТИЯ В ЖУРНАЛ
////////////////////////////////////////////////////////////////////////////////

Процедура ЕРП_ЗаписатьСобытие(
    Уровень,
    Этап,
    Текст
)

    Попытка

        ЕРП_ЖурналИнтеграции.Записать(
            Уровень,
            Этап,
            Текст
        );

    Исключение

        // Ошибка журнала не должна прерывать обработку.
        // Сам журнал уже не может гарантированно записать
        // сообщение о собственной ошибке.

    КонецПопытки;

КонецПроцедуры

   ////////////////////////////////////////////////////////////////////////////////
// УПРАВЛЕНИЕ РЕГЛАМЕНТНЫМ ЗАДАНИЕМ ПРИЕМА НОМЕНКЛАТУРЫ ИЗ PDM
//
// Архитектура повторяет UBT:
// - поиск существующего задания по метаданным;
// - создание через РегламентныеЗаданияСервер.ДобавитьЗадание();
// - изменение через РегламентныеЗаданияСервер.ИзменитьЗадание();
// - передача метаданных, ключа, имени метода, параметров и расписания.
// Повторный вызов не создаёт дубликаты.
////////////////////////////////////////////////////////////////////////////////

Процедура ЕРП_ЗарегистрироватьЗаданиеПриемаНоменклатурыИзPDM() Экспорт

    УстановитьПривилегированныйРежим(Истина);

    Попытка

        МетаданныеЗадания =
            Метаданные.РегламентныеЗадания.ЕРП_ПриемНоменклатурыИзPDM;

        Отбор = Новый Структура;
        Отбор.Вставить("Метаданные", МетаданныеЗадания);

        НайденныеЗадания =
            РегламентныеЗаданияСервер.НайтиЗадания(Отбор);

        Если НайденныеЗадания.Количество() > 1 Тогда
            ВызватьИсключение
                "Обнаружено несколько экземпляров регламентного задания "
                + "ЕРП_ПриемНоменклатурыИзPDM. "
                + "Автоматическое изменение отменено.";
        КонецЕсли;

        Расписание = Новый РасписаниеРегламентногоЗадания;
        Расписание.ПериодПовтораДней = 1;
        Расписание.ВремяНачала = Дата(1, 1, 1, 6, 0, 0);
        Расписание.ВремяКонца = Дата(1, 1, 1, 23, 59, 0);
        Расписание.ПериодПовтораВТечениеДня = 30;

        Параметры = Новый Массив;

        СвойстваЗадания = Новый Структура;
        СвойстваЗадания.Вставить("Расписание", Расписание);
        СвойстваЗадания.Вставить("Параметры", Параметры);
        СвойстваЗадания.Вставить("ИмяМетода", МетаданныеЗадания.ИмяМетода);
        СвойстваЗадания.Вставить(
            "Наименование",
            "Прием номенклатуры из PDM"
        );
        СвойстваЗадания.Вставить("Использование", Истина);

        Если НайденныеЗадания.Количество() = 0 Тогда

            СвойстваЗадания.Вставить("Метаданные", МетаданныеЗадания);
            СвойстваЗадания.Вставить(
                "Ключ",
                Строка(Новый УникальныйИдентификатор)
            );

            РегламентныеЗаданияСервер.ДобавитьЗадание(
                СвойстваЗадания
            );

        Иначе

            РегламентныеЗаданияСервер.ИзменитьЗадание(
                НайденныеЗадания[0],
                СвойстваЗадания
            );

        КонецЕсли;

    Исключение

        УстановитьПривилегированныйРежим(Ложь);
        ВызватьИсключение;

    КонецПопытки;

    УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры
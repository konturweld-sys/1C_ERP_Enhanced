
////////////////////////////////////////////////////////////////////////////////
// ОБЩИЙ МОДУЛЬ: ЕРП_ПриемИнтеграции
//
// Серверный общий модуль.
// Вызов сервера: Да.
//
// Журнал:
// D:\1C Log\ERP_Nomenclature_Integration.log
//
// Ограничения одного запуска:
// - максимум 5 сообщений;
// - максимум 10 секунд;
// - ожидание сообщения максимум 250 мс.
//
// Входящая очередь: pdm_to_erp_nomenclature
// Exchange: 1c_integration
// Очередь статусов: erp_to_pdm_statuses
// Routing key статусов: status_key
////////////////////////////////////////////////////////////////////////////////


Процедура ЕРП_ПринятьПакетыИзPDM() Экспорт

    МаксимумСообщений = 5;
    МаксимальноеВремяСекунд = 10;
    ОжиданиеСообщенияМС = 250;

    Брокер = Неопределено;
    Потребитель = Неопределено;

    ОшибкаОбработки = "";
    ПолученоСообщений = 0;
    УспешноОбработано = 0;
    ОшибокПереноса = 0;
    ПодтвержденоСообщений = 0;

    ВремяНачала = ТекущаяДата();

    ЕРП_ЗаписатьСобытие(
        "INFO",
        "НАЧАЛО",
        "Запуск приема номенклатуры PDM. Максимум сообщений: "
        + Строка(МаксимумСообщений)
        + "; ограничение времени: "
        + Строка(МаксимальноеВремяСекунд)
        + " сек."
    );

    Попытка

        ////////////////////////////////////////////////////////////////////////
        // 1. СОЗДАНИЕ ПОДКЛЮЧЕНИЯ
        ////////////////////////////////////////////////////////////////////////

        ЕРП_ЗаписатьСобытие(
            "INFO",
            "RABBITMQ",
            "Создание подключения к RabbitMQ."
        );

        Попытка
            Брокер = ЕРП_ИнтеграцияRabbitMQ.ЕРП_СоздатьБрокер();
            ЕРП_Уведомления.ЕРП_ЗафиксироватьДоступностьRabbitMQ();
        Исключение
            ТекстОшибкиПодключения =
                ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
            ЕРП_Уведомления.ЕРП_ЗафиксироватьСбойRabbitMQ(
                ТекстОшибкиПодключения
            );
            ВызватьИсключение ТекстОшибкиПодключения;
        КонецПопытки;

        ЕРП_ЗаписатьСобытие(
            "INFO",
            "RABBITMQ",
            "Подключение к RabbitMQ создано."
        );

        ////////////////////////////////////////////////////////////////////////
        // 2. СОЗДАНИЕ ПОТРЕБИТЕЛЯ
        ////////////////////////////////////////////////////////////////////////

        ЕРП_ЗаписатьСобытие(
            "INFO",
            "CONSUMER",
            "Создание потребителя очереди pdm_to_erp_nomenclature."
        );

        Потребитель = Брокер.BasicConsume(
            "pdm_to_erp_nomenclature",
            "",
            Ложь,
            Ложь,
            0
        );

        ОшибкаRabbitMQ = Брокер.GetLastError();

        Если ЗначениеЗаполнено(ОшибкаRabbitMQ) Тогда

            ВызватьИсключение
                "Ошибка создания потребителя RabbitMQ: "
                + ОшибкаRabbitMQ;

        КонецЕсли;

        ЕРП_ЗаписатьСобытие(
            "INFO",
            "CONSUMER",
            "Потребитель создан."
        );

        ////////////////////////////////////////////////////////////////////////
        // 3. ЦИКЛ ПОЛУЧЕНИЯ СООБЩЕНИЙ
        ////////////////////////////////////////////////////////////////////////

        Пока ПолученоСообщений < МаксимумСообщений Цикл

            Если (ТекущаяДата() - ВремяНачала)
                >= МаксимальноеВремяСекунд Тогда

                ЕРП_ЗаписатьСобытие(
                    "INFO",
                    "LIMIT",
                    "Достигнуто ограничение времени выполнения."
                );

                Прервать;

            КонецЕсли;

            ТекстСообщения = "";
            ТегСообщения = 0;

            ПолученоСообщение = Брокер.BasicConsumeMessage(
                "",
                ТекстСообщения,
                ТегСообщения,
                ОжиданиеСообщенияМС
            );

            Если Не ЗначениеЗаполнено(ТекстСообщения) Тогда

                ЕРП_ЗаписатьСобытие(
                    "INFO",
                    "RECEIVE",
                    "Сообщений в очереди за время ожидания не получено."
                );

                Прервать;

            КонецЕсли;

            ПолученоСообщений = ПолученоСообщений + 1;

            ЕРП_ЗаписатьСобытие(
                "INFO",
                "RECEIVE",
                "Получено сообщение №"
                + Строка(ПолученоСообщений)
                + "; delivery tag: "
                + Строка(ТегСообщения)
                + "; длина JSON: "
                + Строка(СтрДлина(ТекстСообщения))
            );

            ////////////////////////////////////////////////////////////////////
            // 4. ПОДГОТОВКА РЕЗУЛЬТАТА ОБРАБОТКИ
            ////////////////////////////////////////////////////////////////////

            Результат = Новый Структура;

            Результат.Вставить(
                "ТегСообщения",
                ТегСообщения
            );

            Результат.Вставить(
                "UUID",
                ""
            );

            Результат.Вставить(
                "Статус",
                "ОшибкаПереноса"
            );

            Результат.Вставить(
                "ТекстОшибки",
                ""
            );

            ////////////////////////////////////////////////////////////////////
            // 5. ПРОВЕРКА И РАЗБОР JSON
            ////////////////////////////////////////////////////////////////////

            ЕРП_ЗаписатьСобытие(
                "INFO",
                "VALIDATION",
                "Начало проверки JSON."
            );

            ТекстОшибкиВалидации = "";

            Попытка

                Данные =
                    ЕРП_ВалидацияКонтракта.ЕРП_ВалидироватьИРазобратьJSON(
                        ТекстСообщения,
                        ТекстОшибкиВалидации
                    );

            Исключение

                ТекстОшибкиВалидации =
                    ПодробноеПредставлениеОшибки(
                        ИнформацияОбОшибке()
                    );

                Данные = Неопределено;

                ЕРП_ЗаписатьСобытие(
                    "ERROR",
                    "VALIDATION",
                    ТекстОшибкиВалидации
                );

            КонецПопытки;

            Если Данные = Неопределено Тогда

                Результат.ТекстОшибки =
                    ТекстОшибкиВалидации;

                ЕРП_ЗаписатьСобытие(
                    "ERROR",
                    "VALIDATION",
                    "Сообщение не прошло проверку JSON: "
                    + ТекстОшибкиВалидации
                );

            Иначе

                Результат.UUID = Данные.UUID;

                ЕРП_ЗаписатьСобытие(
                    "INFO",
                    "VALIDATION",
                    "JSON проверен. UUID: "
                    + Данные.UUID
                );

                //////////////////////////////////////////////////////////////////
                // 6. ОБРАБОТКА ДАННЫХ В ТРАНЗАКЦИИ ERP
                //////////////////////////////////////////////////////////////////

                ТранзакцияНачата = Ложь;
                СозданНовыйЭлемент = Ложь;

                Попытка

                    НачатьТранзакцию();
                    ТранзакцияНачата = Истина;

                    ЕРП_ЗаписатьСобытие(
                        "INFO",
                        "TRANSACTION",
                        "Начата транзакция обработки UUID "
                        + Данные.UUID
                    );

                    Блокировка = Новый БлокировкаДанных;

                    ЭлементБлокировки = Блокировка.Добавить(
                        "РегистрСведений.ЕРП_БлокировкаПриемаRabbitMQ"
                    );

                    ЭлементБлокировки.УстановитьЗначение(
                        "Ключ",
                        "ПриемНоменклатуры"
                    );

                    Блокировка.Заблокировать();

                    ЕРП_ЗаписатьСобытие(
                        "INFO",
                        "LOCK",
                        "Получена блокировка обработки номенклатуры."
                    );

                    Если Данные.ЭтоГруппа Тогда

                        ЕРП_ЗаписатьСобытие(
                            "INFO",
                            "GROUP",
                            "Обработка группы: "
                            + Данные.Наименование
                            + "; UUID: "
                            + Данные.UUID
                        );

                        ЕРП_ОбработатьГруппу(Данные);

                    Иначе

                        ЕРП_ЗаписатьСобытие(
                            "INFO",
                            "ITEM",
                            "Обработка элемента: "
                            + Данные.Наименование
                            + "; UUID: "
                            + Данные.UUID
                        );

                        СозданНовыйЭлемент =
                            ЕРП_ОбработатьЭлемент(Данные);

                        Если СозданНовыйЭлемент Тогда
                            // Событие регистрируется в транзакции создания.
                            // Внешняя отправка выполняется отдельным заданием.
                            ЕРП_Уведомления.ЕРП_ЗарегистрироватьУспешноеСоздание(
                                Данные.UUID,
                                Данные.Наименование
                            );
                        КонецЕсли;

                    КонецЕсли;

                    ЗафиксироватьТранзакцию();
                    ТранзакцияНачата = Ложь;

                    Результат.Статус =
                        "УспешноПеренесено";

                    ЕРП_ЗаписатьСобытие(
                        "INFO",
                        "TRANSACTION",
                        "Транзакция успешно зафиксирована. UUID: "
                        + Данные.UUID
                    );

                Исключение

                    ТекстОшибкиОбработки =
                        ПодробноеПредставлениеОшибки(
                            ИнформацияОбОшибке()
                        );

                    Если ТранзакцияНачата Тогда

                        Попытка
                            ОтменитьТранзакцию();
                            ТранзакцияНачата = Ложь;
                        Исключение
                            ТекстОшибкиОбработки =
                                ТекстОшибкиОбработки
                                + Символы.ПС
                                + "Ошибка отмены транзакции: "
                                + ПодробноеПредставлениеОшибки(
                                    ИнформацияОбОшибке()
                                );
                        КонецПопытки;

                    КонецЕсли;

                    Результат.Статус =
                        "ОшибкаПереноса";

                    Результат.ТекстОшибки =
                        ТекстОшибкиОбработки;

                    ЕРП_ЗаписатьСобытие(
                        "ERROR",
                        "PROCESSING",
                        "Ошибка обработки UUID "
                        + Данные.UUID
                        + ": "
                        + ТекстОшибкиОбработки
                    );

                КонецПопытки;

                // Счётчик пишется после rollback основной транзакции.
                Если Результат.Статус = "ОшибкаПереноса"
                    И Не Данные.ЭтоГруппа Тогда
                    Попытка
                        ЕРП_Уведомления.ЕРП_ЗарегистрироватьНеудачнуюПопыткуСоздания(
                            Данные.UUID,
                            Данные.Наименование,
                            Результат.ТекстОшибки
                        );
                    Исключение
                        ЕРП_ЗаписатьСобытие(
                            "ERROR",
                            "NOTIFICATION",
                            "Не удалось зафиксировать ошибку создания UUID "
                            + Данные.UUID
                            + ": "
                            + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())
                        );
                    КонецПопытки;
                КонецЕсли;

            КонецЕсли;

            ////////////////////////////////////////////////////////////////////
            // 7. ПУБЛИКАЦИЯ СТАТУСА В PDM
            ////////////////////////////////////////////////////////////////////

            ЕРП_ЗаписатьСобытие(
                "INFO",
                "STATUS",
                "Публикация статуса "
                + Результат.Статус
                + "; UUID: "
                + Результат.UUID
            );

            ЕРП_ОпубликоватьСтатус(
                Брокер,
                Результат.UUID,
                Результат.Статус,
                Результат.ТекстОшибки
            );

            ЕРП_ЗаписатьСобытие(
                "INFO",
                "STATUS",
                "Статус опубликован. UUID: "
                + Результат.UUID
            );

            ////////////////////////////////////////////////////////////////////
            // 8. ПОДТВЕРЖДЕНИЕ СООБЩЕНИЯ
            ////////////////////////////////////////////////////////////////////

            ЕРП_ЗаписатьСобытие(
                "INFO",
                "ACK",
                "Подтверждение сообщения. Delivery tag: "
                + Строка(Результат.ТегСообщения)
            );

            ЕРП_ПодтвердитьСообщение(
                Брокер,
                Результат.ТегСообщения
            );

            ПодтвержденоСообщений =
                ПодтвержденоСообщений + 1;

            Если Результат.Статус = "УспешноПеренесено" Тогда

                УспешноОбработано =
                    УспешноОбработано + 1;

            Иначе

                ОшибокПереноса =
                    ОшибокПереноса + 1;

            КонецЕсли;

            ЕРП_ЗаписатьСобытие(
                "INFO",
                "ACK",
                "Сообщение подтверждено."
            );

        КонецЦикла;

    Исключение

        ОшибкаОбработки =
            ПодробноеПредставлениеОшибки(
                ИнформацияОбОшибке()
            );

        ЕРП_ЗаписатьСобытие(
            "ERROR",
            "FATAL",
            ОшибкаОбработки
        );

    КонецПопытки;

    ////////////////////////////////////////////////////////////////////////
    // 9. ОТМЕНА ПОТРЕБИТЕЛЯ
    ////////////////////////////////////////////////////////////////////////

    Если Брокер <> Неопределено
        И Потребитель <> Неопределено Тогда

        Попытка

            ЕРП_ЗаписатьСобытие(
                "INFO",
                "CONSUMER",
                "Отмена потребителя RabbitMQ."
            );

            Брокер.BasicCancel(Потребитель);

            ОшибкаRabbitMQ = Брокер.GetLastError();

            Если ЗначениеЗаполнено(ОшибкаRabbitMQ) Тогда

                ВызватьИсключение
                    "Ошибка отмены потребителя: "
                    + ОшибкаRabbitMQ;

            КонецЕсли;

            ЕРП_ЗаписатьСобытие(
                "INFO",
                "CONSUMER",
                "Потребитель отменён."
            );

        Исключение

            ТекстОшибкиОтмены =
                ПодробноеПредставлениеОшибки(
                    ИнформацияОбОшибке()
                );

            ЕРП_ЗаписатьСобытие(
                "ERROR",
                "CONSUMER",
                ТекстОшибкиОтмены
            );

            Если Не ЗначениеЗаполнено(ОшибкаОбработки) Тогда
                ОшибкаОбработки = ТекстОшибкиОтмены;
            КонецЕсли;

        КонецПопытки;

    КонецЕсли;

    ////////////////////////////////////////////////////////////////////////
    // 10. ИТОГОВАЯ ЗАПИСЬ
    ////////////////////////////////////////////////////////////////////////

    ВремяВыполнения = ТекущаяДата() - ВремяНачала;

    Итог =
        "Получено: " + Строка(ПолученоСообщений)
        + "; успешно обработано: " + Строка(УспешноОбработано)
        + "; ошибок переноса: " + Строка(ОшибокПереноса)
        + "; подтверждено: " + Строка(ПодтвержденоСообщений)
        + "; время выполнения, сек.: " + Строка(ВремяВыполнения);

    Если ЗначениеЗаполнено(ОшибкаОбработки) Тогда

        ЕРП_ЗаписатьСобытие(
            "ERROR",
            "ЗАВЕРШЕНИЕ",
            "Запуск завершён с технической ошибкой. " + Итог
        );

        ВызватьИсключение ОшибкаОбработки;

    Иначе

        ЕРП_ЗаписатьСобытие(
            "INFO",
            "ЗАВЕРШЕНИЕ",
            "Запуск завершён. " + Итог
        );

    КонецЕсли;

КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТКА ГРУППЫ
////////////////////////////////////////////////////////////////////////////////

Процедура ЕРП_ОбработатьГруппу(Данные)

    Родитель = Неопределено;

    Если ЗначениеЗаполнено(Данные.Родитель_UUID) Тогда

        ЕРП_ЗаписатьСобытие(
            "INFO",
            "GROUP",
            "Поиск родительской группы UUID: "
            + Данные.Родитель_UUID
        );

        Родитель =
            ЕРП_СопоставлениеНоменклатуры.ЕРП_ПолучитьСсылкуПоUUID(
                Данные.Родитель_UUID
            );

        Если Родитель = Неопределено Тогда

            ВызватьИсключение
                "Не найдена родительская группа: "
                + Данные.Родитель_UUID;

        КонецЕсли;

    КонецЕсли;

    ЕРП_СопоставлениеНоменклатуры.ЕРП_СоздатьГруппуПоUUID(
        Данные,
        Родитель
    );

    ЕРП_ЗаписатьСобытие(
        "INFO",
        "GROUP",
        "Группа обработана. UUID: " + Данные.UUID
    );

КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТКА ЭЛЕМЕНТА
////////////////////////////////////////////////////////////////////////////////

Функция ЕРП_ОбработатьЭлемент(Данные)

    ЕРП_ЗаписатьСобытие(
        "INFO",
        "ITEM",
        "Обеспечение пути родительских групп."
    );

    Родитель = ЕРП_ОбеспечитьПутьРодителей(Данные);

    ЕРП_ЗаписатьСобытие(
        "INFO",
        "ITEM",
        "Поиск существующего элемента по UUID: "
        + Данные.UUID
    );

    Ссылка =
        ЕРП_СопоставлениеНоменклатуры.ЕРП_ПолучитьСсылкуПоUUID(
            Данные.UUID
        );

    НовыйЭлемент = Ссылка = Неопределено;

    Если Ссылка = Неопределено Тогда

        ЕРП_ЗаписатьСобытие(
            "INFO",
            "ITEM",
            "Элемент не найден. Создание нового элемента."
        );

        Объект = Справочники.Номенклатура.СоздатьЭлемент();

        Объект.УстановитьСсылкуНового(
            Справочники.Номенклатура.ПолучитьСсылку(
                Новый УникальныйИдентификатор(Данные.UUID)
            )
        );

    Иначе

        Если Ссылка.ЭтоГруппа Тогда

            ВызватьИсключение
                "UUID элемента уже занят группой: "
                + Данные.UUID;

        КонецЕсли;

        ЕРП_ЗаписатьСобытие(
            "INFO",
            "ITEM",
            "Найден существующий элемент. Обновление."
        );

        Объект = Ссылка.ПолучитьОбъект();

    КонецЕсли;

    Объект.Наименование = Данные.Наименование;
    Объект.Артикул = Данные.Артикул;
    Объект.Родитель = Родитель;

    // Код ERP не переносим.
    // Характеристики и спецификации не создаём.

    ЕРП_ЗаписатьСобытие(
        "INFO",
        "ITEM",
        "Запись элемента номенклатуры."
    );

    Объект.Записать();

    ЕРП_ЗаписатьСобытие(
        "INFO",
        "ITEM",
        "Элемент записан. UUID: " + Данные.UUID
    );

    Возврат НовыйЭлемент;

КонецФункции


////////////////////////////////////////////////////////////////////////////////
// ОБЕСПЕЧЕНИЕ ПУТИ РОДИТЕЛЕЙ
////////////////////////////////////////////////////////////////////////////////

Функция ЕРП_ОбеспечитьПутьРодителей(Данные)

    Родитель = Неопределено;

    Если Не Данные.Свойство("ПутьРодителей") Тогда
        Возврат Родитель;
    КонецЕсли;

    ЕРП_ЗаписатьСобытие(
        "INFO",
        "PARENTS",
        "Количество родительских групп: "
        + Строка(Данные.ПутьРодителей.Количество())
    );

    Для Каждого ДанныеГруппы Из Данные.ПутьРодителей Цикл

        ЕРП_ЗаписатьСобытие(
            "INFO",
            "PARENTS",
            "Обработка родительской группы: "
            + ДанныеГруппы.Наименование
            + "; UUID: "
            + ДанныеГруппы.UUID
        );

        Родитель =
            ЕРП_СопоставлениеНоменклатуры.ЕРП_СоздатьГруппуПоUUID(
                ДанныеГруппы,
                Родитель
            );

    КонецЦикла;

    Возврат Родитель;

КонецФункции


////////////////////////////////////////////////////////////////////////////////
// ПУБЛИКАЦИЯ СТАТУСА
////////////////////////////////////////////////////////////////////////////////

Процедура ЕРП_ОпубликоватьСтатус(
    Брокер,
    UUID,
    Статус,
    ТекстОшибки
)

    ДанныеСтатуса = Новый Структура;

    ДанныеСтатуса.Вставить("PDM_UUID", UUID);
    ДанныеСтатуса.Вставить("Статус", Статус);
    ДанныеСтатуса.Вставить("ТекстОшибки", ТекстОшибки);
    ДанныеСтатуса.Вставить("ВремяERP", ТекущаяДата());

    ЕРП_ЗаписатьСобытие(
        "INFO",
        "STATUS",
        "Формирование JSON статуса."
    );

    ТекстJSON =
        ЕРП_ИнтеграцияRabbitMQ.ЕРП_СформироватьJSON(
            ДанныеСтатуса
        );

    ЕРП_ЗаписатьСобытие(
        "INFO",
        "STATUS",
        "Публикация в exchange 1c_integration, routing key status_key."
    );

    Брокер.BasicPublish(
        "1c_integration",
        "status_key",
        ТекстJSON,
        0,
        Истина
    );

    ОшибкаRabbitMQ = Брокер.GetLastError();

    Если ЗначениеЗаполнено(ОшибкаRabbitMQ) Тогда

        ВызватьИсключение
            "Ошибка публикации статуса RabbitMQ: "
            + ОшибкаRabbitMQ;

    КонецЕсли;

КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// ПОДТВЕРЖДЕНИЕ СООБЩЕНИЯ
////////////////////////////////////////////////////////////////////////////////


Процедура ЕРП_ПодтвердитьСообщение(
    Брокер,
    ТегСообщения
)

    ЕРП_ЗаписатьСобытие(
        "INFO",
        "ACK",
        "Вызов BasicAck. Тег: " + Строка(ТегСообщения)
    );

    Брокер.BasicAck(ТегСообщения);

    ОшибкаRabbitMQ = Брокер.GetLastError();

    Если ЗначениеЗаполнено(ОшибкаRabbitMQ) Тогда

        ВызватьИсключение
            "Ошибка подтверждения сообщения RabbitMQ: "
            + ОшибкаRabbitMQ;

    КонецЕсли;

    ЕРП_ЗаписатьСобытие(
        "INFO",
        "ACK",
        "BasicAck выполнен. Тег: " + Строка(ТегСообщения)
    );

КонецПроцедуры



////////////////////////////////////////////////////////////////////////////////
// ЗАПИСЬ СОБЫТИЯ В ЖУРНАЛ
////////////////////////////////////////////////////////////////////////////////

Процедура ЕРП_ЗаписатьСобытие(
    Уровень,
    Этап,
    Текст
)

    Попытка

        ЕРП_ЖурналИнтеграции.Записать(
            Уровень,
            Этап,
            Текст
        );

    Исключение

        // Ошибка журнала не должна прерывать обработку.
        // Сам журнал уже не может гарантированно записать
        // сообщение о собственной ошибке.

    КонецПопытки;

КонецПроцедуры

   ////////////////////////////////////////////////////////////////////////////////
// РЕГИСТРАЦИЯ РЕГЛАМЕНТНОГО ЗАДАНИЯ ПРИЕМА НОМЕНКЛАТУРЫ ИЗ PDM
//
// Назначение:
// 1. Проверить наличие экземпляра задания.
// 2. При отсутствии создать его.
// 3. Установить расписание и параметры повторного запуска.
// 4. Включить задание.
//
// Повторный вызов не создаёт дубликаты.
////////////////////////////////////////////////////////////////////////////////

Процедура ЕРП_ЗарегистрироватьЗаданиеПриемаНоменклатурыИзPDM() Экспорт

    УстановитьПривилегированныйРежим(Истина);

    Попытка

        МетаданныеЗадания =
            Метаданные.РегламентныеЗадания.ЕРП_ПриемНоменклатурыИзPDM;

        // Ищем зарегистрированные экземпляры именно нашего задания.

        Отбор = Новый Структура;
        Отбор.Вставить("Метаданные", МетаданныеЗадания);

        НайденныеЗадания =
            РегламентныеЗадания.ПолучитьРегламентныеЗадания(Отбор);

        // Несколько экземпляров — неоднозначная ситуация.
        // Автоматически ничего не удаляем и не изменяем.

        Если НайденныеЗадания.Количество() > 1 Тогда

            ВызватьИсключение
                "Обнаружено несколько экземпляров задания "
                + "ЕРП_ПриемНоменклатурыИзPDM. "
                + "Автоматическая регистрация отменена.";

        КонецЕсли;

        // Используем существующий экземпляр либо создаём новый.

        Если НайденныеЗадания.Количество() = 1 Тогда

            Задание = НайденныеЗадания[0];

        Иначе

            Задание =
                РегламентныеЗадания.СоздатьРегламентноеЗадание(
                    МетаданныеЗадания
                );

        КонецЕсли;

        // Расписание: ежедневно с 06:00 до 23:59,
        // повтор через 30 секунд.

        Расписание = Новый РасписаниеРегламентногоЗадания;

        Расписание.ПериодПовтораДней = 1;
        Расписание.ВремяНачала = Дата(1, 1, 1, 6, 0, 0);
        Расписание.ВремяКонца = Дата(1, 1, 1, 23, 59, 0);
        Расписание.ПериодПовтораВТечениеДня = 30;

        // Настройки экземпляра.

        Задание.Наименование =
            "Прием номенклатуры из PDM";

        Задание.Параметры = Новый Массив;

        Задание.Расписание = Расписание;

        Задание.КоличествоПовторовПриАварийномЗавершении = 3;

        Задание.ИнтервалПовтораПриАварийномЗавершении = 10;

        Задание.Использование = Истина;

        // Регистрация или обновление экземпляра.

        Задание.Записать();

    Исключение

        УстановитьПривилегированныйРежим(Ложь);

        ВызватьИсключение;

    КонецПопытки;

    УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

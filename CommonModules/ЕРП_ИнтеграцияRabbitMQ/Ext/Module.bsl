
////////////////////////////////////////////////////////////////////////////////
// Общий модуль: ЕРП_ИнтеграцияRabbitMQ
//
// Назначение:
// 1. Получение настроек RabbitMQ из регистра сведений.
// 2. Создание и подключение внешней компоненты PinkRabbitMQ.
// 3. Возврат подключённого объекта брокера.
//
// Свойства общего модуля:
// Сервер = Да
// Вызов сервера = Да
////////////////////////////////////////////////////////////////////////////////

Функция ЕРП_ПолучитьНастройки() Экспорт

    Выборка =
        РегистрыСведений.ЕРП_НастройкиИнтеграцииRabbitMQ.Выбрать();

    Если Не Выборка.Следующий() Тогда
        ВызватьИсключение
            "Не найдены настройки RabbitMQ ERP.";
    КонецЕсли;

    Настройки = Новый Структура;

    Настройки.Вставить("Сервер", Выборка.Сервер);
    Настройки.Вставить("Порт", Выборка.Порт);
    Настройки.Вставить("Пользователь", Выборка.Пользователь);
    Настройки.Вставить("Пароль", Выборка.Пароль);
    Настройки.Вставить("ВиртуальныйХост", Выборка.ВиртуальныйХост);

    Возврат Настройки;

КонецФункции

          
     
Функция ЕРП_СоздатьБрокер() Экспорт

    Настройки = ЕРП_ПолучитьНастройки();

    Если Не ЗначениеЗаполнено(Настройки.Сервер) Тогда
        ВызватьИсключение "Не задан сервер RabbitMQ ERP.";
    КонецЕсли;

    Если Не ЗначениеЗаполнено(Настройки.Порт) Тогда
        ВызватьИсключение "Не задан порт RabbitMQ ERP.";
    КонецЕсли;

    ПодключитьВнешнююКомпоненту(
        "C:\1C\ExternalComponents\PinkRabbitMQ\PinkRabbitMQ64.dll",
        "PinkRabbitMQ",
        ТипВнешнейКомпоненты.Native
    );

    Брокер = Новый("AddIn.PinkRabbitMQ.PinkRabbitMQ");

    Брокер.Connect(
        Настройки.Сервер,
        Настройки.Порт,
        Настройки.Пользователь,
        Настройки.Пароль,
        Настройки.ВиртуальныйХост
    );

    Ошибка = Брокер.GetLastError();

    Если ЗначениеЗаполнено(Ошибка) Тогда
        ВызватьИсключение
            "Ошибка подключения к RabbitMQ: " + Ошибка;
    КонецЕсли;

    Возврат Брокер;

КонецФункции



Функция ЕРП_СформироватьJSON(Данные) Экспорт

    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();

    ЗаписатьJSON(
        ЗаписьJSON,
        Данные
    );

    Возврат ЗаписьJSON.Закрыть();

КонецФункции



Процедура ЕРП_ОпубликоватьСообщение(
    Брокер,
    КлючМаршрутизации,
    ТекстСообщения
) Экспорт

    Если Не ЗначениеЗаполнено(ТекстСообщения) Тогда
        ВызватьИсключение
            "Нельзя опубликовать пустое сообщение RabbitMQ.";
    КонецЕсли;

    Брокер.BasicPublish(
        "1c_integration",
        КлючМаршрутизации,
        ТекстСообщения,
        0,
        Истина
    );

    Ошибка = Брокер.GetLastError();

    Если ЗначениеЗаполнено(Ошибка) Тогда
        ВызватьИсключение
            "Ошибка публикации сообщения RabbitMQ: " + Ошибка;
    КонецЕсли;

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Adapter to the separate UBT extension. The Telegram token stays in UBT.
////////////////////////////////////////////////////////////////////////////////

Функция ПолучитьБотаПоУмолчанию() Экспорт
    Боты = Справочники.УБТ_БотыTelegram.Выбрать();
    Бот = Неопределено;
    Пока Боты.Следующий() Цикл
        Если Не Боты.ПометкаУдаления Тогда
            Если ЗначениеЗаполнено(Бот) Тогда
                ВызватьИсключение
                    "В UBT найдено несколько Telegram-ботов. Для создания новой привязки требуется однозначный бот.";
            КонецЕсли;
            Бот = Боты.Ссылка;
        КонецЕсли;
    КонецЦикла;
    Возврат Бот;
КонецФункции


Функция ПолучитьБотаПоИдентификатору(ИдентификаторБота)
    Если Не ЗначениеЗаполнено(ИдентификаторБота) Тогда
        Возврат Неопределено;
    КонецЕсли;
    Боты = Справочники.УБТ_БотыTelegram.Выбрать();
    Пока Боты.Следующий() Цикл
        Если Не Боты.ПометкаУдаления
            И Боты.Ссылка.УникальныйИдентификатор() = ИдентификаторБота Тогда
            Возврат Боты.Ссылка;
        КонецЕсли;
    КонецЦикла;
    Возврат Неопределено;
КонецФункции


Функция ПолучитьЧатБотаПоChatID(Бот, ChatID)
    Если Не ЗначениеЗаполнено(Бот)
        Или Не ЗначениеЗаполнено(ChatID) Тогда
        Возврат Неопределено;
    КонецЕсли;

    Чаты = Справочники.УБТ_ЧатыTelegram.Выбрать();
    Пока Чаты.Следующий() Цикл
        Если Не Чаты.ПометкаУдаления
            И Чаты.Код = ChatID
            И Чаты.Владелец = Бот Тогда
            Возврат Чаты.Ссылка;
        КонецЕсли;
    КонецЦикла;

    Возврат Неопределено;
КонецФункции


Функция ОтправитьСообщениеВЧат(ChatID, Текст, ИдентификаторБота) Экспорт
    Результат = Новый Структура(
        "Успех,ОписаниеОшибки,RetryAfter,РезультатНеопределен",
        Ложь, "", 0, Ложь);
    Если ТипЗнч(ChatID) <> Тип("Строка")
        Или Не ЗначениеЗаполнено(ChatID) Тогда
        Результат.ОписаниеОшибки = "Не указан корректный Telegram Chat ID.";
        Возврат Результат;
    КонецЕсли;
    Если ТипЗнч(Текст) <> Тип("Строка")
        Или Не ЗначениеЗаполнено(Текст) Тогда
        Результат.ОписаниеОшибки = "Текст Telegram-сообщения не может быть пустым.";
        Возврат Результат;
    КонецЕсли;
    Если СтрДлина(Текст) > 4096 Тогда
        Результат.ОписаниеОшибки =
            "Длина Telegram-сообщения превышает ограничение Bot API в 4096 символов.";
        Возврат Результат;
    КонецЕсли;
    Если ТипЗнч(ИдентификаторБота) <> Тип("УникальныйИдентификатор")
        Или Не ЗначениеЗаполнено(ИдентификаторБота) Тогда
        Результат.ОписаниеОшибки =
            "Для Telegram-доставки не указан идентификатор бота привязки.";
        Возврат Результат;
    КонецЕсли;

    Попытка
        Бот = ПолучитьБотаПоИдентификатору(ИдентификаторБота);
    Исключение
        Результат.ОписаниеОшибки =
            "Не удалось получить Telegram-бота из UBT: "
            + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
        Возврат Результат;
    КонецПопытки;
    Если Не ЗначениеЗаполнено(Бот) Тогда
        Результат.ОписаниеОшибки =
            "Telegram-бот привязки отсутствует в UBT или помечен на удаление.";
        Возврат Результат;
    КонецЕсли;

    Попытка
        Чат = ПолучитьЧатБотаПоChatID(Бот, ChatID);
    Исключение
        Результат.ОписаниеОшибки =
            "Не удалось проверить Telegram-чат в UBT.";
        Возврат Результат;
    КонецПопытки;

    Если Не ЗначениеЗаполнено(Чат) Тогда
        Результат.ОписаниеОшибки =
            "Telegram Chat ID не зарегистрирован в UBT за выбранным ботом.";
        Возврат Результат;
    КонецЕсли;

    Попытка
        Сообщение = УБТ_РаботаСБотамиTelegram.НоваяСтруктураСообщенияЧата();
        Сообщение.chat_id = ChatID;
        Сообщение.text = Текст;

        // После передачи запроса UBT сетевой сбой не доказывает,
        // что Telegram не принял сообщение.
        Результат.РезультатНеопределен = Истина;
        Ответ = УБТ_РаботаСБотамиTelegram.ОтправитьСообщениеВЧат(Бот, Сообщение);
        Если ТипЗнч(Ответ) = Тип("Строка") Тогда
            Чтение = Новый ЧтениеJSON;
            Чтение.УстановитьСтроку(Ответ);
            Ответ = ПрочитатьJSON(Чтение);
        КонецЕсли;
        Если ТипЗнч(Ответ) = Тип("Структура") Тогда
            ПризнакУспеха = Неопределено;
            Если Ответ.Свойство("ok", ПризнакУспеха)
                И ТипЗнч(ПризнакУспеха) = Тип("Булево") Тогда
                Результат.РезультатНеопределен = Ложь;
                Результат.Успех = ПризнакУспеха;
            Иначе
                Результат.ОписаниеОшибки =
                    "UBT вернул ответ без корректного логического поля ok.";
            КонецЕсли;
            ОписаниеОшибки = "";
            Если Ответ.Свойство("description", ОписаниеОшибки)
                И ТипЗнч(ОписаниеОшибки) = Тип("Строка")
                И ЗначениеЗаполнено(ОписаниеОшибки) Тогда
                Результат.ОписаниеОшибки = ОписаниеОшибки;
            КонецЕсли;
            Параметры = Неопределено;
            Если Ответ.Свойство("parameters", Параметры)
                И ТипЗнч(Параметры) = Тип("Структура") Тогда
                RetryAfter = Неопределено;
                Если Параметры.Свойство("retry_after", RetryAfter)
                    И ТипЗнч(RetryAfter) = Тип("Число")
                    И RetryAfter >= 0 Тогда
                    Результат.RetryAfter = RetryAfter;
                КонецЕсли;
            КонецЕсли;
        КонецЕсли;
    Исключение
        // Внешний UBT может включать секретные параметры транспорта в текст исключения.
        // Не передаём такие подробности в общий журнал ERP.
        Результат.ОписаниеОшибки =
            "Вызов UBT Telegram завершился исключением; результат не подтверждён. "
            + "Подробности доступны в журнале UBT.";
    КонецПопытки;
    Если Не Результат.Успех И Не ЗначениеЗаполнено(Результат.ОписаниеОшибки) Тогда
        Результат.ОписаниеОшибки = "UBT не подтвердил отправку сообщения Telegram.";
    КонецЕсли;

    Если Результат.РезультатНеопределен
        И Не ЗначениеЗаполнено(Результат.ОписаниеОшибки) Тогда
        Результат.ОписаниеОшибки =
            "Не получено подтверждение результата передачи сообщения в Telegram.";
    КонецЕсли;
    Возврат Результат;
КонецФункции


// Создает чат через штатную структуру данных УБТ, если Telegram прислал /start
// раньше, чем УБТ успел зарегистрировать чат.
Функция СоздатьЧатБотаЕслиОтсутствует(Бот, СтрокаСообщения)

    ChatID = СтрокаСообщения.ИдентификаторЧата;
    Чат = ПолучитьЧатБотаПоChatID(Бот, ChatID);
    Если ЗначениеЗаполнено(Чат) Тогда
        Возврат Чат;
    КонецЕсли;

    ЧатОбъект = Справочники.УБТ_ЧатыTelegram.СоздатьЭлемент();
    ЧатОбъект.Владелец = Бот;
    ЧатОбъект.Код = ChatID;
    ЧатОбъект.Наименование = СтрокаСообщения.НаименованиеЧата;
    ЧатОбъект.ТипЧата = СтрокаСообщения.ТипЧата;
    ЧатОбъект.ИмяКонтакта = СтрокаСообщения.ИмяКонтакта;
    ЧатОбъект.НомерТелефона = СтрокаСообщения.НомерТелефонаКонтакта;
    ЧатОбъект.Записать();

    Возврат ЧатОбъект.Ссылка;

КонецФункции


// Единый шлюз входящих Telegram updates для ERP и УБТ.
// URL этого HTTP-сервиса задается в поле АдресВебхука карточки бота УБТ.
// Секрет и имя бота проверяются штатным методом УБТ до включения привилегированного режима.
// Команды /start обрабатываются ERP и удаляются из таблицы перед вызовом обработчика УБТ,
// остальные сообщения передаются УБТ без изменения.
Функция ПринятьWebhook(ИмяБота, СекретВебхука, ТелоЗапроса) Экспорт

    ИтогПриема = Новый Структура(
        "Авторизован,Успешно,КоличествоОбработанныхКоманд,КоличествоПереданныхУБТ",
        Ложь, Ложь, 0, 0);

    Если Не ЗначениеЗаполнено(ИмяБота)
        Или Не ЗначениеЗаполнено(СекретВебхука)
        Или Не ЗначениеЗаполнено(ТелоЗапроса) Тогда
        Возврат ИтогПриема;
    КонецЕсли;

    Бот = Неопределено;
    Попытка
        Бот = Справочники.УБТ_БотыTelegram.НайтиБотаTelegramПоИмениИСекретномуЗаголовку(
            ИмяБота,
            СекретВебхука);
    Исключение
        Возврат ИтогПриема;
    КонецПопытки;

    Если Не ЗначениеЗаполнено(Бот) Тогда
        Возврат ИтогПриема;
    КонецЕсли;

    ИтогПриема.Авторизован = Истина;

    Попытка
        Обновление = УБТ_РаботаСJSON.JSONВЗначение(ТелоЗапроса, , Ложь);
        МассивОбновлений = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Обновление);
        ТаблицаСообщений =
            УБТ_РаботаСБотамиTelegram.ПолученныеСообщенияВТаблицуЗначений(
                МассивОбновлений);
    Исключение
        Возврат ИтогПриема;
    КонецПопытки;

    ПривилегированныйРежимБылВключен = ПривилегированныйРежим();

    Попытка

        Если Не ПривилегированныйРежимБылВключен Тогда
            УстановитьПривилегированныйРежим(Истина);
        КонецЕсли;

        СтрокиКомандStart = Новый Массив;

        Для Каждого СтрокаСообщения Из ТаблицаСообщений Цикл

            ТекстКоманды = СокрЛП(СтрокаСообщения.ТекстСообщения);
            Если Не ЗначениеЗаполнено(ТекстКоманды) Тогда
                Продолжить;
            КонецЕсли;

            ЧастиКоманды = СтрРазделить(ТекстКоманды, " ");
            Если ЧастиКоманды.Количество() = 0 Тогда
                Продолжить;
            КонецЕсли;

            Команда = ЧастиКоманды[0];
            ЭтоКомандаStart = Команда = "/start"
                Или Лев(Команда, 7) = "/start@";

            Если Не ЭтоКомандаStart Тогда
                Продолжить;
            КонецЕсли;

            Если Не ЗначениеЗаполнено(СтрокаСообщения.ИдентификаторЧата)
                Или ТипЗнч(СтрокаСообщения.ИдентификаторСообщения) <> Тип("Число") Тогда
                ВызватьИсключение "УБТ передал неполные данные Telegram-команды /start.";
            КонецЕсли;

            ЧатУБТ = СоздатьЧатБотаЕслиОтсутствует(Бот, СтрокаСообщения);

            ТипЧатаДляERP = ?(
                СтрокаСообщения.ТипЧата = Перечисления.УБТ_ТипыЧатовTelegram.Приватный,
                "private",
                "other");

            РезультатERP = ЕРП_ПривязкаTelegram.ЕРП_ОбработатьОбновленияTelegramИзWebhook(
                Бот,
                СтрокаСообщения.ИдентификаторЧата,
                ТипЧатаДляERP,
                СтрокаСообщения.ИдентификаторСообщения,
                ТекстКоманды);

            Если ЗначениеЗаполнено(РезультатERP.Сообщение) Тогда
                РезультатОтправки = ОтправитьСообщениеВЧат(
                    СтрокаСообщения.ИдентификаторЧата,
                    РезультатERP.Сообщение,
                    Бот.УникальныйИдентификатор());

                Если Не РезультатОтправки.Успех Тогда
                    ВызватьИсключение
                        "УБТ не подтвердил отправку ответа ERP на команду /start.";
                КонецЕсли;
            КонецЕсли;

            СтрокиКомандStart.Добавить(СтрокаСообщения);
            ИтогПриема.КоличествоОбработанныхКоманд =
                ИтогПриема.КоличествоОбработанныхКоманд + 1;

        КонецЦикла;

        // Не передаем /start payload в UBT: его механизм команд сопоставляет
        // полный текст сообщения с командой и иначе отвечает сообщением "неизвестная команда".
        Для Каждого СтрокаКомандыStart Из СтрокиКомандStart Цикл
            ТаблицаСообщений.Удалить(СтрокаКомандыStart);
        КонецЦикла;

    Исключение

        Если Не ПривилегированныйРежимБылВключен Тогда
            УстановитьПривилегированныйРежим(Ложь);
        КонецЕсли;

        Возврат ИтогПриема;

    КонецПопытки;

    Если Не ПривилегированныйРежимБылВключен Тогда
        УстановитьПривилегированныйРежим(Ложь);
    КонецЕсли;

    Попытка

        Если ТаблицаСообщений.Количество() > 0 Тогда
            УБТ_РаботаСБотамиTelegram.ОтветитьНаПолученныеСообщения(
                Бот,
                ТаблицаСообщений);
            ИтогПриема.КоличествоПереданныхУБТ = ТаблицаСообщений.Количество();
        КонецЕсли;

    Исключение

        Возврат ИтогПриема;

    КонецПопытки;

    ИтогПриема.Успешно = Истина;
    Возврат ИтогПриема;

КонецФункции

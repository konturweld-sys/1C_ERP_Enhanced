
////////////////////////////////////////////////////////////////////////////////
// Общий модуль: ЕРП_ОтправкаПочты
//
// Назначение:
// 1. Чтение настроек SMTP.
// 2. Сохранение настроек SMTP.
// 3. Отправка электронной почты.
//
// Расположение настроек:
// Регистр сведений ЕРП_НастройкиSMTP
//
// SMTP:
// mail.nic.ru
// Порт 465
// SSL
////////////////////////////////////////////////////////////////////////////////


// Возвращает настройки SMTP.
// Если настройки еще не заполнены, возвращает значения по умолчанию.

Функция ЕРП_ПолучитьНастройкиSMTP() Экспорт

	Результат = Новый Структура(
		"SMTPСервер,SMTPПорт,SMTPЛогин,SMTPПароль,АдресОтправителя,ИспользоватьSSL",
		"mail.nic.ru",
		465,
		"system@radixrnd.ru",
		"",
		"system@radixrnd.ru",
		Истина
	);

	НаборЗаписей = РегистрыСведений.ЕРП_НастройкиSMTP.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.КлючНастройки.Установить("Основные");
	НаборЗаписей.Прочитать();

	Если НаборЗаписей.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запись = НаборЗаписей[0];

	Результат.SMTPСервер = Запись.SMTPСервер;
	Результат.SMTPПорт = Запись.SMTPПорт;
	Результат.SMTPЛогин = Запись.SMTPЛогин;
	Результат.SMTPПароль = Запись.SMTPПароль;
	Результат.АдресОтправителя = Запись.АдресОтправителя;
	Результат.ИспользоватьSSL = Запись.ИспользоватьSSL;

	Возврат Результат;

КонецФункции


// Сохраняет настройки SMTP в регистр сведений.

Функция ЕРП_СохранитьНастройкиSMTP(
	SMTPСервер,
	SMTPПорт,
	SMTPЛогин,
	SMTPПароль,
	АдресОтправителя,
	ИспользоватьSSL) Экспорт

	Если ПустаяСтрока(SMTPСервер) Тогда
		Возврат "ОШИБКА: не указан SMTP-сервер.";
	КонецЕсли;

	Если SMTPПорт <= 0 Тогда
		Возврат "ОШИБКА: неверно указан SMTP-порт.";
	КонецЕсли;

	Если ПустаяСтрока(SMTPЛогин) Тогда
		Возврат "ОШИБКА: не указан SMTP-логин.";
	КонецЕсли;

	Если ПустаяСтрока(SMTPПароль) Тогда
		Возврат "ОШИБКА: не указан пароль SMTP.";
	КонецЕсли;

	Если ПустаяСтрока(АдресОтправителя) Тогда
		Возврат "ОШИБКА: не указан адрес отправителя.";
	КонецЕсли;

	Попытка

		НаборЗаписей = РегистрыСведений.ЕРП_НастройкиSMTP.СоздатьНаборЗаписей();

		НаборЗаписей.Отбор.КлючНастройки.Установить("Основные");
		НаборЗаписей.Прочитать();

		Если НаборЗаписей.Количество() = 0 Тогда
			Запись = НаборЗаписей.Добавить();
			Запись.КлючНастройки = "Основные";
		Иначе
			Запись = НаборЗаписей[0];
		КонецЕсли;

		Запись.SMTPСервер = SMTPСервер;
		Запись.SMTPПорт = SMTPПорт;
		Запись.SMTPЛогин = SMTPЛогин;
		Запись.SMTPПароль = SMTPПароль;
		Запись.АдресОтправителя = АдресОтправителя;
		Запись.ИспользоватьSSL = ИспользоватьSSL;

		НаборЗаписей.Записать(Истина);

		ЗаписьЖурналаРегистрации(
			"ЕРП.ОтправкаПочты",
			УровеньЖурналаРегистрации.Информация,
			,
			,
			"Настройки SMTP сохранены."
		);

		Возврат "Настройки SMTP успешно сохранены.";

	Исключение

		ТекстОшибки = ОписаниеОшибки();

		ЗаписьЖурналаРегистрации(
			"ЕРП.ОтправкаПочты",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			"Ошибка сохранения настроек SMTP: " + ТекстОшибки
		);

		Возврат "ОШИБКА СОХРАНЕНИЯ: " + ТекстОшибки;

	КонецПопытки;

КонецФункции


// Отправляет одно электронное письмо.

Функция ЕРП_ОтправитьПисьмо(Получатель, Тема, ТекстПисьма) Экспорт

	Если ПустаяСтрока(Получатель) Тогда
		Возврат "ОШИБКА: не указан адрес получателя.";
	КонецЕсли;

	Если ПустаяСтрока(Тема) Тогда
		Возврат "ОШИБКА: не указана тема письма.";
	КонецЕсли;

	Если ПустаяСтрока(ТекстПисьма) Тогда
		Возврат "ОШИБКА: текст письма не заполнен.";
	КонецЕсли;

	Настройки = ЕРП_ПолучитьНастройкиSMTP();

	Если ПустаяСтрока(Настройки.SMTPСервер)
		Или ПустаяСтрока(Настройки.SMTPЛогин)
		Или ПустаяСтрока(Настройки.SMTPПароль)
		Или ПустаяСтрока(Настройки.АдресОтправителя) Тогда

		Возврат "ОШИБКА: настройки SMTP заполнены не полностью.";

	КонецЕсли;

	Почта = Неопределено;
	Подключено = Ложь;

	Попытка

		Профиль = Новый ИнтернетПочтовыйПрофиль;

		Профиль.АдресСервераSMTP = Настройки.SMTPСервер;
		Профиль.ПортSMTP = Настройки.SMTPПорт;
		Профиль.ИспользоватьSSLSMTP = Настройки.ИспользоватьSSL;
		Профиль.ПользовательSMTP = Настройки.SMTPЛогин;
		Профиль.ПарольSMTP = Настройки.SMTPПароль;
		Профиль.ВремяОжидания = 30;

		Сообщение = Новый ИнтернетПочтовоеСообщение;

		Сообщение.Отправитель = Настройки.АдресОтправителя;
		Сообщение.Тема = Тема;

		Сообщение.Получатели.Добавить(Получатель);

		Сообщение.Тексты.Добавить(
			ТекстПисьма,
			ТипТекстаПочтовогоСообщения.ПростойТекст
		);

		Почта = Новый ИнтернетПочта;

		Почта.Подключиться(Профиль);
		Подключено = Истина;

		Почта.Послать(Сообщение);

		Почта.Отключиться();
		Подключено = Ложь;

		ЗаписьЖурналаРегистрации(
			"ЕРП.ОтправкаПочты",
			УровеньЖурналаРегистрации.Информация,
			,
			,
			"Письмо передано SMTP-серверу. Получатель: " + Получатель
		);

		Возврат "Письмо передано SMTP-серверу. Получатель: " + Получатель;

	Исключение

		ТекстОшибки = ОписаниеОшибки();

		Если Подключено Тогда
			Попытка
				Почта.Отключиться();
			Исключение
			КонецПопытки;
		КонецЕсли;

		ЗаписьЖурналаРегистрации(
			"ЕРП.ОтправкаПочты",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			"Ошибка отправки почты: " + ТекстОшибки
		);

		Возврат "ОШИБКА ОТПРАВКИ SMTP: " + ТекстОшибки;

	КонецПопытки;

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Общий модуль: ЕРП_ОтправкаПочты
//
// Чтение и сохранение настроек SMTP, а также отправка контрольного письма.
// Единственный источник SMTP-настроек: регистр ЕРП_НастройкиSMTP.
////////////////////////////////////////////////////////////////////////////////

Функция ЕРП_ПолучитьНастройкиSMTP() Экспорт

    Результат = Новый Структура(
        "SMTPСервер,SMTPПорт,SMTPЛогин,SMTPПароль,АдресОтправителя,ИспользоватьSSL",
        "",
        465,
        "",
        "",
        "",
        Истина
    );

    НаборЗаписей = РегистрыСведений.ЕРП_НастройкиSMTP.СоздатьНаборЗаписей();
    НаборЗаписей.Отбор.КлючНастройки.Установить("Основные");
    НаборЗаписей.Прочитать();

    Если НаборЗаписей.Количество() = 0 Тогда
        Возврат Результат;
    КонецЕсли;

    Запись = НаборЗаписей[0];

    Результат.SMTPСервер = Запись.SMTPСервер;
    Результат.SMTPПорт = Запись.SMTPПорт;
    Результат.SMTPЛогин = Запись.SMTPЛогин;
    Результат.SMTPПароль = Запись.SMTPПароль;
    Результат.АдресОтправителя = Запись.АдресОтправителя;
    Результат.ИспользоватьSSL = Запись.ИспользоватьSSL;

    Возврат Результат;

КонецФункции


Функция ЕРП_СохранитьНастройкиSMTP(
    SMTPСервер,
    SMTPПорт,
    SMTPЛогин,
    SMTPПароль,
    АдресОтправителя,
    ИспользоватьSSL) Экспорт

    Если ПустаяСтрока(SMTPСервер) Тогда
        ЕРП_ЖурналУведомлений.Ошибка("НАСТРОЙКИ SMTP", "Не указан SMTP-сервер.");
        Возврат "ОШИБКА: не указан SMTP-сервер.";
    КонецЕсли;

    Если SMTPПорт <= 0 Тогда
        ЕРП_ЖурналУведомлений.Ошибка("НАСТРОЙКИ SMTP", "Неверно указан SMTP-порт.");
        Возврат "ОШИБКА: неверно указан SMTP-порт.";
    КонецЕсли;

    Если ПустаяСтрока(SMTPЛогин) Тогда
        ЕРП_ЖурналУведомлений.Ошибка("НАСТРОЙКИ SMTP", "Не указан SMTP-логин.");
        Возврат "ОШИБКА: не указан SMTP-логин.";
    КонецЕсли;

    Если ПустаяСтрока(SMTPПароль) Тогда
        ЕРП_ЖурналУведомлений.Ошибка("НАСТРОЙКИ SMTP", "Не указан пароль SMTP.");
        Возврат "ОШИБКА: не указан пароль SMTP.";
    КонецЕсли;

    Если ПустаяСтрока(АдресОтправителя) Тогда
        ЕРП_ЖурналУведомлений.Ошибка("НАСТРОЙКИ SMTP", "Не указан адрес отправителя.");
        Возврат "ОШИБКА: не указан адрес отправителя.";
    КонецЕсли;

    Попытка
        НаборЗаписей = РегистрыСведений.ЕРП_НастройкиSMTP.СоздатьНаборЗаписей();
        НаборЗаписей.Отбор.КлючНастройки.Установить("Основные");
        НаборЗаписей.Прочитать();

        Если НаборЗаписей.Количество() = 0 Тогда
            Запись = НаборЗаписей.Добавить();
            Запись.КлючНастройки = "Основные";
        Иначе
            Запись = НаборЗаписей[0];
        КонецЕсли;

        Запись.SMTPСервер = SMTPСервер;
        Запись.SMTPПорт = SMTPПорт;
        Запись.SMTPЛогин = SMTPЛогин;
        Запись.SMTPПароль = SMTPПароль;
        Запись.АдресОтправителя = АдресОтправителя;
        Запись.ИспользоватьSSL = ИспользоватьSSL;

        НаборЗаписей.Записать(Истина);

        ЗаписьЖурналаРегистрации(
            "ЕРП.ОтправкаПочты",
            УровеньЖурналаРегистрации.Информация,
            ,
            ,
            "Настройки SMTP сохранены."
        );

        ЕРП_ЖурналУведомлений.Информация(
            "НАСТРОЙКИ SMTP",
            "Настройки SMTP сохранены.",
            "Сервер: " + SMTPСервер + "; порт: " + Строка(SMTPПорт)
        );

        Возврат "Настройки SMTP успешно сохранены.";

    Исключение
        ТекстОшибки = ОписаниеОшибки();

        ЕРП_ЖурналУведомлений.Ошибка(
            "НАСТРОЙКИ SMTP",
            "Ошибка сохранения настроек SMTP: " + ТекстОшибки
        );

        ЗаписьЖурналаРегистрации(
            "ЕРП.ОтправкаПочты",
            УровеньЖурналаРегистрации.Ошибка,
            ,
            ,
            "Ошибка сохранения настроек SMTP: " + ТекстОшибки
        );

        Возврат "ОШИБКА СОХРАНЕНИЯ: " + ТекстОшибки;
    КонецПопытки;

КонецФункции


Функция ЕРП_ОтправитьПисьмоСРезультатом(Получатель, Тема, ТекстПисьма) Экспорт

    Результат = Новый Структура("Успех,ОписаниеОшибки", Ложь, "");

    Если ПустаяСтрока(Получатель) Тогда
        Результат.ОписаниеОшибки = "Не указан адрес получателя.";
        ЕРП_ЖурналУведомлений.Ошибка("SMTP ОТПРАВКА", Результат.ОписаниеОшибки);
        Возврат Результат;
    КонецЕсли;

    Если ПустаяСтрока(Тема) Тогда
        Результат.ОписаниеОшибки = "Не указана тема письма.";
        ЕРП_ЖурналУведомлений.Ошибка("SMTP ОТПРАВКА", Результат.ОписаниеОшибки);
        Возврат Результат;
    КонецЕсли;

    Если ПустаяСтрока(ТекстПисьма) Тогда
        Результат.ОписаниеОшибки = "Текст письма не заполнен.";
        ЕРП_ЖурналУведомлений.Ошибка("SMTP ОТПРАВКА", Результат.ОписаниеОшибки);
        Возврат Результат;
    КонецЕсли;

    Настройки = ЕРП_ПолучитьНастройкиSMTP();

    Если ПустаяСтрока(Настройки.SMTPСервер)
        Или Настройки.SMTPПорт < 1
        Или Настройки.SMTPПорт > 65535
        Или ПустаяСтрока(Настройки.SMTPЛогин)
        Или ПустаяСтрока(Настройки.SMTPПароль)
        Или ПустаяСтрока(Настройки.АдресОтправителя) Тогда

        Результат.ОписаниеОшибки = "Настройки SMTP заполнены не полностью или содержат неверный порт.";
        ЕРП_ЖурналУведомлений.Ошибка("SMTP ОТПРАВКА", Результат.ОписаниеОшибки);
        Возврат Результат;
    КонецЕсли;

    Почта = Неопределено;
    Подключено = Ложь;

    Попытка
        Профиль = Новый ИнтернетПочтовыйПрофиль;
        Профиль.АдресСервераSMTP = Настройки.SMTPСервер;
        Профиль.ПортSMTP = Настройки.SMTPПорт;
        Профиль.ИспользоватьSSLSMTP = Настройки.ИспользоватьSSL;
        Профиль.ПользовательSMTP = Настройки.SMTPЛогин;
        Профиль.ПарольSMTP = Настройки.SMTPПароль;
        Профиль.ВремяОжидания = 30;

        Сообщение = Новый ИнтернетПочтовоеСообщение;
        Сообщение.Отправитель = Настройки.АдресОтправителя;
        Сообщение.Тема = Тема;
        Сообщение.Получатели.Добавить(Получатель);
        Сообщение.Тексты.Добавить(
            ТекстПисьма,
            ТипТекстаПочтовогоСообщения.ПростойТекст
        );

        Почта = Новый ИнтернетПочта;
        Почта.Подключиться(Профиль);
        Подключено = Истина;

        // Успех определяется результатом Послать, а не отключением сеанса.
        // Ошибка закрытия уже отправленного письма не должна вызывать повтор.
        Почта.Послать(Сообщение);
        Результат.Успех = Истина;

        Попытка
            Почта.Отключиться();
            Подключено = Ложь;
        Исключение
            Подключено = Ложь;
        КонецПопытки;

        ЕРП_ЖурналУведомлений.Информация(
            "SMTP ОТПРАВКА",
            "Письмо передано SMTP-серверу.",
            "Получатель: " + Получатель
        );

    Исключение
        Результат.Успех = Ложь;
        Результат.ОписаниеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());

        Если Подключено Тогда
            Попытка
                Почта.Отключиться();
            Исключение
            КонецПопытки;
        КонецЕсли;

        ЕРП_ЖурналУведомлений.Ошибка(
            "SMTP ОТПРАВКА",
            "Ошибка отправки почты: " + Результат.ОписаниеОшибки,
            "Получатель: " + Получатель
        );
    КонецПопытки;

    Возврат Результат;

КонецФункции


// Совместимый интерфейс для формы настройки SMTP и прежних вызовов.
Функция ЕРП_ОтправитьПисьмо(Получатель, Тема, ТекстПисьма) Экспорт

    Результат = ЕРП_ОтправитьПисьмоСРезультатом(
        Получатель,
        Тема,
        ТекстПисьма
    );

    Если Результат.Успех Тогда
        Возврат "Письмо передано SMTP-серверу. Получатель: " + Получатель;
    КонецЕсли;

    Возврат "ОШИБКА ОТПРАВКИ SMTP: " + Результат.ОписаниеОшибки;

КонецФункции

Функция ЕРП_ПолучитьХешКода(Код)

    Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
    Хеширование.Добавить(
        ПолучитьДвоичныеДанныеИзСтроки(Код, КодировкаТекста.UTF8));
    Возврат Base64Строка(Хеширование.ХешСумма);

КонецФункции



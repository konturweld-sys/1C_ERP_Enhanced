////////////////////////////////////////////////////////////////////////////////
// Управление жизненным циклом Telegram-привязок.
// Ключ привязки: ФизическоеЛицо + ИдентификаторБота + ИдентификаторПривязки.
// Исторические записи не перезаписываются; перенос выполняется транзакционно.
////////////////////////////////////////////////////////////////////////////////

Функция ЕРП_СоздатьКодПривязкиTelegram(Сотрудник) Экспорт

    ПроверитьПравоУправленияПривязкамиTelegram(Ложь);
    ФизическоеЛицо = ПроверитьАктивностьСотрудника(Сотрудник);

    Бот = ЕРП_ИнтеграцияUBT.ПолучитьБотаПоУмолчанию();
    Если Не ЗначениеЗаполнено(Бот) Тогда
        ВызватьИсключение "В UBT не найден активный Telegram-бот.";
    КонецЕсли;

    Возврат СоздатьЗапросПривязкиTelegram(
        Сотрудник,
        ФизическоеЛицо,
        Бот.УникальныйИдентификатор(),
        НулевойUUID(),
        НулевойUUID());

КонецФункции


// Перенос запускается администратором для существующей активной привязки.
// Новый владелец подтверждает тот же Telegram Chat через /start, после чего
// администратор отдельно подтверждает перенос в форме запросов.
Функция ЕРП_СоздатьЗапросПереносаTelegram(
    СтарыйИдентификаторПривязки,
    НовыйСотрудник) Экспорт

    Если Не РольДоступна("ЕРП_УправлениеПривязкамиTelegram") Тогда
        ВызватьИсключение "Инициировать перенос может только администратор привязок.";
    КонецЕсли;

    Если Не ЗначениеЗаполнено(СтарыйИдентификаторПривязки) Тогда
        ВызватьИсключение "Не указан UUID исходной привязки.";
    КонецЕсли;

    НовыйФизическоеЛицо = ПроверитьАктивностьСотрудника(НовыйСотрудник);
    СтараяПривязка = ПолучитьПривязкуПоUUID(СтарыйИдентификаторПривязки);

    Если СтараяПривязка.Состояние <> "Активна" Тогда
        ВызватьИсключение "Перенос возможен только из активной привязки.";
    КонецЕсли;

    ТекущееФизическоеЛицоИсточника = ПроверитьАктивностьСотрудника(
        СтараяПривязка.Сотрудник);
    Если ТекущееФизическоеЛицоИсточника <> СтараяПривязка.ФизическоеЛицо Тогда
        ВызватьИсключение
            "Физическое лицо исходного сотрудника изменилось. "
            + "Сначала выполните сверку жизненного цикла привязок.";
    КонецЕсли;

    Если СтараяПривязка.Сотрудник = НовыйСотрудник Тогда
        ВызватьИсключение "Новый владелец совпадает с текущим сотрудником.";
    КонецЕсли;

    ПроверитьНетДругойАктивнойПривязки(
        НовоеФизическоеЛицо,
        СтараяПривязка.ИдентификаторПривязки);

    ИдентификаторОперацииПереноса = Новый УникальныйИдентификатор;

    Возврат СоздатьЗапросПривязкиTelegram(
        НовыйСотрудник,
        НовыйФизическоеЛицо,
        СтараяПривязка.ИдентификаторБота,
        ИдентификаторОперацииПереноса,
        СтараяПривязка.ИдентификаторПривязки);

КонецФункции


Функция ЕРП_ПолучитьСтатусПривязкиTelegram(Сотрудник) Экспорт

    ПроверитьПравоУправленияПривязкамиTelegram(Истина);

    Результат = Новый Структура(
        "Привязана,ChatID,ИдентификаторБота,ИдентификаторПривязки,ДатаПривязки,Состояние",
        Ложь, "", Неопределено, Неопределено, Дата(1,1,1), "НеПривязана");

    БотПоУмолчанию = ЕРП_ИнтеграцияUBT.ПолучитьБотаПоУмолчанию();
    Если Не ЗначениеЗаполнено(БотПоУмолчанию) Тогда
        Возврат Результат;
    КонецЕсли;

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |   Привязки.ChatID КАК ChatID,
    |   Привязки.ИдентификаторБота КАК ИдентификаторБота,
    |   Привязки.ИдентификаторПривязки КАК ИдентификаторПривязки,
    |   Привязки.ДатаПривязки КАК ДатаПривязки,
    |   Привязки.Состояние КАК Состояние
    |ИЗ
    |   РегистрСведений.ЕРП_ПривязкиTelegram КАК Привязки
    |ГДЕ
    |   Привязки.Сотрудник = &Сотрудник
    |   И Привязки.ИдентификаторБота = &ИдентификаторБота
    |   И Привязки.Состояние = ""Активна""";
    Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
    Запрос.УстановитьПараметр("ИдентификаторБота", БотПоУмолчанию.УникальныйИдентификатор());

    Выборка = Запрос.Выполнить().Выбрать();
    Если Не Выборка.Следующий() Тогда
        Возврат Результат;
    КонецЕсли;

    Результат.Привязана = Истина;
    Результат.ChatID = Выборка.ChatID;
    Результат.ИдентификаторБота = Выборка.ИдентификаторБота;
    Результат.ИдентификаторПривязки = Выборка.ИдентификаторПривязки;
    Результат.ДатаПривязки = Выборка.ДатаПривязки;
    Результат.Состояние = Выборка.Состояние;

    Если Выборка.Следующий() Тогда
        ВызватьИсключение "Нарушена целостность: у сотрудника более одной активной Telegram-привязки.";
    КонецЕсли;

    Возврат Результат;

КонецФункции


Функция ЕРП_ОбработатьОбновленияTelegram(
    Бот, ChatID, ТипЧата, UpdateID, ТекстКоманды) Экспорт

    ПроверитьПравоУправленияПривязкамиTelegram(Истина);

    Результат = Новый Структура(
        "Принято,ОжидаетПодтверждения,Сообщение",
        Ложь, Ложь, "");

    Если Не ЗначениеЗаполнено(Бот)
        Или Не ЗначениеЗаполнено(ChatID)
        Или ТипЧата <> "private"
        Или UpdateID <= 0 Тогда
        Результат.Сообщение = "Допускается только личный чат и корректное обновление Telegram.";
        Возврат Результат;
    КонецЕсли;

    Части = СтрРазделить(СокрЛП(ТекстКоманды), " ");
    Если Части.Количество() <> 2 Тогда
        Результат.Сообщение = "Ожидается команда /start КОД.";
        Возврат Результат;
    КонецЕсли;

    Команда = Части[0];
    Если Команда <> "/start" И Лев(Команда, 7) <> "/start@" Тогда
        Результат.Сообщение = "Неизвестная команда.";
        Возврат Результат;
    КонецЕсли;

    Попытка
        ИдентификаторЗапроса = Новый УникальныйИдентификатор(Части[1]);
    Исключение
        Результат.Принято = Истина;
        Результат.Сообщение = "Код запроса имеет некорректный формат.";
        Возврат Результат;
    КонецПопытки;

    ХешКода = ЕРП_ПолучитьХешКода(Части[1]);
    ПовторяемаяОшибка = Истина;

    НачатьТранзакцию();
    Попытка
        ЗаблокироватьВсеЗапросыTelegram();

        ЗапросПривязки = РегистрыСведений.ЕРП_ЗапросыПривязкиTelegram.СоздатьМенеджерЗаписи();
        ЗапросПривязки.ХешКода = ХешКода;
        ЗапросПривязки.Прочитать();

        Если Не ЗапросПривязки.Выбран() Тогда
            ПовторяемаяОшибка = Ложь;
            ВызватьИсключение "Код привязки не найден.";
        КонецЕсли;

        Если ЗапросПривязки.ИдентификаторЗапроса <> НулевойUUID()
            И ЗапросПривязки.ИдентификаторЗапроса <> ИдентификаторЗапроса Тогда
            ПовторяемаяОшибка = Ложь;
            ВызватьИсключение "Конфликт UUID запроса: код не соответствует сохранённому запросу.";
        КонецЕсли;

        Если ЗапросПривязки.ИдентификаторБота <> Бот.УникальныйИдентификатор() Тогда
            ПовторяемаяОшибка = Ложь;
            ВызватьИсключение "Код привязки предназначен для другого бота.";
        КонецЕсли;

        Если ЗапросПривязки.UpdateID > 0 Тогда
            Если ЗапросПривязки.UpdateID <> UpdateID
                Или ЗапросПривязки.ChatID <> ChatID Тогда
                ПовторяемаяОшибка = Ложь;
                ВызватьИсключение "Конфликт идемпотентности: UUID запроса уже использован с другими параметрами.";
            КонецЕсли;

            Если ЗапросПривязки.Состояние = "ТехническаяОшибка" Тогда
                ЗафиксироватьТранзакцию();
                Результат.Принято = Истина;
                Результат.Сообщение = "Лимит повторных попыток исчерпан. Требуется решение администратора ERP.";
                Возврат Результат;
            КонецЕсли;

            Если ЗапросПривязки.Состояние <> "Создан" Тогда
                ЗафиксироватьТранзакцию();
                Результат.Принято = Истина;
                Результат.ОжидаетПодтверждения =
                    ЗапросПривязки.Состояние = "ПолученОтБота"
                    Или ЗапросПривязки.Состояние = "ОжидаетРазрешения";
                Результат.Сообщение = "Повторная доставка уже обработанного Telegram Update. Состояние запроса не изменено.";
                Возврат Результат;
            КонецЕсли;
        КонецЕсли;

        ВыборкаЗапросов = РегистрыСведений.ЕРП_ЗапросыПривязкиTelegram.Выбрать();
        Пока ВыборкаЗапросов.Следующий() Цикл
            Если ВыборкаЗапросов.ХешКода <> ХешКода
                И ВыборкаЗапросов.ИдентификаторБота = ЗапросПривязки.ИдентификаторБота
                И ВыборкаЗапросов.UpdateID = UpdateID
                И ВыборкаЗапросов.UpdateID > 0 Тогда

                Если ВыборкаЗапросов.ИдентификаторЗапроса <> ИдентификаторЗапроса
                    Или ВыборкаЗапросов.ChatID <> ChatID Тогда
                    ПовторяемаяОшибка = Ложь;
                    ВызватьИсключение "Конфликт UpdateID: идентификатор уже использован другим запросом или Telegram Chat.";
                КонецЕсли;
            КонецЕсли;

            Если ВыборкаЗапросов.ХешКода <> ХешКода
                И ВыборкаЗапросов.ИдентификаторЗапроса = ИдентификаторЗапроса Тогда
                ПовторяемаяОшибка = Ложь;
                ВызватьИсключение "Конфликт UUID запроса: обнаружена другая запись с тем же идентификатором.";
            КонецЕсли;
        КонецЦикла;

        Если ЗапросПривязки.Состояние = "ТехническаяОшибка" Тогда
            ЗафиксироватьТранзакцию();
            Результат.Принято = Истина;
            Результат.Сообщение = "Лимит повторных попыток исчерпан. Требуется решение администратора ERP.";
            Возврат Результат;
        КонецЕсли;

        Если ЗапросПривязки.Состояние <> "Создан" Тогда
            ПовторяемаяОшибка = Ложь;
            ВызватьИсключение "Запрос уже завершён или не допускает подтверждение из Telegram.";
        КонецЕсли;

        Если ЗапросПривязки.ДатаИстечения < ТекущаяДата() Тогда
            ПовторяемаяОшибка = Ложь;
            ВызватьИсключение "Срок действия кода привязки истёк.";
        КонецЕсли;

        Если ЗначениеЗаполнено(ЗапросПривязки.ДатаСледующейПопытки)
            И ЗапросПривязки.ДатаСледующейПопытки > ТекущаяДата() Тогда
            ЗафиксироватьТранзакцию();
            Результат.Сообщение = "Повторная обработка отложена до "
                + Формат(ЗапросПривязки.ДатаСледующейПопытки, "ДФ=dd.MM.yyyy HH:mm:ss") + ".";
            Возврат Результат;
        КонецЕсли;

        Если ЗначениеЗаполнено(ЗапросПривязки.ИдентификаторОперацииПереноса)
            И ЗапросПривязки.ИдентификаторОперацииПереноса <> НулевойUUID() Тогда

            СтараяПривязка = ПолучитьПривязкуПоUUID(
                ЗапросПривязки.СтарыйИдентификаторПривязки);

            Если СтараяПривязка.Состояние <> "Активна"
                Или СтараяПривязка.ИдентификаторБота <> ЗапросПривязки.ИдентификаторБота
                Или СтараяПривязка.ChatID <> ChatID Тогда
                ВызватьИсключение "Telegram Chat не соответствует исходной активной привязке. Перенос отклонён.";
            КонецЕсли;

        Иначе

            ПроверитьChatIDВАрхиве(
                ЗапросПривязки.ИдентификаторБота,
                ChatID);

            ЗаблокироватьЗанятыйЧат(ЗапросПривязки.ИдентификаторБота, ChatID);
            ЗанятыйЧат = РегистрыСведений.ЕРП_ЗанятыеЧатыTelegram.СоздатьМенеджерЗаписи();
            ЗанятыйЧат.ИдентификаторБота = ЗапросПривязки.ИдентификаторБота;
            ЗанятыйЧат.ChatID = ChatID;
            ЗанятыйЧат.Прочитать();

            Если ЗанятыйЧат.Выбран() Тогда
                ВызватьИсключение "Этот ChatID уже закреплён за существующей или исторической привязкой. Требуется контролируемый перенос.";
            КонецЕсли;

        КонецЕсли;

        ЗапросПривязки.ИдентификаторЗапроса = ИдентификаторЗапроса;
        ЗапросПривязки.ChatID = ChatID;
        ЗапросПривязки.UpdateID = UpdateID;
        // Счётчик хранит последовательные неудачные попытки текущего этапа.
        // Успешное завершение этапа сбрасывает лимит повторов.
        ЗапросПривязки.КоличествоПопыток = 0;
        ЗапросПривязки.ДатаПоследнейПопытки = ТекущаяДата();
        ЗапросПривязки.ДатаСледующейПопытки = Дата(1, 1, 1);
        ЗапросПривязки.ПоследняяОшибка = "";
        Если ЗапросПривязки.ИдентификаторОперацииПереноса <> НулевойUUID() Тогда
            ЗапросПривязки.Состояние = "ОжидаетРазрешения";
            СтараяПривязкаДляАудита = ПолучитьПривязкуПоUUID(
                ЗапросПривязки.СтарыйИдентификаторПривязки);
            ЗаписатьИсториюПривязки(
                ЗапросПривязки.Сотрудник,
                ЗапросПривязки.ИдентификаторБота,
                ChatID,
                Перечисления.ЕРП_ОперацииПривязкиTelegram.ПодтверждениеВладельцем,
                "Новый владелец подтвердил Telegram Chat через UBT.",
                ЗапросПривязки.ИдентификаторОперацииПереноса,
                ЗапросПривязки.СтарыйИдентификаторПривязки,
                НулевойUUID(),
                СтараяПривязкаДляАудита.Сотрудник,
                ЗапросПривязки.Сотрудник,
                "Успех",
                "ОжидаетПодтверждения",
                "ОжидаетРазрешения",
                СтараяПривязкаДляАудита.ChatID,
                ChatID);
        Иначе
            ЗапросПривязки.Состояние = "ПолученОтБота";
        КонецЕсли;
        ЗапросПривязки.Записать();

        ЗафиксироватьТранзакцию();

    Исключение
        ОшибкаВерификации = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
        ОтменитьТранзакцию();

        Если ПовторяемаяОшибка
            И ЭтоТехническаяОшибкаЗапросаTelegram(ОшибкаВерификации) Тогда
            Попытка
                РезультатПопытки = ЗафиксироватьНеудачнуюПопыткуЗапросаTelegram(
                    ХешКода,
                    ИдентификаторЗапроса,
                    UpdateID,
                    ChatID,
                    ОшибкаВерификации);
                Если РезультатПопытки.ТехническаяОшибка Тогда
                    Результат.Принято = Истина;
                    Результат.Сообщение = "Лимит технических повторов исчерпан. Требуется решение администратора ERP. "
                        + ОшибкаВерификации;
                Иначе
                    Результат.Сообщение = "Техническая ошибка обработки Telegram Update. Попытка "
                        + Строка(РезультатПопытки.КоличествоПопыток)
                        + " из 5; следующая попытка не ранее "
                        + Формат(РезультатПопытки.ДатаСледующейПопытки, "ДФ=dd.MM.yyyy HH:mm:ss")
                        + ". " + ОшибкаВерификации;
                КонецЕсли;
            Исключение
                Результат.Сообщение = "Не удалось зафиксировать техническую ошибку обработки Telegram Update.";
            КонецПопытки;
        Иначе
            Результат.Принято = Истина;
            Результат.Сообщение = ОшибкаВерификации;
        КонецЕсли;

        // Отказ проверки Telegram фиксируется отдельно от откатившейся транзакции.
        Попытка
            ЗапросДляАудита = РегистрыСведений.ЕРП_ЗапросыПривязкиTelegram.СоздатьМенеджерЗаписи();
            ЗапросДляАудита.ХешКода = ХешКода;
            ЗапросДляАудита.Прочитать();

            Если ЗапросДляАудита.Выбран()
                И ЗапросДляАудита.ИдентификаторОперацииПереноса <> НулевойUUID() Тогда

                СтараяПривязкаДляАудита = ПолучитьПривязкуПоUUID(
                    ЗапросДляАудита.СтарыйИдентификаторПривязки);

                ЗаписатьИсториюПривязки(
                    ЗапросДляАудита.Сотрудник,
                    ЗапросДляАудита.ИдентификаторБота,
                    ChatID,
                    Перечисления.ЕРП_ОперацииПривязкиTelegram.ПодтверждениеВладельцем,
                    "Не пройдена проверка Telegram Chat при контролируемом переносе.",
                    ЗапросДляАудита.ИдентификаторОперацииПереноса,
                    ЗапросДляАудита.СтарыйИдентификаторПривязки,
                    НулевойUUID(),
                    СтараяПривязкаДляАудита.Сотрудник,
                    ЗапросДляАудита.Сотрудник,
                    "Отказ",
                    ЗапросДляАудита.Состояние,
                    ЗапросДляАудита.Состояние,
                    СтараяПривязкаДляАудита.ChatID,
                    ChatID,
                    ОшибкаВерификации);

            КонецЕсли;
        Исключение
            // Отказ в обработке не маскируется ошибкой дополнительного аудита.
        КонецПопытки;

        Результат.Сообщение = ОшибкаВерификации;
        Возврат Результат;
    КонецПопытки;

    Результат.Принято = Истина;
    Результат.ОжидаетПодтверждения = Истина;
    Результат.Сообщение = "Telegram подтверждён. Ожидается отдельное подтверждение администратора ERP.";
    Возврат Результат;

КонецФункции


Процедура ЕРП_ПодтвердитьПривязкуTelegram(Сотрудник, Код) Экспорт

    ПроверитьПравоУправленияПривязкамиTelegram(Ложь);
    Если Не ЗначениеЗаполнено(Сотрудник) Или Не ЗначениеЗаполнено(Код) Тогда
        ВызватьИсключение "Не указан сотрудник или код привязки.";
    КонецЕсли;

    ЗавершитьПривязкуTelegramПоХешу(Сотрудник, ЕРП_ПолучитьХешКода(Код));

КонецПроцедуры


Процедура ЕРП_ПодтвердитьПривязкуTelegramПоХешу(Сотрудник, ХешКода) Экспорт

    ПроверитьПравоУправленияПривязкамиTelegram(Ложь);
    Если Не ЗначениеЗаполнено(Сотрудник) Или Не ЗначениеЗаполнено(ХешКода) Тогда
        ВызватьИсключение "Не указан сотрудник или хеш запроса.";
    КонецЕсли;

    ЗавершитьПривязкуTelegramПоХешу(Сотрудник, ХешКода);

КонецПроцедуры


Процедура ЕРП_ПодтвердитьЗапросTelegramПоПараметрам(
    Сотрудник,
    ИдентификаторБота,
    ДатаСоздания,
    UpdateID,
    ИдентификаторОперацииПереноса) Экспорт

    ПроверитьПравоУправленияПривязкамиTelegram(Ложь);
    ХешКода = ПолучитьХешЗапросаПоПараметрам(
        Сотрудник, ИдентификаторБота, ДатаСоздания, UpdateID,
        ИдентификаторОперацииПереноса);

    Если ИдентификаторОперацииПереноса <> НулевойUUID() Тогда
        ЕРП_ПодтвердитьПереносTelegramПоИдентификатору(ИдентификаторОперацииПереноса);
    Иначе
        ЕРП_ПодтвердитьПривязкуTelegramПоХешу(Сотрудник, ХешКода);
    КонецЕсли;

КонецПроцедуры


Процедура ЕРП_ОтменитьЗапросПривязкиTelegramПоПараметрам(
    Сотрудник,
    ИдентификаторБота,
    ДатаСоздания,
    UpdateID,
    ИдентификаторОперацииПереноса) Экспорт

    ПроверитьПравоУправленияПривязкамиTelegram(Ложь);
    ХешКода = ПолучитьХешЗапросаПоПараметрам(
        Сотрудник, ИдентификаторБота, ДатаСоздания, UpdateID,
        ИдентификаторОперацииПереноса);
    ЕРП_ОтменитьЗапросПривязкиTelegramПоХешу(ХешКода);

КонецПроцедуры


Функция ПолучитьХешЗапросаПоПараметрам(
    Сотрудник,
    ИдентификаторБота,
    ДатаСоздания,
    UpdateID,
    ИдентификаторОперацииПереноса)

    Если Не ЗначениеЗаполнено(Сотрудник)
        Или Не ЗначениеЗаполнено(ИдентификаторБота)
        Или Не ЗначениеЗаполнено(ДатаСоздания) Тогда
        ВызватьИсключение "Недостаточно данных для идентификации запроса Telegram.";
    КонецЕсли;

    Если Не ЗначениеЗаполнено(ИдентификаторОперацииПереноса) Тогда
        ИдентификаторОперацииПереноса = НулевойUUID();
    КонецЕсли;

    ЗапросПоиска = Новый Запрос;
    ЗапросПоиска.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 2
    |   Запросы.ХешКода КАК ХешКода
    |ИЗ
    |   РегистрСведений.ЕРП_ЗапросыПривязкиTelegram КАК Запросы
    |ГДЕ
    |   Запросы.Сотрудник = &Сотрудник
    |   И Запросы.ИдентификаторБота = &ИдентификаторБота
    |   И Запросы.ДатаСоздания = &ДатаСоздания
    |   И Запросы.UpdateID = &UpdateID
    |   И Запросы.ИдентификаторОперацииПереноса = &ИдентификаторОперацииПереноса";
    ЗапросПоиска.УстановитьПараметр("Сотрудник", Сотрудник);
    ЗапросПоиска.УстановитьПараметр("ИдентификаторБота", ИдентификаторБота);
    ЗапросПоиска.УстановитьПараметр("ДатаСоздания", ДатаСоздания);
    ЗапросПоиска.УстановитьПараметр("UpdateID", UpdateID);
    ЗапросПоиска.УстановитьПараметр(
        "ИдентификаторОперацииПереноса", ИдентификаторОперацииПереноса);

    ВыборкаЗапроса = ЗапросПоиска.Выполнить().Выбрать();
    Если Не ВыборкаЗапроса.Следующий() Тогда
        ВызватьИсключение "Запрос Telegram не найден или уже недоступен.";
    КонецЕсли;
    ХешКода = ВыборкаЗапроса.ХешКода;
    Если ВыборкаЗапроса.Следующий() Тогда
        ВызватьИсключение "Найдено несколько запросов Telegram с одинаковыми идентификационными данными.";
    КонецЕсли;
    Возврат ХешКода;

КонецФункции


Процедура ЕРП_ПодтвердитьПереносTelegramПоИдентификатору(ИдентификаторОперацииПереноса) Экспорт

    ПроверитьПравоУправленияПривязкамиTelegram(Ложь);
    Если Не ЗначениеЗаполнено(ИдентификаторОперацииПереноса)
        Или ИдентификаторОперацииПереноса = НулевойUUID() Тогда
        ВызватьИсключение "Не указан UUID операции контролируемого переноса.";
    КонецЕсли;

    ЗапросОперации = Новый Запрос;
    ЗапросОперации.Текст =
    "ВЫБРАТЬ
    |   Запросы.ХешКода КАК ХешКода,
    |   Запросы.Сотрудник КАК Сотрудник,
    |   Запросы.Состояние КАК Состояние,
    |   Запросы.ДатаИстечения КАК ДатаИстечения
    |ИЗ
    |   РегистрСведений.ЕРП_ЗапросыПривязкиTelegram КАК Запросы
    |ГДЕ
    |   Запросы.ИдентификаторОперацииПереноса = &ИдентификаторОперации";
    ЗапросОперации.УстановитьПараметр(
        "ИдентификаторОперации",
        ИдентификаторОперацииПереноса);

    ВыборкаОперации = ЗапросОперации.Выполнить().Выбрать();
    Если Не ВыборкаОперации.Следующий() Тогда
        ВызватьИсключение "Операция переноса не найдена.";
    КонецЕсли;

    СотрудникНовогоВладельца = ВыборкаОперации.Сотрудник;
    ХешКода = ВыборкаОперации.ХешКода;
    СостояниеОперации = ВыборкаОперации.Состояние;
    ДатаИстечения = ВыборкаОперации.ДатаИстечения;
    Если ВыборкаОперации.Следующий() Тогда
        ВызватьИсключение "UUID операции переноса не уникален. Подтверждение запрещено.";
    КонецЕсли;

    Если СостояниеОперации = "ОжидаетРазрешения"
        И ДатаИстечения < ТекущаяДата() Тогда
        ЗафиксироватьИстечениеПереноса(ХешКода);
        ВызватьИсключение "Срок подтверждения переноса истёк. Операция переведена в состояние «Истекла».";
    КонецЕсли;

    Если СостояниеОперации <> "ОжидаетРазрешения" Тогда

        // Повторное подтверждение и попытки завершить отменённую/истёкшую
        // операцию фиксируются как отказ, но состояние привязок не меняется.
        Попытка
            ЗапросДляАудита = РегистрыСведений.ЕРП_ЗапросыПривязкиTelegram.СоздатьМенеджерЗаписи();
            ЗапросДляАудита.ХешКода = ХешКода;
            ЗапросДляАудита.Прочитать();

            Если ЗапросДляАудита.Выбран()
                И ЗапросДляАудита.ИдентификаторОперацииПереноса <> НулевойUUID() Тогда

                СтараяПривязкаДляАудита = ПолучитьПривязкуПоUUID(
                    ЗапросДляАудита.СтарыйИдентификаторПривязки);

                ЗаписатьИсториюПривязки(
                    ЗапросДляАудита.Сотрудник,
                    ЗапросДляАудита.ИдентификаторБота,
                    ЗапросДляАудита.ChatID,
                    Перечисления.ЕРП_ОперацииПривязкиTelegram.Перенос,
                    "Отклонена повторная или недопустимая попытка завершения переноса.",
                    ИдентификаторОперацииПереноса,
                    ЗапросДляАудита.СтарыйИдентификаторПривязки,
                    НулевойUUID(),
                    СтараяПривязкаДляАудита.Сотрудник,
                    ЗапросДляАудита.Сотрудник,
                    "Отказ",
                    СостояниеОперации,
                    СостояниеОперации,
                    СтараяПривязкаДляАудита.ChatID,
                    ЗапросДляАудита.ChatID,
                    "Операция не находится в состоянии ОжидаетРазрешения.");

            КонецЕсли;
        Исключение
            // Отказ не маскируется возможной ошибкой дополнительной записи аудита.
        КонецПопытки;

        ВызватьИсключение "Перенос не ожидает окончательного разрешения администратора.";
    КонецЕсли;

    ЗавершитьПривязкуTelegramПоХешу(
        СотрудникНовогоВладельца,
        ХешКода);

КонецПроцедуры


Процедура ЗафиксироватьИстечениеПереноса(ХешКода)

    НачатьТранзакцию();
    Попытка
        ЗаблокироватьЗапросTelegram(ХешКода);

        ЗапросПривязки = РегистрыСведений.ЕРП_ЗапросыПривязкиTelegram.СоздатьМенеджерЗаписи();
        ЗапросПривязки.ХешКода = ХешКода;
        ЗапросПривязки.Прочитать();

        Если ЗапросПривязки.Выбран()
            И ЗапросПривязки.Состояние = "ОжидаетРазрешения"
            И ЗапросПривязки.ДатаИстечения < ТекущаяДата() Тогда

            СтараяПривязка = ПолучитьПривязкуПоUUID(
                ЗапросПривязки.СтарыйИдентификаторПривязки);

            ЗаписатьИсториюПривязки(
                ЗапросПривязки.Сотрудник,
                ЗапросПривязки.ИдентификаторБота,
                ЗапросПривязки.ChatID,
                Перечисления.ЕРП_ОперацииПривязкиTelegram.ИстечениеПереноса,
                "Истёк срок ожидания окончательного разрешения контролируемого переноса.",
                ЗапросПривязки.ИдентификаторОперацииПереноса,
                ЗапросПривязки.СтарыйИдентификаторПривязки,
                НулевойUUID(),
                СтараяПривязка.Сотрудник,
                ЗапросПривязки.Сотрудник,
                "Истёк",
                "ОжидаетРазрешения",
                "Истекла",
                СтараяПривязка.ChatID,
                ЗапросПривязки.ChatID);

            ЗапросПривязки.Состояние = "Истекла";
            ЗапросПривязки.Записать();

        КонецЕсли;

        ЗафиксироватьТранзакцию();

    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;

КонецПроцедуры


Процедура ЗавершитьПривязкуTelegramПоХешу(Сотрудник, ХешКода)

    НачатьТранзакцию();
    Попытка

        ЗаблокироватьЗапросTelegram(ХешКода);

        ЗапросПривязки = РегистрыСведений.ЕРП_ЗапросыПривязкиTelegram.СоздатьМенеджерЗаписи();
        ЗапросПривязки.ХешКода = ХешКода;
        ЗапросПривязки.Прочитать();

        Если ЗапросПривязки.Выбран()
            И ЗапросПривязки.Сотрудник = Сотрудник
            И ЗапросПривязки.Состояние = "Подтверждён" Тогда
            ЗафиксироватьТранзакцию();
            Возврат;
        КонецЕсли;

        Если ЗапросПривязки.Состояние = "ТехническаяОшибка" Тогда
            ВызватьИсключение "Запрос находится в состоянии технической ошибки. Требуется решение администратора ERP.";
        КонецЕсли;

        Если Не ЗапросПривязки.Выбран()
            Или ЗапросПривязки.Сотрудник <> Сотрудник
            Или (ЗапросПривязки.Состояние <> "ПолученОтБота"
                И ЗапросПривязки.Состояние <> "ОжидаетРазрешения")
            Или ЗапросПривязки.ДатаИстечения < ТекущаяДата()
            Или Не ЗначениеЗаполнено(ЗапросПривязки.ChatID) Тогда
            ВызватьИсключение "Запрос не готов к подтверждению, истёк или принадлежит другому сотруднику.";
        КонецЕсли;

        Если ЗначениеЗаполнено(ЗапросПривязки.ДатаСледующейПопытки)
            И ЗапросПривязки.ДатаСледующейПопытки > ТекущаяДата() Тогда
            ВызватьИсключение "Повторная обработка отложена до "
                + Формат(ЗапросПривязки.ДатаСледующейПопытки, "ДФ=dd.MM.yyyy HH:mm:ss") + ".";
        КонецЕсли;

        ФизическоеЛицо = ПроверитьАктивностьСотрудника(Сотрудник);
        ИдентификаторБота = ЗапросПривязки.ИдентификаторБота;

        Если ЗначениеЗаполнено(ЗапросПривязки.ИдентификаторОперацииПереноса)
            И ЗапросПривязки.ИдентификаторОперацииПереноса <> НулевойUUID() Тогда

            ЗавершитьКонтролируемыйПеренос(
                ЗапросПривязки,
                ФизическоеЛицо);

        Иначе

            ЗаблокироватьПривязкуФизЛица(ФизическоеЛицо);
            ПроверитьНетДругойАктивнойПривязки(ФизическоеЛицо, НулевойUUID());

            ЗаблокироватьЗанятыйЧат(ИдентификаторБота, ЗапросПривязки.ChatID);
            ЗанятыйЧат = РегистрыСведений.ЕРП_ЗанятыеЧатыTelegram.СоздатьМенеджерЗаписи();
            ЗанятыйЧат.ИдентификаторБота = ИдентификаторБота;
            ЗанятыйЧат.ChatID = ЗапросПривязки.ChatID;
            ЗанятыйЧат.Прочитать();

            Если ЗанятыйЧат.Выбран() Тогда
                ВызватьИсключение "ChatID уже закреплён. Повторное использование допускается только через контролируемый перенос.";
            КонецЕсли;

            ИдентификаторПривязки = Новый УникальныйИдентификатор;
            НоваяПривязка = РегистрыСведений.ЕРП_ПривязкиTelegram.СоздатьМенеджерЗаписи();
            НоваяПривязка.ФизическоеЛицо = ФизическоеЛицо;
            НоваяПривязка.ИдентификаторБота = ИдентификаторБота;
            НоваяПривязка.ИдентификаторПривязки = ИдентификаторПривязки;
            НоваяПривязка.Сотрудник = Сотрудник;
            НоваяПривязка.ChatID = ЗапросПривязки.ChatID;
            НоваяПривязка.ДатаПривязки = ТекущаяДата();
            НоваяПривязка.Состояние = "Активна";
            НоваяПривязка.ДатаИзменения = ТекущаяДата();
            НоваяПривязка.ОснованиеЗапроса = ХешКода;
            НоваяПривязка.ИдентификаторОперацииПереноса = НулевойUUID();
            НоваяПривязка.Записать();

            ЗанятыйЧат.Сотрудник = Сотрудник;
            ЗанятыйЧат.ДатаЗакрепления = ТекущаяДата();
            ЗанятыйЧат.ИдентификаторПривязки = ИдентификаторПривязки;
            ЗанятыйЧат.Записать();

            ЗаписатьИсториюПривязки(
                Сотрудник,
                ИдентификаторБота,
                ЗапросПривязки.ChatID,
                Перечисления.ЕРП_ОперацииПривязкиTelegram.Создание,
                "Подтверждена администратором ERP.",
                НулевойUUID(),
                НулевойUUID(),
                ИдентификаторПривязки,
                Неопределено,
                Сотрудник);

        КонецЕсли;

        ЗапросПривязки.Состояние = "Подтверждён";
        ЗапросПривязки.ДатаПодтверждения = ТекущаяДата();
        Если ЗапросПривязки.ИдентификаторЗапроса = НулевойUUID() Тогда
            ЗапросПривязки.ИдентификаторЗапроса = Новый УникальныйИдентификатор;
        КонецЕсли;
        ЗапросПривязки.КоличествоПопыток = 0;
        ЗапросПривязки.ДатаПоследнейПопытки = ТекущаяДата();
        ЗапросПривязки.ДатаСледующейПопытки = Дата(1, 1, 1);
        ЗапросПривязки.ПоследняяОшибка = "";
        ЗапросПривязки.Записать();

        ЗафиксироватьТранзакцию();

    Исключение
        ОшибкаЗавершения = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
        ОтменитьТранзакцию();

        Если ЭтоТехническаяОшибкаЗапросаTelegram(ОшибкаЗавершения) Тогда
            Попытка
                ЗафиксироватьНеудачнуюПопыткуЗапросаTelegram(
                    ХешКода,
                    НулевойUUID(),
                    0,
                    "",
                    ОшибкаЗавершения);
            Исключение
                // Не маскируем исходную ошибку финализации.
            КонецПопытки;
        КонецЕсли;

        // Ошибка финализации переносится в аудит отдельной транзакцией,
        // чтобы откат основной операции не удалил сведения о неудачной попытке.
        Попытка
            ЗапросДляАудита = РегистрыСведений.ЕРП_ЗапросыПривязкиTelegram.СоздатьМенеджерЗаписи();
            ЗапросДляАудита.ХешКода = ХешКода;
            ЗапросДляАудита.Прочитать();

            Если ЗапросДляАудита.Выбран()
                И ЗапросДляАудита.ИдентификаторОперацииПереноса <> НулевойUUID() Тогда

                СтараяПривязкаДляАудита = ПолучитьПривязкуПоUUID(
                    ЗапросДляАудита.СтарыйИдентификаторПривязки);

                ЗаписатьИсториюПривязки(
                    ЗапросДляАудита.Сотрудник,
                    ЗапросДляАудита.ИдентификаторБота,
                    ЗапросДляАудита.ChatID,
                    Перечисления.ЕРП_ОперацииПривязкиTelegram.Перенос,
                    "Не удалось завершить контролируемый перенос.",
                    ЗапросДляАудита.ИдентификаторОперацииПереноса,
                    ЗапросДляАудита.СтарыйИдентификаторПривязки,
                    НулевойUUID(),
                    СтараяПривязкаДляАудита.Сотрудник,
                    ЗапросДляАудита.Сотрудник,
                    "Ошибка",
                    ЗапросДляАудита.Состояние,
                    ЗапросДляАудита.Состояние,
                    СтараяПривязкаДляАудита.ChatID,
                    ЗапросДляАудита.ChatID,
                    ОшибкаЗавершения);

            КонецЕсли;
        Исключение
            // Первичная ошибка важнее возможной ошибки дополнительной записи аудита.
        КонецПопытки;

        ВызватьИсключение ОшибкаЗавершения;
    КонецПопытки;

КонецПроцедуры


Процедура ЗавершитьКонтролируемыйПеренос(ЗапросПривязки, НовоеФизическоеЛицо)

    ИдентификаторОперации = ЗапросПривязки.ИдентификаторОперацииПереноса;
    СтараяПривязка = ПолучитьПривязкуПоUUID(
        ЗапросПривязки.СтарыйИдентификаторПривязки);

    Если СтараяПривязка.Состояние <> "Активна"
        Или СтараяПривязка.ИдентификаторБота <> ЗапросПривязки.ИдентификаторБота
        Или СтараяПривязка.ChatID <> ЗапросПривязки.ChatID Тогда
        ВызватьИсключение "Исходная привязка изменилась после инициации переноса.";
    КонецЕсли;

    ЗаблокироватьПривязкуФизЛица(
        СтараяПривязка.ФизическоеЛицо);
    Если НовоеФизическоеЛицо <> СтараяПривязка.ФизическоеЛицо Тогда
        ЗаблокироватьПривязкуФизЛица(
            НовоеФизическоеЛицо);
    КонецЕсли;

    ПроверитьНетДругойАктивнойПривязки(
        НовоеФизическоеЛицо,
        СтараяПривязка.ИдентификаторПривязки);

    ЗаблокироватьЗанятыйЧат(
        СтараяПривязка.ИдентификаторБота,
        СтараяПривязка.ChatID);

    ЗанятыйЧат = РегистрыСведений.ЕРП_ЗанятыеЧатыTelegram.СоздатьМенеджерЗаписи();
    ЗанятыйЧат.ИдентификаторБота = СтараяПривязка.ИдентификаторБота;
    ЗанятыйЧат.ChatID = СтараяПривязка.ChatID;
    ЗанятыйЧат.Прочитать();

    Если Не ЗанятыйЧат.Выбран()
        Или ЗанятыйЧат.ИдентификаторПривязки <> СтараяПривязка.ИдентификаторПривязки
        Или ЗанятыйЧат.Сотрудник <> СтараяПривязка.Сотрудник Тогда
        ВызватьИсключение "Резервирование ChatID не соответствует исходной привязке. Перенос остановлен.";
    КонецЕсли;

    СтараяЗапись = СоздатьМенеджерПривязки(
        СтараяПривязка.ФизическоеЛицо,
        СтараяПривязка.ИдентификаторБота,
        СтараяПривязка.ИдентификаторПривязки);

    СтараяЗапись.Прочитать();
    Если Не СтараяЗапись.Выбран()
        Или СтараяЗапись.Состояние <> "Активна"
        Или СтараяЗапись.Сотрудник <> СтараяПривязка.Сотрудник
        Или СтараяЗапись.ChatID <> СтараяПривязка.ChatID Тогда
        ВызватьИсключение "Исходная запись изменилась после блокировки. Перенос отменён.";
    КонецЕсли;

    // Повторная проверка кадрового статуса и физического лица уже под блокировкой.
    ТекущееФизическоеЛицоИсточника = ПроверитьАктивностьСотрудника(
        СтараяЗапись.Сотрудник);
    Если ТекущееФизическоеЛицоИсточника <> СтараяЗапись.ФизическоеЛицо Тогда
        ВызватьИсключение
            "Физическое лицо исходного сотрудника изменилось. Перенос отменён.";
    КонецЕсли;

    СтараяЗапись.Состояние = "Отключена";
    СтараяЗапись.ДатаДеактивации = ТекущаяДата();
    СтараяЗапись.ДатаИзменения = ТекущаяДата();
    СтараяЗапись.ИдентификаторОперацииПереноса = ИдентификаторОперации;
    СтараяЗапись.Записать();

    НовыйUUIDПривязки = Новый УникальныйИдентификатор;
    НоваяЗапись = СоздатьМенеджерПривязки(
        НовоеФизическоеЛицо,
        СтараяПривязка.ИдентификаторБота,
        НовыйUUIDПривязки);

    НоваяЗапись.Сотрудник = ЗапросПривязки.Сотрудник;
    НоваяЗапись.ChatID = СтараяПривязка.ChatID;
    НоваяЗапись.ДатаПривязки = ТекущаяДата();
    НоваяЗапись.Состояние = "Активна";
    НоваяЗапись.ДатаИзменения = ТекущаяДата();
    НоваяЗапись.ОснованиеЗапроса = ЗапросПривязки.ХешКода;
    НоваяЗапись.ИдентификаторОперацииПереноса = ИдентификаторОперации;
    НоваяЗапись.Записать();

    ЗанятыйЧат.Сотрудник = ЗапросПривязки.Сотрудник;
    ЗанятыйЧат.ДатаЗакрепления = ТекущаяДата();
    ЗанятыйЧат.ИдентификаторПривязки = НовыйUUIDПривязки;
    ЗанятыйЧат.Записать();

    ЗаписатьИсториюПривязки(
        ЗапросПривязки.Сотрудник,
        СтараяПривязка.ИдентификаторБота,
        СтараяПривязка.ChatID,
        Перечисления.ЕРП_ОперацииПривязкиTelegram.Перенос,
        "Контролируемый перенос завершён после UBT-верификации и отдельного разрешения администратора ERP.",
        ИдентификаторОперации,
        СтараяПривязка.ИдентификаторПривязки,
        НовыйUUIDПривязки,
        СтараяПривязка.Сотрудник,
        ЗапросПривязки.Сотрудник,
        "Успех",
        "ОжидаетРазрешения",
        "Завершена",
        СтараяПривязка.ChatID,
        СтараяПривязка.ChatID);

КонецПроцедуры


Процедура ЕРП_ОтвязатьTelegram(
    Сотрудник,
    Причина = "Ручная отвязка",
    ДатаДеактивации = Неопределено) Экспорт

    // Ручная деактивация доступна администратору; кадровые и фоновые
    // обработчики используют внутреннюю процедуру в собственном контексте.
    ПроверитьПравоУправленияПривязкамиTelegram(Ложь);

    Если Не ЗначениеЗаполнено(ДатаДеактивации) Тогда
        ДатаДеактивации = ТекущаяДата();
    КонецЕсли;

    НачатьТранзакцию();
    Попытка

        ОтвязатьTelegramВТекущейТранзакции(
            Сотрудник,
            Причина,
            ДатаДеактивации);

        ЗафиксироватьТранзакцию();

    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;

КонецПроцедуры


// Вызывается только внутри уже открытой транзакции.
// Используется также обработчиком кадровой истории, чтобы не открывать
// вложенную транзакцию внутри записи регистра КадроваяИсторияСотрудников.
Процедура ОтвязатьTelegramВТекущейТранзакции(
    Сотрудник,
    Причина,
    ДатаДеактивации)

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |   Привязки.ФизическоеЛицо КАК ФизическоеЛицо,
    |   Привязки.ИдентификаторБота КАК ИдентификаторБота,
    |   Привязки.ИдентификаторПривязки КАК ИдентификаторПривязки,
    |   Привязки.ChatID КАК ChatID
    |ИЗ
    |   РегистрСведений.ЕРП_ПривязкиTelegram КАК Привязки
    |ГДЕ
    |   Привязки.Сотрудник = &Сотрудник
    |   И Привязки.Состояние = ""Активна""";
    Запрос.УстановитьПараметр("Сотрудник", Сотрудник);

    Выборка = Запрос.Выполнить().Выбрать();
    АктивныеUUID = Новый Массив;
    Пока Выборка.Следующий() Цикл
        АктивныеUUID.Добавить(Новый Структура(
            "ФизическоеЛицо,ИдентификаторБота,ИдентификаторПривязки,ChatID",
            Выборка.ФизическоеЛицо,
            Выборка.ИдентификаторБота,
            Выборка.ИдентификаторПривязки,
            Выборка.ChatID));
    КонецЦикла;

    Для Каждого ДанныеПривязки Из АктивныеUUID Цикл

        ЗаблокироватьПривязкуФизЛица(
            ДанныеПривязки.ФизическоеЛицо);

        Запись = СоздатьМенеджерПривязки(
            ДанныеПривязки.ФизическоеЛицо,
            ДанныеПривязки.ИдентификаторБота,
            ДанныеПривязки.ИдентификаторПривязки);
        Запись.Прочитать();

        Если Запись.Выбран() И Запись.Состояние = "Активна" Тогда
            Запись.Состояние = "Отключена";
            Запись.ДатаДеактивации = ДатаДеактивации;
            Запись.ДатаИзменения = ТекущаяДата();
            Запись.Записать();

            ЗаписатьИсториюПривязки(
                Сотрудник,
                ДанныеПривязки.ИдентификаторБота,
                ДанныеПривязки.ChatID,
                Перечисления.ЕРП_ОперацииПривязкиTelegram.Отключение,
                Причина,
                НулевойUUID(),
                ДанныеПривязки.ИдентификаторПривязки,
                НулевойUUID(),
                Сотрудник,
                Неопределено);
        КонецЕсли;

    КонецЦикла;

КонецПроцедуры


// Обработчик OnWrite набора записей кадровой истории.
// Будущее увольнение не отключает привязку заранее; его обработает
// регламентная сверка в день вступления кадрового события в силу.
Процедура ЕРП_ОбработатьЗаписьКадровойИсторииTelegram(Источник, Отказ) Экспорт

    // Отдельная роль-маркер назначается только кадровым пользователям,
    // которым разрешено запускать эту внутреннюю обработку.
    Если Не РольДоступна("ЕРП_КадроваяОбработкаTelegram") Тогда
        Возврат;
    КонецЕсли;

    Если Источник = Неопределено Или Источник.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;

    ОбработанныеСотрудники = Новый Соответствие;

    Для Каждого ЗаписьКадровойИстории Из Источник Цикл

        Если Не ЗначениеЗаполнено(ЗаписьКадровойИстории.Сотрудник)
            Или ЗаписьКадровойИстории.ВидСобытия
                <> Перечисления.ВидыКадровыхСобытий.Увольнение Тогда
            Продолжить;
        КонецЕсли;

        ДатаУвольнения = НачалоДня(ЗаписьКадровойИстории.Период);
        Если ДатаУвольнения > ТекущаяДата() Тогда
            Продолжить;
        КонецЕсли;

        КлючСотрудника = Строка(
            ЗаписьКадровойИстории.Сотрудник.УникальныйИдентификатор());
        Если ОбработанныеСотрудники.СодержитКлюч(КлючСотрудника) Тогда
            Продолжить;
        КонецЕсли;
        ОбработанныеСотрудники.Вставить(КлючСотрудника, Истина);

        ДействующаяДатаУвольнения =
            ПолучитьДатуУвольненияНаТекущуюДату(
                ЗаписьКадровойИстории.Сотрудник);

        Если Не ЗначениеЗаполнено(ДействующаяДатаУвольнения)
            Или ДействующаяДатаУвольнения <> ДатаУвольнения Тогда
            Продолжить;
        КонецЕсли;

        ОтвязатьTelegramВТекущейТранзакции(
            ЗаписьКадровойИстории.Сотрудник,
            "Кадровое событие: увольнение с "
                + Формат(ДатаУвольнения, "ДФ=dd.MM.yyyy"),
            ДатаУвольнения);

    КонецЦикла;

КонецПроцедуры


Процедура ЕРП_ОтключитьПривязкуПриДеактивацииСотрудника(
    Сотрудник,
    ДатаУвольнения = Неопределено) Экспорт

    Если Не РольДоступна("ЕРП_ФоноваяОбработкаУведомлений") Тогда
        ВызватьИсключение "Недостаточно прав для автоматической деактивации Telegram-привязки.";
    КонецЕсли;

    Если Не ЗначениеЗаполнено(ДатаУвольнения) Тогда
        ДатаУвольнения = ПолучитьДатуУвольненияНаТекущуюДату(Сотрудник);
    КонецЕсли;

    Если Не ЗначениеЗаполнено(ДатаУвольнения) Тогда
        Возврат;
    КонецЕсли;

    ДатаНачалаДеактивации = НачалоДня(ДатаУвольнения);
    Если ДатаНачалаДеактивации > ТекущаяДата() Тогда
        Возврат;
    КонецЕсли;

    ЕРП_ОтвязатьTelegram(
        Сотрудник,
        "Увольнение сотрудника с " + Формат(ДатаНачалаДеактивации, "ДФ=dd.MM.yyyy"),
        ДатаНачалаДеактивации);

КонецПроцедуры


Процедура ЕРП_ОтменитьЗапросПривязкиTelegramПоХешу(ХешКода) Экспорт

    ПроверитьПравоУправленияПривязкамиTelegram(Ложь);

    НачатьТранзакцию();
    Попытка
        ЗаблокироватьЗапросTelegram(ХешКода);

        ЗапросПривязки = РегистрыСведений.ЕРП_ЗапросыПривязкиTelegram.СоздатьМенеджерЗаписи();
        ЗапросПривязки.ХешКода = ХешКода;
        ЗапросПривязки.Прочитать();

        Если Не ЗапросПривязки.Выбран()
            Или (ЗапросПривязки.Состояние <> "Создан"
                И ЗапросПривязки.Состояние <> "ПолученОтБота"
                И ЗапросПривязки.Состояние <> "ОжидаетРазрешения") Тогда
            ВызватьИсключение "Запрос уже обработан или не может быть отменён.";
        КонецЕсли;

        СтарыйСотрудник = Неопределено;
        Если ЗапросПривязки.ИдентификаторОперацииПереноса <> НулевойUUID() Тогда
            СтараяПривязкаДляАудита = ПолучитьПривязкуПоUUID(
                ЗапросПривязки.СтарыйИдентификаторПривязки);
            СтарыйСотрудник = СтараяПривязкаДляАудита.Сотрудник;
        КонецЕсли;

        ЗаписатьИсториюПривязки(
            ЗапросПривязки.Сотрудник,
            ЗапросПривязки.ИдентификаторБота,
            ЗапросПривязки.ChatID,
            Перечисления.ЕРП_ОперацииПривязкиTelegram.ОтменаЗапроса,
            "Администратор отменил запрос Telegram-привязки.",
            ЗапросПривязки.ИдентификаторОперацииПереноса,
            ЗапросПривязки.СтарыйИдентификаторПривязки,
            НулевойUUID(),
            СтарыйСотрудник,
            ЗапросПривязки.Сотрудник,
            "Успех",
            ЗапросПривязки.Состояние,
            "Отменён",
            ?(ЗначениеЗаполнено(ЗапросПривязки.ChatID), ЗапросПривязки.ChatID, ""),
            ЗапросПривязки.ChatID);

        ЗапросПривязки.Состояние = "Отменён";
        ЗапросПривязки.Записать();

        ЗафиксироватьТранзакцию();

    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;

КонецПроцедуры


Процедура ЕРП_ОтклонитьЗапросПривязкиTelegramПоХешу(ХешКода, Причина) Экспорт

    Если Не РольДоступна("ЕРП_УправлениеПривязкамиTelegram") Тогда
        ВызватьИсключение "Недостаточно прав для отклонения запросов Telegram-привязки.";
    КонецЕсли;

    Причина = СокрЛП(Причина);
    Если Не ЗначениеЗаполнено(Причина) Или СтрДлина(Причина) > 250 Тогда
        ВызватьИсключение "Укажите причину отклонения длиной не более 250 символов.";
    КонецЕсли;

    НачатьТранзакцию();
    Попытка
        ЗаблокироватьЗапросTelegram(ХешКода);

        ЗапросПривязки = РегистрыСведений.ЕРП_ЗапросыПривязкиTelegram.СоздатьМенеджерЗаписи();
        ЗапросПривязки.ХешКода = ХешКода;
        ЗапросПривязки.Прочитать();

        Если Не ЗапросПривязки.Выбран()
            Или (ЗапросПривязки.Состояние <> "ПолученОтБота"
                И ЗапросПривязки.Состояние <> "ОжидаетРазрешения")
            Или ЗапросПривязки.ДатаИстечения < ТекущаяДата() Тогда
            ВызватьИсключение "Отклонить можно только действующий запрос, ожидающий подтверждения.";
        КонецЕсли;

        СтарыйСотрудник = Неопределено;
        Если ЗапросПривязки.ИдентификаторОперацииПереноса <> НулевойUUID() Тогда
            СтараяПривязкаДляАудита = ПолучитьПривязкуПоUUID(
                ЗапросПривязки.СтарыйИдентификаторПривязки);
            СтарыйСотрудник = СтараяПривязкаДляАудита.Сотрудник;
        КонецЕсли;

        ЗаписатьИсториюПривязки(
            ЗапросПривязки.Сотрудник,
            ЗапросПривязки.ИдентификаторБота,
            ЗапросПривязки.ChatID,
            Перечисления.ЕРП_ОперацииПривязкиTelegram.Отклонение,
            Причина,
            ЗапросПривязки.ИдентификаторОперацииПереноса,
            ЗапросПривязки.СтарыйИдентификаторПривязки,
            НулевойUUID(),
            СтарыйСотрудник,
            ЗапросПривязки.Сотрудник,
            "Отказ",
            ЗапросПривязки.Состояние,
            "Отклонён",
            ЗапросПривязки.ChatID,
            ЗапросПривязки.ChatID,
            Причина);

        ЗапросПривязки.Состояние = "Отклонён";
        ЗапросПривязки.Записать();

        ЗафиксироватьТранзакцию();

    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;

КонецПроцедуры


Функция СоздатьЗапросПривязкиTelegram(
    Сотрудник,
    ФизическоеЛицо,
    ИдентификаторБота,
    ИдентификаторОперацииПереноса,
    СтарыйИдентификаторПривязки)

    Если ИдентификаторОперацииПереноса <> НулевойUUID() Тогда
        // Для переноса одноразовый /start UUID одновременно является UUID
        // операции, связывающим исходную и новую записи и события аудита.
        Код = Строка(ИдентификаторОперацииПереноса);
    Иначе
        Код = Строка(Новый УникальныйИдентификатор);
    КонецЕсли;

    ХешКода = ЕРП_ПолучитьХешКода(Код);
    ДатаСоздания = ТекущаяДата();
    ДатаИстечения = ДатаСоздания + 600;

    НачатьТранзакцию();
    Попытка

        ЗаблокироватьВсеЗапросыTelegram();
        ЗаблокироватьПривязкуФизЛица(ФизическоеЛицо);

        // Повторная проверка под блокировкой защищает и обычную привязку,
        // и целевого владельца переноса от параллельного создания привязки.
        ПроверитьНетДругойАктивнойПривязки(
            ФизическоеЛицо,
            СтарыйИдентификаторПривязки);

        СтарыеЗапросы = РегистрыСведений.ЕРП_ЗапросыПривязкиTelegram.Выбрать();
        Пока СтарыеЗапросы.Следующий() Цикл
            Если (СтарыеЗапросы.Сотрудник = Сотрудник
                    Или (СтарыйИдентификаторПривязки <> НулевойUUID()
                        И СтарыеЗапросы.СтарыйИдентификаторПривязки = СтарыйИдентификаторПривязки))
                И (СтарыеЗапросы.Состояние = "Создан"
                    Или СтарыеЗапросы.Состояние = "ПолученОтБота"
                    Или СтарыеЗапросы.Состояние = "ОжидаетРазрешения") Тогда

                СтарыйЗапрос = РегистрыСведений.ЕРП_ЗапросыПривязкиTelegram.СоздатьМенеджерЗаписи();
                СтарыйЗапрос.ХешКода = СтарыеЗапросы.ХешКода;
                СтарыйЗапрос.Прочитать();

                Если СтарыйЗапрос.ИдентификаторОперацииПереноса <> НулевойUUID() Тогда
                    СтараяПривязкаДляАудита = ПолучитьПривязкуПоUUID(
                        СтарыйЗапрос.СтарыйИдентификаторПривязки);
                    ЗаписатьИсториюПривязки(
                        СтарыйЗапрос.Сотрудник,
                        СтарыйЗапрос.ИдентификаторБота,
                        СтарыйЗапрос.ChatID,
                        Перечисления.ЕРП_ОперацииПривязкиTelegram.ОтменаЗапроса,
                        "Предыдущий запрос переноса отменён при создании нового запроса.",
                        СтарыйЗапрос.ИдентификаторОперацииПереноса,
                        СтарыйЗапрос.СтарыйИдентификаторПривязки,
                        НулевойUUID(),
                        СтараяПривязкаДляАудита.Сотрудник,
                        СтарыйЗапрос.Сотрудник);
                КонецЕсли;

                СтарыйЗапрос.Состояние = "Отменён";
                СтарыйЗапрос.Записать();

            КонецЕсли;
        КонецЦикла;

        НовыйЗапрос = РегистрыСведений.ЕРП_ЗапросыПривязкиTelegram.СоздатьМенеджерЗаписи();
        НовыйЗапрос.ХешКода = ХешКода;
        НовыйЗапрос.Сотрудник = Сотрудник;
        НовыйЗапрос.ИдентификаторБота = ИдентификаторБота;
        НовыйЗапрос.ДатаСоздания = ДатаСоздания;
        НовыйЗапрос.ДатаИстечения = ДатаИстечения;
        НовыйЗапрос.Состояние = "Создан";
        НовыйЗапрос.ChatID = "";
        НовыйЗапрос.UpdateID = 0;
        НовыйЗапрос.ДатаПодтверждения = Дата(1, 1, 1);
        НовыйЗапрос.ИдентификаторЗапроса = Новый УникальныйИдентификатор(Код);
        НовыйЗапрос.КоличествоПопыток = 0;
        НовыйЗапрос.ДатаПоследнейПопытки = Дата(1, 1, 1);
        НовыйЗапрос.ДатаСледующейПопытки = Дата(1, 1, 1);
        НовыйЗапрос.ПоследняяОшибка = "";
        НовыйЗапрос.ИдентификаторОперацииПереноса = ИдентификаторОперацииПереноса;
        НовыйЗапрос.СтарыйИдентификаторПривязки = СтарыйИдентификаторПривязки;
        НовыйЗапрос.Записать();

        Если ИдентификаторОперацииПереноса <> НулевойUUID() Тогда
            СтараяПривязкаДляАудита = ПолучитьПривязкуПоUUID(
                СтарыйИдентификаторПривязки);
            ЗаписатьИсториюПривязки(
                Сотрудник,
                ИдентификаторБота,
                СтараяПривязкаДляАудита.ChatID,
                Перечисления.ЕРП_ОперацииПривязкиTelegram.ИнициацияПереноса,
                "Администратор инициировал контролируемый перенос Telegram Chat.",
                ИдентификаторОперацииПереноса,
                СтарыйИдентификаторПривязки,
                НулевойUUID(),
                СтараяПривязкаДляАудита.Сотрудник,
                Сотрудник,
                "Успех",
                "Активна",
                "ОжидаетПодтверждения",
                СтараяПривязкаДляАудита.ChatID,
                "");
        КонецЕсли;

        ЗафиксироватьТранзакцию();

    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;

    Возврат Новый Структура(
        "Код,Команда,ДатаИстечения,ИдентификаторОперацииПереноса",
        Код,
        "/start " + Код,
        ДатаИстечения,
        ИдентификаторОперацииПереноса);

КонецФункции


Функция ПолучитьПривязкуПоUUID(ИдентификаторПривязки)

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |   Привязки.ФизическоеЛицо КАК ФизическоеЛицо,
    |   Привязки.ИдентификаторБота КАК ИдентификаторБота,
    |   Привязки.ИдентификаторПривязки КАК ИдентификаторПривязки,
    |   Привязки.Сотрудник КАК Сотрудник,
    |   Привязки.ChatID КАК ChatID,
    |   Привязки.Состояние КАК Состояние,
    |   Привязки.ОснованиеЗапроса КАК ОснованиеЗапроса
    |ИЗ
    |   РегистрСведений.ЕРП_ПривязкиTelegram КАК Привязки
    |ГДЕ
    |   Привязки.ИдентификаторПривязки = &ИдентификаторПривязки";
    Запрос.УстановитьПараметр("ИдентификаторПривязки", ИдентификаторПривязки);

    Выборка = Запрос.Выполнить().Выбрать();
    Если Не Выборка.Следующий() Тогда
        ВызватьИсключение "Привязка с указанным UUID не найдена.";
    КонецЕсли;

    Результат = Новый Структура(
        "ФизическоеЛицо,ИдентификаторБота,ИдентификаторПривязки,Сотрудник,ChatID,Состояние,ОснованиеЗапроса",
        Выборка.ФизическоеЛицо,
        Выборка.ИдентификаторБота,
        Выборка.ИдентификаторПривязки,
        Выборка.Сотрудник,
        Выборка.ChatID,
        Выборка.Состояние,
        Выборка.ОснованиеЗапроса);

    Если Выборка.Следующий() Тогда
        ВызватьИсключение "UUID привязки не уникален. Обнаружено нарушение целостности.";
    КонецЕсли;

    Возврат Результат;

КонецФункции


Функция СоздатьМенеджерПривязки(ФизическоеЛицо, ИдентификаторБота, ИдентификаторПривязки)

    Менеджер = РегистрыСведений.ЕРП_ПривязкиTelegram.СоздатьМенеджерЗаписи();
    Менеджер.ФизическоеЛицо = ФизическоеЛицо;
    Менеджер.ИдентификаторБота = ИдентификаторБота;
    Менеджер.ИдентификаторПривязки = ИдентификаторПривязки;
    Возврат Менеджер;

КонецФункции


Процедура ПроверитьНетДругойАктивнойПривязки(
    ФизическоеЛицо,
    ИсключаемыйUUID)

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |   Привязки.ИдентификаторПривязки КАК ИдентификаторПривязки
    |ИЗ
    |   РегистрСведений.ЕРП_ПривязкиTelegram КАК Привязки
    |ГДЕ
    |   Привязки.ФизическоеЛицо = &ФизическоеЛицо
    |   И Привязки.Состояние = ""Активна""
    |   И Привязки.ИдентификаторПривязки <> &ИсключаемыйUUID";
    Запрос.УстановитьПараметр("ФизическоеЛицо", ФизическоеЛицо);
    Запрос.УстановитьПараметр("ИсключаемыйUUID", ИсключаемыйUUID);

    ВыборкаАктивнойПривязки = Запрос.Выполнить().Выбрать();
    Если ВыборкаАктивнойПривязки.Следующий() Тогда
        ВызватьИсключение "У физического лица уже существует активная Telegram-привязка независимо от бота.";
    КонецЕсли;

КонецПроцедуры


Функция ПроверитьАктивностьСотрудника(Сотрудник)

    Если Не ЗначениеЗаполнено(Сотрудник) Тогда
        ВызватьИсключение "Не указан сотрудник.";
    КонецЕсли;

    Если Сотрудник.ПометкаУдаления Тогда
        ВызватьИсключение "Нельзя привязать Telegram к сотруднику, помеченному на удаление.";
    КонецЕсли;

    Если СотрудникУволенНаТекущуюДату(Сотрудник) Тогда
        ВызватьИсключение
            "Нельзя привязать Telegram к уволенному сотруднику. "
            + "Дата кадрового события «Увольнение» включительно блокирует привязку.";
    КонецЕсли;

    ФизическоеЛицо = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
        Сотрудник, "ФизическоеЛицо");
    Если Не ЗначениеЗаполнено(ФизическоеЛицо) Тогда
        ВызватьИсключение "У сотрудника не указано физическое лицо.";
    КонецЕсли;
    Если ФизическоеЛицо.ПометкаУдаления Тогда
        ВызватьИсключение "Нельзя использовать физическое лицо, помеченное на удаление.";
    КонецЕсли;

    Возврат ФизическоеЛицо;

КонецФункции


Функция ПолучитьДатуУвольненияНаТекущуюДату(Сотрудник)

    // Возвращает начало даты действующего события увольнения.
    // Будущие кадровые события не влияют на текущий статус сотрудника.
    ЗапросКадровойИстории = Новый Запрос;
    ЗапросКадровойИстории.Текст =
    "ВЫБРАТЬ
    |   КадроваяИстория.ВидСобытия КАК ВидСобытия,
    |   КадроваяИстория.Период КАК ДатаСобытия
    |ИЗ
    |   РегистрСведений.КадроваяИсторияСотрудников.СрезПоследних(
    |       &МоментПроверки,
    |       Сотрудник = &Сотрудник) КАК КадроваяИстория";
    ЗапросКадровойИстории.УстановитьПараметр("МоментПроверки", ТекущаяДата());
    ЗапросКадровойИстории.УстановитьПараметр("Сотрудник", Сотрудник);

    ВыборкаКадровойИстории = ЗапросКадровойИстории.Выполнить().Выбрать();
    Если Не ВыборкаКадровойИстории.Следующий() Тогда
        Возврат Неопределено;
    КонецЕсли;

    Если ВыборкаКадровойИстории.ВидСобытия
        <> Перечисления.ВидыКадровыхСобытий.Увольнение Тогда
        Возврат Неопределено;
    КонецЕсли;

    Возврат НачалоДня(ВыборкаКадровойИстории.ДатаСобытия);

КонецФункции


Функция СотрудникУволенНаТекущуюДату(Сотрудник)

    Возврат ЗначениеЗаполнено(
        ПолучитьДатуУвольненияНаТекущуюДату(Сотрудник));

КонецФункции


Функция ИнтервалПовтораЗапросаTelegram(КоличествоПопыток)

    ИнтервалСекунд = 60;
    Для ИндексПопытки = 2 По КоличествоПопыток Цикл
        ИнтервалСекунд = Мин(ИнтервалСекунд * 2, 3600);
    КонецЦикла;

    Возврат ИнтервалСекунд;

КонецФункции



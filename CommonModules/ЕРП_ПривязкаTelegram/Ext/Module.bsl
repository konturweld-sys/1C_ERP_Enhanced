Процедура ЗаписатьИсториюПривязки(
    Сотрудник,
    ИдентификаторБота,
    ChatID,
    Операция,
    Причина,
    ИдентификаторОперацииПереноса,
    СтарыйИдентификаторПривязки,
    НовыйИдентификаторПривязки,
    СтарыйСотрудник,
    НовыйСотрудник,
    Результат = "Успех",
    СостояниеДо = "",
    СостояниеПосле = "",
    СтарыйChatID = "",
    НовыйChatID = "",
    ТекстОшибки = "")

    ЕРП_ЗаписьАудитаПривязокTelegram.Записать(
        Сотрудник,
        ИдентификаторБота,
        ChatID,
        Операция,
        Причина,
        ИдентификаторОперацииПереноса,
        СтарыйИдентификаторПривязки,
        НовыйИдентификаторПривязки,
        СтарыйСотрудник,
        НовыйСотрудник,
        Результат,
        СостояниеДо,
        СостояниеПосле,
        СтарыйChatID,
        НовыйChatID,
        ТекстОшибки);

КонецПроцедуры


Функция ЕРП_ПолучитьХешКода(Код)

    Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
    Хеширование.Добавить(
        ПолучитьДвоичныеДанныеИзСтроки(Код, КодировкаТекста.UTF8));
    Возврат Base64Строка(Хеширование.ХешСумма);

КонецФункции


Функция НулевойUUID()

    Возврат Новый УникальныйИдентификатор(
        "00000000-0000-0000-0000-000000000000");

КонецФункции


Процедура ПроверитьПравоУправленияПривязкамиTelegram(ДопускаетсяФоноваяОбработка)

    Если РольДоступна("ЕРП_УправлениеПривязкамиTelegram") Тогда
        Возврат;
    КонецЕсли;

    Если ДопускаетсяФоноваяОбработка
        И РольДоступна("ЕРП_ФоноваяОбработкаУведомлений") Тогда
        Возврат;
    КонецЕсли;

    Если РольДоступна("АдминистраторСистемы") Тогда
        Возврат;
    КонецЕсли;

    ВызватьИсключение "Недостаточно прав для выполнения операции Telegram-привязки.";

КонецПроцедуры


Процедура ПроверитьChatIDВАрхиве(ИдентификаторБота, ChatID)

    ЗапросАрхива = Новый Запрос;
    ЗапросАрхива.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |   Архив.Сотрудник КАК Сотрудник
    |ИЗ
    |   РегистрСведений.ЕРП_ПривязкиTelegramСтарыйФормат КАК Архив
    |ГДЕ
    |   Архив.ИдентификаторБота = &ИдентификаторБота
    |   И Архив.ChatID = &ChatID";
    ЗапросАрхива.УстановитьПараметр("ИдентификаторБота", ИдентификаторБота);
    ЗапросАрхива.УстановитьПараметр("ChatID", ChatID);

    ВыборкаАрхива = ЗапросАрхива.Выполнить().Выбрать();
    Если ВыборкаАрхива.Следующий() Тогда
        ВызватьИсключение
            "ChatID встречается в архивной записи прежней модели. "
            + "До разрешения архивного конфликта новая привязка запрещена.";
    КонецЕсли;

КонецПроцедуры



////////////////////////////////////////////////////////////////////////////////
// Однократная идемпотентная миграция старого регистра.
// Старый регистр остаётся архивом; исходные строки не удаляются.
////////////////////////////////////////////////////////////////////////////////
Процедура ЕРП_МигрироватьСтарыеПривязкиTelegram() Экспорт

    Если Не РольДоступна("АдминистраторСистемы")
        И Не РольДоступна("ЕРП_ФоноваяОбработкаУведомлений") Тогда
        ВызватьИсключение "Недостаточно прав для миграции Telegram-привязок.";
    КонецЕсли;

    КоличествоПеренесено = 0;
    КоличествоУжеПеренесено = 0;
    КоличествоОшибок = 0;

    СтарыеДанные = Новый Массив;
    ВыборкаСтарых = РегистрыСведений.ЕРП_ПривязкиTelegramСтарыйФормат.Выбрать();

    Пока ВыборкаСтарых.Следующий() Цикл
        СтарыеДанные.Добавить(Новый Структура(
            "Сотрудник,ИдентификаторБота,ChatID,ДатаПривязки,Состояние,ДатаИзменения,ОснованиеЗапроса,ИдентификаторПривязки",
            ВыборкаСтарых.Сотрудник,
            ВыборкаСтарых.ИдентификаторБота,
            ВыборкаСтарых.ChatID,
            ВыборкаСтарых.ДатаПривязки,
            ВыборкаСтарых.Состояние,
            ВыборкаСтарых.ДатаИзменения,
            ВыборкаСтарых.ОснованиеЗапроса,
            ВыборкаСтарых.ИдентификаторПривязки));
    КонецЦикла;

    // Сначала активные строки, чтобы исторические неактивные записи
    // с повторно использовавшимся в старой модели ChatID не занимали его
    // раньше текущей действующей привязки.
    Для НомерПрохода = 1 По 2 Цикл

        Для Каждого СтарыеДанныеСтрока Из СтарыеДанные Цикл

            ЭтоАктивнаяСтрока = СтарыеДанныеСтрока.Состояние = "Активна";
            Если (НомерПрохода = 1 И Не ЭтоАктивнаяСтрока)
                Или (НомерПрохода = 2 И ЭтоАктивнаяСтрока) Тогда
                Продолжить;
            КонецЕсли;

            НачатьТранзакцию();
            Попытка

                Если Не ЗначениеЗаполнено(СтарыеДанныеСтрока.Сотрудник)
                    Или Не ЗначениеЗаполнено(СтарыеДанныеСтрока.ИдентификаторБота) Тогда
                    ВызватьИсключение "В архивной записи отсутствует сотрудник или идентификатор бота.";
                КонецЕсли;

                ФизическоеЛицо = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
                    СтарыеДанныеСтрока.Сотрудник,
                    "ФизическоеЛицо");
                Если Не ЗначениеЗаполнено(ФизическоеЛицо) Тогда
                    ВызватьИсключение "У сотрудника архивной записи не заполнено физическое лицо.";
                КонецЕсли;

                ИдентификаторПривязки = СтарыеДанныеСтрока.ИдентификаторПривязки;
                Если Не ЗначениеЗаполнено(ИдентификаторПривязки)
                    Или ИдентификаторПривязки = НулевойUUID() Тогда
                    ИдентификаторПривязки = Новый УникальныйИдентификатор();
                КонецЕсли;

                ЗаблокироватьПривязкуФизЛица(
                    ФизическоеЛицо);

                // Если UUID уже использован другой записью, выдаём архивной
                // записи новый UUID и сохраняем его обратно в архиве.
                ЗапросUUID = Новый Запрос;
                ЗапросUUID.Текст =
                "ВЫБРАТЬ ПЕРВЫЕ 1
                |   Привязки.ФизическоеЛицо КАК ФизическоеЛицо,
                |   Привязки.ИдентификаторБота КАК ИдентификаторБота
                |ИЗ
                |   РегистрСведений.ЕРП_ПривязкиTelegram КАК Привязки
                |ГДЕ
                |   Привязки.ИдентификаторПривязки = &ИдентификаторПривязки";
                ЗапросUUID.УстановитьПараметр(
                    "ИдентификаторПривязки",
                    ИдентификаторПривязки);

                ВыборкаUUID = ЗапросUUID.Выполнить().Выбрать();
                Если ВыборкаUUID.Следующий()
                    И (ВыборкаUUID.ФизическоеЛицо <> ФизическоеЛицо
                        Или ВыборкаUUID.ИдентификаторБота <> СтарыеДанныеСтрока.ИдентификаторБота) Тогда
                    ИдентификаторПривязки = Новый УникальныйИдентификатор();
                КонецЕсли;

                АрхивнаяЗапись = РегистрыСведений.ЕРП_ПривязкиTelegramСтарыйФормат.СоздатьМенеджерЗаписи();
                АрхивнаяЗапись.Сотрудник = СтарыеДанныеСтрока.Сотрудник;
                АрхивнаяЗапись.Прочитать();
                Если АрхивнаяЗапись.ИдентификаторПривязки <> ИдентификаторПривязки Тогда
                    АрхивнаяЗапись.ИдентификаторПривязки = ИдентификаторПривязки;
                    АрхивнаяЗапись.Записать();
                КонецЕсли;

                НоваяЗапись = СоздатьМенеджерПривязки(
                    ФизическоеЛицо,
                    СтарыеДанныеСтрока.ИдентификаторБота,
                    ИдентификаторПривязки);
                НоваяЗапись.Прочитать();

                Если НоваяЗапись.Выбран()
                    И НоваяЗапись.Сотрудник <> СтарыеДанныеСтрока.Сотрудник Тогда

                    // Дублирующий UUID в старой схеме не должен схлопнуть
                    // две разные записи в одну запись новой модели.
                    ИдентификаторПривязки = Новый УникальныйИдентификатор();
                    АрхивнаяЗапись.ИдентификаторПривязки = ИдентификаторПривязки;
                    АрхивнаяЗапись.Записать();

                    НоваяЗапись = СоздатьМенеджерПривязки(
                        ФизическоеЛицо,
                        СтарыеДанныеСтрока.ИдентификаторБота,
                        ИдентификаторПривязки);
                    НоваяЗапись.Прочитать();

                КонецЕсли;

                ЗаписьУжеМигрирована = НоваяЗапись.Выбран();

                Если ЗаписьУжеМигрирована Тогда
                    // Повторный запуск допустим только для той же исходной записи.
                    // Несовпадение владельца или ChatID означает конфликт данных,
                    // а не основание перезаписывать уже созданную привязку.
                    Если НоваяЗапись.Сотрудник <> СтарыеДанныеСтрока.Сотрудник
                        Или НоваяЗапись.ChatID <> СтарыеДанныеСтрока.ChatID Тогда
                        ВызватьИсключение
                            "Идентификатор привязки уже занят записью с другими исходными данными. "
                            + "Автоматическое объединение запрещено.";
                    КонецЕсли;
                КонецЕсли;

                Если Не ЗаписьУжеМигрирована Тогда

                    СостояниеПривязки = СтарыеДанныеСтрока.Состояние;
                    ПричинаМиграции = "Перенос существующей записи в новую модель Telegram-привязок.";

                    Если СостояниеПривязки = "Активна" Тогда

                        Если СтарыеДанныеСтрока.Сотрудник.ПометкаУдаления
                            Или ФизическоеЛицо.ПометкаУдаления Тогда
                            СостояниеПривязки = "Отключена";
                            ПричинаМиграции = ПричинаМиграции
                                + " Привязка деактивирована: сотрудник или физическое лицо помечено на удаление.";

                        ИначеЕсли СотрудникУволенНаТекущуюДату(СтарыеДанныеСтрока.Сотрудник) Тогда
                            СостояниеПривязки = "Отключена";
                            ПричинаМиграции = ПричинаМиграции
                                + " Привязка деактивирована: последнее кадровое событие — увольнение.";

                        ИначеЕсли Не ЗначениеЗаполнено(СтарыеДанныеСтрока.ChatID) Тогда
                            СостояниеПривязки = "Отключена";
                            ПричинаМиграции = ПричинаМиграции
                                + " Привязка деактивирована: отсутствует ChatID.";

                        КонецЕсли;

                    КонецЕсли;

                    Если СостояниеПривязки = "Активна" Тогда
                        ПроверитьНетДругойАктивнойПривязки(
                            ФизическоеЛицо,
                            НулевойUUID());
                    КонецЕсли;
                    Если ЗначениеЗаполнено(СтарыеДанныеСтрока.ChatID) Тогда

                        ЗаблокироватьЗанятыйЧат(
                            СтарыеДанныеСтрока.ИдентификаторБота,
                            СтарыеДанныеСтрока.ChatID);

                        ЗанятыйЧат = РегистрыСведений.ЕРП_ЗанятыеЧатыTelegram.СоздатьМенеджерЗаписи();
                        ЗанятыйЧат.ИдентификаторБота = СтарыеДанныеСтрока.ИдентификаторБота;
                        ЗанятыйЧат.ChatID = СтарыеДанныеСтрока.ChatID;
                        ЗанятыйЧат.Прочитать();

                        Если ЗанятыйЧат.Выбран()
                            И ЗанятыйЧат.ИдентификаторПривязки <> ИдентификаторПривязки Тогда
                            ВызватьИсключение "ChatID уже зарезервирован другой привязкой; конфликт оставлен в архиве для ручного разрешения.";
                        КонецЕсли;

                        ЗанятыйЧат.Сотрудник = СтарыеДанныеСтрока.Сотрудник;
                        ЗанятыйЧат.ДатаЗакрепления =
                            ?(ЗначениеЗаполнено(СтарыеДанныеСтрока.ДатаПривязки),
                                СтарыеДанныеСтрока.ДатаПривязки,
                                ТекущаяДата());
                        ЗанятыйЧат.ИдентификаторПривязки = ИдентификаторПривязки;
                        ЗанятыйЧат.Записать();

                    КонецЕсли;

                    НоваяЗапись.Сотрудник = СтарыеДанныеСтрока.Сотрудник;
                    НоваяЗапись.ChatID = СтарыеДанныеСтрока.ChatID;
                    НоваяЗапись.ДатаПривязки =
                        ?(ЗначениеЗаполнено(СтарыеДанныеСтрока.ДатаПривязки),
                            СтарыеДанныеСтрока.ДатаПривязки,
                            ТекущаяДата());
                    НоваяЗапись.Состояние = СостояниеПривязки;
                    НоваяЗапись.ДатаИзменения =
                        ?(ЗначениеЗаполнено(СтарыеДанныеСтрока.ДатаИзменения),
                            СтарыеДанныеСтрока.ДатаИзменения,
                            НоваяЗапись.ДатаПривязки);
                    Если СостояниеПривязки = "Отключена" Тогда
                        НоваяЗапись.ДатаДеактивации = НоваяЗапись.ДатаИзменения;
                        Если СотрудникУволенНаТекущуюДату(СтарыеДанныеСтрока.Сотрудник) Тогда
                            НоваяЗапись.ДатаДеактивации =
                                ПолучитьДатуУвольненияНаТекущуюДату(СтарыеДанныеСтрока.Сотрудник);
                        КонецЕсли;
                    КонецЕсли;
                    НоваяЗапись.ОснованиеЗапроса = СтарыеДанныеСтрока.ОснованиеЗапроса;
                    НоваяЗапись.ИдентификаторОперацииПереноса = НулевойUUID();
                    НоваяЗапись.Записать();

                    ЕРП_ЗаписьАудитаПривязокTelegram.Записать(
                        СтарыеДанныеСтрока.Сотрудник,
                        СтарыеДанныеСтрока.ИдентификаторБота,
                        СтарыеДанныеСтрока.ChatID,
                        Перечисления.ЕРП_ОперацииПривязкиTelegram.Миграция,
                        ПричинаМиграции,
                        НулевойUUID(),
                        ИдентификаторПривязки,
                        ИдентификаторПривязки,
                        СтарыеДанныеСтрока.Сотрудник,
                        СтарыеДанныеСтрока.Сотрудник);

                КонецЕсли;

                ЗафиксироватьТранзакцию();

                Если ЗаписьУжеМигрирована Тогда
                    КоличествоУжеПеренесено = КоличествоУжеПеренесено + 1;
                Иначе
                    КоличествоПеренесено = КоличествоПеренесено + 1;
                КонецЕсли;

            Исключение

                КоличествоОшибок = КоличествоОшибок + 1;

                Если ТранзакцияАктивна() Тогда
                    ОтменитьТранзакцию();
                КонецЕсли;

                ЕРП_ЖурналУведомлений.Ошибка(
                    "МИГРАЦИЯ TELEGRAM-ПРИВЯЗОК",
                    "Архивная запись не перенесена. Исходная запись сохранена в ЕРП_ПривязкиTelegramСтарыйФормат.",
                    "Сотрудник: " + Строка(СтарыеДанныеСтрока.Сотрудник)
                        + "; ошибка: "
                        + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));

            КонецПопытки;

        КонецЦикла;

    КонецЦикла;

    Попытка
        ЕРП_ЖурналУведомлений.Информация(
            "МИГРАЦИЯ TELEGRAM-ПРИВЯЗОК",
            "Завершена обработка архива старых привязок.",
            "Перенесено: " + Строка(КоличествоПеренесено)
                + "; ранее перенесено: " + Строка(КоличествоУжеПеренесено)
                + "; конфликтов/ошибок: " + Строка(КоличествоОшибок) + ".");
    Исключение
        // Итоговая запись журнала не должна изменять результат миграции.
    КонецПопытки;

КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// Периодическая сверка жизненного цикла активных Telegram-привязок.
// Выполняется регламентным заданием под ролью фоновой обработки.
////////////////////////////////////////////////////////////////////////////////
Процедура ЕРП_СверитьЖизненныйЦиклПривязокTelegram() Экспорт

    Если Не РольДоступна("ЕРП_ФоноваяОбработкаУведомлений") Тогда
        ВызватьИсключение "Для сверки жизненного цикла требуется роль ЕРП_ФоноваяОбработкаУведомлений.";
    КонецЕсли;

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |   Привязки.Сотрудник КАК Сотрудник,
    |   Привязки.ФизическоеЛицо КАК ФизическоеЛицо
    |ИЗ
    |   РегистрСведений.ЕРП_ПривязкиTelegram КАК Привязки
    |ГДЕ
    |   Привязки.Состояние = ""Активна""";

    ДанныеПроверки = Новый Массив;
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        ДанныеПроверки.Добавить(Новый Структура(
            "Сотрудник,ФизическоеЛицо",
            Выборка.Сотрудник,
            Выборка.ФизическоеЛицо));
    КонецЦикла;

    ОбработанныеСотрудники = Новый Соответствие;

    Для Каждого ДанныеПривязки Из ДанныеПроверки Цикл

        КлючСотрудника = Строка(
            ДанныеПривязки.Сотрудник.УникальныйИдентификатор());
        Если ОбработанныеСотрудники.СодержитКлюч(КлючСотрудника) Тогда
            Продолжить;
        КонецЕсли;
        ОбработанныеСотрудники.Вставить(КлючСотрудника, Истина);

        ПричинаДеактивации = "";
        ДатаДеактивации = ТекущаяДата();

        Попытка

            Если ДанныеПривязки.Сотрудник.ПометкаУдаления Тогда
                ПричинаДеактивации = "Сотрудник помечен на удаление.";

            ИначеЕсли СотрудникУволенНаТекущуюДату(
                ДанныеПривязки.Сотрудник) Тогда
                ПричинаДеактивации =
                    "Последнее кадровое событие — увольнение; дата события включительно.";
                ДатаДеактивации = ПолучитьДатуУвольненияНаТекущуюДату(
                    ДанныеПривязки.Сотрудник);

            Иначе

                ТекущееФизическоеЛицо = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
                    ДанныеПривязки.Сотрудник,
                    "ФизическоеЛицо");

                Если Не ЗначениеЗаполнено(ТекущееФизическоеЛицо) Тогда
                    ПричинаДеактивации = "У сотрудника не заполнено физическое лицо.";
                ИначеЕсли ТекущееФизическоеЛицо.ПометкаУдаления Тогда
                    ПричинаДеактивации = "Физическое лицо помечено на удаление.";
                ИначеЕсли ТекущееФизическоеЛицо <> ДанныеПривязки.ФизическоеЛицо Тогда
                    ПричинаДеактивации =
                        "Физическое лицо сотрудника изменилось после создания привязки.";
                КонецЕсли;

            КонецЕсли;

            Если Не ПустаяСтрока(ПричинаДеактивации) Тогда
                ЕРП_ОтвязатьTelegram(
                    ДанныеПривязки.Сотрудник,
                    "ЖИЗНЕННЫЙ_ЦИКЛ: " + ПричинаДеактивации,
                    ДатаДеактивации);
            КонецЕсли;

        Исключение

            ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
            Попытка
                ЕРП_ЖурналУведомлений.Ошибка(
                    "ЖИЗНЕННЫЙ_ЦИКЛ",
                    "Не удалось проверить или деактивировать Telegram-привязку сотрудника.",
                    "Сотрудник: " + Строка(ДанныеПривязки.Сотрудник)
                        + "; ошибка: " + ТекстОшибки);
            Исключение
                // Не прерываем сверку остальных сотрудников из-за ошибки журнала.
            КонецПопытки;

            Попытка
                ЗаписьЖурналаРегистрации(
                    "ЕРП_ЖИЗНЕННЫЙ_ЦИКЛ",
                    УровеньЖурналаРегистрации.Ошибка,
                    ,
                    ,
                    "Сотрудник: " + Строка(ДанныеПривязки.Сотрудник)
                        + "; ошибка: " + ТекстОшибки);
            Исключение
                // Сверка должна продолжить обработку следующих сотрудников.
            КонецПопытки;

        КонецПопытки;

    КонецЦикла;

    // После кадровой деактивации выполняется независимая проверка целостности.
    // Сверка не изменяет конфликтные данные.
    ЕРП_СверитьСогласованностьПривязокTelegram();

КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// Регламентная сверка целостности Telegram-привязок.
// Сверка только выявляет и сохраняет расхождения; автоматического исправления
// записей привязок, резервирований, запросов, истории и аудита не выполняет.
////////////////////////////////////////////////////////////////////////////////

Процедура ЕРП_СверитьСогласованностьПривязокTelegram() Экспорт

    Если Не РольДоступна("ЕРП_ФоноваяОбработкаУведомлений") Тогда
        ВызватьИсключение "Для сверки согласованности Telegram-привязок требуется роль ЕРП_ФоноваяОбработкаУведомлений.";
    КонецЕсли;

    ИдентификаторСверки = Новый УникальныйИдентификатор;
    ДатаСверки = ТекущаяДата();
    Проблемы = Новый Массив;

    Привязки = Новый Массив;
    ПривязкиПоUUID = Новый Соответствие;
    КлючиUUIDПривязок = Новый Массив;
    АктивныеПоФизЛицу = Новый Соответствие;
    КлючиАктивныхФизЛиц = Новый Массив;
    ПривязкиПоChat = Новый Соответствие;
    КлючиChat = Новый Массив;

    ВыборкаПривязок = РегистрыСведений.ЕРП_ПривязкиTelegram.Выбрать();
    Пока ВыборкаПривязок.Следующий() Цикл

        ДанныеПривязки = Новый Структура(
            "ФизическоеЛицо,ИдентификаторБота,ИдентификаторПривязки,Сотрудник,ChatID,Состояние,ИдентификаторОперацииПереноса",
            ВыборкаПривязок.ФизическоеЛицо,
            ВыборкаПривязок.ИдентификаторБота,
            ВыборкаПривязок.ИдентификаторПривязки,
            ВыборкаПривязок.Сотрудник,
            ВыборкаПривязок.ChatID,
            ВыборкаПривязок.Состояние,
            ВыборкаПривязок.ИдентификаторОперацииПереноса);

        Привязки.Добавить(ДанныеПривязки);

        КлючUUID = Строка(ДанныеПривязки.ИдентификаторПривязки);
        ДобавитьЭлементВГруппуСверкиTelegram(
            ПривязкиПоUUID, КлючиUUIDПривязок, КлючUUID, ДанныеПривязки);

        Если ЗначениеЗаполнено(ДанныеПривязки.ФизическоеЛицо) Тогда
            КлючФизЛица = Строка(
                ДанныеПривязки.ФизическоеЛицо.УникальныйИдентификатор());
            Если ДанныеПривязки.Состояние = "Активна" Тогда
                ДобавитьЭлементВГруппуСверкиTelegram(
                    АктивныеПоФизЛицу,
                    КлючиАктивныхФизЛиц,
                    КлючФизЛица,
                    ДанныеПривязки);
            КонецЕсли;
        КонецЕсли;

        Если Не ПустаяСтрока(ДанныеПривязки.ChatID) Тогда
            КлючChat = Строка(ДанныеПривязки.ИдентификаторБота)
                + "|" + ДанныеПривязки.ChatID;
            ДобавитьЭлементВГруппуСверкиTelegram(
                ПривязкиПоChat, КлючиChat, КлючChat, ДанныеПривязки);
        КонецЕсли;

    КонецЦикла;

    // UUID привязки должен однозначно идентифицировать одну запись.
    Для Каждого КлючUUID Из КлючиUUIDПривязок Цикл
        ГруппаUUID = ПривязкиПоUUID.Получить(КлючUUID);
        Если ГруппаUUID.Количество() > 1 Тогда
            ДобавитьПроблемуСверкиTelegram(
                Проблемы,
                "ДУБЛЬ_UUID_ПРИВЯЗКИ",
                "Критическая",
                "Один UUID привязки обнаружен в нескольких записях регистра.",
                ГруппаUUID[0].ИдентификаторПривязки,
                НулевойUUID(),
                НулевойUUID(),
                ГруппаUUID[0].ФизическоеЛицо,
                ГруппаUUID[0].ИдентификаторБота,
                ГруппаUUID[0].ChatID,
                ГруппаUUID[0].Сотрудник,
                ГруппаUUID.Количество());
        КонецЕсли;
    КонецЦикла;

    // У одного физического лица может быть только одна активная привязка,
    // независимо от Telegram-бота.
    Для Каждого КлючФизЛица Из КлючиАктивныхФизЛиц Цикл
        ГруппаАктивных = АктивныеПоФизЛицу.Получить(КлючФизЛица);
        Если ГруппаАктивных.Количество() > 1 Тогда
            ДобавитьПроблемуСверкиTelegram(
                Проблемы,
                "НЕСКОЛЬКО_АКТИВНЫХ_ПРИВЯЗОК",
                "Критическая",
                "У физического лица обнаружено несколько активных Telegram-привязок.",
                ГруппаАктивных[0].ИдентификаторПривязки,
                НулевойUUID(),
                НулевойUUID(),
                ГруппаАктивных[0].ФизическоеЛицо,
                ГруппаАктивных[0].ИдентификаторБота,
                ГруппаАктивных[0].ChatID,
                ГруппаАктивных[0].Сотрудник,
                ГруппаАктивных.Количество());
        КонецЕсли;
    КонецЦикла;

    // Повтор одного ChatID разрешён только для документированной пары
    // старой отключённой и новой активной записи одного переноса.
    Для Каждого КлючChatГруппы Из КлючиChat Цикл
        ГруппаChat = ПривязкиПоChat.Получить(КлючChatГруппы);
        Если ГруппаChat.Количество() <= 1 Тогда
            Продолжить;
        КонецЕсли;

        ДопустимаяПараПереноса = Ложь;
        Если ГруппаChat.Количество() = 2 Тогда
            СтараяЗапись = Неопределено;
            НоваяЗапись = Неопределено;

            Если ГруппаChat[0].ИдентификаторОперацииПереноса <> НулевойUUID()
                И ГруппаChat[0].ИдентификаторОперацииПереноса
                    = ГруппаChat[1].ИдентификаторОперацииПереноса Тогда

                Если ГруппаChat[0].Состояние = "Отключена"
                    И ГруппаChat[1].Состояние = "Активна" Тогда
                    СтараяЗапись = ГруппаChat[0];
                    НоваяЗапись = ГруппаChat[1];
                ИначеЕсли ГруппаChat[1].Состояние = "Отключена"
                    И ГруппаChat[0].Состояние = "Активна" Тогда
                    СтараяЗапись = ГруппаChat[1];
                    НоваяЗапись = ГруппаChat[0];
                КонецЕсли;

            КонецЕсли;

            Если СтараяЗапись <> Неопределено
                И НоваяЗапись <> Неопределено Тогда
                ДопустимаяПараПереноса = ПроверитьАудитКонтролируемогоПереносаTelegram(
                    СтараяЗапись.ИдентификаторОперацииПереноса,
                    СтараяЗапись.ИдентификаторПривязки,
                    НоваяЗапись.ИдентификаторПривязки);
            КонецЕсли;
        КонецЕсли;

        Если Не ДопустимаяПараПереноса Тогда
            ДобавитьПроблемуСверкиTelegram(
                Проблемы,
                "ДУБЛЬ_CHATID",
                "Критическая",
                "ChatID одного бота используется несколькими записями вне подтверждённой пары контролируемого переноса.",
                ГруппаChat[0].ИдентификаторПривязки,
                ГруппаChat[0].ИдентификаторОперацииПереноса,
                НулевойUUID(),
                ГруппаChat[0].ФизическоеЛицо,
                ГруппаChat[0].ИдентификаторБота,
                ГруппаChat[0].ChatID,
                ГруппаChat[0].Сотрудник,
                ГруппаChat.Количество());
        КонецЕсли;
    КонецЦикла;

    // Сверка действующих привязок с таблицей резервирования ChatID.
    Резервирования = Новый Массив;
    РезервированияПоChat = Новый Соответствие;

    ВыборкаРезервирований = РегистрыСведений.ЕРП_ЗанятыеЧатыTelegram.Выбрать();
    Пока ВыборкаРезервирований.Следующий() Цикл

        ДанныеРезервирования = Новый Структура(
            "ИдентификаторБота,ChatID,Сотрудник,ИдентификаторПривязки",
            ВыборкаРезервирований.ИдентификаторБота,
            ВыборкаРезервирований.ChatID,
            ВыборкаРезервирований.Сотрудник,
            ВыборкаРезервирований.ИдентификаторПривязки);
        Резервирования.Добавить(ДанныеРезервирования);

        КлючChatРезерва = Строка(ДанныеРезервирования.ИдентификаторБота)
            + "|" + ДанныеРезервирования.ChatID;
        РезервированияПоChat.Вставить(КлючChatРезерва, ДанныеРезервирования);

        ГруппаПоUUIDРезерва = ПривязкиПоUUID.Получить(
            Строка(ДанныеРезервирования.ИдентификаторПривязки));
        ЕстьСоответствующаяПривязка = Ложь;

        Если ГруппаПоUUIDРезерва <> Неопределено Тогда
            Для Каждого КандидатПривязки Из ГруппаПоUUIDРезерва Цикл
                Если КандидатПривязки.ИдентификаторБота
                        = ДанныеРезервирования.ИдентификаторБота
                    И КандидатПривязки.ChatID = ДанныеРезервирования.ChatID
                    И КандидатПривязки.Сотрудник = ДанныеРезервирования.Сотрудник Тогда
                    ЕстьСоответствующаяПривязка = Истина;
                    Прервать;
                КонецЕсли;
            КонецЦикла;
        КонецЕсли;

        Если Не ЕстьСоответствующаяПривязка Тогда
            ДобавитьПроблемуСверкиTelegram(
                Проблемы,
                "РЕЗЕРВИРОВАНИЕ_БЕЗ_ПРИВЯЗКИ",
                "Критическая",
                "Резервирование ChatID не соответствует ни одной записи привязки по боту, ChatID, UUID и сотруднику.",
                ДанныеРезервирования.ИдентификаторПривязки,
                НулевойUUID(),
                НулевойUUID(),
                Неопределено,
                ДанныеРезервирования.ИдентификаторБота,
                ДанныеРезервирования.ChatID,
                ДанныеРезервирования.Сотрудник);
        КонецЕсли;

    КонецЦикла;

    Для Каждого ДанныеПривязки Из Привязки Цикл
        Если ДанныеПривязки.Состояние <> "Активна" Тогда
            Продолжить;
        КонецЕсли;

        КлючАктивногоChat = Строка(ДанныеПривязки.ИдентификаторБота)
            + "|" + ДанныеПривязки.ChatID;
        ДанныеРезерва = РезервированияПоChat.Получить(КлючАктивногоChat);

        Если ДанныеРезерва = Неопределено Тогда
            ДобавитьПроблемуСверкиTelegram(
                Проблемы,
                "АКТИВНАЯ_ПРИВЯЗКА_БЕЗ_РЕЗЕРВА",
                "Критическая",
                "Активная Telegram-привязка не имеет резервирования ChatID.",
                ДанныеПривязки.ИдентификаторПривязки,
                ДанныеПривязки.ИдентификаторОперацииПереноса,
                НулевойUUID(),
                ДанныеПривязки.ФизическоеЛицо,
                ДанныеПривязки.ИдентификаторБота,
                ДанныеПривязки.ChatID,
                ДанныеПривязки.Сотрудник);
        ИначеЕсли ДанныеРезерва.ИдентификаторПривязки
                <> ДанныеПривязки.ИдентификаторПривязки
            Или ДанныеРезерва.Сотрудник <> ДанныеПривязки.Сотрудник Тогда
            ДобавитьПроблемуСверкиTelegram(
                Проблемы,
                "НЕСООТВЕТСТВИЕ_РЕЗЕРВИРОВАНИЯ",
                "Критическая",
                "Резервирование ChatID указывает на другого сотрудника или UUID привязки.",
                ДанныеПривязки.ИдентификаторПривязки,
                ДанныеПривязки.ИдентификаторОперацииПереноса,
                НулевойUUID(),
                ДанныеПривязки.ФизическоеЛицо,
                ДанныеПривязки.ИдентификаторБота,
                ДанныеПривязки.ChatID,
                ДанныеПривязки.Сотрудник);
        КонецЕсли;
    КонецЦикла;

    // Проверка ссылочной целостности append-only аудита по UUID привязок.
    АудитПоUUID = Новый Соответствие;
    КлючиАудитаUUID = Новый Массив;
    АудитПереносов = Новый Соответствие;
    КлючиАудитаПереносов = Новый Массив;
    СчетчикАудита = 0;

    ВыборкаАудита = РегистрыСведений.ЕРП_ЖурналАудитаПривязокTelegram.Выбрать();
    Пока ВыборкаАудита.Следующий() Цикл
        СчетчикАудита = СчетчикАудита + 1;

        Если ВыборкаАудита.Результат <> "Успех" Тогда
            Продолжить;
        КонецЕсли;

        Если ВыборкаАудита.СтарыйИдентификаторПривязки <> НулевойUUID() Тогда
            ДобавитьЭлементВГруппуСверкиTelegram(
                АудитПоUUID,
                КлючиАудитаUUID,
                Строка(ВыборкаАудита.СтарыйИдентификаторПривязки),
                ВыборкаАудита.ИдентификаторСобытия);
        КонецЕсли;

        Если ВыборкаАудита.НовыйИдентификаторПривязки <> НулевойUUID() Тогда
            ДобавитьЭлементВГруппуСверкиTelegram(
                АудитПоUUID,
                КлючиАудитаUUID,
                Строка(ВыборкаАудита.НовыйИдентификаторПривязки),
                ВыборкаАудита.ИдентификаторСобытия);
        КонецЕсли;

        Если ВыборкаАудита.ИдентификаторОперацииПереноса <> НулевойUUID()
            И ВыборкаАудита.Операция
                = Перечисления.ЕРП_ОперацииПривязкиTelegram.Перенос Тогда
            ДанныеАудитаПереноса = Новый Структура(
                "СтарыйUUID,НовыйUUID,Результат",
                ВыборкаАудита.СтарыйИдентификаторПривязки,
                ВыборкаАудита.НовыйИдентификаторПривязки,
                ВыборкаАудита.Результат);
            ДобавитьЭлементВГруппуСверкиTelegram(
                АудитПереносов,
                КлючиАудитаПереносов,
                Строка(ВыборкаАудита.ИдентификаторОперацииПереноса),
                ДанныеАудитаПереноса);
        КонецЕсли;

    КонецЦикла;

    Для Каждого ДанныеПривязки Из Привязки Цикл
        Если АудитПоUUID.Получить(
            Строка(ДанныеПривязки.ИдентификаторПривязки)) = Неопределено Тогда
            ДобавитьПроблемуСверкиTelegram(
                Проблемы,
                "ПРИВЯЗКА_БЕЗ_АУДИТА",
                "Критическая",
                "Для UUID привязки не найдено успешное событие в журнале аудита.",
                ДанныеПривязки.ИдентификаторПривязки,
                ДанныеПривязки.ИдентификаторОперацииПереноса,
                НулевойUUID(),
                ДанныеПривязки.ФизическоеЛицо,
                ДанныеПривязки.ИдентификаторБота,
                ДанныеПривязки.ChatID,
                ДанныеПривязки.Сотрудник);
        КонецЕсли;
    КонецЦикла;

    Для Каждого КлючUUIDАудита Из КлючиАудитаUUID Цикл
        Если ПривязкиПоUUID.Получить(КлючUUIDАудита) = Неопределено Тогда
            ДобавитьПроблемуСверкиTelegram(
                Проблемы,
                "АУДИТ_БЕЗ_ПРИВЯЗКИ",
                "Критическая",
                "Успешное событие аудита ссылается на UUID привязки, отсутствующий в регистре привязок.",
                Новый УникальныйИдентификатор(КлючUUIDАудита));
        КонецЕсли;
    КонецЦикла;

    // Проверка незавершённых запросов и длительно промежуточных состояний.
    СчетчикЗапросов = 0;
    ВыборкаЗапросов = РегистрыСведений.ЕРП_ЗапросыПривязкиTelegram.Выбрать();
    Пока ВыборкаЗапросов.Следующий() Цикл
        СчетчикЗапросов = СчетчикЗапросов + 1;

        Если ВыборкаЗапросов.Состояние = "ТехническаяОшибка" Тогда
            ДобавитьПроблемуСверкиTelegram(
                Проблемы,
                "ТЕХНИЧЕСКАЯ_ОШИБКА_ЗАПРОСА",
                "Критическая",
                "Запрос достиг лимита технических повторов и требует решения администратора. "
                    + ВыборкаЗапросов.ПоследняяОшибка,
                НулевойUUID(),
                ВыборкаЗапросов.ИдентификаторОперацииПереноса,
                ВыборкаЗапросов.ИдентификаторЗапроса,
                Неопределено,
                ВыборкаЗапросов.ИдентификаторБота,
                ВыборкаЗапросов.ChatID,
                ВыборкаЗапросов.Сотрудник);
            Продолжить;
        КонецЕсли;

        ЭтоПромежуточноеСостояние =
            ВыборкаЗапросов.Состояние = "Создан"
            Или ВыборкаЗапросов.Состояние = "ПолученОтБота"
            Или ВыборкаЗапросов.Состояние = "ОжидаетРазрешения";

        Если ЭтоПромежуточноеСостояние Тогда

            Если ВыборкаЗапросов.ИдентификаторЗапроса = НулевойUUID() Тогда
                ДобавитьПроблемуСверкиTelegram(
                    Проблемы,
                    "UUID_ЗАПРОСА_НЕ_ЗАПОЛНЕН",
                    "Предупреждение",
                    "У незавершённого запроса отсутствует UUID идемпотентности.",
                    НулевойUUID(),
                    ВыборкаЗапросов.ИдентификаторОперацииПереноса,
                    НулевойUUID(),
                    Неопределено,
                    ВыборкаЗапросов.ИдентификаторБота,
                    ВыборкаЗапросов.ChatID,
                    ВыборкаЗапросов.Сотрудник);
            КонецЕсли;

            Если ВыборкаЗапросов.ДатаИстечения < ДатаСверки Тогда
                ДобавитьПроблемуСверкиTelegram(
                    Проблемы,
                    "ПРОСРОЧЕННЫЙ_НЕЗАВЕРШЕННЫЙ_ЗАПРОС",
                    "Предупреждение",
                    "Срок запроса истёк, но его состояние осталось промежуточным.",
                    НулевойUUID(),
                    ВыборкаЗапросов.ИдентификаторОперацииПереноса,
                    ВыборкаЗапросов.ИдентификаторЗапроса,
                    Неопределено,
                    ВыборкаЗапросов.ИдентификаторБота,
                    ВыборкаЗапросов.ChatID,
                    ВыборкаЗапросов.Сотрудник);
            КонецЕсли;

            Если ДатаСверки - ВыборкаЗапросов.ДатаСоздания > 86400 Тогда
                КатегорияЗапроса = "ДЛИТЕЛЬНОЕ_ПРОМЕЖУТОЧНОЕ_СОСТОЯНИЕ";
                Если ВыборкаЗапросов.ИдентификаторОперацииПереноса <> НулевойUUID() Тогда
                    КатегорияЗапроса = "НЕЗАВЕРШЕННЫЙ_ПЕРЕНОС";
                КонецЕсли;

                ДобавитьПроблемуСверкиTelegram(
                    Проблемы,
                    КатегорияЗапроса,
                    "Предупреждение",
                    "Запрос находится в промежуточном состоянии более 24 часов. "
                        + "Автоматическое завершение или отмена не выполняются.",
                    НулевойUUID(),
                    ВыборкаЗапросов.ИдентификаторОперацииПереноса,
                    ВыборкаЗапросов.ИдентификаторЗапроса,
                    Неопределено,
                    ВыборкаЗапросов.ИдентификаторБота,
                    ВыборкаЗапросов.ChatID,
                    ВыборкаЗапросов.Сотрудник);
            КонецЕсли;

            Если ВыборкаЗапросов.ИдентификаторОперацииПереноса <> НулевойUUID() Тогда
                ГруппаСтаройПривязки = ПривязкиПоUUID.Получить(
                    Строка(ВыборкаЗапросов.СтарыйИдентификаторПривязки));
                ИсходнаяПривязкаАктивна = Ложь;

                Если ГруппаСтаройПривязки <> Неопределено Тогда
                    Для Каждого КандидатСтаройПривязки Из ГруппаСтаройПривязки Цикл
                        Если КандидатСтаройПривязки.Состояние = "Активна"
                            И КандидатСтаройПривязки.ИдентификаторБота
                                = ВыборкаЗапросов.ИдентификаторБота
                            И КандидатСтаройПривязки.ChatID = ВыборкаЗапросов.ChatID Тогда
                            ИсходнаяПривязкаАктивна = Истина;
                            Прервать;
                        КонецЕсли;
                    КонецЦикла;
                КонецЕсли;

                Если Не ИсходнаяПривязкаАктивна Тогда
                    ДобавитьПроблемуСверкиTelegram(
                        Проблемы,
                        "НЕСОГЛАСОВАННОСТЬ_ОПЕРАЦИИ_ПЕРЕНОСА",
                        "Критическая",
                        "Незавершённый перенос не ссылается на существующую активную исходную привязку с теми же ботом и ChatID.",
                        ВыборкаЗапросов.СтарыйИдентификаторПривязки,
                        ВыборкаЗапросов.ИдентификаторОперацииПереноса,
                        ВыборкаЗапросов.ИдентификаторЗапроса,
                        Неопределено,
                        ВыборкаЗапросов.ИдентификаторБота,
                        ВыборкаЗапросов.ChatID,
                        ВыборкаЗапросов.Сотрудник);
                КонецЕсли;
            КонецЕсли;

        ИначеЕсли ВыборкаЗапросов.Состояние <> "Подтверждён"
            И ВыборкаЗапросов.Состояние <> "Отменён"
            И ВыборкаЗапросов.Состояние <> "Отклонён"
            И ВыборкаЗапросов.Состояние <> "Истекла" Тогда

            ДобавитьПроблемуСверкиTelegram(
                Проблемы,
                "НЕИЗВЕСТНОЕ_СОСТОЯНИЕ_ЗАПРОСА",
                "Критическая",
                "Обнаружено неизвестное или не классифицированное состояние запроса: "
                    + ВыборкаЗапросов.Состояние,
                НулевойUUID(),
                ВыборкаЗапросов.ИдентификаторОперацииПереноса,
                ВыборкаЗапросов.ИдентификаторЗапроса,
                Неопределено,
                ВыборкаЗапросов.ИдентификаторБота,
                ВыборкаЗапросов.ChatID,
                ВыборкаЗапросов.Сотрудник);

        КонецЕсли;

    КонецЦикла;

    // Старый регистр истории остаётся архивом прежнего формата. Его строки
    // учитываются в отчёте, но не переписываются и не удаляются.
    СчетчикИстории = 0;
    ВыборкаИстории = РегистрыСведений.ЕРП_ИсторияПривязокTelegram.Выбрать();
    Пока ВыборкаИстории.Следующий() Цикл
        СчетчикИстории = СчетчикИстории + 1;

        Если Не ЗначениеЗаполнено(ВыборкаИстории.Сотрудник)
            Или Не ЗначениеЗаполнено(ВыборкаИстории.ИдентификаторБота)
            Или ВыборкаИстории.ИдентификаторБота = НулевойUUID()
            Или Не ЗначениеЗаполнено(ВыборкаИстории.ДатаСобытия)
            Или Не ЗначениеЗаполнено(ВыборкаИстории.Операция) Тогда

            ДобавитьПроблемуСверкиTelegram(
                Проблемы,
                "НЕКОРРЕКТНАЯ_АРХИВНАЯ_ИСТОРИЯ",
                "Предупреждение",
                "В архивной записи истории отсутствует сотрудник, бот, дата события или тип операции.",
                НулевойUUID(),
                НулевойUUID(),
                НулевойUUID(),
                Неопределено,
                ВыборкаИстории.ИдентификаторБота,
                ВыборкаИстории.ChatID,
                ВыборкаИстории.Сотрудник);

        КонецЕсли;
    КонецЦикла;

    КоличествоКритических = 0;
    КоличествоПредупреждений = 0;
    Для Каждого Проблема Из Проблемы Цикл
        Если Проблема.Уровень = "Критическая" Тогда
            КоличествоКритических = КоличествоКритических + 1;
        Иначе
            КоличествоПредупреждений = КоличествоПредупреждений + 1;
        КонецЕсли;
    КонецЦикла;

    // Сводка и детали одного запуска записываются атомарно. Предыдущие
    // результаты сохраняются для последующего административного разбора.
    НачатьТранзакцию();
    Попытка

        ДанныеСводки = СоздатьСтрокуРезультатаСверкиTelegram(
            ИдентификаторСверки,
            ДатаСверки,
            "Сводка",
            "ИТОГО",
            "Информация",
            "Сверка завершена. Архивных записей истории сохранено: "
                + Строка(СчетчикИстории)
                + ". Архивный регистр не изменялся.",
            Проблемы.Количество(),
            НулевойUUID(),
            НулевойUUID(),
            НулевойUUID(),
            Неопределено,
            НулевойUUID(),
            "",
            Неопределено);

        ДанныеСводки.КоличествоПроверенныхПривязок = Привязки.Количество();
        ДанныеСводки.КоличествоПроверенныхРезервирований = Резервирования.Количество();
        ДанныеСводки.КоличествоПроверенныхЗапросов = СчетчикЗапросов;
        ДанныеСводки.КоличествоПроверенныхСобытийАудита = СчетчикАудита;
        ДанныеСводки.КоличествоПроверенныхЗаписейИстории = СчетчикИстории;
        ДанныеСводки.КоличествоКритических = КоличествоКритических;
        ДанныеСводки.КоличествоПредупреждений = КоличествоПредупреждений;

        ЗаписатьСтрокуРезультатаСверкиTelegram(ДанныеСводки);

        Для Каждого Проблема Из Проблемы Цикл
            ДанныеПроблемы = СоздатьСтрокуРезультатаСверкиTelegram(
                ИдентификаторСверки,
                ДатаСверки,
                "Проблема",
                Проблема.Категория,
                Проблема.Уровень,
                Проблема.Описание,
                Проблема.Количество,
                Проблема.ИдентификаторПривязки,
                Проблема.ИдентификаторОперацииПереноса,
                Проблема.ИдентификаторЗапроса,
                Проблема.ФизическоеЛицо,
                Проблема.ИдентификаторБота,
                Проблема.ChatID,
                Проблема.Сотрудник);
            ЗаписатьСтрокуРезультатаСверкиTelegram(ДанныеПроблемы);
        КонецЦикла;

        ЗафиксироватьТранзакцию();

    Исключение
        Если ТранзакцияАктивна() Тогда
            ОтменитьТранзакцию();
        КонецЕсли;
        ВызватьИсключение;
    КонецПопытки;

    Попытка
        ЕРП_ЖурналУведомлений.Информация(
            "СВЕРКА TELEGRAM-ПРИВЯЗОК",
            "Регламентная сверка согласованности завершена.",
            "UUID сверки: " + Строка(ИдентификаторСверки)
                + "; привязок: " + Строка(Привязки.Количество())
                + "; резервирований: " + Строка(Резервирования.Количество())
                + "; запросов: " + Строка(СчетчикЗапросов)
                + "; проблем: " + Строка(Проблемы.Количество())
                + "; критических: " + Строка(КоличествоКритических)
                + "; предупреждений: " + Строка(КоличествоПредупреждений));
    Исключение
        // Сводка уже надёжно сохранена в регистре результатов сверки.
    КонецПопытки;

КонецПроцедуры


Процедура ДобавитьЭлементВГруппуСверкиTelegram(
    КартаГрупп,
    КлючиГрупп,
    КлючГруппы,
    ЗначениеГруппы)

    Если Не КартаГрупп.СодержитКлюч(КлючГруппы) Тогда
        КартаГрупп.Вставить(КлючГруппы, Новый Массив);
        КлючиГрупп.Добавить(КлючГруппы);
    КонецЕсли;

    Группа = КартаГрупп.Получить(КлючГруппы);
    Группа.Добавить(ЗначениеГруппы);

КонецПроцедуры


Процедура ДобавитьПроблемуСверкиTelegram(
    Проблемы,
    Категория,
    Уровень,
    Описание,
    ИдентификаторПривязки = Неопределено,
    ИдентификаторОперацииПереноса = Неопределено,
    ИдентификаторЗапроса = Неопределено,
    ФизическоеЛицо = Неопределено,
    ИдентификаторБота = Неопределено,
    ChatID = "",
    Сотрудник = Неопределено,
    Количество = 1)

    Проблема = Новый Структура;
    Проблема.Вставить("Категория", Категория);
    Проблема.Вставить("Уровень", Уровень);
    Проблема.Вставить("Описание", Лев(Описание, 1000));
    Проблема.Вставить("Количество", Количество);
    Проблема.Вставить("ИдентификаторПривязки",
        ?(ИдентификаторПривязки = Неопределено, НулевойUUID(), ИдентификаторПривязки));
    Проблема.Вставить("ИдентификаторОперацииПереноса",
        ?(ИдентификаторОперацииПереноса = Неопределено, НулевойUUID(), ИдентификаторОперацииПереноса));
    Проблема.Вставить("ИдентификаторЗапроса",
        ?(ИдентификаторЗапроса = Неопределено, НулевойUUID(), ИдентификаторЗапроса));
    Проблема.Вставить("ФизическоеЛицо",
        ?(ФизическоеЛицо = Неопределено, Справочники.ФизическиеЛица.ПустаяСсылка(), ФизическоеЛицо));
    Проблема.Вставить("ИдентификаторБота",
        ?(ИдентификаторБота = Неопределено, НулевойUUID(), ИдентификаторБота));
    Проблема.Вставить("ChatID", ChatID);
    Проблема.Вставить("Сотрудник",
        ?(Сотрудник = Неопределено, Справочники.Сотрудники.ПустаяСсылка(), Сотрудник));

    Проблемы.Добавить(Проблема);

КонецПроцедуры


Функция СоздатьСтрокуРезультатаСверкиTelegram(
    ИдентификаторСверки,
    ДатаСверки,
    ТипЗаписи,
    Категория,
    Уровень,
    Описание,
    Количество,
    ИдентификаторПривязки,
    ИдентификаторОперацииПереноса,
    ИдентификаторЗапроса,
    ФизическоеЛицо,
    ИдентификаторБота,
    ChatID,
    Сотрудник)

    Данные = Новый Структура;
    Данные.Вставить("ИдентификаторЗаписи", Новый УникальныйИдентификатор);
    Данные.Вставить("ИдентификаторСверки", ИдентификаторСверки);
    Данные.Вставить("ДатаСверки", ДатаСверки);
    Данные.Вставить("ТипЗаписи", ТипЗаписи);
    Данные.Вставить("Категория", Категория);
    Данные.Вставить("Уровень", Уровень);
    Данные.Вставить("Описание", Лев(Описание, 1000));
    Данные.Вставить("Количество", Количество);
    Данные.Вставить("ИдентификаторПривязки", ИдентификаторПривязки);
    Данные.Вставить("ИдентификаторОперацииПереноса", ИдентификаторОперацииПереноса);
    Данные.Вставить("ИдентификаторЗапроса", ИдентификаторЗапроса);
    Данные.Вставить("ФизическоеЛицо",
        ?(ФизическоеЛицо = Неопределено, Справочники.ФизическиеЛица.ПустаяСсылка(), ФизическоеЛицо));
    Данные.Вставить("ИдентификаторБота", ИдентификаторБота);
    Данные.Вставить("ChatID", ChatID);
    Данные.Вставить("Сотрудник",
        ?(Сотрудник = Неопределено, Справочники.Сотрудники.ПустаяСсылка(), Сотрудник));
    Данные.Вставить("КоличествоПроверенныхПривязок", 0);
    Данные.Вставить("КоличествоПроверенныхРезервирований", 0);
    Данные.Вставить("КоличествоПроверенныхЗапросов", 0);
    Данные.Вставить("КоличествоПроверенныхСобытийАудита", 0);
    Данные.Вставить("КоличествоПроверенныхЗаписейИстории", 0);
    Данные.Вставить("КоличествоКритических", 0);
    Данные.Вставить("КоличествоПредупреждений", 0);

    Возврат Данные;

КонецФункции



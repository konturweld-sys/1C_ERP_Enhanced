////////////////////////////////////////////////////////////////////////////////
// Управление жизненным циклом Telegram-привязок. Транспорт принадлежит UBT.
////////////////////////////////////////////////////////////////////////////////

Функция ЕРП_СоздатьКодПривязкиTelegram(Сотрудник) Экспорт
    ПроверитьПравоУправленияПривязкамиTelegram(Ложь);

    Если Не ЗначениеЗаполнено(Сотрудник) Тогда
        ВызватьИсключение "Не указан сотрудник.";
    КонецЕсли;

    Бот = ЕРП_ИнтеграцияUBT.ПолучитьБотаПоУмолчанию();
    Если Не ЗначениеЗаполнено(Бот) Тогда
        ВызватьИсключение "В UBT не найден активный Telegram-бот.";
    КонецЕсли;

    Код = СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");
    ХешКода = ЕРП_ПолучитьХешКода(Код);
    ДатаСоздания = ТекущаяДата();
    ДатаИстечения = ДатаСоздания + 600;

    // Сериализуем создание запросов, чтобы у сотрудника не оставалось
    // нескольких одновременно действующих кодов привязки.
    НачатьТранзакцию();
    Попытка
        ЗаблокироватьВсеЗапросыTelegram();

        СтарыеЗапросы = РегистрыСведений.ЕРП_ЗапросыПривязкиTelegram.Выбрать();
        Пока СтарыеЗапросы.Следующий() Цикл
            Если СтарыеЗапросы.Сотрудник = Сотрудник
                И (СтарыеЗапросы.Состояние = "Создан"
                    Или СтарыеЗапросы.Состояние = "ПолученОтБота") Тогда

                Старый = РегистрыСведений.ЕРП_ЗапросыПривязкиTelegram.СоздатьМенеджерЗаписи();
                Старый.ХешКода = СтарыеЗапросы.ХешКода;
                Старый.Прочитать();
                Старый.Состояние = "Отменён";
                Старый.Записать();
            КонецЕсли;
        КонецЦикла;

        Запрос = РегистрыСведений.ЕРП_ЗапросыПривязкиTelegram.СоздатьМенеджерЗаписи();
        Запрос.ХешКода = ХешКода;
        Запрос.Сотрудник = Сотрудник;
        Запрос.ИдентификаторБота = Бот.УникальныйИдентификатор();
        Запрос.ДатаСоздания = ДатаСоздания;
        Запрос.ДатаИстечения = ДатаИстечения;
        Запрос.Состояние = "Создан";
        Запрос.ChatID = "";
        Запрос.UpdateID = 0;
        Запрос.ДатаПодтверждения = Дата(1, 1, 1);
        Запрос.Записать();

        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;

    Возврат Новый Структура(
        "Код,Команда,ДатаИстечения",
        Код, "/start " + Код, ДатаИстечения
    );
КонецФункции


Функция ЕРП_ПолучитьСтатусПривязкиTelegram(Сотрудник) Экспорт
    ПроверитьПравоУправленияПривязкамиTelegram(Истина);

    Результат = Новый Структура(
        "Привязана,ChatID,ИдентификаторБота,ДатаПривязки,Состояние",
        Ложь, "", Неопределено, Дата(1,1,1), "НеПривязана"
    );
    Привязка = РегистрыСведений.ЕРП_ПривязкиTelegram.СоздатьМенеджерЗаписи();
    Привязка.Сотрудник = Сотрудник;
    Привязка.Прочитать();
    Если Привязка.Состояние = "Активна"
        И ЗначениеЗаполнено(Привязка.ChatID)
        И ЗначениеЗаполнено(Привязка.ИдентификаторБота) Тогда
        Результат.Привязана = Истина;
        Результат.ChatID = Привязка.ChatID;
        Результат.ИдентификаторБота = Привязка.ИдентификаторБота;
        Результат.ДатаПривязки = Привязка.ДатаПривязки;
        Результат.Состояние = Привязка.Состояние;
    КонецЕсли;
    Возврат Результат;
КонецФункции


Функция ЕРП_ОбработатьОбновленияTelegram(
    Бот, ChatID, ТипЧата, UpdateID, ТекстКоманды) Экспорт
    ПроверитьПравоУправленияПривязкамиTelegram(Истина);


    Результат = Новый Структура(
        "Принято,ОжидаетПодтверждения,Сообщение",
        Ложь, Ложь, ""
    );
    Если Не ЗначениеЗаполнено(Бот)
        Или Не ЗначениеЗаполнено(ChatID)
        Или ТипЧата <> "private"
        Или UpdateID <= 0 Тогда
        Результат.Сообщение = "Допускается только личный чат и корректное обновление Telegram.";
        Возврат Результат;
    КонецЕсли;

    Части = СтрРазделить(СокрЛП(ТекстКоманды), " ");
    Если Части.Количество() <> 2 Тогда
        Результат.Сообщение = "Ожидается команда /start КОД.";
        Возврат Результат;
    КонецЕсли;
    Команда = Части[0];
    Если Команда <> "/start" И Лев(Команда, 7) <> "/start@" Тогда
        Результат.Сообщение = "Неизвестная команда.";
        Возврат Результат;
    КонецЕсли;

    ХешКода = ЕРП_ПолучитьХешКода(Части[1]);
    НачатьТранзакцию();
    Попытка
        ЗаблокироватьВсеЗапросыTelegram();
        Запрос = РегистрыСведений.ЕРП_ЗапросыПривязкиTelegram.СоздатьМенеджерЗаписи();
        Запрос.ХешКода = ХешКода;
        Запрос.Прочитать();
        Если Запрос.Состояние <> "Создан"
            Или Запрос.ДатаИстечения < ТекущаяДата()
            Или Запрос.ИдентификаторБота <> Бот.УникальныйИдентификатор() Тогда
            ОтменитьТранзакцию();
            Результат.Сообщение = "Код недействителен, истёк или предназначен для другого бота.";
            Возврат Результат;
        КонецЕсли;

        ВыборкаЗапросов = РегистрыСведений.ЕРП_ЗапросыПривязкиTelegram.Выбрать();
        Пока ВыборкаЗапросов.Следующий() Цикл
            Если ВыборкаЗапросов.ИдентификаторБота = Запрос.ИдентификаторБота
                И ВыборкаЗапросов.UpdateID = UpdateID Тогда
                ОтменитьТранзакцию();
                Результат.Сообщение = "Повторное обновление Telegram проигнорировано.";
                Возврат Результат;
            КонецЕсли;
        КонецЦикла;

        Запрос.ChatID = ChatID;
        Запрос.UpdateID = UpdateID;
        Запрос.Состояние = "ПолученОтБота";
        Запрос.Записать();
        ЗафиксироватьТранзакцию();
        Результат.Принято = Истина;
    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Результат.ОжидаетПодтверждения = Истина;
    Результат.Сообщение = "Чат проверен. Завершите привязку подтверждением в ERP.";
    Возврат Результат;
КонецФункции


// Обратная совместимость: существующие вызовы продолжают передавать
// открытый UUID. В хранилище открытый код не записывается.
Процедура ЕРП_ПодтвердитьПривязкуTelegram(Сотрудник, Код) Экспорт
    ПроверитьПравоУправленияПривязкамиTelegram(Ложь);

    Если Не ЗначениеЗаполнено(Сотрудник) Тогда
        ВызватьИсключение "Не указан сотрудник.";
    КонецЕсли;
    Если Не ЗначениеЗаполнено(Код) Тогда
        ВызватьИсключение "Не указан код привязки.";
    КонецЕсли;

    ХешКода = ЕРП_ПолучитьХешКода(Код);
    ЗавершитьПривязкуTelegramПоХешу(Сотрудник, ХешКода);
КонецПроцедуры


// Подтверждение из формы списка запросов. Принимает уже вычисленный
// SHA-256-хеш; открытый UUID для повторного открытия формы не требуется.
Процедура ЕРП_ПодтвердитьПривязкуTelegramПоХешу(Сотрудник, ХешКода) Экспорт
    ПроверитьПравоУправленияПривязкамиTelegram(Ложь);

    Если Не ЗначениеЗаполнено(Сотрудник) Тогда
        ВызватьИсключение "Не указан сотрудник.";
    КонецЕсли;
    Если Не ЗначениеЗаполнено(ХешКода) Тогда
        ВызватьИсключение "Не указан хеш запроса привязки.";
    КонецЕсли;

    ЗавершитьПривязкуTelegramПоХешу(Сотрудник, ХешКода);
КонецПроцедуры


// Общая точка завершения для обоих экспортных методов.
// Блокировка ключа запроса берётся до чтения и проверки состояния,
// а все изменения выполняются в одной транзакции.
Процедура ЗавершитьПривязкуTelegramПоХешу(Сотрудник, ХешКода)
    НачатьТранзакцию();
    Попытка
        ЗаблокироватьЗапросTelegram(ХешКода);

        Запрос = РегистрыСведений.ЕРП_ЗапросыПривязкиTelegram.СоздатьМенеджерЗаписи();
        Запрос.ХешКода = ХешКода;
        Запрос.Прочитать();

        Если Запрос.ХешКода <> ХешКода
            Или Запрос.Сотрудник <> Сотрудник
            Или Запрос.Состояние <> "ПолученОтБота"
            Или Запрос.ДатаИстечения < ТекущаяДата()
            Или Не ЗначениеЗаполнено(Запрос.ChatID) Тогда
            ВызватьИсключение "Запрос привязки не готов к подтверждению, истёк или принадлежит другому сотруднику.";
        КонецЕсли;

        ЗаблокироватьПривязкуСотрудника(Сотрудник);
        ЗаблокироватьЗанятыйЧат(Запрос.ИдентификаторБота, Запрос.ChatID);
        ЗанятыйЧат = РегистрыСведений.ЕРП_ЗанятыеЧатыTelegram.СоздатьМенеджерЗаписи();
        ЗанятыйЧат.ИдентификаторБота = Запрос.ИдентификаторБота;
        ЗанятыйЧат.ChatID = Запрос.ChatID;
        ЗанятыйЧат.Прочитать();
        Если ЗначениеЗаполнено(ЗанятыйЧат.Сотрудник)
            И ЗанятыйЧат.Сотрудник <> Сотрудник Тогда
            ВызватьИсключение "Этот Telegram Chat ID уже закреплён за другим сотрудником.";
        КонецЕсли;

        Привязка = РегистрыСведений.ЕРП_ПривязкиTelegram.СоздатьМенеджерЗаписи();
        Привязка.Сотрудник = Сотрудник;
        Привязка.Прочитать();
        ЭтоЗамена = Привязка.Состояние = "Активна"
            И ЗначениеЗаполнено(Привязка.ChatID)
            И (Привязка.ChatID <> Запрос.ChatID
                Или Привязка.ИдентификаторБота <> Запрос.ИдентификаторБота);

        Если ЭтоЗамена Тогда
            ЗаписатьИсториюПривязки(
                Сотрудник, Привязка.ИдентификаторБота, Привязка.ChatID,
                Перечисления.ЕРП_ОперацииПривязкиTelegram.Замена,
                "Заменена прежняя привязка.", Привязка.ОснованиеЗапроса
            );
            СтарыйЧат = РегистрыСведений.ЕРП_ЗанятыеЧатыTelegram.СоздатьМенеджерЗаписи();
            СтарыйЧат.ИдентификаторБота = Привязка.ИдентификаторБота;
            СтарыйЧат.ChatID = Привязка.ChatID;
            СтарыйЧат.Прочитать();
            Если СтарыйЧат.Сотрудник = Сотрудник Тогда
                СтарыйЧат.Удалить();
            КонецЕсли;
        КонецЕсли;

        ИдентификаторПривязки = Новый УникальныйИдентификатор;
        Привязка.Сотрудник = Сотрудник;
        Привязка.ИдентификаторБота = Запрос.ИдентификаторБота;
        Привязка.ChatID = Запрос.ChatID;
        Привязка.ДатаПривязки = ТекущаяДата();
        Привязка.Состояние = "Активна";
        Привязка.ДатаИзменения = ТекущаяДата();
        Привязка.ОснованиеЗапроса = ХешКода;
        Привязка.ИдентификаторПривязки = ИдентификаторПривязки;
        Привязка.Записать();

        ЗанятыйЧат.Сотрудник = Сотрудник;
        ЗанятыйЧат.ДатаЗакрепления = ТекущаяДата();
        ЗанятыйЧат.ИдентификаторПривязки = ИдентификаторПривязки;
        ЗанятыйЧат.Записать();

        ЗаписатьИсториюПривязки(
            Сотрудник, Запрос.ИдентификаторБота, Запрос.ChatID,
            ?(ЭтоЗамена, Перечисления.ЕРП_ОперацииПривязкиTelegram.Замена,
                Перечисления.ЕРП_ОперацииПривязкиTelegram.Создание),
            "Подтверждена пользователем ERP.", ХешКода
        );
        Запрос.Состояние = "Подтверждён";
        Запрос.ДатаПодтверждения = ТекущаяДата();
        Запрос.Записать();

        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
КонецПроцедуры


Процедура ЕРП_ОтвязатьTelegram(Сотрудник, Причина = "Ручная отвязка") Экспорт
    ПроверитьПравоУправленияПривязкамиTelegram(Истина);

    НачатьТранзакцию();
    Попытка
        ЗаблокироватьПривязкуСотрудника(Сотрудник);
        Привязка = РегистрыСведений.ЕРП_ПривязкиTelegram.СоздатьМенеджерЗаписи();
        Привязка.Сотрудник = Сотрудник;
        Привязка.Прочитать();
        Если Привязка.Состояние = "Активна"
            И ЗначениеЗаполнено(Привязка.ChatID) Тогда
            ЗаблокироватьЗанятыйЧат(Привязка.ИдентификаторБота, Привязка.ChatID);
            ЗанятыйЧат = РегистрыСведений.ЕРП_ЗанятыеЧатыTelegram.СоздатьМенеджерЗаписи();
            ЗанятыйЧат.ИдентификаторБота = Привязка.ИдентификаторБота;
            ЗанятыйЧат.ChatID = Привязка.ChatID;
            ЗанятыйЧат.Прочитать();
            Если ЗанятыйЧат.Сотрудник = Сотрудник Тогда
                ЗанятыйЧат.Удалить();
            КонецЕсли;
            ЗаписатьИсториюПривязки(
                Сотрудник, Привязка.ИдентификаторБота, Привязка.ChatID,
                Перечисления.ЕРП_ОперацииПривязкиTelegram.Отключение,
                Причина, Привязка.ОснованиеЗапроса
            );
            Привязка.ChatID = "";
            Привязка.Состояние = "Отключена";
            Привязка.ДатаИзменения = ТекущаяДата();
            Привязка.Записать();
        КонецЕсли;
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
КонецПроцедуры


Процедура ЕРП_ОтключитьПривязкуПриДеактивацииСотрудника(Сотрудник) Экспорт
    Если Не РольДоступна("ЕРП_ФоноваяОбработкаУведомлений") Тогда
        ВызватьИсключение "Недостаточно прав для автоматической деактивации Telegram-привязки.";
    КонецЕсли;

    ЕРП_ОтвязатьTelegram(Сотрудник, "Сотрудник уволен или деактивирован.");
КонецПроцедуры


Процедура ЗаблокироватьВсеЗапросыTelegram()
    Блокировка = Новый БлокировкаДанных;
    Элемент = Блокировка.Добавить("РегистрСведений.ЕРП_ЗапросыПривязкиTelegram");
    Элемент.Режим = РежимБлокировкиДанных.Исключительный;
    Блокировка.Заблокировать();
КонецПроцедуры


Процедура ЗаблокироватьПривязкуСотрудника(Сотрудник)
    Блокировка = Новый БлокировкаДанных;
    Элемент = Блокировка.Добавить("РегистрСведений.ЕРП_ПривязкиTelegram");
    Элемент.УстановитьЗначение("Сотрудник", Сотрудник);
    Элемент.Режим = РежимБлокировкиДанных.Исключительный;
    Блокировка.Заблокировать();
КонецПроцедуры


Процедура ЗаблокироватьЗапросTelegram(ХешКода)
    Блокировка = Новый БлокировкаДанных;
    Элемент = Блокировка.Добавить("РегистрСведений.ЕРП_ЗапросыПривязкиTelegram");
    Элемент.УстановитьЗначение("ХешКода", ХешКода);
    Элемент.Режим = РежимБлокировкиДанных.Исключительный;
    Блокировка.Заблокировать();
КонецПроцедуры


Процедура ЗаблокироватьЗанятыйЧат(ИдентификаторБота, ChatID)
    Блокировка = Новый БлокировкаДанных;
    Элемент = Блокировка.Добавить("РегистрСведений.ЕРП_ЗанятыеЧатыTelegram");
    Элемент.УстановитьЗначение("ИдентификаторБота", ИдентификаторБота);
    Элемент.УстановитьЗначение("ChatID", ChatID);
    Элемент.Режим = РежимБлокировкиДанных.Исключительный;
    Блокировка.Заблокировать();
КонецПроцедуры


Процедура ЗаписатьИсториюПривязки(
    Сотрудник, ИдентификаторБота, ChatID, Операция, Причина, ХешЗапроса,
    ИдентификаторОперацииПереноса = Неопределено,
    СтарыйИдентификаторПривязки = Неопределено,
    НовыйИдентификаторПривязки = Неопределено)

    ЕРП_ЗаписьАудитаПривязокTelegram.Записать(
        Сотрудник, ИдентификаторБота, ChatID, Операция, Причина,
        ИдентификаторОперацииПереноса,
        СтарыйИдентификаторПривязки,
        НовыйИдентификаторПривязки);

КонецПроцедуры


Функция ЕРП_ПолучитьХешКода(Код)
    Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
    Хеширование.Добавить(ПолучитьДвоичныеДанныеИзСтроки(Код, КодировкаТекста.UTF8));
    Возврат Base64Строка(Хеширование.ХешСумма);
КонецФункции

// Отмена ожидающего запроса из административного интерфейса.
// Открытый UUID и хеш запроса не передаются на клиент.
Процедура ЕРП_ОтменитьЗапросПривязкиTelegramПоХешу(ХешКода) Экспорт
    ПроверитьПравоУправленияПривязкамиTelegram(Ложь);

    Если Не ЗначениеЗаполнено(ХешКода) Тогда
        ВызватьИсключение "Не указан идентификатор запроса привязки.";
    КонецЕсли;

    НачатьТранзакцию();
    Попытка
        ЗаблокироватьЗапросTelegram(ХешКода);

        Запрос = РегистрыСведений.ЕРП_ЗапросыПривязкиTelegram.СоздатьМенеджерЗаписи();
        Запрос.ХешКода = ХешКода;
        Запрос.Прочитать();

        Если Не Запрос.Выбран()
            Или (Запрос.Состояние <> "Создан"
                И Запрос.Состояние <> "ПолученОтБота") Тогда
            ВызватьИсключение "Запрос уже обработан или не может быть отменён.";
        КонецЕсли;

        Запрос.Состояние = "Отменён";
        Запрос.Записать();

        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
КонецПроцедуры


// Отклонение запроса, уже подтверждённого Telegram-ботом.
// Действие доступно только пользователям с отдельной ролью управления привязками.
Процедура ЕРП_ОтклонитьЗапросПривязкиTelegramПоХешу(ХешКода, Причина) Экспорт

    Если Не РольДоступна("ЕРП_УправлениеПривязкамиTelegram") Тогда
        ВызватьИсключение "Недостаточно прав для отклонения запросов Telegram-привязки.";
    КонецЕсли;

    Если Не ЗначениеЗаполнено(ХешКода) Тогда
        ВызватьИсключение "Не указан идентификатор запроса привязки.";
    КонецЕсли;

    Причина = СокрЛП(Причина);
    Если Не ЗначениеЗаполнено(Причина) Тогда
        ВызватьИсключение "Укажите причину отклонения запроса.";
    КонецЕсли;
    Если СтрДлина(Причина) > 250 Тогда
        ВызватьИсключение "Причина отклонения не должна превышать 250 символов.";
    КонецЕсли;

    Инициатор = Пользователи.ТекущийПользователь();
    Если Не ЗначениеЗаполнено(Инициатор) Тогда
        ВызватьИсключение "Не удалось определить пользователя, выполняющего отклонение.";
    КонецЕсли;

    НачатьТранзакцию();
    Попытка
        ЗаблокироватьЗапросTelegram(ХешКода);

        Запрос = РегистрыСведений.ЕРП_ЗапросыПривязкиTelegram.СоздатьМенеджерЗаписи();
        Запрос.ХешКода = ХешКода;
        Запрос.Прочитать();

        Если Не Запрос.Выбран()
            Или Запрос.Состояние <> "ПолученОтБота"
            Или Не ЗначениеЗаполнено(Запрос.ИдентификаторБота)
            Или Не ЗначениеЗаполнено(Запрос.ChatID)
            Или Запрос.ДатаИстечения < ТекущаяДата() Тогда
            ВызватьИсключение "Отклонить можно только действующий запрос, ожидающий подтверждения.";
        КонецЕсли;

        ЗаписатьИсториюПривязки(
            Запрос.Сотрудник,
            Запрос.ИдентификаторБота,
            Запрос.ChatID,
            Перечисления.ЕРП_ОперацииПривязкиTelegram.Отклонение,
            Причина,
            ХешКода
        );

        Запрос.Состояние = "Отклонён";
        Запрос.Записать();

        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;

КонецПроцедуры


Процедура ПроверитьПравоУправленияПривязкамиTelegram(ДопускаетсяФоноваяОбработка)

    Если РольДоступна("ЕРП_УправлениеПривязкамиTelegram") Тогда
        Возврат;
    КонецЕсли;

    Если ДопускаетсяФоноваяОбработка
        И РольДоступна("ЕРП_ФоноваяОбработкаУведомлений") Тогда
        Возврат;
    КонецЕсли;

    ВызватьИсключение "Недостаточно прав для выполнения операции Telegram-привязки.";

КонецПроцедуры


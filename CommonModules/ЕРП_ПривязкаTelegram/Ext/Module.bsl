    БизнесОшибки.Добавить("Не указан сотрудник.");
    БизнесОшибки.Добавить("Нельзя привязать Telegram к сотруднику, помеченному на удаление.");
    БизнесОшибки.Добавить("Нельзя привязать Telegram к уволенному сотруднику.");
    БизнесОшибки.Добавить("У сотрудника не указано физическое лицо.");
    БизнесОшибки.Добавить("Нельзя использовать физическое лицо, помеченное на удаление.");
    БизнесОшибки.Добавить("Перенос возможен только из активной привязки.");
    БизнесОшибки.Добавить("Новый владелец совпадает с текущим сотрудником.");
    БизнесОшибки.Добавить("ChatID встречается в архивной записи прежней модели.");
    БизнесОшибки.Добавить("Привязка с указанным UUID не найдена.");
    БизнесОшибки.Добавить("UUID привязки не уникален.");
    БизнесОшибки.Добавить("Исходная привязка изменилась после инициации переноса.");
    БизнесОшибки.Добавить("Резервирование ChatID не соответствует исходной привязке.");
    БизнесОшибки.Добавить("Исходная запись изменилась после блокировки.");
    БизнесОшибки.Добавить("Физическое лицо исходного сотрудника изменилось.");

    Для Каждого ФрагментОшибки Из БизнесОшибки Цикл
        Если СтрНайти(ТекстОшибки, ФрагментОшибки) > 0 Тогда
            Возврат Ложь;
        КонецЕсли;
    КонецЦикла;

    Возврат Истина;

КонецФункции


Функция ЗафиксироватьНеудачнуюПопыткуЗапросаTelegram(
    ХешКода,
    ИдентификаторЗапроса,
    UpdateID,
    ChatID,
    ТекстОшибки)

    Результат = Новый Структура(
        "КоличествоПопыток,ТехническаяОшибка,ДатаСледующейПопытки",
        0, Ложь, Дата(1, 1, 1));

    НачатьТранзакцию();
    Попытка
        ЗаблокироватьЗапросTelegram(ХешКода);

        ЗаписьЗапроса = РегистрыСведений.ЕРП_ЗапросыПривязкиTelegram.СоздатьМенеджерЗаписи();
        ЗаписьЗапроса.ХешКода = ХешКода;
        ЗаписьЗапроса.Прочитать();

        Если Не ЗаписьЗапроса.Выбран()
            Или ЗаписьЗапроса.Состояние = "Подтверждён"
            Или ЗаписьЗапроса.Состояние = "Отменён"
            Или ЗаписьЗапроса.Состояние = "Истекла"
            Или ЗаписьЗапроса.Состояние = "ТехническаяОшибка" Тогда
            ЗафиксироватьТранзакцию();
            Возврат Результат;
        КонецЕсли;

        Если ЗаписьЗапроса.ИдентификаторЗапроса = НулевойUUID() Тогда
            Если ИдентификаторЗапроса <> НулевойUUID() Тогда
                ЗаписьЗапроса.ИдентификаторЗапроса = ИдентификаторЗапроса;
            Иначе
                ЗаписьЗапроса.ИдентификаторЗапроса = Новый УникальныйИдентификатор;
            КонецЕсли;
        ИначеЕсли ИдентификаторЗапроса <> НулевойUUID()
            И ЗаписьЗапроса.ИдентификаторЗапроса <> ИдентификаторЗапроса Тогда
            ЗафиксироватьТранзакцию();
            Возврат Результат;
        КонецЕсли;

        Если UpdateID > 0 Тогда
            Если ЗаписьЗапроса.UpdateID > 0
                И (ЗаписьЗапроса.UpdateID <> UpdateID
                    Или ЗаписьЗапроса.ChatID <> ChatID) Тогда
                ЗафиксироватьТранзакцию();
                Возврат Результат;
            КонецЕсли;
            ЗаписьЗапроса.UpdateID = UpdateID;
            ЗаписьЗапроса.ChatID = ChatID;
        КонецЕсли;

        ЗаписьЗапроса.КоличествоПопыток = ЗаписьЗапроса.КоличествоПопыток + 1;
        ЗаписьЗапроса.ДатаПоследнейПопытки = ТекущаяДата();
        ЗаписьЗапроса.ПоследняяОшибка = Лев(ТекстОшибки, 1000);

        Результат.КоличествоПопыток = ЗаписьЗапроса.КоличествоПопыток;

        Если ЗаписьЗапроса.КоличествоПопыток >= 5 Тогда
            ЗаписьЗапроса.Состояние = "ТехническаяОшибка";
            ЗаписьЗапроса.ДатаСледующейПопытки = Дата(1, 1, 1);
            Результат.ТехническаяОшибка = Истина;
        Иначе
            ИнтервалСекунд = ИнтервалПовтораЗапросаTelegram(
                ЗаписьЗапроса.КоличествоПопыток);
            ЗаписьЗапроса.ДатаСледующейПопытки =
                ТекущаяДата() + ИнтервалСекунд;
            Результат.ДатаСледующейПопытки =
                ЗаписьЗапроса.ДатаСледующейПопытки;
        КонецЕсли;

        ЗаписьЗапроса.Записать();
        ЗафиксироватьТранзакцию();

        Если Результат.ТехническаяОшибка Тогда
            Попытка
                ЕРП_ЖурналУведомлений.Ошибка(
                    "Telegram привязка",
                    "Исчерпан лимит повторных попыток обработки запроса привязки.",
                    "UUID запроса: " + Строка(ЗаписьЗапроса.ИдентификаторЗапроса)
                        + "; сотрудник: " + Строка(ЗаписьЗапроса.Сотрудник)
                        + "; попыток: " + Строка(Результат.КоличествоПопыток)
                        + "; последняя ошибка: " + Лев(ТекстОшибки, 1000));
            Исключение
                // Ошибка журнала не отменяет фиксацию терминального состояния.
            КонецПопытки;
        КонецЕсли;

    Исключение
        Если ТранзакцияАктивна() Тогда
            ОтменитьТранзакцию();
        КонецЕсли;
        ВызватьИсключение;
    КонецПопытки;

    Возврат Результат;

КонецФункции



КонецПроцедуры


Функция ПроверитьАудитКонтролируемогоПереносаTelegram(
    ИдентификаторОперации,
    СтарыйUUID,
    НовыйUUID)

    ВыборкаАудита = РегистрыСведений.ЕРП_ЖурналАудитаПривязокTelegram.Выбрать();
    Пока ВыборкаАудита.Следующий() Цикл
        Если ВыборкаАудита.Результат = "Успех"
            И ВыборкаАудита.Операция
                = Перечисления.ЕРП_ОперацииПривязкиTelegram.Перенос
            И ВыборкаАудита.ИдентификаторОперацииПереноса = ИдентификаторОперации
            И ВыборкаАудита.СтарыйИдентификаторПривязки = СтарыйUUID
            И ВыборкаАудита.НовыйИдентификаторПривязки = НовыйUUID Тогда
            Возврат Истина;
        КонецЕсли;
    КонецЦикла;

    Возврат Ложь;

КонецФункции



////////////////////////////////////////////////////////////////////////////////
// Append-only административное решение по результату регламентной сверки.
////////////////////////////////////////////////////////////////////////////////

Функция ЕРП_ЗафиксироватьРешениеПоСверкеTelegram(
    ИдентификаторЗаписиПроблемы,
    Решение,
    ПричинаРешения,
    СостояниеПослеРешения) Экспорт

    Если Не РольДоступна("ЕРП_УправлениеПривязкамиTelegram")
        И Не РольДоступна("АдминистраторСистемы") Тогда
        ВызватьИсключение "Недостаточно прав для административного решения по Telegram-сверке.";
    КонецЕсли;

    Решение = СокрЛП(Решение);
    ПричинаРешения = СокрЛП(ПричинаРешения);
    СостояниеПослеРешения = СокрЛП(СостояниеПослеРешения);

    Если Не ЗначениеЗаполнено(ИдентификаторЗаписиПроблемы)
        Или ИдентификаторЗаписиПроблемы = НулевойUUID() Тогда
        ВызватьИсключение "Не указан UUID проблемной записи.";
    КонецЕсли;

    Если Решение <> "ИсправленоВручную"
        И Решение <> "ЛожноеСрабатывание"
        И Решение <> "ОставленоБезИзменений" Тогда
        ВызватьИсключение "Недопустимый тип решения.";
    КонецЕсли;

    Если ПустаяСтрока(ПричинаРешения)
        Или ПустаяСтрока(СостояниеПослеРешения) Тогда
        ВызватьИсключение "Причина и описание состояния после решения обязательны.";
    КонецЕсли;

    Если СтрДлина(ПричинаРешения) > 1000
        Или СтрДлина(СостояниеПослеРешения) > 1000 Тогда
        ВызватьИсключение "Причина и описание результата ограничены 1000 символами.";
    КонецЕсли;

    НачатьТранзакцию();
    Попытка

        // Общая исключительная блокировка исключает одновременное принятие
        // двух решений по одной и той же проблеме разными администраторами.
        Блокировка = Новый БлокировкаДанных;
        ЭлементБлокировки = Блокировка.Добавить(
            "РегистрСведений.ЕРП_РезультатыСверкиПривязокTelegram");
        ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
        Блокировка.Заблокировать();

        ИсходнаяЗапись = РегистрыСведений.ЕРП_РезультатыСверкиПривязокTelegram.СоздатьМенеджерЗаписи();
        ИсходнаяЗапись.ИдентификаторЗаписи = ИдентификаторЗаписиПроблемы;
        ИсходнаяЗапись.Прочитать();

        Если Не ИсходнаяЗапись.Выбран()
            Или ИсходнаяЗапись.ТипЗаписи <> "Проблема" Тогда
            ВызватьИсключение "Выбранная запись не является проблемой регламентной сверки.";
        КонецЕсли;

        ЗапросПовтора = Новый Запрос;
        ЗапросПовтора.УстановитьПараметр("ИдентификаторПроблемы", ИдентификаторЗаписиПроблемы);
        ЗапросПовтора.Текст =
        "ВЫБРАТЬ ПЕРВЫЕ 1
        |   Решения.ИдентификаторЗаписи
        |ИЗ
        |   РегистрСведений.ЕРП_РезультатыСверкиПривязокTelegram КАК Решения
        |ГДЕ
        |   Решения.ТипЗаписи = ""Решение""
        |   И Решения.ИдентификаторПроблемы = &ИдентификаторПроблемы";
        Если Не ЗапросПовтора.Выполнить().Пустой() Тогда
            ВызватьИсключение "По этой проблеме уже зарегистрировано административное решение. Повторное применение запрещено.";
        КонецЕсли;

        Если Решение = "ИсправленоВручную" Тогда

            // Подтверждаем исправление только по более поздней регламентной
            // сверке, в которой тот же конфликт уже не обнаруживается.
            ЗапросПоследнейСверки = Новый Запрос;
            ЗапросПоследнейСверки.УстановитьПараметр("ДатаПроблемы", ИсходнаяЗапись.ДатаСверки);
            ЗапросПоследнейСверки.Текст =
            "ВЫБРАТЬ ПЕРВЫЕ 1
            |   Сводки.ИдентификаторСверки
            |ИЗ
            |   РегистрСведений.ЕРП_РезультатыСверкиПривязокTelegram КАК Сводки
            |ГДЕ
            |   Сводки.ТипЗаписи = ""Сводка""
            |   И Сводки.ДатаСверки > &ДатаПроблемы
            |УПОРЯДОЧИТЬ ПО
            |   Сводки.ДатаСверки УБЫВ";
            ВыборкаСверки = ЗапросПоследнейСверки.Выполнить().Выбрать();
            Если Не ВыборкаСверки.Следующий() Тогда
                ВызватьИсключение "После обнаружения проблемы ещё не выполнялась повторная регламентная сверка.";
            КонецЕсли;

            ЗапросПроблемы = Новый Запрос;
            ЗапросПроблемы.УстановитьПараметр("ИдентификаторСверки", ВыборкаСверки.ИдентификаторСверки);
            ЗапросПроблемы.УстановитьПараметр("Категория", ИсходнаяЗапись.Категория);
            ЗапросПроблемы.УстановитьПараметр("ИдентификаторПривязки", ИсходнаяЗапись.ИдентификаторПривязки);
            ЗапросПроблемы.УстановитьПараметр("ИдентификаторОперацииПереноса", ИсходнаяЗапись.ИдентификаторОперацииПереноса);
            ЗапросПроблемы.УстановитьПараметр("ИдентификаторЗапроса", ИсходнаяЗапись.ИдентификаторЗапроса);
            ЗапросПроблемы.УстановитьПараметр("ФизическоеЛицо", ИсходнаяЗапись.ФизическоеЛицо);
            ЗапросПроблемы.УстановитьПараметр("ИдентификаторБота", ИсходнаяЗапись.ИдентификаторБота);
            ЗапросПроблемы.УстановитьПараметр("ChatID", ИсходнаяЗапись.ChatID);
            ЗапросПроблемы.УстановитьПараметр("Сотрудник", ИсходнаяЗапись.Сотрудник);
            ЗапросПроблемы.Текст =
            "ВЫБРАТЬ ПЕРВЫЕ 1
            |   Проблемы.ИдентификаторЗаписи
            |ИЗ
            |   РегистрСведений.ЕРП_РезультатыСверкиПривязокTelegram КАК Проблемы
            |ГДЕ
            |   Проблемы.ТипЗаписи = ""Проблема""
            |   И Проблемы.ИдентификаторСверки = &ИдентификаторСверки
            |   И Проблемы.Категория = &Категория
            |   И Проблемы.ИдентификаторПривязки = &ИдентификаторПривязки
            |   И Проблемы.ИдентификаторОперацииПереноса = &ИдентификаторОперацииПереноса
            |   И Проблемы.ИдентификаторЗапроса = &ИдентификаторЗапроса
            |   И Проблемы.ФизическоеЛицо = &ФизическоеЛицо
            |   И Проблемы.ИдентификаторБота = &ИдентификаторБота
            |   И Проблемы.ChatID = &ChatID
            |   И Проблемы.Сотрудник = &Сотрудник";
            Если Не ЗапросПроблемы.Выполнить().Пустой() Тогда
                ВызватьИсключение "Повторная сверка по-прежнему обнаруживает эту проблему. Закрытие как исправленной запрещено.";
            КонецЕсли;

        КонецЕсли;

        СнимокДо = "UUID записи: " + Строка(ИсходнаяЗапись.ИдентификаторЗаписи)
            + "; UUID сверки: " + Строка(ИсходнаяЗапись.ИдентификаторСверки)
            + "; дата: " + Формат(ИсходнаяЗапись.ДатаСверки, "ДФ=dd.MM.yyyy HH:mm:ss")
            + "; категория: " + ИсходнаяЗапись.Категория
            + "; уровень: " + ИсходнаяЗапись.Уровень
            + "; описание: " + ИсходнаяЗапись.Описание
            + "; UUID привязки: " + Строка(ИсходнаяЗапись.ИдентификаторПривязки)
            + "; UUID переноса: " + Строка(ИсходнаяЗапись.ИдентификаторОперацииПереноса)
            + "; UUID запроса: " + Строка(ИсходнаяЗапись.ИдентификаторЗапроса)
            + "; бот: " + Строка(ИсходнаяЗапись.ИдентификаторБота)
            + "; ChatID: " + ИсходнаяЗапись.ChatID
            + "; сотрудник: " + Строка(ИсходнаяЗапись.Сотрудник);

        РешениеЗапись = РегистрыСведений.ЕРП_РезультатыСверкиПривязокTelegram.СоздатьМенеджерЗаписи();
        РешениеЗапись.ИдентификаторЗаписи = Новый УникальныйИдентификатор;
        РешениеЗапись.ИдентификаторСверки = ИсходнаяЗапись.ИдентификаторСверки;
        РешениеЗапись.ДатаСверки = ИсходнаяЗапись.ДатаСверки;
        РешениеЗапись.ТипЗаписи = "Решение";
        РешениеЗапись.Категория = ИсходнаяЗапись.Категория;
        РешениеЗапись.Уровень = ИсходнаяЗапись.Уровень;
        РешениеЗапись.Описание = ИсходнаяЗапись.Описание;
        РешениеЗапись.Количество = ИсходнаяЗапись.Количество;
        РешениеЗапись.ИдентификаторПривязки = ИсходнаяЗапись.ИдентификаторПривязки;
        РешениеЗапись.ИдентификаторОперацииПереноса = ИсходнаяЗапись.ИдентификаторОперацииПереноса;
        РешениеЗапись.ИдентификаторЗапроса = ИсходнаяЗапись.ИдентификаторЗапроса;
        РешениеЗапись.ФизическоеЛицо = ИсходнаяЗапись.ФизическоеЛицо;
        РешениеЗапись.ИдентификаторБота = ИсходнаяЗапись.ИдентификаторБота;
        РешениеЗапись.ChatID = ИсходнаяЗапись.ChatID;
        РешениеЗапись.Сотрудник = ИсходнаяЗапись.Сотрудник;
        РешениеЗапись.ИдентификаторПроблемы = ИдентификаторЗаписиПроблемы;
        РешениеЗапись.Решение = Решение;
        РешениеЗапись.ПричинаРешения = ПричинаРешения;
        РешениеЗапись.ДатаРешения = ТекущаяДата();
        РешениеЗапись.ИнициаторРешения = Пользователи.ТекущийПользователь();
        РешениеЗапись.СостояниеДоРешения = Лев(СнимокДо, 1000);
        РешениеЗапись.СостояниеПослеРешения = СостояниеПослеРешения;
        РешениеЗапись.Записать();

        ИдентификаторНовойЗаписи = РешениеЗапись.ИдентификаторЗаписи;
        ЗафиксироватьТранзакцию();

    Исключение
        Если ТранзакцияАктивна() Тогда
            ОтменитьТранзакцию();
        КонецЕсли;
        ВызватьИсключение;
    КонецПопытки;

    Возврат ИдентификаторНовойЗаписи;

КонецФункции


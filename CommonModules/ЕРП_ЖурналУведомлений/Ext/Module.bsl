                      
#Область ПубличныйИнтерфейс

// Единая точка записи событий подсистемы Email и Telegram.
// Уровни: INFO, WARN, ERROR.
// Ошибка журналирования не передаётся вызывающему коду.

Процедура Записать(Уровень, Операция, Сообщение, ДополнительнаяИнформация = "") Экспорт
	
	Попытка
		
		ЗаписатьВоФайл(Уровень, Операция, Сообщение, ДополнительнаяИнформация);
		
	Исключение
		// Не вызываем журнал повторно, чтобы избежать рекурсии.
	КонецПопытки;
	
КонецПроцедуры


Процедура Информация(Операция, Сообщение, ДополнительнаяИнформация = "") Экспорт
	
	Записать("INFO", Операция, Сообщение, ДополнительнаяИнформация);
	
КонецПроцедуры


Процедура Предупреждение(Операция, Сообщение, ДополнительнаяИнформация = "") Экспорт
	
	Записать("WARN", Операция, Сообщение, ДополнительнаяИнформация);
	
КонецПроцедуры


Процедура Ошибка(Операция, Сообщение, ДополнительнаяИнформация = "") Экспорт
	
	Записать("ERROR", Операция, Сообщение, ДополнительнаяИнформация);
	
КонецПроцедуры

#КонецОбласти


#Область СлужебныеПроцедурыИФункции

Процедура ЗаписатьВоФайл(Уровень, Операция, Сообщение, ДополнительнаяИнформация)
	
	КаталогЖурнала = "D:\1C Log";
	ИмяФайлаЖурнала = КаталогЖурнала
		+ "\ERP_Email_Telegram_Notification.log";
	
	ТранзакцияБылаАктивна = ТранзакцияАктивна();
	НачалиСобственнуюТранзакцию = Ложь;
	
	Попытка
		
		Если Не ТранзакцияБылаАктивна Тогда
			НачатьТранзакцию();
			НачалиСобственнуюТранзакцию = Истина;
		КонецЕсли;
		
		// Сериализация записей журнала между сеансами 1С.
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить(
			"РегистрСведений.ЕРП_БлокировкаЖурнала");
		
		ЭлементБлокировки.УстановитьЗначение("Ключ", "ЖУРНАЛ");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		
		Блокировка.Заблокировать();
		
		ФайлКаталога = Новый Файл(КаталогЖурнала);
		
		Если Не ФайлКаталога.Существует() Тогда
			СоздатьКаталог(КаталогЖурнала);
		КонецЕсли;
		
		МеткаВремени = Формат(
			ТекущаяДата(),
			"ДФ=yyyy-MM-dd HH:mm:ss");
		
		СтрокаЖурнала = МеткаВремени
			+ " | " + НормализоватьПоле(Уровень)
			+ " | " + НормализоватьПоле(Операция)
			+ " | " + НормализоватьПоле(Сообщение);
		
		Если Не ПустаяСтрока(ДополнительнаяИнформация) Тогда
			СтрокаЖурнала = СтрокаЖурнала
				+ " | " + НормализоватьПоле(ДополнительнаяИнформация);
		КонецЕсли;
		
		Запись = Новый ЗаписьТекста(
			ИмяФайлаЖурнала,
			КодировкаТекста.UTF8,
			Символы.ПС,
			РежимОткрытияФайла.Дозапись);
		
		Запись.ЗаписатьСтроку(СтрокаЖурнала);
		Запись.Закрыть();
		
		Если НачалиСобственнуюТранзакцию Тогда
			ЗафиксироватьТранзакцию();
			НачалиСобственнуюТранзакцию = Ложь;
		КонецЕсли;
		
	Исключение
		
		Если НачалиСобственнуюТранзакцию Тогда
			ОтменитьТранзакцию();
			НачалиСобственнуюТранзакцию = Ложь;
		КонецЕсли;
		
		ВызватьИсключение;
		
	КонецПопытки;
	
КонецПроцедуры


Функция НормализоватьПоле(Значение)
	
	Результат = Строка(Значение);
	
	Результат = СтрЗаменить(Результат, Символы.ВК, " ");
	Результат = СтрЗаменить(Результат, Символы.ПС, " ");
	Результат = СтрЗаменить(Результат, Символы.Таб, " ");
	
	Возврат СокрЛП(Результат);
	
КонецФункции

#КонецОбласти

////////////////////////////////////////////////////////////////////////////////
// Модуль объекта справочника ЕРП_МаскиЖурналов.
// Маски являются предопределёнными правилами; разрешено менять только Активна.
////////////////////////////////////////////////////////////////////////////////

Процедура ПередЗаписью(Отказ)

    Если ЭтоНовый() Тогда

        Если Не Предопределенный Тогда
            Отказ = Истина;
            Сообщить("Создание пользовательских масок журналов запрещено.");
        КонецЕсли;

        Возврат;

    КонецЕсли;

    СтарыйОбъект = Ссылка.ПолучитьОбъект();

    Если Код <> СтарыйОбъект.Код
        Или Наименование <> СтарыйОбъект.Наименование
        Или МаскаФайлов <> СтарыйОбъект.МаскаФайлов
        Или ТипПоиска <> СтарыйОбъект.ТипПоиска
        Или ШаблонПоиска <> СтарыйОбъект.ШаблонПоиска
        Или ИсключающиеСлова <> СтарыйОбъект.ИсключающиеСлова
        Или УчитыватьРегистр <> СтарыйОбъект.УчитыватьРегистр
        Или ШаблонТемы <> СтарыйОбъект.ШаблонТемы
        Или ШаблонСообщения <> СтарыйОбъект.ШаблонСообщения
        Или РегулярноеВыражениеВремени <> СтарыйОбъект.РегулярноеВыражениеВремени Тогда

        Отказ = Истина;
        Сообщить("Параметры предопределённой маски неизменяемы. Разрешено изменять только признак «Активна».");

    КонецЕсли;

КонецПроцедуры


Процедура ПередУдалением(Отказ)

    Отказ = Истина;
    Сообщить("Удаление предопределённых масок журналов запрещено.");

КонецПроцедуры

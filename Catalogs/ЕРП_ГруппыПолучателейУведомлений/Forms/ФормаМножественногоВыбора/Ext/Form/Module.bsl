////////////////////////////////////////////////////////////////////////////////
// Форма множественного выбора групп получателей уведомлений.
//
// Контракт вызова:
// - РежимВыбора = Истина;
// - МножественныйВыбор = Истина;
// - ЗакрыватьПриВыборе = Ложь;
// - форма открывается с владельцем и обработчиком результата.
//
// Команда «Выбрать» возвращает владельцу массив ссылок
// СправочникСсылка.ЕРП_ГруппыПолучателейУведомлений через
// ОповеститьОВыборе(). Запись в справочник и регистры не выполняется.
////////////////////////////////////////////////////////////////////////////////

&НаКлиенте
Процедура ВыбратьГруппы(Команда)

	ВыбранныеСсылки = Новый Массив;

	Для Каждого КлючСтроки Из Элементы.Список.ВыделенныеСтроки Цикл

		СсылкаГруппы = Неопределено;

		// Для динамического списка с основной таблицей ключом строки
		// является ссылка справочника.
		Если ТипЗнч(КлючСтроки) = Тип("СправочникСсылка.ЕРП_ГруппыПолучателейУведомлений") Тогда

			СсылкаГруппы = КлючСтроки;

		Иначе

			// Резервный путь для ключей строк, не являющихся ссылками.
			ДанныеСтроки = Элементы.Список.ДанныеСтроки(КлючСтроки);

			Если ДанныеСтроки <> Неопределено Тогда
				СсылкаГруппы = ДанныеСтроки.Ссылка;
			КонецЕсли;

		КонецЕсли;

		Если ТипЗнч(СсылкаГруппы) = Тип("СправочникСсылка.ЕРП_ГруппыПолучателейУведомлений") Тогда
			Если ВыбранныеСсылки.Найти(СсылкаГруппы) = Неопределено Тогда
				ВыбранныеСсылки.Добавить(СсылкаГруппы);
			КонецЕсли;
		КонецЕсли;

	КонецЦикла;

	Если ВыбранныеСсылки.Количество() = 0 Тогда
		ПоказатьПредупреждение(
			,
			"Выделите одну или несколько групп получателей."
		);
		Возврат;
	КонецЕсли;

	// Платформа передает массив владельцу формы и завершает выбор.
	ОповеститьОВыборе(ВыбранныеСсылки);

КонецПроцедуры

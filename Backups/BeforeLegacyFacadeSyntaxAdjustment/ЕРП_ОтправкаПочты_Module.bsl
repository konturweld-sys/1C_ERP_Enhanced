////////////////////////////////////////////////////////////////////////////////
// УСТАРЕВШИЙ СОВМЕСТИМЫЙ ФАСАД SMTP.
//
// Рабочая отправка Email выполняется только через ЕРП_УведомленияEmail
// и штатную подсистему БСП РаботаСПочтовымиСообщениями.
// Реквизиты регистра ЕРП_НастройкиSMTP больше не читаются и не записываются.
////////////////////////////////////////////////////////////////////////////////

Функция ЕРП_ПолучитьНастройкиSMTP() Экспорт

    // Сохраняем форму совместимости для существующей формы настройки.
    // Реальные параметры берутся из учетной записи БСП.
    Возврат Новый Структура(
        "SMTPСервер,SMTPПорт,SMTPЛогин,SMTPПароль,АдресОтправителя,ИспользоватьSSL",
        "",
        465,
        "",
        "",
        "",
        Истина
    );

КонецФункции


Функция ЕРП_СохранитьНастройкиSMTP(
    SMTPСервер,
    SMTPПорт,
    SMTPЛогин,
    SMTPПароль,
    АдресОтправителя,
    ИспользоватьSSL) Экспорт

    // Не сохраняем SMTP-пароли в расширении.
    // Учетные записи и параметры почты настраиваются штатными средствами ERP/БСП.
    Возврат
        "Настройки SMTP в расширении не сохраняются. Настройте учетную запись электронной почты штатными средствами ERP.";

КонецФункции


Функция ЕРП_ОтправитьПисьмо(Получатель, Тема, ТекстПисьма) Экспорт

    Результат = ЕРП_УведомленияEmail.ОтправитьПисьмо(
        Получатель,
        Тема,
        ТекстПисьма
    );

    Если Результат.Успех Тогда
        Возврат "Письмо передано штатной подсистеме БСП.";
    КонецЕсли;

    Возврат "ОШИБКА ОТПРАВКИ EMAIL: " + Результат.ОписаниеОшибки;

КонецФункции
